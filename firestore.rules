rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /mysteryBoxGames/{gameId} {
      allow read: if request.auth != null || resource.data.isPublic == true;
      allow write: if request.auth != null;
    }
    match /gameFolders/{folderId} {
      allow read, write: if request.auth != null;
    }
    match /users/{userId} {
      allow read, write: if request.auth != null;
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null;
      }
    }
    match /classRewards/{rewardId} {
      allow read, write: if request.auth != null;
    }
    match /userClassData/{userId} {
      allow read, write: if request.auth != null;
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for Room
    function isValidRoom(data) {
      return data.keys().hasAll(['hostId', 'status', 'createdAt'])
        && data.hostId is string && data.hostId.size() <= 128
        && data.status is string && data.status in ['lobby', 'playing', 'finished']
        && data.createdAt is number
        && data.hostId == request.auth.uid; // Only host can create/update room
    }

    // Validation for Player
    function isValidPlayer(data) {
      return data.keys().hasAll(['name', 'score', 'joinedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 20
        && data.score is number
        && data.joinedAt is number;
    }

    match /ttt_rooms/{roomId} {
      allow read, write: if true;
      match /actions/{actionId} {
        allow read, write: if true;
      }
    }
    
    match /rooms/{roomId} {
      // Allow read to everyone so players can join
      allow get: if isValidId(roomId);
      allow list: if false; // No blanket listing of rooms

      // Host can create their room
      allow create: if isSignedIn() && isValidId(roomId) && isValidRoom(incoming()) && incoming().createdAt == request.time;
      
      // Host can update their room
      allow update: if isSignedIn() && isValidId(roomId) && existing().hostId == request.auth.uid && isValidRoom(incoming()) && incoming().hostId == existing().hostId && incoming().createdAt == existing().createdAt;
      
      // Host can delete their room
      allow delete: if isSignedIn() && isValidId(roomId) && existing().hostId == request.auth.uid;

      match /players/{playerId} {
        // Anyone in the room can read players
        allow read: if isValidId(roomId) && isValidId(playerId);

        // A player can join the room anonymously or signed in
        allow create: if isValidId(roomId) && isValidId(playerId) && isValidPlayer(incoming()) && incoming().joinedAt == request.time;
        
        // A player can update their own score
        allow update: if isValidId(roomId) && isValidId(playerId) && isValidPlayer(incoming()) && incoming().name == existing().name && incoming().joinedAt == existing().joinedAt;
        
        // A player can leave, or host can kick
        allow delete: if isValidId(roomId) && isValidId(playerId);
      }
    }
  }
}
