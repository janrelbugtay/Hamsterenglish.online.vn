rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'janrelbugtay03@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'janrelbugtay03@gmail.com')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User accounts and profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // User activity logs
    match /userActivities/{activityId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Custom games created across all modes (Slap & Chop, Mystery Box, Shark Attack, etc.)
    match /mysteryBoxGames/{gameId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    // Game folders
    match /gameFolders/{folderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    // Classroom data and student economy
    match /userClassData/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /classRewards/{rewardId} {
      allow read, write: if isSignedIn();
    }

    // App global settings & page visits
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Tic-Tac-Toe Multiplayer Rooms
    match /ttt_rooms/{roomId} {
      allow read, write: if true;
      match /actions/{actionId} {
        allow read, write: if true;
      }
    }

    // Multiplayer Game Rooms
    match /rooms/{roomId} {
      allow get: if isValidId(roomId);
      allow list: if false;

      allow create: if isSignedIn() && isValidId(roomId);
      allow update: if isSignedIn() && isValidId(roomId) && (resource.data.hostId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(roomId) && (resource.data.hostId == request.auth.uid || isAdmin());

      match /players/{playerId} {
        allow read, write: if isValidId(roomId) && isValidId(playerId);
      }
    }
  }
}
