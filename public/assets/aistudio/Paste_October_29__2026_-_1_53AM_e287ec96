        if (!playViewVisible) return;

        if (e.code === 'Space' || e.code === 'ArrowRight') {
          e.preventDefault();
          dealNextCard();
        } else if (e.code === 'ArrowUp' || e.code === 'ArrowDown' || e.code === 'KeyF') {
          if (appState.cardSides === 2 && appState.currentCard) {
            e.preventDefault();
            flipCurrentCard();
          }
        } else if (e.code === 'ArrowLeft' || e.code === 'Backspace') {
          e.preventDefault();
          undoLastDeal();
        } else if (e.code === 'KeyS') {
          e.preventDefault();
          shuffleDeckInGame();
        } else if (e.code === 'Escape') {
