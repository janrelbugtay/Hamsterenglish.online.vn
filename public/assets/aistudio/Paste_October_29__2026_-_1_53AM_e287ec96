                      </button>
                    ` : ''}
                  </div>
                </div>
              </div>
            </div>
          `;
        }
      }).join('');
    }

    function escapeHtml(str) {
      if (!str) return '';
      return str.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function updateCardField(index, field, val) {
      if (appState.cards[index]) {
        appState.cards[index][field] = val;
      }
    }

    function addNewCard() {
      if (appState.cards.length >= 50) {
        showToast('Maximum 50 cards per deck reached', 'warn');
        return;
      }
      appState.cards.push({
        id: 'c_' + Date.now(),
        frontText: '',
        backText: '',
        frontMedia: '✨',
        backMedia: ''
      });
      renderCardsEditor();
      playSound('deal');
    }

    function duplicateCard(index) {
      const copy = JSON.parse(JSON.stringify(appState.cards[index]));
      copy.id = 'c_' + Date.now();
      appState.cards.splice(index + 1, 0, copy);
      renderCardsEditor();
      showToast('Card duplicated', 'info');
    }

    function deleteCard(index) {
      if (appState.cards.length <= 1) {
        showToast('Deck must have at least 1 card!', 'warn');
        return;
      }
      appState.cards.splice(index, 1);
      renderCardsEditor();
    }

    function swapSingleCardSides(index) {
      const c = appState.cards[index];
      const tempText = c.frontText;
      const tempMedia = c.frontMedia;
      c.frontText = c.backText;
      c.frontMedia = c.backMedia;
      c.backText = tempText;
      c.backMedia = tempMedia;
      renderCardsEditor();
      playSound('flip');
    }

    function swapAllFrontBack() {
      appState.cards.forEach(c => {
        const tempText = c.frontText;
        const tempMedia = c.frontMedia;
        c.frontText = c.backText;
        c.frontMedia = c.backMedia;
        c.backText = tempText;
        c.backMedia = tempMedia;
      });
      renderCardsEditor();
      playSound('flip');
      showToast('Swapped Front & Back for all cards!', 'success');
    }

    function loadPresetSample() {
      appState.topic = 'Feelings & Emotions (Cảm xúc)';
      appState.level = 'Movers / Flyers (B1)';
      appState.cardSides = 2;
      appState.contentMode = 'both';
      appState.theme = 'london';
      appState.cards = JSON.parse(JSON.stringify(DEFAULT_CARDS));
      document.getElementById('topicInput').value = appState.topic;
      document.getElementById('levelInput').value = appState.level;
      renderThemeSelector();
      updateConfigUI();
      renderCardsEditor();
      showToast('Loaded Sample Emotions Deck!', 'success');
    }

    /*************************************************************
     * 10. MEDIA / EMOJI / UPLOAD MODAL FUNCTIONS
     *************************************************************/
    function renderStickerGrid() {
      const grid = document.getElementById('emojiStickerGrid');
      grid.innerHTML = STICKER_EMOJIS.map(emoji => `
        <button type="button" onclick="selectEmojiSticker('${emoji}')"
          class="h-10 rounded-xl bg-white hover:bg-purple-100 border border-slate-200 flex items-center justify-center text-2xl transition transform hover:scale-110">
          ${emoji}
        </button>
      `).join('');
    }

    function openMediaPickerModal(cardIndex, side) {
      activeMediaTarget = { cardIndex, side };
      const currentVal = side === 'front' ? appState.cards[cardIndex].frontMedia : appState.cards[cardIndex].backMedia;
      document.getElementById('mediaUrlInput').value = isImageData(currentVal) && currentVal.startsWith('http') ? currentVal : '';
      document.getElementById('mediaPickerModal').classList.remove('hidden');
    }

    function closeMediaPickerModal() {
      document.getElementById('mediaPickerModal').classList.add('hidden');
      activeMediaTarget = null;
    }

    function selectEmojiSticker(emoji) {
      if (!activeMediaTarget) return;
      const { cardIndex, side } = activeMediaTarget;
      if (side === 'front') appState.cards[cardIndex].frontMedia = emoji;
      else appState.cards[cardIndex].backMedia = emoji;
      renderCardsEditor();
      closeMediaPickerModal();
      playSound('flip');
    }

    function handleLocalImageUpload(event) {
      const file = event.target.files[0];
      if (!file || !activeMediaTarget) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        const { cardIndex, side } = activeMediaTarget;
        if (side === 'front') appState.cards[cardIndex].frontMedia = e.target.result;
        else appState.cards[cardIndex].backMedia = e.target.result;
        renderCardsEditor();
        closeMediaPickerModal();
        showToast('Picture added to card!', 'success');
      };
      reader.readAsDataURL(file);
      event.target.value = '';
    }

    function applyMediaUrl() {
      const url = document.getElementById('mediaUrlInput').value.trim();
      if (!url || !activeMediaTarget) return;
      const { cardIndex, side } = activeMediaTarget;
      if (side === 'front') appState.cards[cardIndex].frontMedia = url;
      else appState.cards[cardIndex].backMedia = url;
      renderCardsEditor();
      closeMediaPickerModal();
      showToast('Image URL applied!', 'success');
    }

    function clearCurrentMediaSlot() {
      if (!activeMediaTarget) return;
      const { cardIndex, side } = activeMediaTarget;
      if (side === 'front') appState.cards[cardIndex].frontMedia = '';
      else appState.cards[cardIndex].backMedia = '';
      renderCardsEditor();
      closeMediaPickerModal();
    }

    /*************************************************************
     * 11. BULK PASTE & LIBRARY STORAGE
     *************************************************************/
    function openBulkPasteModal() {
      document.getElementById('bulkPasteModal').classList.remove('hidden');
    }
    function closeBulkPasteModal() {
      document.getElementById('bulkPasteModal').classList.add('hidden');
    }
    function openHowToBulkModal() {
      document.getElementById('howToBulkModal').classList.remove('hidden');
    }
    function closeHowToBulkModal() {
      document.getElementById('howToBulkModal').classList.add('hidden');
    }

    function processBulkPaste() {
      const raw = document.getElementById('bulkPasteTextarea').value.trim();
      if (!raw) {
        showToast('Please paste some lines first', 'warn');
        return;
      }
      const lines = raw.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
      const parsedCards = lines.map((line, i) => {
        const parts = line.includes('|') ? line.split('|') : line.split('\t');
        return {
          id: 'bulk_' + Date.now() + '_' + i,
          frontText: (parts[0] || '').trim(),
          backText: (parts[1] || '').trim(),
          frontMedia: (parts[2] || '✨').trim(),
          backMedia: (parts[3] || '').trim()
        };
      });

      const replaceAll = document.getElementById('bulkReplaceCheckbox').checked;
      if (replaceAll) {
        appState.cards = parsedCards;
      } else {
        appState.cards = [...appState.cards, ...parsedCards].slice(0, 50);
      }

      renderCardsEditor();
      closeBulkPasteModal();
      document.getElementById('bulkPasteTextarea').value = '';
      showToast(`Imported ${parsedCards.length} flashcards!`, 'success');
    }

    // Folder & LocalStorage Library
    function openNewFolderModal() {
      document.getElementById('newFolderModal').classList.remove('hidden');
    }
    function closeNewFolderModal() {
      document.getElementById('newFolderModal').classList.add('hidden');
    }
    function confirmAddFolder() {
      const name = document.getElementById('newFolderNameInput').value.trim();
      if (!name) return;
      const select = document.getElementById('folderSelect');
      const opt = document.createElement('option');
      opt.value = name;
      opt.textContent = name;
      opt.selected = true;
      select.appendChild(opt);
      appState.folder = name;
      document.getElementById('newFolderNameInput').value = '';
      closeNewFolderModal();
      showToast(`Folder "${name}" created!`, 'success');
    }

    function getSavedLibrary() {
      try {
        return JSON.parse(localStorage.getItem('cardmaster_decks_v1') || '[]');
      } catch {
        return [];
      }
    }

    function updateLibraryBadge() {
      const decks = getSavedLibrary();
      document.getElementById('libraryCountBadge').textContent = decks.length;
    }

    function saveDeckToLibrary() {
      appState.topic = document.getElementById('topicInput').value.trim() || 'Untitled Flashcard Deck';
      appState.level = document.getElementById('levelInput').value.trim() || 'General';
      appState.folder = document.getElementById('folderSelect').value;

      const decks = getSavedLibrary();
      const newEntry = {
        id: 'deck_' + Date.now(),
        savedAt: new Date().toLocaleDateString(),
        topic: appState.topic,
        level: appState.level,
        folder: appState.folder,
        cardSides: appState.cardSides,
        contentMode: appState.contentMode,
        theme: appState.theme,
        cards: appState.cards
      };
      decks.unshift(newEntry);
      localStorage.setItem('cardmaster_decks_v1', JSON.stringify(decks.slice(0, 30)));
      updateLibraryBadge();
      playSound('deal');
      showToast(`Saved "${appState.topic}" to My Library!`, 'success');
    }

    function openLibraryModal() {
      const decks = getSavedLibrary();
      const container = document.getElementById('savedDecksContainer');
      if (decks.length === 0) {
        container.innerHTML = `
          <div class="p-8 text-center text-slate-400 border-2 border-dashed border-slate-200 rounded-2xl">
            <i class="ph-duotone ph-books text-4xl mb-2"></i>
            <p class="font-bold text-sm text-slate-600">No saved decks yet</p>
            <p class="text-xs mt-1">Click "Save Quiz" in the top bar to store your customized decks here.</p>
          </div>
        `;
      } else {
        container.innerHTML = decks.map((d, idx) => `
          <div class="p-4 rounded-2xl border border-slate-200 hover:border-indigo-300 bg-slate-50/70 flex items-center justify-between gap-3">
            <div>
              <div class="flex items-center gap-2">
                <span class="font-extrabold text-sm text-slate-900">${escapeHtml(d.topic)}</span>
                <span class="px-2 py-0.5 text-[10px] font-bold bg-indigo-100 text-indigo-700 rounded-md">${d.cards.length} cards</span>
                <span class="px-2 py-0.5 text-[10px] font-bold bg-amber-100 text-amber-800 rounded-md">${d.cardSides === 2 ? '2-Sided' : '1-Sided'}</span>
              </div>
              <div class="text-xs text-slate-500 mt-0.5">
                Folder: <strong>${escapeHtml(d.folder)}</strong> • Level: ${escapeHtml(d.level)} • Saved ${d.savedAt}
              </div>
            </div>
            <div class="flex items-center gap-2">
              <button onclick="loadDeckFromLibrary(${idx})" class="px-3.5 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold">Load</button>
              <button onclick="deleteDeckFromLibrary(${idx})" class="w-8 h-8 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-600 flex items-center justify-center">
                <i class="ph-bold ph-trash"></i>
              </button>
            </div>
          </div>
        `).join('');
      }
      document.getElementById('libraryModal').classList.remove('hidden');
    }

    function closeLibraryModal() {
      document.getElementById('libraryModal').classList.add('hidden');
    }

    function loadDeckFromLibrary(idx) {
      const decks = getSavedLibrary();
      const d = decks[idx];
      if (!d) return;
      appState.topic = d.topic;
      appState.level = d.level;
      appState.folder = d.folder;
      appState.cardSides = d.cardSides || 2;
      appState.contentMode = d.contentMode || 'both';
      appState.theme = d.theme || 'london';
      appState.cards = JSON.parse(JSON.stringify(d.cards));

      document.getElementById('topicInput').value = appState.topic;
      document.getElementById('levelInput').value = appState.level;
      renderThemeSelector();
      updateConfigUI();
      renderCardsEditor();
      closeLibraryModal();
      showToast(`Loaded "${d.topic}"!`, 'success');
    }

    function deleteDeckFromLibrary(idx) {
      const decks = getSavedLibrary();
      decks.splice(idx, 1);
      localStorage.setItem('cardmaster_decks_v1', JSON.stringify(decks));
      updateLibraryBadge();
      openLibraryModal();
    }

    /*************************************************************
     * 12. PLAY / CARD DEALER VIEW ENGINE
     *************************************************************/
    function startGame() {
      // Sync metadata inputs
      appState.topic = document.getElementById('topicInput').value.trim() || 'Flashcard Activity';
      appState.level = document.getElementById('levelInput').value.trim() || 'All Levels';

      // Filter valid cards
      const validCards = appState.cards.filter(c =>
        c.frontText.trim() !== '' || c.backText.trim() !== '' || c.frontMedia !== '' || c.backMedia !== ''
      );

      if (validCards.length === 0) {
        showToast('Please add content to at least 1 card before playing!', 'warn');
        return;
      }

      // Initialize Play Session
      appState.undealtDeck = JSON.parse(JSON.stringify(validCards));
      appState.dealtHistory = [];
      appState.currentCard = null;
      appState.isCurrentFlipped = !appState.dealFrontFirst;

      // Switch Views
      document.getElementById('setupView').classList.add('hidden');
      const playView = document.getElementById('playView');
      playView.classList.remove('hidden');
      playView.classList.add('flex');

      // Setup HUD & Theme Background
      document.getElementById('hudTopicTitle').textContent = appState.topic;
      document.getElementById('hudLevelBadge').textContent = appState.level;
      document.getElementById('hudModeBadge').textContent =
        appState.cardSides === 2 ? '2-Sided Flip' : '1-Sided Direct';

      // Show/Hide 2-Sided specific controls
      document.getElementById('btnFlipDock').style.display = appState.cardSides === 2 ? 'flex' : 'none';
      document.getElementById('dealSideToggleWrap').classList.toggle('md:flex', appState.cardSides === 2);
      document.getElementById('dealSideToggleWrap').classList.toggle('hidden', appState.cardSides === 1);

      renderPlayStageBackground();
      renderDeckStack();
      renderActiveDealtCard();
      startPlayTimer();
      playSound('shuffle');
    }

    function exitGameToSetup() {
      stopPlayTimer();
      document.getElementById('playView').classList.add('hidden');
      document.getElementById('playView').classList.remove('flex');
      document.getElementById('setupView').classList.remove('hidden');
    }

    function renderPlayStageBackground() {
      const themeObj = THEMES[appState.theme] || THEMES.london;
      document.getElementById('themeStageBackground').innerHTML = themeObj.stageSvg;
      document.getElementById('hudThemeIcon').textContent = themeObj.badge.split(' ')[0];
      document.getElementById('inGameThemeSelect').value = appState.theme;
    }

    function renderDeckStack() {
      const themeObj = THEMES[appState.theme] || THEMES.london;
      const count = appState.undealtDeck.length;
      const total = count + appState.dealtHistory.length;

      // Update HUD Progress
      const dealtCount = appState.dealtHistory.length;
      document.getElementById('hudDealtCount').textContent = dealtCount;
      document.getElementById('hudTotalCount').textContent = total;
      const pct = total > 0 ? Math.round((dealtCount / total) * 100) : 0;
      document.getElementById('hudProgressBar').style.width = `${pct}%`;

      document.getElementById('deckRemainingLabel').textContent =
        count > 0 ? `${count} card${count > 1 ? 's' : ''} in deck — Click to Deal` : '0 cards left in deck';

      const container = document.getElementById('deckThicknessContainer');
      const emptyPlaceholder = document.getElementById('emptyDeckPlaceholder');

      if (count === 0) {
        container.innerHTML = '';
        emptyPlaceholder.classList.remove('hidden');
        document.getElementById('btnDealDock').disabled = true;
        return;
      }

      emptyPlaceholder.classList.add('hidden');
      document.getElementById('btnDealDock').disabled = false;

      // Build realistic 3D stacked layers (up to 6 visible depth slices)
      const layers = Math.min(count, 6);
      let html = '';

      // Bottom solid 3D base block (replicates the thick blue-grey block from the screenshot)
      const stackDepthPx = layers * 7;
      html += `
        <div class="absolute inset-x-0 top-3 bottom-0 rounded-3xl bg-slate-500/90 border-2 border-slate-600/80 shadow-[0_24px_45px_rgba(0,0,0,0.55)]"
             style="transform: translateY(${stackDepthPx}px);"></div>
      `;

      for (let i = layers - 1; i >= 0; i--) {
        const offsetY = i * 5;
        const isTopCard = i === 0;
        html += `
          <div class="absolute inset-0 rounded-3xl ${themeObj.deckCardBg} border-4 shadow-md flex items-center justify-center p-4 transition-all"
               style="transform: translateY(${offsetY}px);">
            <div class="w-full h-full rounded-2xl border-2 border-current/30 flex flex-col items-center justify-center relative">
              <!-- Corner ornaments -->
              <span class="absolute top-2 left-2 w-2.5 h-2.5 border-t-2 border-l-2 border-current/50"></span>
              <span class="absolute top-2 right-2 w-2.5 h-2.5 border-t-2 border-r-2 border-current/50"></span>
              <span class="absolute bottom-2 left-2 w-2.5 h-2.5 border-b-2 border-l-2 border-current/50"></span>
              <span class="absolute bottom-2 right-2 w-2.5 h-2.5 border-b-2 border-r-2 border-current/50"></span>
              ${isTopCard ? themeObj.emblemSvg : ''}
            </div>
          </div>
        `;
      }

      container.innerHTML = html;
    }

    function formatCardFaceHTML(text, media) {
      const showText = appState.contentMode === 'text' || appState.contentMode === 'both';
      const showPhoto = appState.contentMode === 'photo' || appState.contentMode === 'both';
      const themeObj = THEMES[appState.theme] || THEMES.london;

      const hasText = Boolean(showText && text && text.trim() !== '');
      const hasPhoto = Boolean(showPhoto && media && media.trim() !== '');

      // CASE 1: BOTH WORD AND PICTURE PRESENT -> SPLIT HORIZONTAL LAYOUT (LEFT = WORDS, RIGHT = PICTURE)
      if (hasText && hasPhoto) {
        const len = text.trim().length;
        let sizeClass = 'text-4xl sm:text-5xl lg:text-6xl xl:text-7xl';
        if (len > 55) sizeClass = 'text-2xl sm:text-3xl lg:text-4xl';
        else if (len > 28) sizeClass = 'text-3xl sm:text-4xl lg:text-5xl';

        const formattedLines = escapeHtml(text).replace(/\n/g, '<br/>');

        let rightVisualHTML = '';
        if (isImageData(media)) {
          rightVisualHTML = `
            <div class="w-full h-full max-h-[420px] rounded-3xl overflow-hidden shadow-lg border-4 border-slate-100 bg-slate-50 flex items-center justify-center p-3">
              <img src="${media}" alt="Card visual" class="w-full h-full object-contain rounded-2xl" />
            </div>
          `;
        } else {
          rightVisualHTML = `
            <div class="w-full h-full max-h-[420px] rounded-3xl bg-slate-100/75 border-2 border-slate-200/80 shadow-inner flex items-center justify-center p-6">
              <div class="text-[6.5rem] sm:text-[9rem] lg:text-[11.5rem] xl:text-[13rem] leading-none select-none drop-shadow-md transition-transform duration-300 hover:scale-105">
                ${media}
              </div>
            </div>
          `;
        }

        return `
          <div class="w-full h-full grid grid-cols-1 md:grid-cols-12 gap-4 sm:gap-8 items-center">
            <!-- LEFT SIDE: WORDS -->
            <div class="md:col-span-7 h-full flex flex-col items-center md:items-start justify-center text-center md:text-left px-2 sm:px-4 overflow-y-auto">
              <div class="${themeObj.cardFont} ${sizeClass} font-extrabold text-slate-900 tracking-tight leading-[1.15] break-words w-full">
                ${formattedLines}
              </div>
            </div>

            <!-- RIGHT SIDE: PICTURE / STICKER -->
            <div class="md:col-span-5 h-full flex items-center justify-center min-h-0">
              ${rightVisualHTML}
            </div>
          </div>
        `;
      }

      // CASE 2: ONLY PICTURE PRESENT -> MASSIVE CENTERED PICTURE
      if (hasPhoto && !hasText) {
        if (isImageData(media)) {
          return `
            <div class="w-full h-full flex items-center justify-center p-2">
              <img src="${media}" alt="Card visual" class="max-w-full max-h-full object-contain rounded-3xl shadow-lg border-4 border-slate-100" />
            </div>
          `;
        }
        return `
          <div class="w-full h-full flex items-center justify-center">
            <div class="text-[8rem] sm:text-[11rem] lg:text-[14rem] leading-none select-none drop-shadow-md">
              ${media}
            </div>
          </div>
        `;
      }

      // CASE 3: ONLY WORDS PRESENT -> MASSIVE CENTERED TYPOGRAPHY
      if (hasText && !hasPhoto) {
        const len = text.trim().length;
        let sizeClass = 'text-4xl sm:text-6xl lg:text-7xl xl:text-8xl';
        if (len > 60) sizeClass = 'text-2xl sm:text-4xl lg:text-5xl';
        else if (len > 30) sizeClass = 'text-3xl sm:text-5xl lg:text-6xl';

        const formattedLines = escapeHtml(text).replace(/\n/g, '<br/>');
        return `
          <div class="w-full h-full flex items-center justify-center text-center px-4">
            <div class="${themeObj.cardFont} ${sizeClass} font-extrabold text-slate-900 tracking-tight leading-tight break-words max-w-full">
              ${formattedLines}
            </div>
          </div>
        `;
      }

      return `<div class="text-slate-400 italic text-xl">(Empty Side)</div>`;
    }

    function renderActiveDealtCard(animationType = 'none') {
      const noCardEl = document.getElementById('noCardDealtState');
      const activeStage = document.getElementById('activeCardStage');
      const flipInner = document.getElementById('activeCardFlipInner');

      // Update Undo & Flip buttons state
      document.getElementById('btnUndoDeal').disabled = appState.dealtHistory.length === 0;
      document.getElementById('btnFlipDock').disabled = !appState.currentCard;

      if (!appState.currentCard) {
        noCardEl.classList.remove('hidden');
        activeStage.classList.add('hidden');
        return;
      }

      noCardEl.classList.add('hidden');
      activeStage.classList.remove('hidden');

      // Apply Deal or Undo animation
      activeStage.classList.remove('animate-deal', 'animate-undo');
      void activeStage.offsetWidth; // Force reflow
      if (animationType === 'deal') {
        activeStage.classList.add('animate-deal');
      }

      // Sync Flip Rotation
      if (appState.cardSides === 2 && appState.isCurrentFlipped) {
        flipInner.classList.add('is-flipped');
      } else {
        flipInner.classList.remove('is-flipped');
      }

      // Populate Front & Back content
      const card = appState.currentCard;
      const cardNumber = appState.dealtHistory.length;

      document.getElementById('frontContentBody').innerHTML = formatCardFaceHTML(card.frontText, card.frontMedia);
      document.getElementById('backContentBody').innerHTML = formatCardFaceHTML(card.backText, card.backMedia);

      document.getElementById('frontCardIndexLabel').textContent = `Card #${cardNumber}`;
      document.getElementById('backCardIndexLabel').textContent = `Card #${cardNumber}`;

      // Update badges based on 1-Sided vs 2-Sided
      document.getElementById('frontSideBadge').textContent =
        appState.cardSides === 2 ? 'Front • Prompt' : 'Flashcard';
      document.getElementById('frontFlipHint').style.display =
        appState.cardSides === 2 ? 'flex' : 'none';
    }

    function dealNextCard() {
      if (appState.undealtDeck.length === 0) {
        showToast('All cards dealt! Click Shuffle to play again.', 'info');
        return;
      }

      const nextCard = appState.undealtDeck.shift();
      appState.dealtHistory.push(nextCard);
      appState.currentCard = nextCard;
      appState.isCurrentFlipped = appState.cardSides === 2 ? !appState.dealFrontFirst : false;

      playSound('deal');
      renderDeckStack();
      renderActiveDealtCard('deal');
    }

    function undoLastDeal() {
      if (appState.dealtHistory.length === 0) return;

      const activeStage = document.getElementById('activeCardStage');
      activeStage.classList.remove('animate-deal');
      activeStage.classList.add('animate-undo');
      playSound('undo');

      setTimeout(() => {
        const returnedCard = appState.dealtHistory.pop();
        appState.undealtDeck.unshift(returnedCard);
        appState.currentCard = appState.dealtHistory[appState.dealtHistory.length - 1] || null;
        appState.isCurrentFlipped = appState.cardSides === 2 ? !appState.dealFrontFirst : false;

        renderDeckStack();
        renderActiveDealtCard('none');
      }, 280);
    }

    function flipCurrentCard() {
      if (appState.cardSides !== 2 || !appState.currentCard) return;
      appState.isCurrentFlipped = !appState.isCurrentFlipped;
      const flipInner = document.getElementById('activeCardFlipInner');
      flipInner.classList.toggle('is-flipped', appState.isCurrentFlipped);
      playSound('flip');
    }

    function handleActiveCardClick(event) {
      if (appState.cardSides === 2 && appState.currentCard) {
        flipCurrentCard();
      } else {
        dealNextCard();
      }
    }

    function shuffleDeckInGame() {
      // Combine all dealt + undealt cards back into the deck and Fisher-Yates shuffle
      const allCards = [...appState.dealtHistory, ...appState.undealtDeck];
      for (let i = allCards.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [allCards[i], allCards[j]] = [allCards[j], allCards[i]];
      }

      appState.undealtDeck = allCards;
      appState.dealtHistory = [];
      appState.currentCard = null;
      appState.isCurrentFlipped = !appState.dealFrontFirst;

      playSound('shuffle');
      renderDeckStack();
      renderActiveDealtCard('none');

      const deckWrapper = document.getElementById('deckStackWrapper');
      deckWrapper.classList.remove('animate-shuffle');
      void deckWrapper.offsetWidth;
      deckWrapper.classList.add('animate-shuffle');

      showToast('Deck shuffled!', 'info');
    }

    function requeueCurrentCard() {
      if (!appState.currentCard) return;
      const cardToReview = appState.dealtHistory.pop();
      // Insert randomly into the remaining undealt deck
      const insertIdx = Math.floor(Math.random() * (appState.undealtDeck.length + 1));
      appState.undealtDeck.splice(insertIdx, 0, cardToReview);
      appState.currentCard = appState.dealtHistory[appState.dealtHistory.length - 1] || null;
      playSound('undo');
      renderDeckStack();
      renderActiveDealtCard('none');
      showToast('Card shuffled back into the deck for review!', 'warn');
    }

    function setDealFrontFirst(frontFirst) {
      appState.dealFrontFirst = frontFirst;
      const btnFront = document.getElementById('btnDealFrontFirst');
      const btnBack = document.getElementById('btnDealBackFirst');
      if (frontFirst) {
        btnFront.className = 'px-2.5 py-1 rounded-lg font-bold bg-white/20 text-white transition';
        btnBack.className = 'px-2.5 py-1 rounded-lg font-bold text-white/70 hover:text-white transition';
      } else {
        btnBack.className = 'px-2.5 py-1 rounded-lg font-bold bg-white/20 text-white transition';
        btnFront.className = 'px-2.5 py-1 rounded-lg font-bold text-white/70 hover:text-white transition';
      }
      if (appState.currentCard) {
        appState.isCurrentFlipped = !frontFirst;
        renderActiveDealtCard('none');
      }
    }

    /*************************************************************
     * 13. CLASSROOM EXTRAS: TTS SPEECH, SPOTLIGHT, TIMER, AUDIO
     *************************************************************/
    function speakCardSide(side) {
      if (!appState.currentCard || !('speechSynthesis' in window)) {
        showToast('Speech synthesis not supported in this browser', 'warn');
        return;
      }
      window.speechSynthesis.cancel();
      const text = side === 'front' ? appState.currentCard.frontText : appState.currentCard.backText;
      if (!text) return;

      const utterance = new SpeechSynthesisUtterance(text.replace(/\n/g, ' '));
      // Auto-detect Vietnamese diacritics vs English
      const hasVietnamese = /[àáạảãâầấậẩẫăằắặẳẵèéẹẻẽêềếệểễìíịỉĩòóọỏõôồốộổỗơờớợởỡùúụủũưừứựửữỳýỵỷỹđ]/i.test(text);
      utterance.lang = hasVietnamese ? 'vi-VN' : 'en-US';
      utterance.rate = 0.95;
      window.speechSynthesis.speak(utterance);
    }

    function toggleSpotlightModal() {
      const modal = document.getElementById('spotlightModal');
      if (!modal.classList.contains('hidden')) {
        modal.classList.add('hidden');
        return;
      }
      if (!appState.currentCard) return;
      const showingBack = appState.cardSides === 2 && appState.isCurrentFlipped;
      const text = showingBack ? appState.currentCard.backText : appState.currentCard.frontText;
      const media = showingBack ? appState.currentCard.backMedia : appState.currentCard.frontMedia;

      document.getElementById('spotlightContent').innerHTML = formatCardFaceHTML(text, media);
      modal.classList.remove('hidden');
    }

    function startPlayTimer() {
      stopPlayTimer();
      appState.timerSeconds = 0;
      appState.timerPaused = false;
      updateTimerUI();
      appState.timerInterval = setInterval(() => {
        if (!appState.timerPaused) {
          appState.timerSeconds++;
          updateTimerUI();
        }
      }, 1000);
    }

    function stopPlayTimer() {
      if (appState.timerInterval) {
        clearInterval(appState.timerInterval);
        appState.timerInterval = null;
      }
    }

    function togglePauseTimer() {
      appState.timerPaused = !appState.timerPaused;
      const icon = document.getElementById('pauseIcon');
      icon.className = appState.timerPaused ? 'ph-fill ph-play text-xl text-emerald-600' : 'ph-fill ph-pause text-xl';
      showToast(appState.timerPaused ? 'Timer paused' : 'Timer resumed', 'info');
    }

    function updateTimerUI() {
      const mins = String(Math.floor(appState.timerSeconds / 60)).padStart(2, '0');
      const secs = String(appState.timerSeconds % 60).padStart(2, '0');
      document.getElementById('gameTimerDisplay').textContent = `${mins}:${secs}`;
    }

    function toggleSoundFx() {
      appState.soundEnabled = !appState.soundEnabled;
      const icon = document.getElementById('soundIcon');
      icon.className = appState.soundEnabled ? 'ph-fill ph-speaker-high text-xl' : 'ph-fill ph-speaker-slash text-xl text-rose-400';
      showToast(appState.soundEnabled ? 'Sound FX Enabled' : 'Sound FX Muted', 'info');
    }

    function toggleFullscreenMode() {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
        document.getElementById('fullscreenIcon').className = 'ph-bold ph-corners-in text-xl';
      } else {
        document.exitFullscreen().catch(() => {});
        document.getElementById('fullscreenIcon').className = 'ph-bold ph-corners-out text-xl';
      }
    }
  </script>
</body>
