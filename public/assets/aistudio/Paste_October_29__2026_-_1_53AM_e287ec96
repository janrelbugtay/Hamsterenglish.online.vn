     * 9. DYNAMIC CARDS EDITOR LIST
     *************************************************************/
    function isImageData(str) {
      if (!str) return false;
      return str.startsWith('http://') || str.startsWith('https://') || str.startsWith('data:image');
    }

    function renderMediaButtonPreview(mediaVal) {
      if (!mediaVal) {
        return `<i class="ph-bold ph-image text-base"></i><span>Add Media</span>`;
      }
      if (isImageData(mediaVal)) {
        return `<img src="${mediaVal}" alt="Media" class="w-6 h-6 rounded object-cover border border-purple-300" /><span>Change Pic</span>`;
      }
      return `<span class="text-lg leading-none">${mediaVal}</span><span>Media</span>`;
    }

    function renderCardsEditor() {
      const container = document.getElementById('cardsEditorList');
      document.getElementById('cardCountLabel').textContent = appState.cards.length;

      const showTextInput = appState.contentMode === 'text' || appState.contentMode === 'both';
      const showMediaBtn = appState.contentMode === 'photo' || appState.contentMode === 'both';

      container.innerHTML = appState.cards.map((card, idx) => {
        if (appState.cardSides === 1) {
          // 1-SIDED ROW LAYOUT
          return `
            <div class="group bg-white rounded-2xl border border-slate-200/90 hover:border-blue-300 p-4 shadow-sm transition flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
              <!-- Card Number Badge -->
              <div class="flex items-center justify-between sm:justify-start gap-2">
