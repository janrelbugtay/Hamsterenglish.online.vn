<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CardMaster Studio — Interactive Flashcards & Card Dealer</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Inter:wght@400;500;600;700;800&family=Orbitron:wght@600;800&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <style>
    :root {
      --card-font: 'Inter', sans-serif;
    }
    body {
      font-family: 'Inter', sans-serif;
      user-select: none;
      overflow-x: hidden;
    }

    /* 3D Card Flip & Perspective Utilities */
    .perspective-1200 {
      perspective: 1400px;
    }
    .preserve-3d {
      transform-style: preserve-3d;
    }
    .backface-hidden {
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }
    .rotate-y-180 {
      transform: rotateY(180deg);
    }

    /* Smooth Card Flip Container */
    .card-flip-inner {
      transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
      transform-style: preserve-3d;
    }
    .card-flip-inner.is-flipped {
      transform: rotateY(180deg);
    }

    /* Deal Fly-over Animation */
    @keyframes dealFlyIn {
      0% {
        opacity: 0;
        transform: translate3d(-340px, -30px, 120px) scale(0.72) rotateZ(-8deg) rotateY(-65deg);
      }
      65% {
        opacity: 1;
        transform: translate3d(14px, -6px, 30px) scale(1.03) rotateZ(1.5deg) rotateY(6deg);
      }
      100% {
        opacity: 1;
        transform: translate3d(0, 0, 0) scale(1) rotateZ(0deg) rotateY(0deg);
      }
    }
    .animate-deal {
      animation: dealFlyIn 0.52s cubic-bezier(0.2, 0.9, 0.3, 1.05) forwards;
    }

    /* Undo Fly-back Animation */
    @keyframes undoFlyBack {
      0% {
        opacity: 1;
        transform: translate3d(0, 0, 0) scale(1);
      }
      100% {
        opacity: 0;
        transform: translate3d(-320px, -20px, 80px) scale(0.7) rotateZ(-10deg);
      }
    }
    .animate-undo {
      animation: undoFlyBack 0.36s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    /* Shuffle Riffle Animation */
    @keyframes shuffleRiffleLeft {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      25% { transform: translate(-36px, -18px) rotate(-9deg); }
      50% { transform: translate(22px, 10px) rotate(6deg); }
      75% { transform: translate(-15px, 6px) rotate(-4deg); }
    }
    .animate-shuffle {
      animation: shuffleRiffleLeft 0.55s ease-in-out;
    }

    /* Floating bus / space / cloud subtle motion */
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-8px); }
    }
    .float-slow {
      animation: floatSlow 5s ease-in-out infinite;
    }

    @keyframes busDrive {
      0%, 100% { transform: translateX(0px); }
      50% { transform: translateX(18px); }
    }
    .bus-bob {
      animation: busDrive 8s ease-in-out infinite;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    /* Theme Typography Classes */
    .font-london { font-family: 'Playfair Display', Georgia, serif; }
    .font-cyber { font-family: 'Orbitron', sans-serif; }
    .font-playful { font-family: 'Fredoka', sans-serif; }
    .font-clean { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen">

  <!-- ========================================================= -->
  <!-- TOAST NOTIFICATION CONTAINER                              -->
  <!-- ========================================================= -->
  <div id="toastContainer" class="fixed top-4 right-4 z-[100] flex flex-col gap-2 pointer-events-none"></div>

  <!-- ========================================================= -->
  <!-- VIEW 1: GAME SETUP VIEW (MODERN EDTECH DASHBOARD)         -->
  <!-- ========================================================= -->
  <div id="setupView" class="min-h-screen pb-24 transition-opacity duration-300">
    <!-- Top Sticky Navigation Header -->
    <header class="sticky top-0 z-30 bg-white/90 backdrop-blur-md border-b border-slate-200 shadow-sm">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3.5 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center text-white shadow-md shadow-blue-500/20">
            <i class="ph-fill ph-cards text-2xl"></i>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-slate-900">GAME SETUP</h1>
              <span class="px-2.5 py-0.5 text-xs font-bold uppercase tracking-wider bg-indigo-50 text-indigo-600 rounded-full border border-indigo-200">Flashcard Dealer Pro</span>
            </div>
            <p class="text-xs text-slate-500 hidden sm:block">Customize theme, 1-sided or 2-sided flip cards, photos & classroom extras</p>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
          <button onclick="openLibraryModal()" class="px-3.5 py-2 rounded-xl text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition flex items-center gap-1.5">
            <i class="ph ph-books text-lg text-indigo-600"></i>
            <span>My Library</span>
            <span id="libraryCountBadge" class="ml-1 px-1.5 py-0.2 bg-indigo-100 text-indigo-700 rounded-md text-xs font-bold">0</span>
          </button>

          <button onclick="loadPresetSample()" class="px-3.5 py-2 rounded-xl text-sm font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition flex items-center gap-1.5" title="Reset to sample Emotions deck">
            <i class="ph ph-magic-wand text-lg text-amber-500"></i>
            <span class="hidden md:inline">Sample Deck</span>
          </button>

          <button onclick="saveDeckToLibrary()" class="px-4 py-2 rounded-xl text-sm font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 transition flex items-center gap-1.5">
            <i class="ph-bold ph-floppy-disk text-lg"></i>
            <span>Save Quiz</span>
          </button>

          <button onclick="startGame()" class="px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 shadow-lg shadow-blue-600/25 transition transform active:scale-95 flex items-center gap-2">
            <i class="ph-fill ph-play-circle text-xl"></i>
            <span>Play Game</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Setup Card Container -->
    <main class="max-w-6xl mx-auto px-4 sm:px-6 mt-6">
      <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/70 border border-slate-200/80 p-5 sm:p-8 space-y-8">

        <!-- SECTION 1: METADATA ROW (TOPIC, CLASS LEVEL, FOLDER) -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          <!-- Topic -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">
              <i class="ph-bold ph-tag mr-1 text-blue-500"></i> Topic
            </label>
            <input id="topicInput" type="text" value="Feelings & Emotions (Cảm xúc)" placeholder="e.g. Animals, Present Simple, IELTS Speaking..."
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 outline-none text-sm font-medium text-slate-800 transition" />
          </div>

          <!-- Class Level -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-500">
                <i class="ph-bold ph-graduation-cap mr-1 text-indigo-500"></i> Class Level
              </label>
              <div class="flex gap-1">
                <button type="button" onclick="setQuickLevel('Starters')" class="text-[11px] px-2 py-0.5 rounded bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 font-medium text-slate-600 transition">Starters</button>
                <button type="button" onclick="setQuickLevel('Grade 5')" class="text-[11px] px-2 py-0.5 rounded bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 font-medium text-slate-600 transition">Grade 5</button>
                <button type="button" onclick="setQuickLevel('IELTS')" class="text-[11px] px-2 py-0.5 rounded bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 font-medium text-slate-600 transition">IELTS</button>
              </div>
            </div>
            <input id="levelInput" type="text" value="Movers / Flyers (B1)" placeholder="e.g. Kindergarten, Grade 3, Starters..."
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 outline-none text-sm font-medium text-slate-800 transition" />
          </div>

          <!-- Folder -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-500">
                <i class="ph-bold ph-folder-notch mr-1 text-amber-500"></i> Folder
              </label>
              <button type="button" onclick="openNewFolderModal()" class="text-xs font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1">
                <i class="ph-bold ph-folder-plus"></i> + New Folder
              </button>
            </div>
            <select id="folderSelect" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 outline-none text-sm font-medium text-slate-800 bg-white transition">
              <option value="No Folder (Root Library)">No Folder (Root Library)</option>
              <option value="Vocabulary & Idioms" selected>Vocabulary & Idioms</option>
              <option value="Grammar Drills">Grammar Drills</option>
              <option value="Cambridge Starters/Movers">Cambridge Starters/Movers</option>
            </select>
          </div>
        </div>

        <!-- SECTION 2: CARD SIDE MODE (1-SIDED VS 2-SIDED) & CONTENT MODE (TEXT / PHOTOS / BOTH) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 bg-slate-50/90 p-4 sm:p-5 rounded-2xl border border-slate-200/80">
          <!-- Left: 1-Sided vs 2-Sided Card Mode -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white p-3.5 rounded-xl border border-slate-200/70 shadow-sm">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
                <i class="ph-fill ph-flip-horizontal text-xl"></i>
              </div>
              <div>
                <div class="text-xs font-extrabold uppercase tracking-wider text-slate-700">Card Side Mode</div>
                <div id="sideModeSubtext" class="text-xs text-slate-500">2-Sided: Flip between Front & Back</div>
              </div>
            </div>

            <div class="inline-flex bg-slate-100 p-1 rounded-xl border border-slate-200/60 self-start sm:self-auto">
              <button type="button" id="btnSide1" onclick="setCardSides(1)"
                class="px-3.5 py-2 rounded-lg text-xs font-bold transition flex items-center gap-1.5 text-slate-600 hover:text-slate-900">
                <i class="ph-bold ph-square text-sm"></i>
                <span>1-Side Card</span>
              </button>
              <button type="button" id="btnSide2" onclick="setCardSides(2)"
                class="px-3.5 py-2 rounded-lg text-xs font-bold transition flex items-center gap-1.5 bg-white text-indigo-600 shadow-sm border border-slate-200/60">
                <i class="ph-bold ph-arrows-clockwise text-sm"></i>
                <span>Double-Side (Flip)</span>
              </button>
            </div>
          </div>

          <!-- Right: Content Mode (Text Only / Photos Only / Word + Picture) -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white p-3.5 rounded-xl border border-slate-200/70 shadow-sm">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                <i class="ph-fill ph-stack text-xl"></i>
              </div>
              <div>
                <div class="text-xs font-extrabold uppercase tracking-wider text-slate-700">Option Content Mode</div>
                <div id="contentModeSubtext" class="text-xs text-slate-500">Show Word + Picture on cards</div>
              </div>
            </div>

            <div class="inline-flex bg-slate-100 p-1 rounded-xl border border-slate-200/60 self-start sm:self-auto">
              <button type="button" id="btnContentText" onclick="setContentMode('text')"
                class="px-3 py-2 rounded-lg text-xs font-bold transition flex items-center gap-1.5 text-slate-600 hover:text-slate-900">
                <i class="ph-bold ph-text-t text-sm"></i>
                <span>Text Only</span>
              </button>
              <button type="button" id="btnContentPhoto" onclick="setContentMode('photo')"
                class="px-3 py-2 rounded-lg text-xs font-bold transition flex items-center gap-1.5 text-slate-600 hover:text-slate-900">
                <i class="ph-bold ph-image text-sm"></i>
                <span>Photos</span>
              </button>
              <button type="button" id="btnContentBoth" onclick="setContentMode('both')"
                class="px-3.5 py-2 rounded-lg text-xs font-bold transition flex items-center gap-1.5 bg-white text-amber-600 shadow-sm border border-slate-200/60">
                <i class="ph-fill ph-sparkle text-sm"></i>
                <span>Word & Pic</span>
              </button>
            </div>
          </div>
        </div>

        <!-- SECTION 3: VISUAL GAME THEME SELECTOR -->
        <div>
          <div class="flex items-center justify-between mb-3">
            <div>
              <h2 class="text-xs font-extrabold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
                <i class="ph-fill ph-palette text-purple-600 text-base"></i>
                Select Game Stage Theme & Card Back
              </h2>
              <p class="text-xs text-slate-500">Changes the animated stage scenery, card deck emblem, and sound vibe during gameplay</p>
            </div>
            <span id="selectedThemeLabel" class="text-xs font-bold px-3 py-1 rounded-full bg-purple-50 text-purple-700 border border-purple-200">London Fog (Royal Crown)</span>
          </div>

          <div id="themeSelectorGrid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5">
            <!-- Populated dynamically by JS -->
          </div>
        </div>

        <hr class="border-slate-200" />

        <!-- SECTION 4: CARDS HEADER & BULK PASTE BAR -->
        <div class="bg-blue-50/70 border border-blue-200/80 rounded-2xl p-4 flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <span class="px-3 py-1.5 rounded-xl bg-blue-600 text-white font-extrabold text-xs tracking-wide shadow-sm">
              CARDS (<span id="cardCountLabel">8</span> / 50)
            </span>
            <div class="text-xs sm:text-sm font-medium text-slate-600">
              <span id="editorModeHint">Editing <strong>Double-Sided</strong> cards with <strong>Word & Picture</strong></span>
            </div>
          </div>

          <div class="flex items-center gap-2.5 flex-wrap">
            <button type="button" onclick="swapAllFrontBack()" id="btnSwapAllSides"
              class="px-3.5 py-2 rounded-xl text-xs font-bold bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 shadow-sm transition flex items-center gap-1.5">
              <i class="ph-bold ph-arrows-left-right text-indigo-600 text-sm"></i>
              <span>Swap All Front/Back</span>
            </button>

            <button type="button" onclick="openBulkPasteModal()"
              class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-blue-600 hover:bg-blue-700 text-white shadow-sm shadow-blue-500/20 transition flex items-center gap-1.5">
              <i class="ph-bold ph-clipboard-text text-base"></i>
              <span>Bulk Paste</span>
            </button>

            <button type="button" onclick="openHowToBulkModal()"
              class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-purple-600 hover:bg-purple-700 text-white shadow-sm shadow-purple-500/20 transition flex items-center gap-1.5">
              <i class="ph-fill ph-play-circle text-base"></i>
              <span>How to Bulk Paste</span>
            </button>
          </div>
        </div>

        <!-- SECTION 5: DYNAMIC CARDS EDITOR LIST -->
        <div id="cardsEditorList" class="space-y-4">
          <!-- Rendered dynamically by renderCardsEditor() -->
        </div>

        <!-- ADD ANOTHER CARD BUTTON -->
        <button type="button" onclick="addNewCard()"
          class="w-full py-4 rounded-2xl border-2 border-dashed border-slate-300 hover:border-blue-500 hover:bg-blue-50/40 text-slate-600 hover:text-blue-600 font-bold text-sm transition flex items-center justify-center gap-2 group">
          <i class="ph-bold ph-plus-circle text-xl group-hover:scale-110 transition"></i>
          <span>+ Add Another Flashcard</span>
        </button>

      </div>
    </main>
  </div>

  <!-- ========================================================= -->
  <!-- VIEW 2: FULL-SCREEN PLAY / CARD DEALER VIEW               -->
  <!-- ========================================================= -->
  <div id="playView" class="fixed inset-0 z-40 hidden flex-col justify-between overflow-hidden select-none">
    
    <!-- Dynamic Illustrated Background Stage -->
    <div id="themeStageBackground" class="absolute inset-0 pointer-events-none z-0 overflow-hidden"></div>

    <!-- TOP HUD BAR -->
    <header class="relative z-20 px-4 sm:px-8 pt-4 pb-2 flex items-center justify-between gap-4">
      <!-- Left: Deck Title & Level -->
      <div class="flex items-center gap-3 bg-slate-900/45 backdrop-blur-md px-4 py-2 rounded-2xl border border-white/20 text-white shadow-lg">
        <div class="w-9 h-9 rounded-xl bg-white/15 flex items-center justify-center text-lg" id="hudThemeIcon">🇬🇧</div>
        <div>
          <h2 id="hudTopicTitle" class="font-bold text-sm sm:text-base leading-tight line-clamp-1">Feelings & Emotions</h2>
          <div class="flex items-center gap-2 text-[11px] text-white/80 font-medium">
            <span id="hudLevelBadge">Movers / Flyers</span>
            <span>•</span>
            <span id="hudModeBadge" class="text-amber-300 font-semibold">2-Sided Flip</span>
          </div>
        </div>
      </div>

      <!-- Center: Close / Back to Setup Button (Matches reference top-center 'X' + label) -->
      <button onclick="exitGameToSetup()" title="Return to Game Setup (Esc)"
        class="group flex items-center gap-2 px-4 py-2 rounded-full bg-slate-900/55 hover:bg-rose-600/90 text-white backdrop-blur-md border border-white/25 shadow-lg transition duration-200">
        <i class="ph-bold ph-x text-base"></i>
        <span class="text-xs font-bold tracking-wide hidden sm:inline">Edit Setup</span>
      </button>

      <!-- Right: Progress Counter & Deal Direction Toggle -->
      <div class="flex items-center gap-2.5">
        <div id="dealSideToggleWrap" class="hidden md:flex items-center bg-slate-900/45 backdrop-blur-md p-1 rounded-xl border border-white/20 text-white text-xs">
          <button id="btnDealFrontFirst" onclick="setDealFrontFirst(true)" class="px-2.5 py-1 rounded-lg font-bold bg-white/20 text-white transition">Front First</button>
          <button id="btnDealBackFirst" onclick="setDealFrontFirst(false)" class="px-2.5 py-1 rounded-lg font-bold text-white/70 hover:text-white transition">Back First</button>
        </div>

        <div class="bg-slate-900/45 backdrop-blur-md px-4 py-2 rounded-2xl border border-white/20 text-white shadow-lg flex items-center gap-3">
          <div class="text-right">
            <div class="text-[10px] uppercase tracking-wider text-white/70 font-bold">Dealt Cards</div>
            <div class="text-sm sm:text-base font-extrabold leading-none">
              <span id="hudDealtCount">0</span> <span class="text-white/50">/</span> <span id="hudTotalCount">8</span>
            </div>
          </div>
          <div class="w-16 sm:w-24 h-2.5 bg-white/20 rounded-full overflow-hidden">
            <div id="hudProgressBar" class="h-full bg-gradient-to-r from-emerald-400 to-cyan-400 transition-all duration-300" style="width: 0%"></div>
          </div>
        </div>
      </div>
    </header>

    <!-- CENTER STAGE: LEFT 3D DECK STACK + RIGHT MASSIVE DEALT ACTIVE CARD -->
    <div class="relative z-10 flex-1 w-full max-w-[1720px] mx-auto px-4 sm:px-8 lg:px-12 py-2 flex flex-col lg:flex-row items-center justify-center gap-6 lg:gap-10 min-h-0">

      <!-- LEFT COLUMN: 3D STACKED DECK -->
      <div class="w-full lg:w-[28%] xl:w-[26%] flex flex-col items-center justify-center shrink-0">
        <div id="deckStackWrapper" onclick="dealNextCard()"
          class="relative w-full max-w-[260px] sm:max-w-[320px] lg:max-w-[380px] aspect-[4/3] cursor-pointer group select-none">

          <!-- Empty Deck Placeholder (shown when 0 cards remain in undealt pile) -->
          <div id="emptyDeckPlaceholder"
            class="absolute inset-0 rounded-3xl border-4 border-dashed border-white/40 bg-slate-900/30 backdrop-blur-sm flex flex-col items-center justify-center text-white/80 p-6 text-center transition">
            <i class="ph-duotone ph-StackSimple text-5xl mb-2 text-white/60"></i>
            <p class="font-bold text-base">All Cards Dealt!</p>
            <p class="text-xs text-white/70 mt-1">Click Shuffle to restart the deck</p>
          </div>

          <!-- 3D Thickness Layers (Dynamic height based on remaining undealt cards) -->
          <div id="deckThicknessContainer" class="absolute inset-0 transition-transform duration-300 group-hover:-translate-y-1.5">
            <!-- Populated by renderPlayStage() -->
          </div>
        </div>

        <!-- Remaining counter pill under deck -->
        <div class="mt-6 flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-900/60 backdrop-blur-md border border-white/20 text-white text-xs sm:text-sm font-bold shadow-md">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="deckRemainingLabel">8 cards in deck — Click deck or Deal</span>
        </div>
      </div>

      <!-- RIGHT COLUMN: MASSIVE ACTIVE DEALT CARD AREA FITTING SCREEN -->
      <div class="w-full lg:w-[72%] xl:w-[74%] h-full flex flex-col items-center justify-center min-h-0">
        <div class="relative w-full h-[50vh] sm:h-[60vh] lg:h-[70vh] max-h-[680px] min-h-[340px] perspective-1200">

          <!-- Waiting to Deal State -->
          <div id="noCardDealtState" onclick="dealNextCard()"
            class="absolute inset-0 rounded-[2rem] border-4 border-dashed border-white/45 bg-white/10 backdrop-blur-md flex flex-col items-center justify-center text-white p-8 text-center cursor-pointer hover:bg-white/15 transition shadow-2xl">
            <div class="w-20 h-20 rounded-3xl bg-white/20 flex items-center justify-center mb-4 animate-bounce">
              <i class="ph-fill ph-hand-tap text-5xl"></i>
            </div>
            <h3 class="text-2xl sm:text-4xl font-extrabold tracking-tight">Ready to Deal!</h3>
