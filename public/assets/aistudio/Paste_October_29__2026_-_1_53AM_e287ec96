                <div class="p-3 rounded-xl bg-indigo-50/40 border border-indigo-200/70 flex flex-col gap-2">
                  <div class="flex items-center justify-between">
                    <span class="text-[11px] font-extrabold uppercase tracking-wider text-indigo-600 flex items-center gap-1">
                      <span class="w-2 h-2 rounded-full bg-indigo-600"></span> Back Side (Flip Answer / Meaning)
                    </span>
                  </div>
                  <div class="flex items-center gap-2">
                    ${showTextInput ? `
                      <input type="text" value="${escapeHtml(card.backText.replace(/\n/g, ' '))}"
                        oninput="updateCardField(${idx}, 'backText', this.value)"
                        placeholder="Back text (e.g. Miserable)..."
                        class="flex-1 px-3.5 py-2 rounded-xl bg-white border border-indigo-200 focus:border-indigo-500 outline-none text-sm font-semibold text-slate-800" />
                    ` : `
                      <div class="flex-1 text-xs text-indigo-500 italic px-2">Photo-only back side</div>
                    `}
                    ${showMediaBtn ? `
                      <button type="button" onclick="openMediaPickerModal(${idx}, 'back')"
