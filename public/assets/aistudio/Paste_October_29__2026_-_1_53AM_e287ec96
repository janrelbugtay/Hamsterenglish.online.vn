        } else {
          // 2-SIDED (DOUBLE SIDE FLIP) ROW LAYOUT
          return `
            <div class="group bg-white rounded-2xl border border-slate-200/90 hover:border-indigo-300 p-4 shadow-sm transition space-y-3">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-8 h-8 rounded-full bg-indigo-50 text-indigo-600 font-extrabold text-xs flex items-center justify-center border border-indigo-200">
                    ${idx + 1}
                  </span>
                  <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Double-Sided Flip Card</span>
                </div>

                <div class="flex items-center gap-1.5">
                  <button type="button" onclick="swapSingleCardSides(${idx})" title="Swap Front & Back of this card"
                    class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-indigo-50 text-slate-600 hover:text-indigo-600 text-xs font-bold flex items-center gap-1 transition">
                    <i class="ph-bold ph-arrows-left-right"></i> Swap Sides
                  </button>
                  <button type="button" onclick="duplicateCard(${idx})" title="Duplicate Card"
                    class="w-8 h-8 rounded-lg text-slate-400 hover:text-blue-600 hover:bg-blue-50 flex items-center justify-center transition">
                    <i class="ph-bold ph-copy"></i>
                  </button>
                  <button type="button" onclick="deleteCard(${idx})" title="Delete Card"
                    class="w-8 h-8 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 flex items-center justify-center transition">
                    <i class="ph-bold ph-trash"></i>
                  </button>
                </div>
              </div>

              <!-- Two Columns: Front Side & Back Side -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <!-- FRONT SIDE INPUT -->
                <div class="p-3 rounded-xl bg-slate-50/80 border border-slate-200/80 flex flex-col gap-2">
                  <div class="flex items-center justify-between">
                    <span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-500 flex items-center gap-1">
                      <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Front Side (Word / Prompt)
                    </span>
                  </div>
                  <div class="flex items-center gap-2">
                    ${showTextInput ? `
                      <input type="text" value="${escapeHtml(card.frontText.replace(/\n/g, ' '))}"
                        oninput="updateCardField(${idx}, 'frontText', this.value)"
                        placeholder="Front text (e.g. Khổ sở, vô cùng buồn bã)..."
                        class="flex-1 px-3.5 py-2 rounded-xl bg-white border border-slate-200 focus:border-emerald-500 outline-none text-sm font-semibold text-slate-800" />
