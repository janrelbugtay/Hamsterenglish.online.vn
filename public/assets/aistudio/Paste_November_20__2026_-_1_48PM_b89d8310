        function arrangeHamstersInBoat() {
            const active = game.students.filter(s => !s.eliminated);
            const count = active.length;
            if (count === 0) return;

            if (count === 1) {
                active[0].seatX = 0;
                active[0].seatY = 0;
                active[0].seatType = 'bench';
                active[0].curX = 0;
                active[0].curY = 0;
                return;
            }

            // Distribute hamsters across the central wooden cross-bench and clutching the inner rim/ribs
            active.forEach((h, i) => {
                if (count <= 6) {
                    const ang = (i / count) * Math.PI * 2 + 0.3;
                    const r = i % 2 === 0 ? 0.42 : 0.64;
                    h.seatX = Math.cos(ang) * r;
                    h.seatY = Math.sin(ang) * r;
                    h.seatType = r > 0.5 ? 'rim' : 'bench';
                } else if (count <= 16) {
                    const innerCount = Math.min(5, Math.floor(count * 0.35));
                    if (i < innerCount) {
                        // Seated along the wooden cross-plank bench
                        const spread = (i / Math.max(1, innerCount - 1)) - 0.5;
                        h.seatX = spread * 0.72;
                        h.seatY = (i % 2 === 0 ? 0.08 : -0.08);
                        h.seatType = 'bench';
                    } else {
                        // Bracing along the colorful rim and bamboo ribs
                        const outerCount = count - innerCount;
                        const j = i - innerCount;
                        const ang = (j / outerCount) * Math.PI * 2 + 0.25;
                        h.seatX = Math.cos(ang) * 0.66;
                        h.seatY = Math.sin(ang) * 0.66;
                        h.seatType = 'rim';
                    }
                } else {
                    // Up to 30+ students: bench + middle rib ring + outer rim ring
                    const ring1 = 5;
                    const ring2 = 10;
                    const ring3 = count - ring1 - ring2;
                    if (i < ring1) {
                        const ang = (i / ring1) * Math.PI * 2;
                        h.seatX = Math.cos(ang) * 0.25;
                        h.seatY = Math.sin(ang) * 0.25;
                        h.seatType = 'bench';
                    } else if (i < ring1 + ring2) {
                        const j = i - ring1;
                        const ang = (j / ring2) * Math.PI * 2 + 0.2;
                        h.seatX = Math.cos(ang) * 0.48;
                        h.seatY = Math.sin(ang) * 0.48;
                        h.seatType = 'floor';
                    } else {
                        const k = i - ring1 - ring2;
                        const ang = (k / ring3) * Math.PI * 2 + 0.1;
                        h.seatX = Math.cos(ang) * 0.70;
                        h.seatY = Math.sin(ang) * 0.70;
                        h.seatType = 'rim';
                    }
                }
                h.curX = h.seatX;
                h.curY = h.seatY;
            });

            // Space eliminated hamsters evenly in the surrounding lagoon water (foreground & sides)
            const eliminated = game.students.filter(s => s.eliminated);
            eliminated.forEach((h, idx) => {
                const baseAngle = (idx / Math.max(1, eliminated.length)) * Math.PI * 2 + 0.35;
                h.floatAngle = baseAngle;
            });
        }

