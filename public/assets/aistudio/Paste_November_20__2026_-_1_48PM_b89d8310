        /**
         * Transform local 3D coordinates inside the Coconut Basket Boat (lx, ly, lz)
         * into Tilted & Rotated World 3D coordinates, and then project onto the 2D screen
         * with side-camera elevation (`game.cameraPitch`).
         * - lx, ly: position across the circular opening of the boat (-R .. +R)
         * - lz: height relative to the top rim (0 = rim level, negative = down inside the bowl, positive = above rim)
         */
        function projectBoatPoint(lx, ly, lz, boatCenterX, boatCenterY) {
            // 1. Spin around boat's vertical axis (yaw = game.boatAngle)
            const cosA = Math.cos(game.boatAngle);
            const sinA = Math.sin(game.boatAngle);
            const rx = lx * cosA - ly * sinA;
            const ry = lx * sinA + ly * cosA;
            const rz = lz;

            // 2. Apply acrobatic boat Roll (side-to-side tilt) & Pitch (front-back rock)
            const cosRoll = Math.cos(game.boatTiltRoll);
            const sinRoll = Math.sin(game.boatTiltRoll);
            const x1 = rx * cosRoll - rz * sinRoll;
            const z1 = rx * sinRoll + rz * cosRoll;
            const y1 = ry;

            const cosPitch = Math.cos(game.boatTiltPitch);
            const sinPitch = Math.sin(game.boatTiltPitch);
            const y2 = y1 * cosPitch - z1 * sinPitch;
            const z2 = y1 * sinPitch + z1 * cosPitch;
            const x2 = x1;

            // 3. Project onto 2.5D side-angled camera plane
            const sinCam = Math.sin(game.cameraPitch); // Vertical foreshortening of horizontal plane (~0.55)
            const cosCam = Math.cos(game.cameraPitch); // Vertical height scale (~0.83)

            return {
                x: boatCenterX + x2,
                y: boatCenterY + y2 * sinCam - z2 * cosCam,
                depth: y2 * cosCam + z2 * sinCam, // Larger depth = closer to the viewer in front
                worldX: x2,
                worldY: y2,
                worldZ: z2
            };
        }

        // Draw lush Vietnamese Nipa Palm (Dừa Nước) river shoreline & sunlit emerald water
        function drawTropicalLagoon(w, h, time) {
            const horizonY = Math.max(125, h * 0.24);

            // 1. Golden Tropical Sky & Sunburst Rays
            const skyGrad = ctx.createLinearGradient(0, 0, 0, horizonY);
            skyGrad.addColorStop(0, '#48CAE4');
            skyGrad.addColorStop(0.45, '#ADE8F4');
            skyGrad.addColorStop(1, '#FFF3B0');
            ctx.fillStyle = skyGrad;
            ctx.fillRect(0, 0, w, horizonY);

            // Glowing tropical sun & rotating sunbeams
            const sunX = w * 0.82;
            const sunY = horizonY * 0.42;
            ctx.save();
            ctx.translate(sunX, sunY);
            const sunGlow = ctx.createRadialGradient(0, 0, 10, 0, 0, 110);
            sunGlow.addColorStop(0, 'rgba(255, 243, 176, 0.95)');
            sunGlow.addColorStop(0.4, 'rgba(255, 209, 102, 0.45)');
            sunGlow.addColorStop(1, 'rgba(255, 209, 102, 0)');
            ctx.fillStyle = sunGlow;
            ctx.beginPath();
            ctx.arc(0, 0, 110, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = '#FFF8E7';
            ctx.beginPath();
            ctx.arc(0, 0, 28, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();

            // Distant misty karst mountains on the horizon
            ctx.fillStyle = 'rgba(82, 183, 136, 0.35)';
            ctx.beginPath();
            ctx.moveTo(0, horizonY);
            for (let mx = 0; mx <= w; mx += w / 6) {
                const mh = 35 + Math.sin(mx * 0.015) * 24;
                ctx.quadraticCurveTo(mx - w / 12, horizonY - mh, mx, horizonY);
            }
            ctx.closePath();
            ctx.fill();

            // Fluffy cartoon clouds with warm bottom shading
            for (let c = 0; c < 4; c++) {
                const cx = ((c * w * 0.28 + time * 12) % (w + 180)) - 90;
                const cy = 36 + (c % 2) * 22;
                ctx.fillStyle = 'rgba(255, 255, 255, 0.88)';
                ctx.beginPath();
                ctx.arc(cx, cy, 24, 0, Math.PI * 2);
                ctx.arc(cx + 22, cy - 7, 31, 0, Math.PI * 2);
                ctx.arc(cx + 46, cy, 23, 0, Math.PI * 2);
                ctx.fill();
            }

            // 2. Dense Vietnamese Water Coconut (Nipa Palm) Forest along the river bank
            drawNipaPalmForest(w, horizonY, time);

            // 3. Perspective Tropical River Water (Emerald green near palms -> Crystal Turquoise in foreground)
            const waterGrad = ctx.createLinearGradient(0, horizonY, 0, h);
            waterGrad.addColorStop(0, '#2D6A4F');
            waterGrad.addColorStop(0.12, '#40916C');
            waterGrad.addColorStop(0.32, '#2EC4B6');
            waterGrad.addColorStop(0.68, '#00B4D8');
            waterGrad.addColorStop(1, '#0077B6');
            ctx.fillStyle = waterGrad;
            ctx.fillRect(0, horizonY, w, h - horizonY);

            // Subtle underwater koi shadows swimming in the lagoon
            ctx.save();
            game.koiShadows.forEach((koi, idx) => {
                const a = koi.angle + time * koi.speed;
                const kx = w * 0.5 + Math.cos(a) * (w * koi.dist);
                const ky = h * 0.6 + Math.sin(a) * (h * 0.22);
                const heading = a + (koi.speed > 0 ? Math.PI / 2 : -Math.PI / 2);
                ctx.save();
                ctx.translate(kx, ky);
                ctx.rotate(heading);
                ctx.fillStyle = 'rgba(7, 59, 76, 0.16)';
                ctx.beginPath();
                ctx.ellipse(0, 0, koi.size, koi.size * 0.42, 0, 0, Math.PI * 2);
                ctx.fill();
                // Tail fin wiggle
                const tailWiggle = Math.sin(time * 8 + idx) * 4;
                ctx.beginPath();
                ctx.moveTo(-koi.size * 0.85, 0);
                ctx.lineTo(-koi.size * 1.45, -6 + tailWiggle);
                ctx.lineTo(-koi.size * 1.45, 6 + tailWiggle);
                ctx.closePath();
                ctx.fill();
                ctx.restore();
            });
            ctx.restore();

            // Shimmering palm reflections near the upper bank
            ctx.fillStyle = 'rgba(27, 67, 50, 0.28)';
            for (let i = 0; i < 18; i++) {
                const rx = (i / 18) * w + Math.sin(time * 2 + i) * 10;
                const rw = 40 + (i % 3) * 25;
                ctx.fillRect(rx, horizonY + 4 + (i % 4) * 7, rw, 4);
            }

            // Perspective horizontal water wave bands & sunlit caustic sparkles
            ctx.save();
            for (let i = 1; i <= 14; i++) {
                const p = Math.pow(i / 14, 1.65);
                const wy = horizonY + p * (h - horizonY);
                const waveLen = 35 + p * 110;
                const alpha = 0.14 + p * 0.24;
                ctx.strokeStyle = `rgba(255, 255, 255, ${alpha})`;
                ctx.lineWidth = 1.5 + p * 3;
                ctx.lineCap = 'round';
                ctx.beginPath();
                for (let x = -50; x < w + 50; x += waveLen * 1.9) {
                    const offset = Math.sin(time * (1.5 + p) + i * 1.7) * 22 * (i % 2 === 0 ? 1 : -1);
                    ctx.moveTo(x + offset, wy);
                    ctx.quadraticCurveTo(x + offset + waveLen * 0.5, wy - 4 * p, x + offset + waveLen, wy);
                }
                ctx.stroke();
            }

            // Floating Lotus Lily Pads & Tropical Flowers around the river edges
            game.lotusPads.forEach((pad, idx) => {
                const px = pad.xRatio * w + Math.sin(time * 1.2 + idx) * 6;
                const py = pad.yRatio * h + Math.cos(time * 1.5 + idx) * 4;
                const pr = pad.r * (w < 640 ? 0.75 : 1);
                ctx.save();
                ctx.translate(px, py);
                ctx.scale(1, 0.58); // Perspective foreshortening on water
                ctx.rotate(pad.rot + Math.sin(time * 0.8 + idx) * 0.08);

                // Pad shadow
                ctx.fillStyle = 'rgba(10, 50, 60, 0.25)';
                ctx.beginPath();
                ctx.arc(2, 5, pr, 0.25, Math.PI * 2 - 0.25);
                ctx.lineTo(2, 5);
                ctx.closePath();
                ctx.fill();

                // Green lily pad with notch
                ctx.fillStyle = '#52B788';
                ctx.strokeStyle = '#1B4332';
                ctx.lineWidth = 2.5;
                ctx.beginPath();
                ctx.arc(0, 0, pr, 0.25, Math.PI * 2 - 0.25);
                ctx.lineTo(0, 0);
                ctx.closePath();
                ctx.fill();
                ctx.stroke();

                // Vein lines
                ctx.strokeStyle = '#74C69D';
                ctx.lineWidth = 1.5;
                for (let v = 1; v <= 5; v++) {
                    const va = (v / 6) * Math.PI * 2;
                    ctx.beginPath();
                    ctx.moveTo(0, 0);
                    ctx.lineTo(Math.cos(va) * pr * 0.75, Math.sin(va) * pr * 0.75);
                    ctx.stroke();
                }

                // Blooming lotus flower
                if (pad.flower) {
                    ctx.fillStyle = pad.flower;
                    ctx.strokeStyle = '#4A2C11';
                    ctx.lineWidth = 1.8;
                    for (let p = 0; p < 6; p++) {
                        const pa = (p / 6) * Math.PI * 2;
                        ctx.beginPath();
                        ctx.ellipse(Math.cos(pa) * pr * 0.28, Math.sin(pa) * pr * 0.28, pr * 0.24, pr * 0.14, pa, 0, Math.PI * 2);
                        ctx.fill();
                        ctx.stroke();
                    }
                    ctx.fillStyle = '#FFD166';
                    ctx.beginPath();
                    ctx.arc(0, 0, pr * 0.14, 0, Math.PI * 2);
                    ctx.fill();
                }
                ctx.restore();
            });
            ctx.restore();

            // 4. Distant Ambient Coconut Basket Boats in the background river
            drawBackgroundBasketBoats(w, horizonY, time);
        }

        function drawNipaPalmForest(w, horizonY, time) {
            // Back layer dark tropical foliage silhouettes
            const clumpCount = Math.ceil(w / 70) + 2;
            for (let i = 0; i < clumpCount; i++) {
                const bx = i * 70 - 20;
                const sway = Math.sin(time * 1.4 + i * 0.7) * 4;
                drawPalmFrondCluster(bx + sway, horizonY + 6, 82, '#1B4332', '#2D6A4F', false);
            }
            // Front sunlit nipa palm fronds with feathery leaflets & mudbank roots
            for (let i = 0; i < clumpCount; i++) {
                const fx = i * 72 + 12;
                const sway = Math.cos(time * 1.8 + i * 0.9) * 5;
                drawPalmFrondCluster(fx + sway, horizonY + 10, 68, '#40916C', '#74C69D', true);
            }
            // Riverbank edge & coconut clusters
            ctx.fillStyle = '#3A2210';
            ctx.fillRect(0, horizonY + 4, w, 5);
        }

        function drawPalmFrondCluster(x, baseY, size, stemColor, leafColor, detailed) {
            ctx.save();
            ctx.translate(x, baseY);
            const angles = [-0.95, -0.5, -0.1, 0.35, 0.8];
            angles.forEach((ang, idx) => {
                ctx.save();
                ctx.rotate(ang);
                const len = size * (0.85 + (idx % 2) * 0.25);

                // Frond spine
                ctx.strokeStyle = stemColor;
                ctx.lineWidth = 3;
                ctx.beginPath();
                ctx.moveTo(0, 0);
                ctx.quadraticCurveTo(len * 0.15, -len * 0.55, len * 0.35, -len);
                ctx.stroke();

                // Feathery palm leaflets
                ctx.fillStyle = idx % 2 === 0 ? leafColor : stemColor;
                ctx.beginPath();
                ctx.moveTo(0, 0);
                ctx.quadraticCurveTo(-len * 0.22, -len * 0.5, len * 0.35, -len);
                ctx.quadraticCurveTo(len * 0.48, -len * 0.45, 0, 0);
                ctx.fill();

                if (detailed) {
                    ctx.strokeStyle = '#95D5B2';
                    ctx.lineWidth = 1.2;
                    for (let k = 1; k <= 5; k++) {
                        const fy = -len * (k / 6);
                        ctx.beginPath();
                        ctx.moveTo(len * 0.08 * (k / 6), fy);
                        ctx.lineTo(len * 0.08 * (k / 6) - 12, fy - 6);
                        ctx.moveTo(len * 0.08 * (k / 6), fy);
                        ctx.lineTo(len * 0.08 * (k / 6) + 14, fy - 4);
                        ctx.stroke();
                    }
                }
                ctx.restore();
            });
            ctx.restore();
        }

        function drawBackgroundBasketBoats(w, horizonY, time) {
            game.bgBoats.forEach((b, idx) => {
                const bx = w * b.xRatio + Math.sin(time * 0.5 + b.phase) * 18;
                const by = horizonY + b.yOffset + Math.cos(time * 2 + b.phase) * 2.5;
                ctx.save();
                ctx.translate(bx, by);
                const scale = 0.42;
                ctx.scale(scale, scale);

                // Water ripple
                ctx.strokeStyle = 'rgba(255,255,255,0.5)';
                ctx.lineWidth = 3;
                ctx.beginPath();
                ctx.ellipse(0, 18, 68, 14, 0, 0, Math.PI * 2);
                ctx.stroke();

                // Mini basket boat hull
                ctx.fillStyle = '#5C3A21';
                ctx.strokeStyle = '#2B180A';
                ctx.lineWidth = 4;
                ctx.beginPath();
                ctx.arc(0, 0, 52, 0, Math.PI);
                ctx.fill();
                ctx.stroke();

                // Colorful rim
                ctx.fillStyle = b.color;
                ctx.beginPath();
                ctx.ellipse(0, 0, 55, 16, 0, 0, Math.PI * 2);
                ctx.fill();
                ctx.stroke();

                // Cute sun umbrella
                ctx.strokeStyle = '#4A2C11';
                ctx.lineWidth = 4;
                ctx.beginPath();
                ctx.moveTo(-10, 0);
                ctx.lineTo(-15, -55);
                ctx.stroke();

                ctx.fillStyle = b.umbrella;
                ctx.beginPath();
                ctx.arc(-15, -45, 38, Math.PI, 0);
                ctx.closePath();
                ctx.fill();
                ctx.stroke();

                ctx.restore();
            });
        }

        /********************************************************************
         * 5B. 3D-PROJECTED VIETNAMESE COCONUT BASKET BOAT (THUYỀN THÚNG)
         ********************************************************************/
        const RIM_COLORS = ['#EF233C', '#FFD166', '#00BBF9', '#06D6A0']; // Vibrant Red, Yellow, Sky Blue, Mint Green

        function drawTiltedCoconutBasketBoat(cx, cy, boatRadius, time, renderCallbackInside) {
            const bowlDepth = boatRadius * 0.66; // Deep concave basket hull

            // Sample 3D points along the top circular rim and bottom hull base
            const SEGMENTS = 24;
            const rimPoints = [];
            const hullMidPoints = [];
            const floorPoints = [];

            for (let i = 0; i < SEGMENTS; i++) {
                const ang = (i / SEGMENTS) * Math.PI * 2;
                const nextAng = ((i + 1) / SEGMENTS) * Math.PI * 2;
                const cos0 = Math.cos(ang), sin0 = Math.sin(ang);
                const cos1 = Math.cos(nextAng), sin1 = Math.sin(nextAng);

                const pRim0 = projectBoatPoint(cos0 * boatRadius, sin0 * boatRadius, 0, cx, cy);
                const pRim1 = projectBoatPoint(cos1 * boatRadius, sin1 * boatRadius, 0, cx, cy);

                const pMid0 = projectBoatPoint(cos0 * boatRadius * 0.86, sin0 * boatRadius * 0.86, -bowlDepth * 0.58, cx, cy);
                const pMid1 = projectBoatPoint(cos1 * boatRadius * 0.86, sin1 * boatRadius * 0.86, -bowlDepth * 0.58, cx, cy);

                const pBot0 = projectBoatPoint(cos0 * boatRadius * 0.48, sin0 * boatRadius * 0.48, -bowlDepth, cx, cy);
                const pBot1 = projectBoatPoint(cos1 * boatRadius * 0.48, sin1 * boatRadius * 0.48, -bowlDepth, cx, cy);

                rimPoints.push({ i, ang, nextAng, pRim0, pRim1, pMid0, pMid1, pBot0, pBot1, avgDepth: (pRim0.depth + pRim1.depth) * 0.5 });
                hullMidPoints.push(pMid0);
                floorPoints.push(pBot0);
            }

            // 1. Draw Churning White Water Foam & Wake Underneath the Boat
            ctx.save();
            const wakeRx = boatRadius * 1.18;
            const wakeRy = boatRadius * Math.sin(game.cameraPitch) * 1.05;
            ctx.translate(cx, cy + bowlDepth * 0.36);

            // Outer water shadow
            ctx.fillStyle = 'rgba(12, 74, 96, 0.32)';
            ctx.beginPath();
            ctx.ellipse(0, 8, wakeRx * 0.96, wakeRy * 0.92, 0, 0, Math.PI * 2);
            ctx.fill();

            // Animated whitewater foam rings
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.78)';
            ctx.lineWidth = 5 + Math.min(8, game.boatSpeed * 1.3);
            ctx.setLineDash([22, 14]);
            ctx.lineDashOffset = -time * 75;
            ctx.beginPath();
            ctx.ellipse(0, 0, wakeRx, wakeRy, 0, 0, Math.PI * 2);
            ctx.stroke();

            ctx.strokeStyle = 'rgba(255, 255, 255, 0.45)';
            ctx.lineWidth = 3;
            ctx.setLineDash([12, 18]);
            ctx.lineDashOffset = time * 55;
            ctx.beginPath();
            ctx.ellipse(0, 4, wakeRx * 1.12, wakeRy * 1.12, 0, 0, Math.PI * 2);
            ctx.stroke();
            ctx.restore();

            // 2. Draw Interior Concave Basket Bowl (Visible through the tilted opening)
            ctx.save();
            ctx.beginPath();
            rimPoints.forEach((seg, idx) => {
                if (idx === 0) ctx.moveTo(seg.pRim0.x, seg.pRim0.y);
                else ctx.lineTo(seg.pRim0.x, seg.pRim0.y);
            });
            ctx.closePath();

            // Warm woven bamboo & coconut interior gradient
            const centerFloor = projectBoatPoint(0, 0, -bowlDepth, cx, cy);
            const intGrad = ctx.createRadialGradient(
                centerFloor.x, centerFloor.y, boatRadius * 0.08,
                cx, cy, boatRadius * 1.05
            );
            intGrad.addColorStop(0, '#B07D4F');
            intGrad.addColorStop(0.48, '#E6CCB2');
            intGrad.addColorStop(0.82, '#DDB892');
            intGrad.addColorStop(1, '#6C462B');
            ctx.fillStyle = intGrad;
            ctx.fill();

            // Clip interior details to the rim opening
            ctx.clip();

            // Diagonal woven herring-bone rattan mat texture inside the bowl
            ctx.strokeStyle = 'rgba(127, 85, 57, 0.22)';
            ctx.lineWidth = 2;
            for (let wv = -6; wv <= 6; wv++) {
                const offset = wv * (boatRadius * 0.16);
                const pStart = projectBoatPoint(-boatRadius * 0.85, offset, -bowlDepth * 0.55, cx, cy);
                const pEnd = projectBoatPoint(boatRadius * 0.85, offset, -bowlDepth * 0.55, cx, cy);
                ctx.beginPath();
                ctx.moveTo(pStart.x, pStart.y);
                ctx.lineTo(pEnd.x, pEnd.y);
                ctx.stroke();
            }

            // Woven bamboo lattice floor rings inside the bowl
            [0.25, 0.45, 0.65, 0.84].forEach(rRatio => {
                const zLevel = -bowlDepth * (1 - rRatio * rRatio * 0.75);
                ctx.strokeStyle = 'rgba(92, 58, 33, 0.48)';
                ctx.lineWidth = 3.2;
                ctx.beginPath();
                for (let i = 0; i <= SEGMENTS; i++) {
                    const a = (i / SEGMENTS) * Math.PI * 2;
                    const pt = projectBoatPoint(Math.cos(a) * boatRadius * rRatio, Math.sin(a) * boatRadius * rRatio, zLevel, cx, cy);
                    if (i === 0) ctx.moveTo(pt.x, pt.y);
                    else ctx.lineTo(pt.x, pt.y);
                }
                ctx.stroke();
            });

            // Radial wooden/bamboo structural ribs curving down the interior walls (like the reference photos!)
            for (let i = 0; i < 16; i++) {
                const a = (i / 16) * Math.PI * 2;
                const pTop = projectBoatPoint(Math.cos(a) * boatRadius * 0.96, Math.sin(a) * boatRadius * 0.96, -2, cx, cy);
                const pMid = projectBoatPoint(Math.cos(a) * boatRadius * 0.68, Math.sin(a) * boatRadius * 0.68, -bowlDepth * 0.68, cx, cy);
                const pBot = projectBoatPoint(Math.cos(a) * boatRadius * 0.22, Math.sin(a) * boatRadius * 0.22, -bowlDepth * 0.96, cx, cy);

                // Dark shadow edge of rib
                ctx.strokeStyle = '#5C3A21';
                ctx.lineWidth = 6.5;
                ctx.lineCap = 'round';
                ctx.beginPath();
                ctx.moveTo(pTop.x, pTop.y);
                ctx.quadraticCurveTo(pMid.x, pMid.y, pBot.x, pBot.y);
                ctx.stroke();

                // Light bamboo highlight of rib
                ctx.strokeStyle = '#F3D5B5';
                ctx.lineWidth = 3.2;
                ctx.beginPath();
                ctx.moveTo(pTop.x, pTop.y);
                ctx.quadraticCurveTo(pMid.x, pMid.y, pBot.x, pBot.y);
                ctx.stroke();
            }

            // Slatted Wooden Cross-Bench Plank across the middle of the basket boat
            drawWoodenCrossBench(cx, cy, boatRadius, bowlDepth);

            ctx.restore();

            // 3. Draw Back-Side Exterior Hull & Back Rim Segments (Segments further from camera)
            rimPoints.forEach(seg => {
                if (seg.avgDepth < 0) {
                    drawHullWallSegment(seg);
                    drawColorfulRimSegment(seg);
                }
            });

            // 4. Invoke callback to draw Depth-Sorted Student Hamsters & Captain Coconut INSIDE the boat!
            if (renderCallbackInside) {
                renderCallbackInside();
            }

            // 5. Draw Front-Side Exterior Hull Wall (occluding lower bodies of hamsters inside) & Front Colorful Rim
            // Sort front segments back-to-front for clean overlapping
            const frontSegments = rimPoints.filter(seg => seg.avgDepth >= 0).sort((a, b) => a.avgDepth - b.avgDepth);
            frontSegments.forEach(seg => {
                drawHullWallSegment(seg);
            });
            frontSegments.forEach(seg => {
                drawColorfulRimSegment(seg);
            });

            // 6. Draw Dynamic Water Foam & Spray Splashing against the Low Tilted Side of the Boat
            drawBoatEdgeWaterSpray(cx, cy, boatRadius, bowlDepth, time);
        }

        function drawWoodenCrossBench(cx, cy, boatRadius, bowlDepth) {
            const benchZ = -bowlDepth * 0.28;
            const halfLen = boatRadius * 0.84;
            const halfWid = boatRadius * 0.19;

            const corners = [
                projectBoatPoint(-halfLen, -halfWid, benchZ, cx, cy),
                projectBoatPoint(halfLen, -halfWid, benchZ, cx, cy),
                projectBoatPoint(halfLen, halfWid, benchZ, cx, cy),
                projectBoatPoint(-halfLen, halfWid, benchZ, cx, cy)
            ];

            // Bench drop shadow inside hull
            ctx.fillStyle = 'rgba(58, 34, 16, 0.35)';
            ctx.beginPath();
            ctx.moveTo(corners[0].x, corners[0].y + 8);
            ctx.lineTo(corners[1].x, corners[1].y + 8);
            ctx.lineTo(corners[2].x, corners[2].y + 8);
            ctx.lineTo(corners[3].x, corners[3].y + 8);
            ctx.closePath();
            ctx.fill();

            // Bamboo slat bench surface
            ctx.fillStyle = '#E6CCB2';
            ctx.strokeStyle = '#5C3A21';
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.moveTo(corners[0].x, corners[0].y);
            ctx.lineTo(corners[1].x, corners[1].y);
            ctx.lineTo(corners[2].x, corners[2].y);
            ctx.lineTo(corners[3].x, corners[3].y);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();

            // Slatted lines along the bench
            ctx.strokeStyle = '#9C6644';
            ctx.lineWidth = 1.6;
            for (let s = -0.6; s <= 0.6; s += 0.4) {
                const pA = projectBoatPoint(-halfLen * 0.92, halfWid * s, benchZ, cx, cy);
                const pB = projectBoatPoint(halfLen * 0.92, halfWid * s, benchZ, cx, cy);
                ctx.beginPath();
                ctx.moveTo(pA.x, pA.y);
                ctx.lineTo(pB.x, pB.y);
                ctx.stroke();
            }
        }

        function drawHullWallSegment(seg) {
            // Only draw outer hull wall where the 3D surface faces toward the viewer (front or high-tilted side)
            const { pRim0, pRim1, pMid0, pMid1, pBot0, pBot1, i } = seg;
            if (pMid0.y <= pRim0.y - 2 && pMid1.y <= pRim1.y - 2) return;

            ctx.save();
            // Alternating dark fibrous coconut shell & painted vertical festival stripe panels (like the photo!)
            const stripeColors = ['#4A2C11', '#5C3A21', '#D90429', '#F4A261', '#1D3557', '#2A9D8F'];
            const panelColor = (i % 3 === 0) ? stripeColors[(i / 3) % stripeColors.length | 0] : ((i % 2 === 0) ? '#5C3A21' : '#4A2C11');

            ctx.fillStyle = panelColor;
            ctx.strokeStyle = '#3A2210';
            ctx.lineWidth = 1.8;

            ctx.beginPath();
            ctx.moveTo(pRim0.x, pRim0.y);
            ctx.lineTo(pRim1.x, pRim1.y);
            ctx.lineTo(pMid1.x, pMid1.y);
            ctx.lineTo(pBot1.x, pBot1.y);
            ctx.lineTo(pBot0.x, pBot0.y);
            ctx.lineTo(pMid0.x, pMid0.y);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();

            // Woven bamboo horizontal texture lines on exterior hull
            ctx.strokeStyle = 'rgba(255, 248, 231, 0.18)';
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.moveTo((pRim0.x + pMid0.x) * 0.5, (pRim0.y + pMid0.y) * 0.5);
            ctx.lineTo((pRim1.x + pMid1.x) * 0.5, (pRim1.y + pMid1.y) * 0.5);
            ctx.stroke();

            // Stenciled white boat lettering ("C", "O", "C", "O") on front panels like the tourist basket boat photo
            const letters = { 2: 'C', 3: 'O', 4: 'C', 5: 'O', 14: 'C', 15: 'H', 16: 'A', 17: 'O', 18: 'S' };
            if (letters[i] && pMid0.y > pRim0.y + 8) {
                const lx = (pRim0.x + pRim1.x + pMid0.x + pMid1.x) * 0.25;
                const ly = (pRim0.y + pRim1.y + pMid0.y + pMid1.y) * 0.25;
                ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
                ctx.font = "900 13px 'Fredoka', sans-serif";
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(letters[i], lx, ly);
            }

            ctx.restore();
        }

        function drawColorfulRimSegment(seg) {
            const { pRim0, pRim1, i } = seg;
            const color = RIM_COLORS[i % RIM_COLORS.length];
            const rimThickness = 15;

            ctx.save();
            // Thick painted torus rim segment
            ctx.strokeStyle = '#3A2210';
            ctx.lineWidth = rimThickness + 5;
            ctx.lineCap = 'round';
            ctx.beginPath();
            ctx.moveTo(pRim0.x, pRim0.y);
            ctx.lineTo(pRim1.x, pRim1.y);
            ctx.stroke();

            ctx.strokeStyle = color;
            ctx.lineWidth = rimThickness;
            ctx.beginPath();
            ctx.moveTo(pRim0.x, pRim0.y);
            ctx.lineTo(pRim1.x, pRim1.y);
            ctx.stroke();

            // Glossy top highlight on rim
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.38)';
            ctx.lineWidth = 4;
            ctx.beginPath();
            ctx.moveTo(pRim0.x, pRim0.y - 3);
            ctx.lineTo(pRim1.x, pRim1.y - 3);
            ctx.stroke();

            // Rattan lashing band between segments
            ctx.fillStyle = '#3A2210';
            ctx.beginPath();
            ctx.arc(pRim0.x, pRim0.y, rimThickness * 0.48, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
        }

        function drawBoatEdgeWaterSpray(cx, cy, boatRadius, bowlDepth, time) {
            // Whenever the boat tilts or spins fast, draw frothy water splashes along the lowest rim edge
            const tiltMag = Math.hypot(game.boatTiltRoll, game.boatTiltPitch);
            if (tiltMag < 0.08 && game.boatSpeed < 1.5) return;

            ctx.save();
            ctx.fillStyle = 'rgba(255, 255, 255, 0.82)';
            for (let i = 0; i < 8; i++) {
                const a = time * 4 + i * 0.8;
                const pt = projectBoatPoint(Math.cos(a) * boatRadius * 1.04, Math.sin(a) * boatRadius * 1.04, -bowlDepth * 0.25, cx, cy);
                if (pt.worldZ < -8) { // Submerged/low side of the tilted rim
                    const r = 5 + Math.sin(time * 15 + i) * 3 + tiltMag * 12;
                    ctx.beginPath();
                    ctx.arc(pt.x, pt.y + 6, Math.max(2, r), 0, Math.PI * 2);
                    ctx.fill();
                }
            }
            ctx.restore();
        }

        // Draw adorable kawaii hamster character
        function drawHamsterCharacter(targetCtx, x, y, radius, hamster, time, isCaptain = false) {
            targetCtx.save();
            targetCtx.translate(x, y);

            // Wobble or rock rotation
            const wobble = hamster.wobbleAngle || 0;
            targetCtx.rotate(wobble);

            // Soft drop shadow
            targetCtx.fillStyle = 'rgba(74, 44, 17, 0.22)';
            targetCtx.beginPath();
            targetCtx.ellipse(0, radius * 0.78, radius * 0.85, radius * 0.38, 0, 0, Math.PI * 2);
            targetCtx.fill();

            const furColor = isCaptain ? '#D97706' : hamster.palette.body;
            const bellyColor = isCaptain ? '#FEF3C7' : hamster.palette.belly;
            const earInner = isCaptain ? '#F59E0B' : hamster.palette.ear;

            // Round little ears
            const earSpread = radius * 0.68;
            const earY = -radius * 0.65;
            [-1, 1].forEach(dir => {
                targetCtx.fillStyle = furColor;
                targetCtx.strokeStyle = '#4A2C11';
                targetCtx.lineWidth = Math.max(2, radius * 0.1);
                targetCtx.beginPath();
                targetCtx.arc(dir * earSpread, earY, radius * 0.34, 0, Math.PI * 2);
                targetCtx.fill();
                targetCtx.stroke();

                targetCtx.fillStyle = '#FFCAD4';
                targetCtx.beginPath();
                targetCtx.arc(dir * earSpread, earY, radius * 0.18, 0, Math.PI * 2);
                targetCtx.fill();
            });

            // Chubby 3D-shaded potato-shaped body
            const bodyGrad = targetCtx.createRadialGradient(-radius * 0.28, -radius * 0.28, radius * 0.08, 0, 0, radius * 1.05);
            bodyGrad.addColorStop(0, '#FFFFFF');
            bodyGrad.addColorStop(0.2, furColor);
            bodyGrad.addColorStop(0.85, furColor);
            bodyGrad.addColorStop(1, earInner);
            targetCtx.fillStyle = bodyGrad;
            targetCtx.strokeStyle = '#4A2C11';
            targetCtx.lineWidth = Math.max(2.2, radius * 0.11);
            targetCtx.beginPath();
            targetCtx.ellipse(0, 0, radius * 0.96, radius * 0.9, 0, 0, Math.PI * 2);
            targetCtx.fill();
            targetCtx.stroke();

            // Fluffy top head fur tuft
            targetCtx.fillStyle = furColor;
            targetCtx.beginPath();
            targetCtx.moveTo(-radius * 0.16, -radius * 0.84);
            targetCtx.quadraticCurveTo(0, -radius * 1.08, radius * 0.06, -radius * 0.88);
            targetCtx.quadraticCurveTo(radius * 0.18, -radius * 1.04, radius * 0.18, -radius * 0.82);
            targetCtx.fill();
            targetCtx.stroke();

            // Fluffy cream belly patch
            targetCtx.fillStyle = bellyColor;
            targetCtx.beginPath();
            targetCtx.ellipse(0, radius * 0.24, radius * 0.58, radius * 0.48, 0, 0, Math.PI * 2);
            targetCtx.fill();

            // Rosy pink cheeks & delicate whiskers
            targetCtx.fillStyle = 'rgba(255, 105, 135, 0.7)';
            [-1, 1].forEach(dir => {
                targetCtx.beginPath();
                targetCtx.ellipse(dir * radius * 0.54, radius * 0.06, radius * 0.23, radius * 0.15, 0, 0, Math.PI * 2);
                targetCtx.fill();

                // Cute twin whiskers on each cheek
                targetCtx.strokeStyle = 'rgba(74, 44, 17, 0.65)';
                targetCtx.lineWidth = Math.max(1.2, radius * 0.055);
                targetCtx.beginPath();
                targetCtx.moveTo(dir * radius * 0.68, radius * 0.02);
                targetCtx.lineTo(dir * radius * 1.06, -radius * 0.05);
                targetCtx.moveTo(dir * radius * 0.68, radius * 0.11);
                targetCtx.lineTo(dir * radius * 1.04, radius * 0.14);
                targetCtx.stroke();
            });

            // Expressive eyes
            const expr = isCaptain ? 'captain' : (hamster.expression || 'happy');
            const eyeX = radius * 0.34;
            const eyeY = -radius * 0.14;

            if (expr === 'dizzy') {
                // Swirling spiral eyes
                targetCtx.strokeStyle = '#4A2C11';
                targetCtx.lineWidth = 2.2;
                [-1, 1].forEach(dir => {
                    targetCtx.save();
                    targetCtx.translate(dir * eyeX, eyeY);
                    targetCtx.rotate(time * 8 * dir);
                    targetCtx.beginPath();
                    targetCtx.arc(0, 0, radius * 0.17, 0, Math.PI * 1.5);
                    targetCtx.stroke();
                    targetCtx.restore();
                });
            } else if (expr === 'shocked' || expr === 'scream') {
                // Wide popped cartoon eyes
                [-1, 1].forEach(dir => {
                    targetCtx.fillStyle = '#FFFFFF';
                    targetCtx.strokeStyle = '#4A2C11';
                    targetCtx.lineWidth = 2;
                    targetCtx.beginPath();
                    targetCtx.arc(dir * eyeX, eyeY, radius * 0.22, 0, Math.PI * 2);
                    targetCtx.fill();
                    targetCtx.stroke();

                    targetCtx.fillStyle = '#2B180A';
                    targetCtx.beginPath();
                    targetCtx.arc(dir * eyeX, eyeY, radius * 0.09, 0, Math.PI * 2);
                    targetCtx.fill();
                });
            } else {
                // Big glossy kawaii eyes with dual anime-style catchlights
                [-1, 1].forEach(dir => {
                    targetCtx.fillStyle = '#2B180A';
                    targetCtx.beginPath();
                    targetCtx.arc(dir * eyeX, eyeY, radius * 0.18, 0, Math.PI * 2);
                    targetCtx.fill();

                    // Large upper eye shine highlight
                    targetCtx.fillStyle = '#FFFFFF';
                    targetCtx.beginPath();
                    targetCtx.arc(dir * eyeX - radius * 0.055, eyeY - radius * 0.055, radius * 0.07, 0, Math.PI * 2);
                    targetCtx.fill();

                    // Small lower sparkle catchlight
                    targetCtx.beginPath();
                    targetCtx.arc(dir * eyeX + radius * 0.05, eyeY + radius * 0.05, radius * 0.032, 0, Math.PI * 2);
                    targetCtx.fill();
                });
            }

            // Cute tiny pink nose & mouth
            targetCtx.fillStyle = '#FF758F';
            targetCtx.beginPath();
            targetCtx.ellipse(0, -radius * 0.01, radius * 0.1, radius * 0.07, 0, 0, Math.PI * 2);
            targetCtx.fill();

            targetCtx.strokeStyle = '#4A2C11';
            targetCtx.lineWidth = 2;
            if (expr === 'scream' || expr === 'shocked') {
                targetCtx.fillStyle = '#E63946';
                targetCtx.beginPath();
                targetCtx.ellipse(0, radius * 0.18, radius * 0.16, radius * 0.2, 0, 0, Math.PI * 2);
                targetCtx.fill();
                targetCtx.stroke();
            } else {
                // Cat-like "w" hamster smile
                targetCtx.beginPath();
                targetCtx.arc(-radius * 0.09, radius * 0.07, radius * 0.09, 0, Math.PI);
                targetCtx.arc(radius * 0.09, radius * 0.07, radius * 0.09, 0, Math.PI);
                targetCtx.stroke();
            }

            // Little paws (clinging or waving frantically)
            const pawWave = (expr === 'scream' || expr === 'shocked') ? Math.sin(time * 24) * radius * 0.25 : Math.sin(time * 4 + (hamster.bobOffset || 0)) * radius * 0.08;
            targetCtx.fillStyle = bellyColor;
            targetCtx.strokeStyle = '#4A2C11';
            targetCtx.lineWidth = 2;
            [-1, 1].forEach(dir => {
                targetCtx.beginPath();
                targetCtx.arc(dir * radius * 0.58, radius * 0.22 - Math.abs(pawWave), radius * 0.17, 0, Math.PI * 2);
                targetCtx.fill();
                targetCtx.stroke();
            });

            // Optional sunflower seed snack in idle
            if (!isCaptain && hamster.eatingSeed && game.state === STATE.IDLE) {
                targetCtx.fillStyle = '#3D405B';
                targetCtx.beginPath();
                targetCtx.ellipse(0, radius * 0.22, radius * 0.12, radius * 0.18, 0.3, 0, Math.PI * 2);
                targetCtx.fill();
            }

            // Accessories or Captain Hat
            if (isCaptain) {
                drawCaptainHatAndPaddle(targetCtx, radius, time);
            } else {
                if (hamster.expression === 'crown') {
                    drawWinnerCrown(targetCtx, radius);
                } else {
                    drawHamsterAccessory(targetCtx, radius, hamster.accessory, time);
                }
            }

            targetCtx.restore();
        }

        function drawCaptainHatAndPaddle(targetCtx, r, time) {
            // Iconic Vietnamese Conical Bamboo Hat (Nón Lá) + Captain Band (inspired by the photo!)
            targetCtx.save();
            targetCtx.translate(0, -r * 0.72);

            // Turquoise neck scarf fluttering
            targetCtx.fillStyle = '#00BBF9';
            targetCtx.strokeStyle = '#4A2C11';
            targetCtx.lineWidth = 2;
            targetCtx.beginPath();
            targetCtx.ellipse(0, r * 1.02, r * 0.62, r * 0.18, 0, 0, Math.PI * 2);
            targetCtx.fill();
            targetCtx.stroke();

            // Conical Nón Lá Straw Hat
            const hatGrad = targetCtx.createLinearGradient(-r, -r * 0.7, r, 0);
            hatGrad.addColorStop(0, '#FFF8E7');
            hatGrad.addColorStop(0.5, '#F3D5B5');
            hatGrad.addColorStop(1, '#D4A373');
            targetCtx.fillStyle = hatGrad;
            targetCtx.strokeStyle = '#4A2C11';
            targetCtx.lineWidth = 2.5;
            targetCtx.beginPath();
            targetCtx.moveTo(-r * 1.25, r * 0.05);
            targetCtx.lineTo(0, -r * 0.78);
            targetCtx.lineTo(r * 1.25, r * 0.05);
            targetCtx.quadraticCurveTo(0, r * 0.28, -r * 1.25, r * 0.05);
            targetCtx.closePath();
            targetCtx.fill();
            targetCtx.stroke();

            // Woven rings on the conical hat
            targetCtx.strokeStyle = 'rgba(92, 58, 33, 0.35)';
            targetCtx.lineWidth = 1.5;
            targetCtx.beginPath();
            targetCtx.moveTo(-r * 0.75, -r * 0.22);
            targetCtx.quadraticCurveTo(0, -r * 0.08, r * 0.75, -r * 0.22);
            targetCtx.stroke();

            targetCtx.restore();

            // Long Bamboo Oar / Paddle dipping deep into the river water on the side
            const strokeAngle = Math.sin(game.captainPaddlePhase) * 0.48;
            targetCtx.save();
            targetCtx.translate(r * 0.45, r * 0.15);
            targetCtx.rotate(0.55 + strokeAngle);

            // Long bamboo shaft
            targetCtx.strokeStyle = '#DDB892';
            targetCtx.lineWidth = Math.max(5, r * 0.24);
            targetCtx.lineCap = 'round';
            targetCtx.beginPath();
            targetCtx.moveTo(-r * 0.9, -r * 0.4);
            targetCtx.lineTo(r * 2.1, r * 0.9);
            targetCtx.stroke();

            targetCtx.strokeStyle = '#4A2C11';
            targetCtx.lineWidth = 2;
            targetCtx.beginPath();
            targetCtx.moveTo(-r * 0.9, -r * 0.4);
            targetCtx.lineTo(r * 2.1, r * 0.9);
            targetCtx.stroke();

            // Wooden paddle blade & water splash foam at tip
            targetCtx.fillStyle = '#B08968';
            targetCtx.strokeStyle = '#4A2C11';
            targetCtx.lineWidth = 2.2;
            targetCtx.beginPath();
            targetCtx.ellipse(r * 2.25, r * 0.98, r * 0.48, r * 0.22, 0.4, 0, Math.PI * 2);
            targetCtx.fill();
            targetCtx.stroke();

            // White water splash droplets around the oar blade
            targetCtx.fillStyle = 'rgba(255, 255, 255, 0.85)';
            targetCtx.beginPath();
            targetCtx.arc(r * 2.45, r * 1.05, r * 0.22, 0, Math.PI * 2);
            targetCtx.arc(r * 2.05, r * 1.12, r * 0.16, 0, Math.PI * 2);
            targetCtx.fill();

            targetCtx.restore();
        }

        function drawHamsterAccessory(targetCtx, r, type, time) {
            targetCtx.save();
            targetCtx.strokeStyle = '#4A2C11';
            targetCtx.lineWidth = 2;

            if (type === 'pink_bow') {
                targetCtx.translate(-r * 0.45, -r * 0.72);
                targetCtx.fillStyle = '#FF4D6D';
                targetCtx.beginPath();
                targetCtx.ellipse(-r * 0.18, 0, r * 0.2, r * 0.13, -0.2, 0, Math.PI * 2);
                targetCtx.ellipse(r * 0.18, 0, r * 0.2, r * 0.13, 0.2, 0, Math.PI * 2);
                targetCtx.fill();
                targetCtx.stroke();
                targetCtx.beginPath();
                targetCtx.arc(0, 0, r * 0.1, 0, Math.PI * 2);
                targetCtx.fill();
                targetCtx.stroke();
            } else if (type === 'sunglasses') {
                targetCtx.fillStyle = '#1D3557';
                targetCtx.fillRect(-r * 0.62, -r * 0.3, r * 0.5, r * 0.28);
                targetCtx.fillRect(r * 0.12, -r * 0.3, r * 0.5, r * 0.28);
                targetCtx.beginPath();
                targetCtx.moveTo(-r * 0.12, -r * 0.18);
                targetCtx.lineTo(r * 0.12, -r * 0.18);
                targetCtx.stroke();
            } else if (type === 'sailor_hat') {
                targetCtx.translate(0, -r * 0.85);
                targetCtx.fillStyle = '#FFFFFF';
                targetCtx.beginPath();
                targetCtx.arc(0, 0, r * 0.4, Math.PI, 0);
                targetCtx.closePath();
                targetCtx.fill();
                targetCtx.stroke();
                targetCtx.fillStyle = '#3A86FF';
                targetCtx.fillRect(-r * 0.4, -r * 0.12, r * 0.8, r * 0.12);
            } else if (type === 'headband') {
                targetCtx.fillStyle = '#FF006E';
                targetCtx.fillRect(-r * 0.78, -r * 0.52, r * 1.56, r * 0.18);
                targetCtx.strokeRect(-r * 0.78, -r * 0.52, r * 1.56, r * 0.18);
            } else if (type === 'flower') {
                targetCtx.translate(r * 0.45, -r * 0.72);
                targetCtx.fillStyle = '#FFBE0B';
                for (let p = 0; p < 5; p++) {
                    const a = (p / 5) * Math.PI * 2;
                    targetCtx.beginPath();
                    targetCtx.arc(Math.cos(a) * r * 0.16, Math.sin(a) * r * 0.16, r * 0.12, 0, Math.PI * 2);
                    targetCtx.fill();
                }
                targetCtx.fillStyle = '#FB5607';
                targetCtx.beginPath();
                targetCtx.arc(0, 0, r * 0.1, 0, Math.PI * 2);
                targetCtx.fill();
            } else if (type === 'propeller_cap') {
                targetCtx.translate(0, -r * 0.82);
                targetCtx.fillStyle = '#06D6A0';
                targetCtx.beginPath();
                targetCtx.arc(0, 0, r * 0.42, Math.PI, 0);
                targetCtx.fill();
                targetCtx.stroke();
                targetCtx.fillStyle = '#EF476F';
                targetCtx.fillRect(-r * 0.35, -r * 0.52, r * 0.7, r * 0.09);
            } else if (type === 'straw_hat') {
                targetCtx.translate(0, -r * 0.82);
                targetCtx.fillStyle = '#F4D35E';
                targetCtx.beginPath();
                targetCtx.ellipse(0, 0, r * 0.72, r * 0.18, 0, 0, Math.PI * 2);
                targetCtx.fill();
                targetCtx.stroke();
            } else if (type === 'leaf_sprout') {
                targetCtx.translate(0, -r * 0.88);
                targetCtx.fillStyle = '#80ED99';
                targetCtx.beginPath();
                targetCtx.ellipse(-r * 0.15, -r * 0.15, r * 0.2, r * 0.1, -0.4, 0, Math.PI * 2);
                targetCtx.ellipse(r * 0.15, -r * 0.15, r * 0.2, r * 0.1, 0.4, 0, Math.PI * 2);
                targetCtx.fill();
                targetCtx.stroke();
