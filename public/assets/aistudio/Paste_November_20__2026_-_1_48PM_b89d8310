<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🥥 COCONUT CHAOS: THE HAMSTER BOAT</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Quicksand:wght@600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --coconut-dark: #5C3A21;
            --coconut-mid: #8B5A2B;
            --coconut-cream: #FFF8E7;
            --water-light: #72EFDD;
            --water-deep: #48CAE4;
        }
        body {
            font-family: 'Quicksand', sans-serif;
            overflow: hidden;
            user-select: none;
            background-color: #48CAE4;
        }
        h1, h2, h3, .cartoon-font {
            font-family: 'Fredoka', sans-serif;
            letter-spacing: 0.02em;
        }
        .text-outline {
            text-shadow: 
                -2px -2px 0 #4A2C11,  
                 2px -2px 0 #4A2C11,
                -2px  2px 0 #4A2C11,
                 2px  2px 0 #4A2C11,
                 0px  4px 0 #4A2C11;
        }
        .text-outline-sm {
            text-shadow: 
                -1.5px -1.5px 0 #4A2C11,  
                 1.5px -1.5px 0 #4A2C11,
                -1.5px  1.5px 0 #4A2C11,
                 1.5px  1.5px 0 #4A2C11,
                 0px  2.5px 0 #4A2C11;
        }
        .btn-cartoon {
            transition: all 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 6px 0 #4A2C11, 0 10px 15px rgba(0,0,0,0.2);
            border: 3px solid #4A2C11;
        }
        .btn-cartoon:hover:not(:disabled) {
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 9px 0 #4A2C11, 0 14px 20px rgba(0,0,0,0.25);
        }
        .btn-cartoon:active:not(:disabled) {
            transform: translateY(4px);
            box-shadow: 0 2px 0 #4A2C11, 0 4px 6px rgba(0,0,0,0.15);
        }
        .btn-cartoon:disabled {
            opacity: 0.55;
            cursor: not-allowed;
            transform: translateY(2px);
            box-shadow: 0 3px 0 #4A2C11;
        }
        .wood-panel {
            background: linear-gradient(180deg, #FFFDF7 0%, #FDF0D5 100%);
            border: 4px solid #5C3A21;
            box-shadow: 0 8px 0 #4A2C11, 0 14px 28px rgba(0,0,0,0.28), inset 0 2px 0 rgba(255,255,255,0.9);
        }
        .coconut-badge {
            background: linear-gradient(135deg, #9C6644 0%, #5C3A21 100%);
            border: 3px solid #FFF8E7;
            box-shadow: 0 5px 0 #3A2210, 0 8px 16px rgba(0,0,0,0.25);
        }
        @keyframes floatSlow {
            0%, 100% { transform: translateY(0px) rotate(-1deg); }
            50% { transform: translateY(-10px) rotate(1deg); }
        }
        .animate-float {
            animation: floatSlow 3.5s ease-in-out infinite;
        }
        @keyframes popIn {
            0% { transform: scale(0.4); opacity: 0; }
            70% { transform: scale(1.08); opacity: 1; }
            100% { transform: scale(1); opacity: 1; }
        }
        .animate-pop {
            animation: popIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #F3E5AB;
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb {
            background: #8B5A2B;
            border-radius: 8px;
        }
    </style>
</head>
<body class="w-screen h-screen relative select-none overflow-hidden">

    <!-- MAIN GAME CANVAS -->
    <canvas id="gameCanvas" class="w-full h-full block"></canvas>

    <!-- TOP HUD BAR -->
