            targetCtx.restore();
        }

        function drawWinnerCrown(targetCtx, r) {
            targetCtx.save();
            targetCtx.translate(0, -r * 1.05);
            targetCtx.fillStyle = '#FFD700';
            targetCtx.strokeStyle = '#4A2C11';
            targetCtx.lineWidth = 2.5;
            targetCtx.beginPath();
            targetCtx.moveTo(-r * 0.48, 0);
            targetCtx.lineTo(-r * 0.55, -r * 0.45);
            targetCtx.lineTo(-r * 0.2, -r * 0.2);
            targetCtx.lineTo(0, -r * 0.55);
            targetCtx.lineTo(r * 0.2, -r * 0.2);
            targetCtx.lineTo(r * 0.55, -r * 0.45);
            targetCtx.lineTo(r * 0.48, 0);
            targetCtx.closePath();
            targetCtx.fill();
            targetCtx.stroke();
            targetCtx.restore();
        }

        // Draw crisp student name badge that ALWAYS stays upright and legible
        function drawNameTag(x, y, text, isCaptain = false) {
            ctx.save();
            ctx.font = isCaptain ? "700 13px 'Fredoka', sans-serif" : "700 14px 'Quicksand', sans-serif";
            const paddingX = 10;
            const metrics = ctx.measureText(text);
            const boxW = metrics.width + paddingX * 2;
            const boxH = 23;

            ctx.translate(x, y);

            // Soft drop shadow under badge
            ctx.fillStyle = 'rgba(43, 24, 10, 0.28)';
            ctx.beginPath();
            ctx.roundRect(-boxW / 2, -boxH / 2 + 3, boxW, boxH, 10);
            ctx.fill();

            ctx.fillStyle = isCaptain ? '#5C3A21' : 'rgba(255, 253, 245, 0.96)';
            ctx.strokeStyle = isCaptain ? '#FFD166' : '#4A2C11';
            ctx.lineWidth = 2.4;

            ctx.beginPath();
            ctx.roundRect(-boxW / 2, -boxH / 2, boxW, boxH, 10);
            ctx.fill();
            ctx.stroke();

            // Little pointer triangle pointing to the hamster
            ctx.beginPath();
            ctx.moveTo(-4, boxH / 2);
            ctx.lineTo(4, boxH / 2);
            ctx.lineTo(0, boxH / 2 + 4);
            ctx.closePath();
            ctx.fill();

            ctx.fillStyle = isCaptain ? '#FFD166' : '#3A2210';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(text, 0, 1);
            ctx.restore();
        }

        /********************************************************************
         * 6. MAIN GAMEPLAY LOOP & ANIMATION SEQUENCE
         ********************************************************************/
        let lastFrameTime = performance.now();

        function gameLoop(now) {
            const rawDt = Math.min(0.05, (now - lastFrameTime) / 1000);
            lastFrameTime = now;
            const dt = game.paused ? 0 : rawDt * game.slowMoFactor;
            const time = now / 1000;

            updateGameLogic(dt, time);
            renderScene(time);

            requestAnimationFrame(gameLoop);
        }

        function getSpeedMultiplier() {
            if (game.settings.speedPreset === 'slow') return 0.65;
            if (game.settings.speedPreset === 'crazy') return 1.55;
            return 1.0;
        }

        function getRoundDuration() {
            if (game.settings.durationPreset === 'short') return 4.2;
            if (game.settings.durationPreset === 'long') return 10.5;
            return 7.0;
        }

        function updateGameLogic(dt, time) {
            if (game.paused) return;

            const speedMult = getSpeedMultiplier();
            const totalDuration = getRoundDuration();

            // Update camera perspective pitch
            if (game.cameraMode === 'side') {
                game.cameraPitch += (0.56 - game.cameraPitch) * 5 * dt; // ~32 deg dramatic side view
            } else if (game.cameraMode === 'high') {
                game.cameraPitch += (0.98 - game.cameraPitch) * 5 * dt; // ~56 deg high overview
            } else if (game.cameraMode === 'dynamic') {
                const targetPitch = 0.52 + Math.sin(time * 0.85) * 0.18;
                game.cameraPitch += (targetPitch - game.cameraPitch) * 4 * dt;
            }

            // Gentle rocking motion on water
            game.boatRockPhase += dt * (2.5 + game.boatSpeed * 10);

            // Calculate acrobatic 3D Boat Roll & Pitch (like the real Vietnamese basket boat performers!)
            let tiltIntensity = 0.10;
            if (game.state === STATE.SLOW_SPIN) tiltIntensity = 0.22;
            else if (game.state === STATE.CHAOS_SPIN) tiltIntensity = 0.44; // Dramatic 25+ degree side tilt!
            else if (game.state === STATE.LAUNCHING) tiltIntensity = 0.35;

            game.boatTiltRoll = Math.sin(game.boatRockPhase) * tiltIntensity;
            game.boatTiltPitch = Math.cos(game.boatRockPhase * 0.85) * (tiltIntensity * 0.65);

            if (game.state === STATE.BOARDING) {
                game.phaseTimer += dt;
                let allBoarded = true;
                game.students.forEach(h => {
                    if (game.phaseTimer > h.boardDelay) {
                        h.boardProgress = Math.min(1, h.boardProgress + dt * 3.2);
                    }
                    if (h.boardProgress < 1) allBoarded = false;
                });
                game.boatAngle += 0.35 * dt;
                game.captainPaddlePhase += dt * 4;
                if (allBoarded && game.phaseTimer > 1.2) {
                    game.state = STATE.IDLE;
                    setStatusText("ALL HAMSTERS ABOARD! READY TO SPIN 🥥");
                }
            } else if (game.state === STATE.IDLE) {
                game.boatAngle += 0.28 * dt;
                game.captainPaddlePhase += dt * 3.8;
            } else if (game.state === STATE.SLOW_SPIN) {
                // Phase 2: Nice and easy
                game.phaseTimer += dt;
                game.boatSpeed = (1.2 + game.phaseTimer * 0.6) * speedMult;
                game.boatAngle += game.boatSpeed * dt;
                game.captainPaddlePhase += dt * 9 * speedMult;

                if (Math.random() < 0.14) {
                    sound.playPaddleSplash(0.5);
                }

                if (game.phaseTimer >= totalDuration * 0.32) {
                    game.state = STATE.CHAOS_SPIN;
                    setStatusText("🌪️ ACROBATIC COCONUT CHAOS!! 🌪️");
                }
            } else if (game.state === STATE.CHAOS_SPIN) {
                // Phase 3: High speed chaos, dramatic side tilting, sliding, wobbling, funny quotes
                game.phaseTimer += dt;
                const chaosProgress = (game.phaseTimer - totalDuration * 0.32) / (totalDuration * 0.68);
                game.boatSpeed = (2.2 + chaosProgress * 5.8) * speedMult;
                game.boatAngle += game.boatSpeed * dt;
                game.captainPaddlePhase += dt * 22 * speedMult;

                if (Math.random() < 0.28) {
                    sound.playPaddleSplash(1.2);
                }
                if (Math.random() < 0.08) {
                    sound.playSqueak();
                }

                // Random funny hamster quotes
                game.quoteTimer -= dt;
                if (game.quoteTimer <= 0) {
                    const quote = CHAOS_QUOTES[Math.floor(Math.random() * CHAOS_QUOTES.length)];
                    showPhaseBanner(quote, 1300);
                    game.quoteTimer = 1.45;
                }

                // Update active hamsters' expressions & centrifugal slide toward the tilted rim
                const active = game.students.filter(s => !s.eliminated);
                active.forEach((h, idx) => {
                    h.wobbleAngle = Math.sin(time * 18 + idx) * 0.38 - game.boatTiltRoll * 0.6;
                    const pushOut = 1 + Math.min(0.26, chaosProgress * 0.24);
                    const slideGravityX = Math.sin(game.boatTiltRoll) * 0.14;
                    h.curX = h.seatX * pushOut + slideGravityX + Math.cos(time * 12 + idx) * 0.04;
                    h.curY = h.seatY * pushOut + Math.sin(time * 12 + idx) * 0.04;
                    h.expression = idx % 2 === 0 ? 'dizzy' : 'scream';
                });

                if (game.phaseTimer >= totalDuration) {
                    launchRandomVictim();
                }
            } else if (game.state === STATE.LAUNCHING) {
                // Phase 4: Slow-motion dramatic launch into the water
                game.boatAngle += game.boatSpeed * 0.35 * dt;
                if (game.flyingHamster) {
                    game.flyingHamster.t += dt / 1.15; // 1.15s flight duration
                    if (game.flyingHamster.t > 0.15 && game.flyingHamster.t < 0.65) {
                        game.slowMoFactor = 0.48; // Dramatic slow motion mid-air!
                    } else {
                        game.slowMoFactor = 1.0;
                    }

                    if (game.flyingHamster.t >= 1) {
                        completeEliminationSplash();
                    }
                }
            }

            // Update splash & confetti particles
            for (let i = game.particles.length - 1; i >= 0; i--) {
                const p = game.particles[i];
                p.x += p.vx * dt;
                p.y += p.vy * dt;
                if (p.gravity) p.vy += p.gravity * dt;
                p.life -= dt;
                if (p.life <= 0) game.particles.splice(i, 1);
            }
        }

        function renderScene(time) {
            const w = window.innerWidth;
            const h = window.innerHeight;
            const cx = w / 2;
            const cy = h * 0.57; // Positioned in the river foreground below the Nipa palm bank

            drawTropicalLagoon(w, h, time);

            // Responsive Coconut Basket Boat Radius
            const boatRadius = Math.min(w, h) * (w < 640 ? 0.34 : 0.31);
            const bowlDepth = boatRadius * 0.66;

            // Helper to render floating eliminated hamsters (split into background & foreground for true 2.5D depth)
            const eliminated = game.students.filter(s => s.eliminated);
            const sinCam = Math.sin(game.cameraPitch);

            function drawEliminatedSet(isForeground) {
                eliminated.forEach((ham, idx) => {
                    const floatR = boatRadius * 1.48 + (idx % 2) * 34;
                    const ang = ham.floatAngle + Math.sin(time * 0.45 + idx) * 0.08;
                    const sinA = Math.sin(ang);
                    if (isForeground ? (sinA < 0) : (sinA >= 0)) return;

                    const fx = cx + Math.cos(ang) * floatR;
                    const fy = cy + sinA * floatR * sinCam + Math.sin(time * 3 + idx) * 4;
                    const depthScale = 0.85 + (sinA + 1) * 0.12;

                    // Gentle water ripple under floatie
                    ctx.strokeStyle = 'rgba(255,255,255,0.55)';
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.ellipse(fx, fy + 6, 30 * depthScale, 15 * depthScale, 0, 0, Math.PI * 2);
                    ctx.stroke();

                    // Colorful 2.5D glossy donut inner tube with tropical stripes
                    const tubeGrad = ctx.createRadialGradient(fx - 6 * depthScale, fy - 2 * depthScale, 3 * depthScale, fx, fy + 4, 26 * depthScale);
                    tubeGrad.addColorStop(0, '#FFFFFF');
                    tubeGrad.addColorStop(0.25, ham.tubeColor);
                    tubeGrad.addColorStop(1, ham.tubeColor);
                    ctx.fillStyle = tubeGrad;
                    ctx.strokeStyle = '#4A2C11';
                    ctx.lineWidth = 3;
                    ctx.beginPath();
                    ctx.ellipse(fx, fy + 4, 25 * depthScale, 14.5 * depthScale, 0, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.stroke();

                    // Inner ring detail on floatie
                    ctx.strokeStyle = 'rgba(255,255,255,0.65)';
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.ellipse(fx, fy + 2, 16 * depthScale, 8 * depthScale, 0, 0, Math.PI * 2);
                    ctx.stroke();

                    drawHamsterCharacter(ctx, fx, fy - 4 * depthScale, 16 * depthScale, ham, time, false);
                    drawNameTag(fx, fy - 30 * depthScale, ham.name, false);
                });
            }

            // 1. Draw Eliminated Hamsters floating behind the boat
            drawEliminatedSet(false);

            // 2. Draw Tilted 3D Coconut Basket Boat + Depth-Sorted Hamsters & Captain Inside
            const rockX = Math.sin(game.boatRockPhase * 0.5) * 7;
            const rockY = Math.cos(game.boatRockPhase * 0.8) * 5;
            const boatX = cx + rockX;
            const boatY = cy + rockY;

            const active = game.students.filter(s => !s.eliminated);
            const hamRadius = Math.max(15, Math.min(28, boatRadius * (active.length > 18 ? 0.12 : active.length > 10 ? 0.15 : 0.19)));
            const usableRadius = boatRadius * 0.80;
            const nameTagQueue = [];

            drawTiltedCoconutBasketBoat(boatX, boatY, boatRadius, time, () => {
                // Collect all 3D entities inside the boat (Students + Captain Coconut) and sort by depth (back-to-front)
                const renderEntities = [];

                active.forEach(ham => {
                    if (game.flyingHamster && game.flyingHamster.hamster.id === ham.id) return;

                    const lx = (game.state === STATE.CHAOS_SPIN ? ham.curX : ham.seatX) * usableRadius;
                    const ly = (game.state === STATE.CHAOS_SPIN ? ham.curY : ham.seatY) * usableRadius;

                    // Height inside the concave bowl: rim seats sit higher, bench/floor sit deeper inside
                    const rNorm = Math.min(1, Math.hypot(lx, ly) / boatRadius);
                    const seatZ = -bowlDepth * (1 - rNorm * rNorm * 0.82) + hamRadius * 0.35;

                    const proj = projectBoatPoint(lx, ly, seatZ, boatX, boatY);
                    renderEntities.push({
                        type: 'student',
                        ham,
                        proj,
                        depth: proj.depth
                    });
                });

                // Captain Coconut stands near the stern/side edge rocking the boat with a long bamboo paddle
                const capBounce = Math.abs(Math.sin(game.captainPaddlePhase)) * 8;
                const capProj = projectBoatPoint(0, -boatRadius * 0.78, hamRadius * 0.55 + capBounce, boatX, boatY);
                renderEntities.push({
                    type: 'captain',
                    proj: capProj,
                    depth: capProj.depth
                });

                // Painter's Algorithm: Sort from furthest back (smallest depth) to closest front (largest depth)
                renderEntities.sort((a, b) => a.depth - b.depth);

                renderEntities.forEach(ent => {
                    if (ent.type === 'captain') {
                        const capR = Math.max(24, boatRadius * 0.20);
                        drawHamsterCharacter(ctx, ent.proj.x, ent.proj.y, capR, {
                            wobbleAngle: Math.sin(time * 10) * 0.14 - game.boatTiltRoll * 0.5
                        }, time, true);

                        nameTagQueue.push({
                            x: ent.proj.x,
                            y: ent.proj.y - capR - 22,
                            name: "CAPTAIN COCONUT 🥥",
                            isCaptain: true
                        });
                    } else {
                        const ham = ent.ham;
                        let screenX = ent.proj.x;
                        let screenY = ent.proj.y;

                        // Perspective scale based on depth
                        const depthFactor = 0.92 + (ent.proj.depth / (boatRadius * 2)) * 0.18;
                        let scale = depthFactor;

                        if (ham.boardProgress < 1) {
                            const p = ham.boardProgress;
                            screenY -= Math.sin(p * Math.PI) * 110;
                            scale *= (0.5 + 0.5 * p);
                        } else {
                            screenY += Math.sin(time * 5 + ham.bobOffset) * 2.5;
                        }

                        drawHamsterCharacter(ctx, screenX, screenY, hamRadius * scale, ham, time, false);
                        nameTagQueue.push({
                            x: screenX,
                            y: screenY - hamRadius * scale - 14,
                            name: ham.name,
                            isCaptain: false
                        });
                    }
                });
            });

            // 3. Draw Eliminated Hamsters floating in the foreground water
            drawEliminatedSet(true);

            // 4. Render all student & captain name tags upright on top so they are 100% legible
            nameTagQueue.forEach(tag => {
                drawNameTag(tag.x, tag.y, tag.name, tag.isCaptain);
            });

            // 5. Draw Flying Eliminated Hamster (During Phase 4 High-Arc 3D Launch)
            if (game.flyingHamster) {
                const fh = game.flyingHamster;
                const t = fh.t;
                const curX = fh.startX + (fh.targetX - fh.startX) * t;
                const curY = fh.startY + (fh.targetY - fh.startY) * t - Math.sin(t * Math.PI) * 210;
                const zoomScale = 1 + Math.sin(t * Math.PI) * 0.72;

                fh.hamster.wobbleAngle = t * Math.PI * 6;
                fh.hamster.expression = 'shocked';
                drawHamsterCharacter(ctx, curX, curY, hamRadius * zoomScale, fh.hamster, time, false);
                drawNameTag(curX, curY - hamRadius * zoomScale - 18, fh.hamster.name, false);
            }

            // 6. Render Multi-Layered Water Splash & Confetti Particles
            game.particles.forEach(p => {
                ctx.save();
                ctx.globalAlpha = Math.max(0, Math.min(1, p.life / p.maxLife));
                ctx.fillStyle = p.color;
                ctx.beginPath();
                if (p.shape === 'rect') {
                    ctx.translate(p.x, p.y);
                    ctx.rotate(p.life * 8);
                    ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.6);
                } else {
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    ctx.fill();
                }
                ctx.restore();
            });

            // 7. Subtle Warm Sunlit Vignette Frame
            const vig = ctx.createRadialGradient(cx, h * 0.5, Math.min(w, h) * 0.38, cx, h * 0.5, Math.max(w, h) * 0.75);
            vig.addColorStop(0, 'rgba(255, 255, 255, 0)');
            vig.addColorStop(1, 'rgba(10, 46, 54, 0.16)');
            ctx.fillStyle = vig;
            ctx.fillRect(0, 0, w, h);
        }

        /********************************************************************
         * 7. GENUINE RANDOM SELECTION & ELIMINATION FLOW
         ********************************************************************/
        function startSpinRound() {
            const active = game.students.filter(s => !s.eliminated);
            if (active.length <= 1) {
                if (active.length === 1) declareChampion(active[0]);
                return;
            }

            document.getElementById('resultModal').classList.add('hidden');
            document.getElementById('resultModal').classList.remove('flex');

            active.forEach(h => {
                h.expression = 'happy';
                h.wobbleAngle = 0;
                h.curX = h.seatX;
                h.curY = h.seatY;
            });

            game.state = STATE.SLOW_SPIN;
            game.phaseTimer = 0;
            game.quoteTimer = 1.0;
            game.paused = false;
            setStatusText("🚣 NICE AND EASY… EVERYONE IS SAFE! 🐹");
            showPhaseBanner("Nice and easy… Everyone is safe! 🐹", 2000);
            sound.playPop(600);
            updateHUD();
        }

        function launchRandomVictim() {
            const active = game.students.filter(s => !s.eliminated);
            if (active.length === 0) return;

            // Genuine uniform random selection independent of seat position
            const randomIndex = Math.floor(Math.random() * active.length);
            const victim = active[randomIndex];
            game.selectedVictim = victim;

            const w = window.innerWidth;
            const h = window.innerHeight;
            const cx = w / 2;
            const cy = h * 0.57;
            const boatRadius = Math.min(w, h) * (w < 640 ? 0.34 : 0.31);

            // Compute victim's current 3D projected screen position inside the tilted boat
            const usableRadius = boatRadius * 0.80;
            const lx = victim.seatX * usableRadius;
            const ly = victim.seatY * usableRadius;
            const startProj = projectBoatPoint(lx, ly, -boatRadius * 0.2, cx, cy);

            // Compute target splash landing spot in the lagoon outside the boat
            const splashAngle = Math.atan2(startProj.y - cy, startProj.x - cx);
            const targetDist = boatRadius * 1.48;
            const targetX = cx + Math.cos(splashAngle) * targetDist;
            const targetY = cy + Math.sin(splashAngle) * targetDist * Math.sin(game.cameraPitch);

            victim.floatAngle = splashAngle;

            game.flyingHamster = {
                hamster: victim,
                startX: startProj.x,
                startY: startProj.y,
                targetX,
                targetY,
                t: 0
            };

            game.state = STATE.LAUNCHING;
            setStatusText("OH NOOOOO! 💦 SOMEONE IS FLYING OVER THE RIM!");
            showPhaseBanner("OH NOOOOO! 💦", 1400);
            sound.playFallWhistle();
        }

        function completeEliminationSplash() {
            const fh = game.flyingHamster;
            if (!fh) return;

            const victim = fh.hamster;
            victim.eliminated = true;
            victim.expression = 'happy';
            victim.wobbleAngle = 0;
            game.eliminatedOrder.push(victim.name);

            // Spawn Big Cartoon Water Splash & Bubbles
            spawnWaterSplash(fh.targetX, fh.targetY);
            sound.playBigSplash();

            game.flyingHamster = null;
            game.slowMoFactor = 1.0;

            // Reposition remaining hamsters neatly
            arrangeHamstersInBoat();
            game.students.filter(s => !s.eliminated).forEach(h => {
                h.expression = 'happy';
                h.wobbleAngle = 0;
            });

            updateHUD();

            const remaining = game.students.filter(s => !s.eliminated);
            if (remaining.length === 1) {
                // First show the eliminated student briefly, or if teacher prefers, show elimination modal then crown champion
                showEliminationModal(victim, true);
            } else {
                showEliminationModal(victim, false);
            }
        }

        function spawnWaterSplash(x, y) {
            const colors = ['#FFFFFF', '#CAF0F8', '#90E0EF', '#48CAE4'];
            for (let i = 0; i < 38; i++) {
                const ang = Math.random() * Math.PI * 2;
                const spd = 40 + Math.random() * 190;
                game.particles.push({
                    x,
                    y,
                    vx: Math.cos(ang) * spd,
                    vy: Math.sin(ang) * spd - 90,
                    gravity: 340,
                    size: 4 + Math.random() * 7,
                    color: colors[i % colors.length],
                    life: 0.6 + Math.random() * 0.5,
                    maxLife: 1.1,
                    shape: 'circle'
                });
            }
        }

        function spawnVictoryConfetti() {
            const w = window.innerWidth;
            const colors = ['#FF4D6D', '#FFD166', '#06D6A0', '#4CC9F0', '#F72585', '#FFBE0B'];
            for (let i = 0; i < 85; i++) {
                game.particles.push({
                    x: Math.random() * w,
                    y: -20 - Math.random() * 120,
                    vx: (Math.random() - 0.5) * 140,
                    vy: 90 + Math.random() * 160,
                    gravity: 80,
                    size: 8 + Math.random() * 6,
                    color: colors[i % colors.length],
                    life: 2.5 + Math.random() * 1.5,
                    maxLife: 4.0,
                    shape: 'rect'
                });
            }
        }

        function showEliminationModal(hamster, isPenultimate) {
            game.state = STATE.PAUSED_RESULT;
            setStatusText(`${hamster.name.toUpperCase()} HAS BEEN COCONUT-ED! 🥥`);

            // Draw cute portrait of the selected hamster
            pCtx.clearRect(0, 0, 144, 144);
            drawHamsterCharacter(pCtx, 72, 78, 42, hamster, performance.now() / 1000, false);

            document.getElementById('modalBadge').textContent = "OH NOOOOO! 💦 OUT YOU GO!";
            document.getElementById('modalBadge').className = "inline-block bg-rose-500 text-white cartoon-font text-xl px-5 py-1.5 rounded-full border-4 border-amber-950 -mt-12 shadow-md mb-3";
            document.getElementById('modalStudentName').textContent = hamster.name;
            document.getElementById('modalSubtext').textContent = "HAS BEEN COCONUT-ED! 🥥";

            document.getElementById('modalButtonsElimination').classList.remove('hidden');
            document.getElementById('modalButtonsElimination').classList.add('flex');
            document.getElementById('modalButtonsChampion').classList.add('hidden');

            const spinBtn = document.getElementById('btnModalSpinAgain');
            if (isPenultimate) {
                spinBtn.innerHTML = "<span>👑 CROWN FINAL CHAMPION!</span>";
            } else {
                spinBtn.innerHTML = "<span>SPIN AGAIN! 🥥</span>";
            }

            const modal = document.getElementById('resultModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');

            // Auto-continue mode support
            if (game.settings.autoMode) {
                setTimeout(() => {
                    if (game.state === STATE.PAUSED_RESULT) {
                        handleSpinAgainClick();
                    }
                }, 3200);
            }
        }

        function declareChampion(winner) {
            game.state = STATE.CHAMPION;
            winner.expression = 'crown';
            winner.seatX = 0;
            winner.seatY = 0;
            sound.playFanfare();
            spawnVictoryConfetti();

            setStatusText(`🏆 ${winner.name.toUpperCase()} IS THE COCONUT CHAMPION! 🏆`);

            pCtx.clearRect(0, 0, 144, 144);
            drawHamsterCharacter(pCtx, 72, 82, 42, winner, performance.now() / 1000, false);

            document.getElementById('modalBadge').textContent = "🏆 THE LAST HAMSTER STANDING! 🏆";
            document.getElementById('modalBadge').className = "inline-block bg-amber-400 text-amber-950 cartoon-font text-xl px-5 py-1.5 rounded-full border-4 border-amber-950 -mt-12 shadow-md mb-3";
            document.getElementById('modalStudentName').textContent = winner.name;
            document.getElementById('modalSubtext').textContent = "IS THE COCONUT CHAMPION! 👑🥥";

            document.getElementById('modalButtonsElimination').classList.add('hidden');
            document.getElementById('modalButtonsChampion').classList.remove('hidden');
            document.getElementById('modalButtonsChampion').classList.add('flex');

            const modal = document.getElementById('resultModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function handleSpinAgainClick() {
            const remaining = game.students.filter(s => !s.eliminated);
            if (remaining.length === 1) {
                declareChampion(remaining[0]);
            } else {
                game.round++;
                startSpinRound();
            }
        }

        /********************************************************************
         * 8. UI CONTROLS, BANNERS & TEACHER PANEL BINDINGS
         ********************************************************************/
        let bannerTimeout = null;
        function showPhaseBanner(text, duration = 1800) {
            const banner = document.getElementById('phaseBanner');
            const bannerText = document.getElementById('phaseBannerText');
            bannerText.textContent = text;
            banner.classList.remove('hidden');
            if (bannerTimeout) clearTimeout(bannerTimeout);
            bannerTimeout = setTimeout(() => {
                banner.classList.add('hidden');
            }, duration);
        }

        function setStatusText(text) {
            document.getElementById('hudStatusPill').textContent = text;
        }

        function updateHUD() {
            const total = game.students.length;
            const eliminatedCount = game.students.filter(s => s.eliminated).length;
            const aboardCount = total - eliminatedCount;

            document.getElementById('hudAboard').textContent = aboardCount;
            document.getElementById('hudEliminated').textContent = eliminatedCount;
            document.getElementById('hudRound').textContent = game.round;
            document.getElementById('drawerCountBadge').textContent = `${total} Students`;

            // Update pause button state
            const isSpinning = (game.state === STATE.SLOW_SPIN || game.state === STATE.CHAOS_SPIN);
            document.getElementById('btnPauseResume').disabled = !isSpinning;
            document.getElementById('btnStartGame').disabled = isSpinning || (game.state === STATE.LAUNCHING) || aboardCount <= 1;

            // Update eliminated order list in Teacher Drawer
            const elimContainer = document.getElementById('eliminatedListContainer');
            if (game.eliminatedOrder.length === 0) {
                elimContainer.innerHTML = '<span class="text-rose-400 italic">No hamsters splashed out yet!</span>';
            } else {
                elimContainer.innerHTML = game.eliminatedOrder.map((name, idx) =>
                    `<span class="bg-rose-200 text-rose-950 px-2.5 py-1 rounded-lg">#${idx + 1} ${name}</span>`
                ).join('');
            }
        }

        // Sync textarea with current student roster
        function syncTextareaFromStudents() {
            document.getElementById('studentTextarea').value = game.students.map(s => s.name).join('\n');
        }

        function applyStudentListFromTextarea() {
            const raw = document.getElementById('studentTextarea').value;
            const names = raw.split('\n').map(s => s.trim()).filter(Boolean);
            if (names.length < 2) {
                showPhaseBanner("Please enter at least 2 students! 🐹", 2200);
                return;
            }
            triggerBoardingAnimation(names);
        }

        // Event Listeners
        document.getElementById('btnWelcomePlay').addEventListener('click', () => {
            sound.init();
            sound.playPop(550);
            document.getElementById('welcomeOverlay').classList.add('hidden');
            triggerBoardingAnimation(game.students.map(s => s.name));
        });

        document.getElementById('btnWelcomeEdit').addEventListener('click', () => {
            sound.init();
            sound.playPop(480);
            document.getElementById('welcomeOverlay').classList.add('hidden');
            document.getElementById('teacherDrawer').classList.remove('translate-x-full');
        });

        document.getElementById('btnHome').addEventListener('click', () => {
            sound.playPop(450);
            document.getElementById('welcomeOverlay').classList.remove('hidden');
        });

        document.getElementById('btnStartGame').addEventListener('click', () => {
            startSpinRound();
        });

        document.getElementById('btnPauseResume').addEventListener('click', () => {
            if (game.state !== STATE.SLOW_SPIN && game.state !== STATE.CHAOS_SPIN) return;
            game.paused = !game.paused;
            document.getElementById('pauseBtnText').textContent = game.paused ? 'RESUME' : 'PAUSE';
            setStatusText(game.paused ? "⏸️ GAME PAUSED BY TEACHER" : "🚣 SPINNING IN PROGRESS...");
        });

        document.getElementById('btnShuffle').addEventListener('click', () => {
            sound.playPop(640);
            for (let i = game.students.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [game.students[i], game.students[j]] = [game.students[j], game.students[i]];
            }
            arrangeHamstersInBoat();
            showPhaseBanner("Positions Shuffled! 🔀", 1400);
        });

        document.getElementById('btnReset').addEventListener('click', () => {
            document.getElementById('resultModal').classList.add('hidden');
            document.getElementById('resultModal').classList.remove('flex');
            triggerBoardingAnimation(game.students.map(s => s.name));
        });

        document.getElementById('btnModalSpinAgain').addEventListener('click', () => {
            handleSpinAgainClick();
        });

        document.getElementById('btnModalStop').addEventListener('click', () => {
            sound.playPop(420);
            document.getElementById('resultModal').classList.add('hidden');
            document.getElementById('resultModal').classList.remove('flex');
            game.state = STATE.IDLE;
            setStatusText("READY FOR NEXT ROUND! 🥥");
            updateHUD();
        });

        document.getElementById('btnModalPlayAgain').addEventListener('click', () => {
            document.getElementById('resultModal').classList.add('hidden');
            document.getElementById('resultModal').classList.remove('flex');
            triggerBoardingAnimation(game.students.map(s => s.name));
        });

        // Teacher Drawer Controls
        document.getElementById('btnToggleDrawer').addEventListener('click', () => {
            sound.playPop(500);
            document.getElementById('teacherDrawer').classList.toggle('translate-x-full');
        });

        document.getElementById('btnCloseDrawer').addEventListener('click', () => {
            sound.playPop(420);
            document.getElementById('teacherDrawer').classList.add('translate-x-full');
        });

        document.getElementById('btnApplyRoster').addEventListener('click', () => {
            applyStudentListFromTextarea();
            document.getElementById('teacherDrawer').classList.add('translate-x-full');
        });

        document.getElementById('btnQuickAdd').addEventListener('click', () => {
            const input = document.getElementById('quickAddInput');
            const val = input.value.trim();
            if (!val) return;
            const current = document.getElementById('studentTextarea').value.trim();
            document.getElementById('studentTextarea').value = current ? (current + '\n' + val) : val;
            input.value = '';
            applyStudentListFromTextarea();
        });

        document.getElementById('quickAddInput').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') document.getElementById('btnQuickAdd').click();
        });

        document.getElementById('btnSampleClass').addEventListener('click', () => {
            document.getElementById('studentTextarea').value = DEFAULT_STUDENTS.join('\n');
            applyStudentListFromTextarea();
        });

        // Speed & Duration Setting Buttons
        document.querySelectorAll('.speed-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                game.settings.speedPreset = btn.dataset.speed;
                document.querySelectorAll('.speed-btn').forEach(b => {
                    b.className = "speed-btn py-2 rounded-xl font-bold text-sm border-2 border-amber-900 bg-amber-100 text-amber-900";
                });
                btn.className = "speed-btn py-2 rounded-xl font-bold text-sm border-2 border-amber-900 bg-amber-400 text-amber-950 shadow-inner";
                sound.playPop(580);
            });
        });

        document.querySelectorAll('.dur-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                game.settings.durationPreset = btn.dataset.duration;
                document.querySelectorAll('.dur-btn').forEach(b => {
                    b.className = "dur-btn py-2 rounded-xl font-bold text-sm border-2 border-amber-900 bg-amber-100 text-amber-900";
                });
                btn.className = "dur-btn py-2 rounded-xl font-bold text-sm border-2 border-amber-900 bg-amber-400 text-amber-950 shadow-inner";
                sound.playPop(580);
            });
        });

        document.getElementById('toggleAutoMode').addEventListener('change', (e) => {
            game.settings.autoMode = e.target.checked;
            sound.playPop(520);
        });

        // Sound, Music & Camera Perspective Toggles
        document.getElementById('btnCameraToggle').addEventListener('click', () => {
            const modes = ['side', 'dynamic', 'high'];
            const labels = {
                side: 'SIDE TILT',
                dynamic: 'DYNAMIC CAM',
                high: 'HIGH ANGLE'
            };
            const nextIdx = (modes.indexOf(game.cameraMode) + 1) % modes.length;
            game.cameraMode = modes[nextIdx];
            document.getElementById('cameraBtnText').textContent = labels[game.cameraMode];
            sound.playPop(660);
            showPhaseBanner(`🎥 Camera: ${labels[game.cameraMode]}`, 1200);
        });

        document.getElementById('btnSoundToggle').addEventListener('click', (e) => {
            sound.sfxEnabled = !sound.sfxEnabled;
            e.currentTarget.textContent = sound.sfxEnabled ? '🔊' : '🔇';
            if (sound.sfxEnabled) sound.playPop(600);
        });

        document.getElementById('btnMusicToggle').addEventListener('click', (e) => {
            const playing = sound.toggleMusic();
            e.currentTarget.className = playing
                ? "btn-cartoon bg-emerald-400 hover:bg-emerald-300 text-amber-950 w-11 h-11 rounded-2xl flex items-center justify-center text-xl"
                : "btn-cartoon bg-teal-400 hover:bg-teal-300 text-amber-950 w-11 h-11 rounded-2xl flex items-center justify-center text-xl";
        });

        // Initialize Default Roster & Start Animation Loop on Load
        window.onload = function () {
            document.getElementById('studentTextarea').value = DEFAULT_STUDENTS.join('\n');
            game.students = DEFAULT_STUDENTS.map((n, i) => createHamsterFromName(n, i));
            arrangeHamstersInBoat();
            updateHUD();
            requestAnimationFrame(gameLoop);
        };
    </script>
</body>
</html>