      showDropZonesHint = !showDropZonesHint;
      document.getElementById('btn-drop-hint').textContent = showDropZonesHint ? '🎯 Show Drop Zones: ON' : '🎯 Show Drop Zones: OFF';
      updateDropZonesVisibility();
