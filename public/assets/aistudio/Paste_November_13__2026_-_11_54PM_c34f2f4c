            DOM.ui.statusIcon.innerText = cfg.icon;
            DOM.ui.statusText.innerText = cfg.label;
            DOM.ui.subMessage.innerText = cfg.subMessage;
            DOM.ui.statusBadge.className = `glass-panel px-5 py-2 rounded-full flex items-center gap-2.5 border-2 bg-black/50 backdrop-blur-md transition-all duration-300 ${cfg.badgeBorder}`;
            DOM.ui.meterPill.className = `px-3 py-1 text-xs font-extrabold rounded-full border ${cfg.pillClass}`;
            DOM.ui.meterPill.innerText = `${cfg.icon} ${cfg.label}`;
            DOM.ui.meterFill.className = `h-full rounded-full bg-gradient-to-r ${cfg.barGradient} relative z-10`;

            // 3. Update Hamster SVG Character & Habitat Animations
            DOM.ui.postureSleep.classList.remove('hidden');
            DOM.ui.postureAwake.classList.add('hidden');
            DOM.ui.eyesClosed.classList.add('hidden');
            DOM.ui.eyesPeeking.classList.add('hidden');
            DOM.ui.eyesAlmost.classList.add('hidden');
            if (DOM.ui.mouthCalm) DOM.ui.mouthCalm.classList.remove('hidden');
            if (DOM.ui.mouthDisturbed) DOM.ui.mouthDisturbed.classList.add('hidden');
            DOM.ui.pawsRelaxed.classList.remove('hidden');
            DOM.ui.pawCoverEar.classList.add('hidden');
            if (DOM.ui.dreamBubble) DOM.ui.dreamBubble.classList.add('hidden');

            if (newState === SLEEP_STATES.DEEP_SLEEP || newState === SLEEP_STATES.RECOVERING) {
                DOM.ui.hamsterRoot.setAttribute('class', 'hamster-body-calm cursor-pointer');
                DOM.ui.eyesClosed.classList.remove('hidden');
                if (newState === SLEEP_STATES.DEEP_SLEEP && DOM.ui.dreamBubble) {
                    DOM.ui.dreamBubble.classList.remove('hidden');
                }
                DOM.ui.svgWheel.setAttribute('class', 'wheel-stationary');
                DOM.ui.svgStarToy.setAttribute('class', 'star-calm');
                DOM.ui.houseWarmGlow.setAttribute('opacity', '0.95');
            } else if (newState === SLEEP_STATES.LIGHT_SLEEP) {
                DOM.ui.hamsterRoot.setAttribute('class', 'hamster-body-calm cursor-pointer');
                DOM.ui.eyesClosed.classList.remove('hidden');
                if (DOM.ui.dreamBubble) DOM.ui.dreamBubble.classList.remove('hidden');
                DOM.ui.svgWheel.setAttribute('class', 'wheel-stationary');
                DOM.ui.svgStarToy.setAttribute('class', 'star-calm');
                DOM.ui.houseWarmGlow.setAttribute('opacity', '0.6');
            } else if (newState === SLEEP_STATES.DISTURBED) {
                DOM.ui.hamsterRoot.setAttribute('class', 'hamster-body-fast');
                DOM.ui.eyesPeeking.classList.remove('hidden');
                if (DOM.ui.mouthCalm) DOM.ui.mouthCalm.classList.add('hidden');
                if (DOM.ui.mouthDisturbed) DOM.ui.mouthDisturbed.classList.remove('hidden');
                DOM.ui.pawsRelaxed.classList.add('hidden');
                DOM.ui.pawCoverEar.classList.remove('hidden');
                DOM.ui.svgWheel.setAttribute('class', 'wheel-rocking');
                DOM.ui.svgStarToy.setAttribute('class', 'star-noisy');
                DOM.ui.houseWarmGlow.setAttribute('opacity', '0.35');
                playToneEffect('warning');
            } else if (newState === SLEEP_STATES.ALMOST_AWAKE) {
                DOM.ui.hamsterRoot.setAttribute('class', 'hamster-body-fast');
                DOM.ui.eyesAlmost.classList.remove('hidden');
                if (DOM.ui.mouthCalm) DOM.ui.mouthCalm.classList.add('hidden');
                if (DOM.ui.mouthDisturbed) DOM.ui.mouthDisturbed.classList.remove('hidden');
                DOM.ui.svgWheel.setAttribute('class', 'wheel-rocking');
                DOM.ui.svgStarToy.setAttribute('class', 'star-noisy');
                DOM.ui.houseWarmGlow.setAttribute('opacity', '0.15');
