        // Coat Color Customizer (4 Realistic Hamster Breeds)
        const COAT_STYLES = [
            { name: 'Golden Syrian', body: ['#fbd38d', '#dd842c', '#9c4221'], head: ['#f6ad55', '#c06c22', '#8c4215'] },
            { name: 'Cream Caramel', body: ['#fef3c7', '#eab308', '#a16207'], head: ['#fde68a', '#d97706', '#92400e'] },
            { name: 'Winter Pearl',  body: ['#ffffff', '#e2e8f0', '#94a3b8'], head: ['#f8fafc', '#cbd5e1', '#64748b'] },
            { name: 'Cocoa Bear',    body: ['#d6bcfa', '#78350f', '#451a03'], head: ['#a78bfa', '#78350f', '#3f1d0b'] }
        ];
        let currentCoatIdx = 0;

        DOM.controls.btnCoatStyle.addEventListener('click', () => {
            currentCoatIdx = (currentCoatIdx + 1) % COAT_STYLES.length;
            const coat = COAT_STYLES[currentCoatIdx];
            DOM.controls.uiCoatLabel.innerText = coat.name;
            DOM.ui.furStop1.setAttribute('stop-color', coat.body[0]);
            DOM.ui.furStop2.setAttribute('stop-color', coat.body[1]);
            DOM.ui.furStop3.setAttribute('stop-color', coat.body[2]);
            DOM.ui.headStop1.setAttribute('stop-color', coat.head[0]);
            DOM.ui.headStop2.setAttribute('stop-color', coat.head[1]);
            DOM.ui.headStop3.setAttribute('stop-color', coat.head[2]);
        });

        // Interactive Petting on Hamster Click
        DOM.ui.hamsterRoot.addEventListener('click', () => {
            const heart = document.createElement('div');
            heart.className = 'heart-particle';
            heart.innerText = '💖';
            heart.style.left = `${35 + Math.random() * 30}%`;
            heart.style.bottom = '25px';
            DOM.ui.particleLayer.appendChild(heart);
            setTimeout(() => { if (heart.parentNode) heart.parentNode.removeChild(heart); }, 1800);

            if (State.sustainedEnergy > 15) {
                State.sustainedEnergy = Math.max(8, State.sustainedEnergy - 15);
                updateNoiseMeterUI();
            }
        });

        // Drop Sunflower Seed / Veggie Treat into Bedding
        DOM.controls.btnDropTreat.addEventListener('click', () => {
            const x = 350 + Math.random() * 280;
            const y = 445 + Math.random() * 20;
            const isSeed = Math.random() > 0.4;
            const treat = document.createElementNS('http://www.w3.org/2000/svg', 'g');
            treat.setAttribute('transform', `translate(${x}, ${y})`);
            if (isSeed) {
                treat.innerHTML = `<ellipse cx="0" cy="0" rx="7" ry="4" transform="rotate(-20)" fill="#27272a" stroke="#fef08a" stroke-width="1.5"/>`;
            } else {
                treat.innerHTML = `<circle cx="0" cy="0" r="6" fill="#f97316" stroke="#fdba74" stroke-width="1.5"/>`;
            }
            DOM.ui.treatsLayer.appendChild(treat);
            if (DOM.ui.treatsLayer.children.length > 10) {
                DOM.ui.treatsLayer.removeChild(DOM.ui.treatsLayer.firstChild);
            }
            playToneEffect('star');
        });

        DOM.controls.btnSoundToggle.addEventListener('click', () => {
            State.soundEnabled = !State.soundEnabled;
            DOM.controls.iconSound.className = State.soundEnabled
                ? 'fas fa-volume-up text-app-accent'
                : 'fas fa-volume-mute text-gray-400';
            DOM.controls.btnSoundToggle.querySelector('span').innerText = State.soundEnabled ? 'Sound On' : 'Muted';
        });

        DOM.controls.btnPause.addEventListener('click', () => {
            State.isPaused = !State.isPaused;
            DOM.controls.btnPause.innerHTML = State.isPaused
                ? '<i class="fas fa-play"></i> Resume'
                : '<i class="fas fa-pause"></i> Pause';
        });

        DOM.controls.btnEnd.addEventListener('click', () => {
            State.timerSeconds = 0;
            State.sustainedEnergy = 8;
            State.simulatedLevel = 0;
            DOM.controls.simSlider.value = 0;
            updateClockUI();
            applySleepState(SLEEP_STATES.DEEP_SLEEP);
        });

        // Settings & Room Calibration Modal
        DOM.controls.btnOpenSettings.addEventListener('click', () => {
            DOM.screens.settingsModal.classList.remove('hidden');
            DOM.screens.settingsModal.classList.add('flex');
        });

        const closeSettings = () => {
            DOM.screens.settingsModal.classList.add('hidden');
            DOM.screens.settingsModal.classList.remove('flex');
        };
        DOM.controls.btnCloseModal.addEventListener('click', closeSettings);
        DOM.controls.btnSaveSettings.addEventListener('click', closeSettings);

        DOM.controls.sliderGain.addEventListener('input', (e) => {
            State.micGain = parseFloat(e.target.value);
            DOM.controls.uiGainVal.innerText = `${State.micGain.toFixed(1)}x`;
        });

        DOM.controls.sliderForgiveness.addEventListener('input', (e) => {
            State.forgivenessLevel = parseInt(e.target.value);
            const labels = { 1: 'Fast Reaction', 2: 'Balanced', 3: 'Very Forgiving' };
            DOM.controls.uiForgivenessVal.innerText = labels[State.forgivenessLevel];
        });

        DOM.controls.selectGoal.addEventListener('change', (e) => {
            State.goalSeconds = parseInt(e.target.value);
            DOM.ui.goalLabel.innerText = `Goal: ${formatTime(State.goalSeconds)}`;
        });

        // 3-Second Automatic Quiet Room Baseline Calibration
        DOM.controls.btnCalibrate.addEventListener('click', () => {
            if (!State.analyser) {
                DOM.controls.btnCalibrate.innerHTML = '<i class="fas fa-check"></i> Demo Mode Calibrated!';
                return;
            }
            DOM.controls.btnCalibrate.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sampling Quiet Room (3s)...';
            const samples = [];
            const sampleInterval = setInterval(() => {
                const buf = new Uint8Array(State.analyser.frequencyBinCount);
                State.analyser.getByteFrequencyData(buf);
                let sum = 0;
                for (let i = 2; i < 85; i++) sum += buf[i] * buf[i];
                samples.push(Math.sqrt(sum / 83));
            }, 100);

            setTimeout(() => {
                clearInterval(sampleInterval);
                if (samples.length > 0) {
                    const avgRms = samples.reduce((a, b) => a + b, 0) / samples.length;
                    State.noiseFloor = Math.min(45, Math.round(avgRms * 1.15));
                    DOM.controls.uiNoiseFloor.innerText = `+${State.noiseFloor} dB Filtered`;
                }
                DOM.controls.btnCalibrate.innerHTML = '<i class="fas fa-check text-app-green"></i> Room Calibrated!';
                setTimeout(() => {
                    DOM.controls.btnCalibrate.innerHTML = '<i class="fas fa-crosshairs"></i> Calibrate Quiet Room Now (3s)';
                }, 2000);
            }, 3000);
        });

        // Initialize Best Streak Display
        DOM.ui.bestStreak.innerText = formatTime(State.bestStreakSeconds);
    </script>
</body>
</html>