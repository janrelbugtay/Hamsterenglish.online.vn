        function applySleepState(newState) {
            State.currentState = newState;
            const cfg = STATE_PRESENTATION[newState];

            // 1. Update Enclosure Glow & Rim
            DOM.ui.habitat.className = `habitat-enclosure ${cfg.enclosureClass} w-full max-w-4xl h-full flex items-center justify-center relative overflow-visible`;
            DOM.ui.glowStop1.setAttribute('stop-color', cfg.glowColor);

