        /**
         * Connect Microphone with Vocal Bandpass/Highpass Filtering
         */
        async function requestMicrophone() {
            try {
                DOM.ui.micStatus.classList.remove('hidden');
                DOM.ui.micStatus.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Connecting to classroom microphone...';

                const stream = await navigator.mediaDevices.getUserMedia({
                    audio: {
                        echoCancellation: true,
                        noiseSuppression: false,
                        autoGainControl: false
                    },
                    video: false
                });

                State.audioContext = new (window.AudioContext || window.webkitAudioContext)();
                State.analyser = State.audioContext.createAnalyser();
                State.analyser.fftSize = 512;
                State.analyser.smoothingTimeConstant = 0.65;

                // Filter out low-frequency AC rumble (< 120Hz)
                State.highpassFilter = State.audioContext.createBiquadFilter();
                State.highpassFilter.type = 'highpass';
                State.highpassFilter.frequency.value = 120;

                State.microphone = State.audioContext.createMediaStreamSource(stream);
                State.microphone.connect(State.highpassFilter);
                State.highpassFilter.connect(State.analyser);

                DOM.ui.micStatus.classList.add('hidden');
                return true;
            } catch (err) {
                DOM.ui.micStatus.innerHTML = '<i class="fas fa-info-circle mr-1"></i> Mic unavailable — launching interactive Demo Mode!';
                State.demoMode = true;
                return true;
            }
        }

        async function startSession(useDemo = false) {
            State.demoMode = useDemo;
            if (!useDemo && !State.audioContext) {
                await requestMicrophone();
            }
            if (State.audioContext && State.audioContext.state === 'suspended') {
                await State.audioContext.resume();
            }

            State.isRunning = true;
            State.isPaused = false;
            State.timerSeconds = 0;
            State.earnedStars = 0;
            State.sustainedEnergy = 8;

            initAmbientDust();
            updateThresholdMarkers();
            updateClockUI();
            DOM.ui.bestStreak.innerText = formatTime(State.bestStreakSeconds);
            DOM.ui.stars.innerText = '0';

            DOM.screens.start.classList.add('opacity-0');
            setTimeout(() => {
                DOM.screens.start.classList.add('hidden');
                DOM.screens.app.classList.remove('opacity-0');
            }, 450);

            applySleepState(SLEEP_STATES.DEEP_SLEEP);

            if (animFrameId) cancelAnimationFrame(animFrameId);
            if (clockIntervalId) clearInterval(clockIntervalId);
            if (particleIntervalId) clearInterval(particleIntervalId);

            audioProcessingLoop();
            clockIntervalId = setInterval(tickClock, 1000);
            particleIntervalId = setInterval(spawnZParticle, 950);
        }

        /**
         * Advanced Classroom Audio Processing Loop
         * Separates transient spikes from sustained classroom noise
         */
        function audioProcessingLoop() {
            if (!State.isRunning) return;

            if (!State.isPaused) {
                let rawInput = 0;

                if (State.analyser && !State.demoMode) {
                    const bufferLength = State.analyser.frequencyBinCount;
                    const freqData = new Uint8Array(bufferLength);
                    State.analyser.getByteFrequencyData(freqData);

                    // Focus on human speech frequency bins (~150Hz to 4500Hz)
                    let speechSum = 0;
                    const startBin = 2;
                    const endBin = Math.min(85, bufferLength);
                    for (let i = startBin; i < endBin; i++) {
                        speechSum += freqData[i] * freqData[i];
                    }
                    const rms = Math.sqrt(speechSum / (endBin - startBin));

                    // Apply ambient noise floor subtraction & sensitivity gain
                    const adjustedRms = Math.max(0, rms - State.noiseFloor) * State.micGain;

                    // Logarithmic curve for natural dB-like classroom perception
                    rawInput = Math.min(100, Math.pow(adjustedRms / 115, 0.82) * 100);

                    // Update live mini spectrum bars
                    updateSpectrumBars(freqData);
                }

                // Combine with manual Test Noise Simulator slider if active
                rawInput = Math.max(rawInput, State.simulatedLevel);
                State.rawLevel = rawInput;

                // Asymmetric Attack & Release Filter (absorbs brief spikes like coughs or dropped books)
                const attackRates = { 1: 0.08, 2: 0.038, 3: 0.018 };
                const releaseRate = 0.028;
                const attackRate = attackRates[State.forgivenessLevel] || 0.038;

                if (rawInput > State.sustainedEnergy) {
                    // Dampen brief spikes: only climb steadily if noise persists
                    const delta = Math.min(rawInput - State.sustainedEnergy, 28);
                    State.sustainedEnergy += delta * attackRate;
                } else {
                    // Smooth recovery when students quiet down
                    State.sustainedEnergy -= (State.sustainedEnergy - rawInput) * releaseRate;
                }

                State.sustainedEnergy = Math.max(4, Math.min(100, State.sustainedEnergy));
                State.estimatedDb = Math.round(25 + (State.sustainedEnergy * 0.68));

                evaluateSleepState();
                updateNoiseMeterUI();
            }

            animFrameId = requestAnimationFrame(audioProcessingLoop);
        }

        function updateSpectrumBars(freqData) {
            const bars = DOM.ui.freqBars;
            if (!bars || !bars.length) return;
            for (let i = 0; i < bars.length; i++) {
                const val = freqData[i * 4 + 3] || 0;
                const heightPct = Math.max(15, Math.min(100, (val / 200) * 100));
                bars[i].style.height = `${heightPct}%`;
            }
        }

        /**
         * Evaluate Emotional Progression & Recovery System
         */
        function evaluateSleepState() {
            const t = State.settings.thresholds[State.settings.sensitivity];
            const energy = State.sustainedEnergy;

            // If Hamster is AWAKE, check if classroom has become quiet enough to enter RECOVERING
            if (State.currentState === SLEEP_STATES.AWAKE) {
                if (energy < t.disturbed) {
                    State.recoveryHoldFrames++;
                    if (State.recoveryHoldFrames > 75) { // ~1.2 seconds of quiet initiates recovery
                        State.recoveryHoldFrames = 0;
                        applySleepState(SLEEP_STATES.RECOVERING);
                    }
                } else {
                    State.recoveryHoldFrames = 0;
                }
                return;
            }

            // Determine target state from sustained classroom energy
            let nextState = SLEEP_STATES.DEEP_SLEEP;
            if (energy >= t.awake) {
                nextState = SLEEP_STATES.AWAKE;
            } else if (energy >= t.almost) {
                nextState = SLEEP_STATES.ALMOST_AWAKE;
            } else if (energy >= t.disturbed) {
                nextState = SLEEP_STATES.DISTURBED;
            } else if (energy >= t.light) {
                nextState = SLEEP_STATES.LIGHT_SLEEP;
            } else {
                // If recovering from a disturbed/awake state, show RECOVERING briefly before DEEP_SLEEP
                if (
                    (State.currentState === SLEEP_STATES.DISTURBED ||
                     State.currentState === SLEEP_STATES.ALMOST_AWAKE ||
                     State.currentState === SLEEP_STATES.RECOVERING) &&
                    energy > t.light * 0.65
                ) {
                    nextState = SLEEP_STATES.RECOVERING;
                } else {
                    nextState = SLEEP_STATES.DEEP_SLEEP;
                }
            }

            if (nextState !== State.currentState) {
                applySleepState(nextState);
            }
        }

