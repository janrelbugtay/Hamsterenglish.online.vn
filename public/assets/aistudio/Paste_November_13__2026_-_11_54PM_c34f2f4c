                DOM.ui.postureSleep.classList.add('hidden');
                DOM.ui.postureAwake.classList.remove('hidden');
                DOM.ui.svgWheel.setAttribute('class', 'wheel-spinning');
                DOM.ui.svgStarToy.setAttribute('class', 'star-noisy');
