<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Don't Wake the Hamster!</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Nunito', 'sans-serif'],
                    },
                    colors: {
                        app: {
                            bg: '#1a103c',       // Deep purple background
                            panel: '#2a1b54',    // Lighter purple for panels
                            glass: 'rgba(42, 27, 84, 0.6)',
                            glassBorder: 'rgba(255, 255, 255, 0.1)',
                            accent: '#a881ff',   // Soft violet highlight
                            text: '#e2d9f3',     // Off-white for text
                            
                            // Status Colors
                            green: '#4ade80',    // Deep Sleep
                            blue: '#60a5fa',     // Light Sleep
                            yellow: '#fbbf24',   // Disturbed
                            orange: '#f97316',   // Almost Awake
                            red: '#f87171',      // Awake
                        }
                    },
                    boxShadow: {
                        'glass': '0 8px 32px 0 rgba(0, 0, 0, 0.3)',
                        'glow-green': '0 0 15px rgba(74, 222, 128, 0.5)',
                        'glow-red': '0 0 25px rgba(248, 113, 113, 0.6)',
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background: radial-gradient(circle at 50% 20%, #2b195c 0%, #170d33 60%, #0d0720 100%);
            color: #e2d9f3;
            overflow: hidden;
            user-select: none;
        }

        /* Glassmorphism Utilities */
        .glass-panel {
            background: rgba(38, 23, 77, 0.65);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 12px 36px 0 rgba(0, 0, 0, 0.45);
        }

        /* 3D Glass Enclosure Habitat */
        .habitat-enclosure {
            position: relative;
            border-radius: 2.75rem;
            background: linear-gradient(180deg, rgba(67, 43, 125, 0.25) 0%, rgba(28, 17, 61, 0.65) 85%, #23144a 100%);
            border: 6px solid rgba(186, 154, 255, 0.35);
            box-shadow: 
                0 30px 70px rgba(0, 0, 0, 0.7),
                0 0 40px rgba(168, 129, 255, 0.18),
                inset 0 2px 25px rgba(255, 255, 255, 0.18),
                inset 0 -18px 35px rgba(18, 9, 43, 0.9);
            transition: border-color 0.6s ease, box-shadow 0.6s ease, transform 0.3s ease;
        }

        /* Top & Bottom Tank Rim */
        .tank-rim-top {
            position: absolute;
            top: -14px;
            left: 2%;
            right: 2%;
            height: 26px;
            background: linear-gradient(180deg, #a78bfa 0%, #7c3aed 45%, #4c1d95 100%);
            border-radius: 14px 14px 6px 6px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.55), inset 0 2px 4px rgba(255,255,255,0.45);
            z-index: 25;
        }
        .tank-lid-vent {
            position: absolute;
            top: -24px;
            left: 22%;
            right: 22%;
            height: 14px;
            background: linear-gradient(180deg, #6d28d9 0%, #4c1d95 100%);
            border-radius: 12px 12px 0 0;
            border-top: 2px solid rgba(255,255,255,0.3);
            z-index: 24;
        }

        .tank-rim-base {
            position: absolute;
            bottom: -16px;
            left: 0.5%;
            right: 0.5%;
            height: 34px;
            background: linear-gradient(180deg, #7c3aed 0%, #5b21b6 55%, #3b0764 100%);
            border-radius: 0.75rem 0.75rem 1.75rem 1.75rem;
            box-shadow: 0 18px 38px rgba(0,0,0,0.85), inset 0 3px 6px rgba(255,255,255,0.35);
            z-index: 25;
        }

        /* Realistic Glass Corner Pillars */
        .glass-pillar-left, .glass-pillar-right {
            position: absolute;
            top: 10px;
            bottom: 16px;
            width: 18px;
            background: linear-gradient(90deg, rgba(255,255,255,0.22), rgba(167,139,250,0.05), rgba(255,255,255,0.12));
            z-index: 22;
            pointer-events: none;
        }
        .glass-pillar-left { left: 6px; border-right: 1px solid rgba(255,255,255,0.15); }
        .glass-pillar-right { right: 6px; border-left: 1px solid rgba(255,255,255,0.15); }

        @keyframes waterBubble {
            0% { transform: translateY(0) scale(0.6); opacity: 0; }
            20% { opacity: 0.85; }
            90% { opacity: 0.85; }
            100% { transform: translateY(-95px) scale(1.25); opacity: 0; }
        }
        .water-bubble-anim {
            animation: waterBubble 4.5s ease-in infinite;
        }

        @keyframes heartFloat {
            0% { transform: translateY(0) scale(0.5); opacity: 0; }
            25% { opacity: 1; }
            100% { transform: translateY(-85px) scale(1.35); opacity: 0; }
        }
        .heart-particle {
            position: absolute;
            font-size: 1.5rem;
            animation: heartFloat 1.8s ease-out forwards;
            pointer-events: none;
            filter: drop-shadow(0 0 8px rgba(244,114,182,0.8));
        }

        /* State Glows for Enclosure */
        .state-deep.habitat-enclosure {
            border-color: rgba(74, 222, 128, 0.4);
            box-shadow: 0 30px 70px rgba(0,0,0,0.7), 0 0 50px rgba(74, 222, 128, 0.18), inset 0 2px 25px rgba(255,255,255,0.18);
        }
        .state-light.habitat-enclosure {
            border-color: rgba(96, 165, 250, 0.45);
            box-shadow: 0 30px 70px rgba(0,0,0,0.7), 0 0 50px rgba(96, 165, 250, 0.2), inset 0 2px 25px rgba(255,255,255,0.18);
        }
        .state-disturbed.habitat-enclosure {
            border-color: rgba(251, 191, 36, 0.55);
            box-shadow: 0 30px 70px rgba(0,0,0,0.7), 0 0 55px rgba(251, 191, 36, 0.25), inset 0 2px 25px rgba(255,251,235,0.2);
        }
        .state-almost.habitat-enclosure {
            border-color: rgba(249, 115, 22, 0.7);
            box-shadow: 0 30px 70px rgba(0,0,0,0.7), 0 0 65px rgba(249, 115, 22, 0.35), inset 0 0 35px rgba(249, 115, 22, 0.25);
            animation: enclosureShake 0.45s infinite;
        }
        .state-awake.habitat-enclosure {
            border-color: rgba(248, 113, 113, 0.85);
            box-shadow: 0 30px 70px rgba(0,0,0,0.7), 0 0 80px rgba(248, 113, 113, 0.5), inset 0 0 50px rgba(248, 113, 113, 0.3);
        }
        .state-recovering.habitat-enclosure {
            border-color: rgba(167, 139, 250, 0.55);
            box-shadow: 0 30px 70px rgba(0,0,0,0.7), 0 0 55px rgba(167, 139, 250, 0.25), inset 0 2px 25px rgba(255,255,255,0.18);
        }

        /* Animations */
        @keyframes enclosureShake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-2px); }
            75% { transform: translateX(2px); }
        }
        @keyframes hamsterBreathe {
            0%, 100% { transform: scale(1, 1) translateY(0); }
            50% { transform: scale(1.035, 0.97) translateY(2px); }
        }
        @keyframes hamsterBreatheFast {
            0%, 100% { transform: scale(1, 1) translateY(0); }
            50% { transform: scale(1.05, 0.95) translateY(3px); }
        }
        @keyframes earTwitch {
            0%, 88%, 100% { transform: rotate(0deg); }
            92% { transform: rotate(-14deg); }
            96% { transform: rotate(8deg); }
        }
        @keyframes starSwingCalm {
            0%, 100% { transform: rotate(-4deg); }
            50% { transform: rotate(4deg); }
        }
        @keyframes starSwingNoisy {
            0%, 100% { transform: rotate(-18deg); }
            50% { transform: rotate(18deg); }
        }
        @keyframes wheelRock {
            0%, 100% { transform: rotate(0deg); }
            30% { transform: rotate(12deg); }
            70% { transform: rotate(-8deg); }
        }
        @keyframes wheelSpin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        @keyframes floatZ {
            0% { transform: translateY(0) translateX(0) scale(0.4) rotate(-12deg); opacity: 0; }
            20% { opacity: 0.95; }
            50% { transform: translateY(-55px) translateX(14px) scale(1) rotate(8deg); opacity: 0.85; }
            100% { transform: translateY(-120px) translateX(-10px) scale(1.45) rotate(-8deg); opacity: 0; }
        }
        @keyframes floatDust {
            0%, 100% { transform: translateY(0) translateX(0); opacity: 0.25; }
            50% { transform: translateY(-18px) translateX(10px); opacity: 0.65; }
        }

        .hamster-body-calm {
            transform-origin: 500px 410px;
            animation: hamsterBreathe 4.2s ease-in-out infinite;
        }
        .hamster-body-fast {
            transform-origin: 500px 410px;
            animation: hamsterBreatheFast 1.6s ease-in-out infinite;
        }
        .hamster-ear-anim {
            transform-origin: 435px 285px;
            animation: earTwitch 4.5s infinite;
        }
        .star-calm {
            transform-origin: 690px 40px;
            animation: starSwingCalm 5s ease-in-out infinite;
        }
        .star-noisy {
            transform-origin: 690px 40px;
            animation: starSwingNoisy 1.1s ease-in-out infinite;
        }
        .wheel-stationary {
            transform-origin: 295px 255px;
        }
        .wheel-rocking {
            transform-origin: 295px 255px;
            animation: wheelRock 1.8s ease-in-out infinite;
        }
        .wheel-spinning {
            transform-origin: 295px 255px;
            animation: wheelSpin 1.4s linear infinite;
        }

        /* Sleep Bubble & Startled Shock Animations */
        @keyframes snotBubbleBreath {
            0%, 100% { transform: scale(0.72) rotate(-3deg); opacity: 0.82; }
            50% { transform: scale(1.18) rotate(4deg); opacity: 0.96; }
        }
        @keyframes shockPulse {
            0%, 100% { transform: scale(1) rotate(0deg); }
            50% { transform: scale(1.14) rotate(3deg); }
        }
        .sleep-snot-bubble {
            transform-origin: 486px 382px;
            animation: snotBubbleBreath 4.2s ease-in-out infinite;
        }
        .shock-sparks {
            transform-origin: 555px 195px;
            animation: shockPulse 0.45s ease-in-out infinite;
        }

        /* Particle Layer */
        .zzz-particle {
            position: absolute;
            color: #f5f3ff;
            font-family: 'Nunito', sans-serif;
            font-weight: 900;
            text-shadow: 0 0 14px rgba(168, 129, 255, 0.95), 0 2px 4px rgba(0,0,0,0.5);
            animation: floatZ linear forwards;
            pointer-events: none;
        }

        .dust-mote {
            position: absolute;
            border-radius: 999px;
            background: radial-gradient(circle, rgba(255,255,255,0.8) 0%, rgba(168,129,255,0) 70%);
            animation: floatDust 6s ease-in-out infinite;
            pointer-events: none;
        }

        /* Smooth Meter Fill */
        #noise-fill {
            transition: width 0.08s ease-out, background 0.3s ease;
        }
        #spike-marker {
            transition: left 0.05s linear, opacity 0.25s ease;
        }
    </style>
</head>

<body class="h-screen w-screen flex flex-col p-3 md:p-5 lg:p-6 antialiased select-none">

    <!-- START SCREEN OVERLAY -->
    <div id="start-screen" class="absolute inset-0 z-50 flex items-center justify-center bg-app-bg/95 backdrop-blur-xl transition-opacity duration-500 p-4">
        <div class="glass-panel p-8 md:p-10 rounded-3xl max-w-xl w-full text-center shadow-2xl border-app-accent/30 text-white relative overflow-hidden">
            <div class="absolute -top-24 -right-24 w-52 h-52 bg-app-accent rounded-full mix-blend-screen filter blur-3xl opacity-25"></div>
            <div class="absolute -bottom-24 -left-24 w-52 h-52 bg-pink-500 rounded-full mix-blend-screen filter blur-3xl opacity-20"></div>
            
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-gradient-to-br from-amber-300/20 to-purple-500/20 border border-white/15 shadow-inner mb-4 text-5xl">
                🐹
            </div>

            <h1 class="text-3xl md:text-4xl font-black mb-2 text-transparent bg-clip-text bg-gradient-to-r from-amber-200 via-purple-200 to-pink-300">
                Don't Wake the Hamster!
            </h1>
            <p class="text-base text-app-text/80 mb-6">Smart Classroom Noise Monitor & Interactive Habitat</p>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6 text-left">
                <div class="bg-black/25 p-3.5 rounded-2xl flex items-center gap-3.5 border border-white/10">
                    <div class="w-10 h-10 shrink-0 rounded-xl bg-app-green/20 flex items-center justify-center text-app-green"><i class="fas fa-shield-alt"></i></div>
                    <div>
                        <h3 class="font-bold text-sm">Smart Spike Filter</h3>
                        <p class="text-xs text-gray-400">Ignores brief coughs or dropped pencils.</p>
                    </div>
                </div>
                <div class="bg-black/25 p-3.5 rounded-2xl flex items-center gap-3.5 border border-white/10">
                    <div class="w-10 h-10 shrink-0 rounded-xl bg-app-accent/20 flex items-center justify-center text-app-accent"><i class="fas fa-heart"></i></div>
                    <div>
                        <h3 class="font-bold text-sm">Auto Recovery</h3>
                        <p class="text-xs text-gray-400">Get quiet again to help the hamster fall back asleep!</p>
                    </div>
                </div>
            </div>

            <div id="mic-status" class="mb-4 text-sm text-amber-300 bg-amber-500/10 border border-amber-400/20 py-2 px-4 rounded-xl hidden">
                <i class="fas fa-microphone mr-1"></i> Requesting microphone access...
            </div>

            <div class="flex flex-col sm:flex-row gap-3">
                <button id="btn-start" class="flex-1 py-4 bg-gradient-to-r from-purple-500 to-indigo-600 hover:from-purple-400 hover:to-indigo-500 text-white font-black text-lg rounded-2xl shadow-[0_6px_0_#4c1d95] active:translate-y-[4px] active:shadow-[0_2px_0_#4c1d95] transition-all flex justify-center items-center gap-2">
                    <i class="fas fa-microphone"></i> START WITH MIC
                </button>
                <button id="btn-start-sim" class="py-4 px-5 bg-white/10 hover:bg-white/15 border border-white/15 text-white font-bold text-sm rounded-2xl transition-all flex justify-center items-center gap-2" title="Test without a microphone">
                    <i class="fas fa-sliders-h"></i> Demo Mode
                </button>
            </div>
        </div>
    </div>

    <!-- CALIBRATION / AUDIO SETTINGS MODAL -->
    <div id="settings-modal" class="absolute inset-0 z-50 hidden items-center justify-center bg-black/70 backdrop-blur-md p-4">
        <div class="glass-panel p-6 md:p-8 rounded-3xl max-w-lg w-full text-white border border-white/15 shadow-2xl">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-2xl font-black flex items-center gap-2.5">
                    <i class="fas fa-sliders-h text-app-accent"></i> Smart Noise Engine Settings
                </h2>
                <button id="btn-close-modal" class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="space-y-5">
                <!-- Room Baseline Calibration -->
                <div class="bg-black/30 p-4 rounded-2xl border border-white/10">
                    <div class="flex justify-between items-center mb-2">
                        <div>
                            <h3 class="font-bold text-sm">Ambient Room Noise Floor</h3>
                            <p class="text-xs text-gray-400">Filters out AC hum, projector fans, or distant traffic.</p>
                        </div>
                        <span id="ui-noise-floor" class="font-mono font-bold text-app-accent text-sm">0 dB</span>
                    </div>
                    <button id="btn-calibrate" class="w-full mt-2 py-2.5 bg-app-accent/25 hover:bg-app-accent/40 border border-app-accent/50 rounded-xl font-bold text-sm transition flex items-center justify-center gap-2">
                        <i class="fas fa-crosshairs"></i> Calibrate Quiet Room Now (3s)
                    </button>
                </div>

                <!-- Microphone Gain Boost -->
                <div class="bg-black/30 p-4 rounded-2xl border border-white/10">
                    <div class="flex justify-between items-center mb-1">
                        <label class="font-bold text-sm">Microphone Sensitivity Gain</label>
                        <span id="ui-gain-val" class="font-mono text-xs font-bold text-app-green">1.0x</span>
                    </div>
                    <p class="text-xs text-gray-400 mb-3">Increase if your microphone is far from the students.</p>
                    <input id="slider-gain" type="range" min="0.4" max="2.5" step="0.1" value="1.0" class="w-full accent-purple-400 cursor-pointer">
                </div>

                <!-- Spike Forgiveness (Sustained Time) -->
                <div class="bg-black/30 p-4 rounded-2xl border border-white/10">
                    <div class="flex justify-between items-center mb-1">
                        <label class="font-bold text-sm">Spike Forgiveness (Sustained Filter)</label>
                        <span id="ui-forgiveness-val" class="font-mono text-xs font-bold text-amber-300">Balanced</span>
                    </div>
                    <p class="text-xs text-gray-400 mb-3">How long noise must continue before disturbing the hamster.</p>
                    <input id="slider-forgiveness" type="range" min="1" max="3" step="1" value="2" class="w-full accent-purple-400 cursor-pointer">
                    <div class="flex justify-between text-[10px] text-gray-400 font-bold mt-1">
                        <span>Fast Reaction</span>
                        <span>Balanced (Classroom)</span>
                        <span>Very Forgiving</span>
                    </div>
                </div>

                <!-- Session Goal -->
                <div class="flex items-center justify-between bg-black/30 p-4 rounded-2xl border border-white/10">
                    <div>
                        <h3 class="font-bold text-sm">Session Quiet Goal</h3>
                        <p class="text-xs text-gray-400">Target duration for class completion</p>
                    </div>
                    <select id="select-goal" class="bg-app-panel border border-white/15 rounded-xl px-3 py-2 text-sm font-bold text-white outline-none">
                        <option value="300">5 Minutes</option>
                        <option value="600">10 Minutes</option>
                        <option value="900">15 Minutes</option>
                        <option value="1800" selected>30 Minutes</option>
                    </select>
                </div>
            </div>

            <button id="btn-save-settings" class="w-full mt-6 py-3 bg-app-accent hover:bg-purple-500 text-white font-bold rounded-xl shadow-lg transition">
                Done
            </button>
        </div>
    </div>

    <!-- MAIN APP WRAPPER -->
    <div id="app-content" class="flex-1 flex flex-col max-w-7xl mx-auto w-full relative opacity-0 transition-opacity duration-700 justify-between">
        
        <!-- TOP HUD -->
        <header class="flex justify-between items-start z-30 shrink-0">
            <!-- Left: Current Quiet Time -->
            <div class="flex items-center gap-3">
                <div class="glass-panel px-5 py-2.5 rounded-2xl flex flex-col shadow-lg border-t border-white/15">
                    <span class="text-[11px] font-extrabold text-app-accent uppercase tracking-wider">Current Quiet Time</span>
                    <div class="flex items-baseline gap-2">
                        <span id="ui-current-time" class="text-3xl md:text-4xl font-black font-mono text-white drop-shadow">00:00</span>
                    </div>
                </div>
                <div class="glass-panel px-3.5 py-2 rounded-full hidden sm:inline-flex items-center gap-2 shadow-md">
                    <i class="fas fa-star text-app-yellow text-xs"></i>
                    <span id="ui-goal-label" class="text-xs font-bold text-gray-200">Goal: 30:00</span>
                </div>
            </div>

            <!-- Top Center: Floating Sleep Status Badge -->
            <div class="flex flex-col items-center">
                <div id="ui-status-badge" class="glass-panel px-5 py-2 rounded-full flex items-center gap-2.5 border-2 border-app-green/60 shadow-glow-green bg-black/50 backdrop-blur-md transition-all duration-300">
                    <span id="ui-status-icon" class="text-app-green text-lg">💤</span>
                    <span id="ui-status-text" class="font-extrabold text-white tracking-wide text-sm md:text-base">DEEP SLEEP</span>
                </div>
                <span id="ui-sub-message" class="text-xs font-bold text-purple-200/80 mt-1.5 tracking-wide transition-opacity duration-300">
                    The classroom is peaceful and quiet.
                </span>
            </div>

            <!-- Right: Best Streak & Sound Controls -->
            <div class="flex items-center gap-3">
                <button id="btn-sound-toggle" class="glass-panel px-3.5 py-2.5 rounded-2xl flex items-center gap-2 hover:bg-white/10 transition-colors text-xs font-bold text-gray-200" title="Toggle Gentle Sound Effects">
                    <i id="icon-sound" class="fas fa-volume-up text-app-accent"></i>
                    <span class="hidden md:inline">Sound On</span>
                </button>
                <div class="glass-panel px-5 py-2.5 rounded-2xl flex flex-col items-end shadow-lg border-t border-white/15">
                    <span class="text-[11px] font-extrabold text-app-accent uppercase tracking-wider">Best Streak</span>
                    <span id="ui-best-streak" class="text-2xl md:text-3xl font-black font-mono text-white/95">00:00</span>
                </div>
            </div>
        </header>

        <!-- CENTER: LIVING INTERACTIVE HAMSTER HABITAT -->
        <main class="flex-1 relative flex items-center justify-center my-2 min-h-[290px] max-h-[58vh]">
            
            <!-- Dynamic Classroom Warning Banner -->
            <div id="warning-msg" class="absolute z-40 top-3 left-1/2 transform -translate-x-1/2 bg-gradient-to-r from-orange-500 to-red-600 text-white px-7 py-3 rounded-2xl font-black text-lg md:text-xl shadow-[0_12px_35px_rgba(248,113,113,0.65)] border-2 border-white/30 opacity-0 -translate-y-3 transition-all duration-300 pointer-events-none text-center">
                ⚠️ Shhh... the hamster is waking up!
            </div>

            <!-- 3D Glass Enclosure -->
            <div id="habitat-wrapper" class="habitat-enclosure state-deep w-full max-w-4xl h-full flex items-center justify-center relative overflow-visible">
                
                <!-- Top & Bottom Purple Enclosure Caps & Ventilated Lid -->
                <div class="tank-lid-vent"></div>
                <div class="tank-rim-top"></div>
                <div class="tank-rim-base"></div>
                <div class="glass-pillar-left"></div>
                <div class="glass-pillar-right"></div>

                <!-- Inner Clipping Container for Scene -->
                <div class="relative w-full h-full overflow-hidden rounded-[2.4rem] flex items-center justify-center">
                    
                    <!-- Ambient Dust Motes -->
                    <div id="dust-layer" class="absolute inset-0 pointer-events-none z-10"></div>

                    <!-- Floating Zzz & Heart Particle Layer -->
                    <div id="particle-layer" class="absolute top-[10%] left-[42%] w-52 h-56 pointer-events-none z-20"></div>

                    <!-- Interactive SVG Habitat & Character -->
                    <svg id="habitat-svg" viewBox="0 0 1000 540" preserveAspectRatio="xMidYMid slice" class="w-full h-full select-none">
                        <defs>
                            <!-- Soft 3D Drop Shadows -->
                            <filter id="softShadow" x="-15%" y="-15%" width="130%" height="135%">
                                <feDropShadow dx="0" dy="8" stdDeviation="7" flood-color="#0d0521" flood-opacity="0.55"/>
