        function formatTime(totalSeconds) {
            const m = Math.floor(totalSeconds / 60).toString().padStart(2, '0');
            const s = (totalSeconds % 60).toString().padStart(2, '0');
            return `${m}:${s}`;
        }

        function tickClock() {
            if (State.isPaused || State.currentState === SLEEP_STATES.AWAKE) return;

            State.timerSeconds++;
            updateClockUI();

            if (State.timerSeconds > State.bestStreakSeconds) {
                State.bestStreakSeconds = State.timerSeconds;
                localStorage.setItem('hamsterBestStreak', State.bestStreakSeconds);
                DOM.ui.bestStreak.innerText = formatTime(State.bestStreakSeconds);
            }

            // Award 1 star every 5 minutes (300s) of quiet time
            const newStars = Math.floor(State.timerSeconds / 300);
            if (newStars > State.earnedStars) {
                State.earnedStars = newStars;
                DOM.ui.stars.innerText = State.earnedStars;
                playToneEffect('star');
            }
        }

        function updateClockUI() {
            const formatted = formatTime(State.timerSeconds);
            DOM.ui.timer.innerText = formatted;
            DOM.ui.sideTimer.innerText = formatted;
        }

        /**
         * Floating "Z" Symbol Generator
         */
        function spawnZParticle() {
            if (!State.isRunning || State.isPaused) return;
            if (
                State.currentState !== SLEEP_STATES.DEEP_SLEEP &&
                State.currentState !== SLEEP_STATES.LIGHT_SLEEP &&
                State.currentState !== SLEEP_STATES.RECOVERING
            ) {
                return;
            }

            const z = document.createElement('div');
            z.innerText = 'Z';
            z.className = 'zzz-particle';

            const offsetX = Math.random() * 36 - 18;
            z.style.left = `calc(40% + ${offsetX}px)`;
            z.style.bottom = '10px';

            const isDeep = State.currentState === SLEEP_STATES.DEEP_SLEEP;
            const sizeRem = isDeep ? (1.4 + Math.random() * 1.1) : (0.95 + Math.random() * 0.5);
            z.style.fontSize = `${sizeRem}rem`;

            const duration = isDeep ? (3.2 + Math.random() * 1.2) : 2.1;
            z.style.animationDuration = `${duration}s`;

            DOM.ui.particleLayer.appendChild(z);
            setTimeout(() => {
                if (z.parentNode) z.parentNode.removeChild(z);
            }, duration * 1000);
        }

