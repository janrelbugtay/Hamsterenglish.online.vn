            const archGroup = new THREE.Group();
            archGroup.position.copy(position);

            const pillarMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, metalness: 0.5, roughness: 0.4 });
            const leftPost = new THREE.Mesh(new THREE.CylinderGeometry(0.25, 0.25, 7, 10), pillarMat);
            leftPost.position.set(-4.2, 2.5, 0);
            const rightPost = new THREE.Mesh(new THREE.CylinderGeometry(0.25, 0.25, 7, 10), pillarMat);
            rightPost.position.set(4.2, 2.5, 0);
            archGroup.add(leftPost, rightPost);

            // 3D Floating Left & Right Answer Signboards above the branching rails
            const signCanvasL = createAnswerSignCanvas(questionObj.leftText, '#0284c7', '◀ LEFT');
            const signTexL = new THREE.CanvasTexture(signCanvasL);
            const signL = new THREE.Mesh(
                new THREE.PlaneGeometry(3.8, 2.0),
                new THREE.MeshBasicMaterial({ map: signTexL, side: THREE.DoubleSide })
            );
            signL.position.set(-2.3, 4.3, 0);
            archGroup.add(signL);

            const signCanvasR = createAnswerSignCanvas(questionObj.rightText, '#e11d48', 'RIGHT ▶');
            const signTexR = new THREE.CanvasTexture(signCanvasR);
            const signR = new THREE.Mesh(
                new THREE.PlaneGeometry(3.8, 2.0),
                new THREE.MeshBasicMaterial({ map: signTexR, side: THREE.DoubleSide })
            );
            signR.position.set(2.3, 4.3, 0);
            archGroup.add(signR);

            return archGroup;
        }

        function createAnswerSignCanvas(text, bgColor, label) {
            const c = document.createElement('canvas');
            c.width = 512;
            c.height = 256;
            const ctx = c.getContext('2d');

            ctx.fillStyle = bgColor;
            ctx.beginPath();
            if (ctx.roundRect) {
                ctx.roundRect(12, 12, 488, 232, 36);
            } else {
                ctx.rect(12, 12, 488, 232);
            }
            ctx.fill();
            ctx.lineWidth = 10;
            ctx.strokeStyle = '#ffffff';
            ctx.stroke();

            ctx.fillStyle = 'rgba(255,255,255,0.85)';
            ctx.font = 'bold 34px Inter, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(label, 256, 68);

            ctx.fillStyle = '#ffffff';
            ctx.font = '900 64px Fredoka, sans-serif';
            ctx.fillText(String(text).slice(0, 14), 256, 165);
            return c;
        }

        // Generate the entire roller coaster course with 8 question forks
        function generateCoasterCourse() {
            while (trackMeshGroup.children.length > 0) {
                trackMeshGroup.remove(trackMeshGroup.children[0]);
            }
            gateCheckpoints = [];
            gate3DSigns = [];

            const pts = [];
            let curX = 0;
            let curY = 4.5;
            let curZ = 25;

            // Initial Lift Hill (matching reference image climb toward the arch)
            pts.push(new THREE.Vector3(0, 3.8, 28));
            pts.push(new THREE.Vector3(0, 6.2, 12));
            pts.push(new THREE.Vector3(0, 10.5, -6));
            pts.push(new THREE.Vector3(0, 13.8, -22));

            curZ = -22;
            curY = 13.8;

            const numGates = activeDeck.length;

            for (let g = 0; g < numGates; g++) {
                const qItem = activeDeck[g];
                const correctSide = Math.random() < 0.5 ? -1 : 1; // -1 = Left, +1 = Right
                const leftText = correctSide === -1 ? qItem.correct : qItem.wrong;
                const rightText = correctSide === 1 ? qItem.correct : qItem.wrong;

                // Straight approach before the fork
                const approachZ = curZ - 18;
                const approachPt = new THREE.Vector3(curX, curY, approachZ);
                pts.push(approachPt);

                const forkZ = approachZ - 14;
                const forkPt = new THREE.Vector3(curX, curY - 1.2, forkZ);
                pts.push(forkPt);

                // The intact branch bends toward `correctSide`
                const branchX = curX + correctSide * 6.5;
                const peakOrDipY = g % 2 === 0 ? Math.max(5.5, curY - 4.5) : Math.min(18, curY + 4.5);
                const postForkZ = forkZ - 20;
                const intactPt = new THREE.Vector3(branchX, peakOrDipY, postForkZ);
                pts.push(intactPt);

                // Build the WRONG broken track branch curving the opposite way and ending in mid-air!
                const wrongSide = -correctSide;
                const wrongPts = [
                    forkPt.clone(),
                    new THREE.Vector3(curX + wrongSide * 2.8, curY - 1.5, forkZ - 7),
                    new THREE.Vector3(curX + wrongSide * 6.2, curY - 2.2, forkZ - 15)
                ];
                const wrongCurve = new THREE.CatmullRomCurve3(wrongPts);
                const wrongMesh = buildDetailedTrackSegment(wrongCurve, 18, false, true);
                trackMeshGroup.add(wrongMesh);

                gateCheckpoints.push({
                    index: g,
                    question: qItem.q,
                    correctAnswer: qItem.correct,
                    leftText,
                    rightText,
                    correctSide,
                    forkWorldPos: forkPt.clone(),
                    wrongCurve,
                    resolved: false,
                    promptShown: false
                });

                curX = branchX;
                curY = peakOrDipY;
                curZ = postForkZ;
            }

            // Finale victory hill
            pts.push(new THREE.Vector3(curX, curY + 3, curZ - 25));
            pts.push(new THREE.Vector3(curX, curY, curZ - 50));

            mainCurve = new THREE.CatmullRomCurve3(pts);
            const mainTrackMesh = buildDetailedTrackSegment(mainCurve, 340, true, false);
            trackMeshGroup.add(mainTrackMesh);

            // Compute normalized curve `t` parameter for each gate fork
            const totalSamples = 600;
            gateCheckpoints.forEach(gate => {
                let bestT = 0;
                let bestDist = Infinity;
                for (let s = 0; s <= totalSamples; s++) {
                    const t = s / totalSamples;
                    const p = mainCurve.getPointAt(t);
                    const dist = p.distanceTo(gate.forkWorldPos);
                    if (dist < bestDist) {
                        bestDist = dist;
                        bestT = t;
                    }
                }
                gate.forkT = bestT;
                gate.promptStartT = Math.max(0.02, bestT - 0.072);

                const arch = create3DGateArch(gate.forkWorldPos, gate.index, gate);
                trackMeshGroup.add(arch);
                gate3DSigns.push(arch);
            });
        }

        /********************************************************************
         * 7. CONFETTI / SPARKS PARTICLE BURST ON CORRECT GATE
         ********************************************************************/
        const particles = [];
        function spawnCelebrationSparks(origin) {
            const colors = [0xfacc15, 0x38bdf8, 0x4ade80, 0xf43f5e, 0xa855f7];
            for (let i = 0; i < 32; i++) {
                const mat = new THREE.MeshBasicMaterial({ color: colors[i % colors.length] });
                const mesh = new THREE.Mesh(new THREE.BoxGeometry(0.28, 0.28, 0.28), mat);
                mesh.position.copy(origin).add(new THREE.Vector3(0, 1.5, -2));
                const vel = new THREE.Vector3(
                    (Math.random() - 0.5) * 14,
                    4 + Math.random() * 10,
                    (Math.random() - 0.5) * 12
                );
                scene.add(mesh);
                particles.push({ mesh, vel, life: 1.1 });
            }
        }

        function updateParticles(dt) {
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.life -= dt;
                p.vel.y -= 18 * dt;
                p.mesh.position.addScaledVector(p.vel, dt);
                p.mesh.rotation.x += 5 * dt;
                p.mesh.rotation.y += 5 * dt;
                if (p.life <= 0) {
                    scene.remove(p.mesh);
                    particles.splice(i, 1);
                }
            }
        }

        /********************************************************************
         * 8. CONTROLS: TABLET GYROSCOPE TILT + TOUCH RINGS + KEYBOARD
         ********************************************************************/
        let steeringChoice = 0; // -1 = Left, 0 = Center, +1 = Right
        let smoothSteerAngle = 0; // Continuous value [-1, 1] for visual lean & meter
        let tiltSensorEnabled = false;

        function setSteeringChoice(dir) {
            ensureAudio();
            steeringChoice = dir;
            smoothSteerAngle = dir;
            playTone(dir < 0 ? 420 : 520, 'sine', 0.07, 0.1);
            updateSteeringUI();
        }

        function updateSteeringUI() {
            const dot = document.getElementById('tilt-indicator-dot');
            const label = document.getElementById('steer-direction-label');
            const wheelL = document.getElementById('wheel-left');
            const wheelR = document.getElementById('wheel-right');
            const cardL = document.getElementById('choice-left-card');
            const cardR = document.getElementById('choice-right-card');
            const badgeL = document.getElementById('left-lock-badge');
            const badgeR = document.getElementById('right-lock-badge');

            const pct = 50 + smoothSteerAngle * 38;
            dot.style.left = `calc(${pct}% - 10px)`;

            wheelL.classList.toggle('active-left', steeringChoice === -1);
            wheelR.classList.toggle('active-right', steeringChoice === 1);

            cardL.classList.toggle('selected', steeringChoice === -1);
            cardR.classList.toggle('selected', steeringChoice === 1);
            badgeL.classList.toggle('hidden', steeringChoice !== -1);
            badgeR.classList.toggle('hidden', steeringChoice !== 1);

            if (steeringChoice === -1) {
                label.textContent = "STEERING: ◀ LEFT TRACK LOCKED";
                label.className = "text-[11px] font-extrabold uppercase tracking-wider text-sky-300 mt-1 drop-shadow";
            } else if (steeringChoice === 1) {
                label.textContent = "STEERING: RIGHT TRACK LOCKED ▶";
                label.className = "text-[11px] font-extrabold uppercase tracking-wider text-rose-300 mt-1 drop-shadow";
            } else {
                label.textContent = "STEERING: CENTER (TILT OR TAP!)";
                label.className = "text-[11px] font-extrabold uppercase tracking-wider text-amber-300 mt-1 drop-shadow";
            }
        }

        // Keyboard A/D & Left/Right Arrow Support
        window.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') {
                setSteeringChoice(-1);
            } else if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') {
                setSteeringChoice(1);
            }
        });

        // Tablet / Mobile DeviceOrientation Tilt Handler
        function handleOrientation(event) {
            // Depending on portrait vs landscape tablet orientation, use gamma or beta
            const isLandscape = window.innerWidth > window.innerHeight;
            let rawTilt = isLandscape ? event.beta : event.gamma;
            if (rawTilt === null || rawTilt === undefined) return;

            // Clamp tilt between -25 deg and +25 deg
            const normalized = Math.max(-1, Math.min(1, rawTilt / 18));
            smoothSteerAngle = normalized;

            if (normalized < -0.28) {
                if (steeringChoice !== -1) {
                    steeringChoice = -1;
                }
            } else if (normalized > 0.28) {
                if (steeringChoice !== 1) {
                    steeringChoice = 1;
                }
            }
            updateSteeringUI();
        }

        async function requestTiltPermission() {
            ensureAudio();
            const statusText = document.getElementById('tilt-status-text');
            try {
                if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function') {
                    const response = await DeviceOrientationEvent.requestPermission();
                    if (response === 'granted') {
                        window.addEventListener('deviceorientation', handleOrientation, true);
                        tiltSensorEnabled = true;
                        statusText.textContent = "Tablet Tilt Active ✓";
                    } else {
                        statusText.textContent = "Touch Mode Active";
                    }
                } else if ('DeviceOrientationEvent' in window) {
                    window.addEventListener('deviceorientation', handleOrientation, true);
                    tiltSensorEnabled = true;
                    statusText.textContent = "Tablet Tilt Active ✓";
                } else {
                    statusText.textContent = "Touch / Keys Active";
                }
            } catch (err) {
                statusText.textContent = "Touch / Keys Active";
            }
        }

        // Automatically attach listener on non-iOS tablets
        if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission !== 'function') {
            window.addEventListener('deviceorientation', handleOrientation, true);
        }

        /********************************************************************
         * 9. GAME STATE MACHINE & COASTER PHYSICS LOOP
         ********************************************************************/
        // States: 'COUNTDOWN', 'RIDING', 'WRONG_BRANCH', 'FALLING', 'CRASHED', 'VICTORY'
        let gameState = 'COUNTDOWN';
        let countdownTimer = 4.0;
        let lastCountdownInt = 5;

        let trackProgressT = 0.0;
        let baseSpeedT = 0.026; // Normalized curve speed
        let wrongBranchT = 0.0;
        let activeGateIndex = 0;

        // Free-fall physics state when derailing off the broken track
        let fallPosition = new THREE.Vector3();
        let fallVelocity = new THREE.Vector3();
        let fallRotation = new THREE.Euler();
        let fallTimer = 0;

        function startCountdownSequence() {
            gameState = 'COUNTDOWN';
            countdownTimer = 4.0;
            lastCountdownInt = 5;
            document.getElementById('countdown-overlay').classList.remove('hidden');
            document.getElementById('countdown-title').textContent = 'GET READY';
            document.getElementById('countdown-digit').textContent = '4';
            document.getElementById('question-hud').classList.add('opacity-0', 'scale-90');
            document.getElementById('vignette-overlay').classList.add('opacity-0');
        }

        function showGatePrompt(gate) {
            gate.promptShown = true;
            steeringChoice = 0;
            smoothSteerAngle = 0;
            updateSteeringUI();

            document.getElementById('hud-progress').textContent = `${gate.index + 1}/${gateCheckpoints.length}`;
            document.getElementById('question-text').textContent = gate.question;
            document.getElementById('choice-left-text').textContent = gate.leftText;
            document.getElementById('choice-right-text').textContent = gate.rightText;

            const qHud = document.getElementById('question-hud');
            qHud.classList.remove('opacity-0', 'scale-90');
            qHud.classList.add('opacity-100', 'scale-100');
        }

        function hideGatePrompt() {
            const qHud = document.getElementById('question-hud');
            qHud.classList.remove('opacity-100', 'scale-100');
            qHud.classList.add('opacity-0', 'scale-90');
        }

        function retryFromCheckpoint() {
            document.getElementById('crash-modal').classList.add('hidden');
            document.getElementById('crash-modal').classList.remove('flex');
            document.getElementById('vignette-overlay').classList.add('opacity-0');

            const gate = gateCheckpoints[activeGateIndex];
            if (gate) {
                gate.resolved = false;
                gate.promptShown = false;
                trackProgressT = Math.max(0.01, gate.promptStartT - 0.015);
            } else {
                trackProgressT = 0;
            }
            steeringChoice = 0;
            smoothSteerAngle = 0;
            updateSteeringUI();
            gameState = 'RIDING';
        }

        function restartFullRide() {
            document.getElementById('crash-modal').classList.add('hidden');
            document.getElementById('crash-modal').classList.remove('flex');
            document.getElementById('victory-modal').classList.add('hidden');
            document.getElementById('victory-modal').classList.remove('flex');
            document.getElementById('vignette-overlay').classList.add('opacity-0');

            score = 0;
            activeGateIndex = 0;
            trackProgressT = 0.0;
            steeringChoice = 0;
            smoothSteerAngle = 0;
            document.getElementById('hud-score').textContent = '0';

            buildQuestionDeck();
            generateCoasterCourse();
            document.getElementById('hud-progress').textContent = `1/${gateCheckpoints.length}`;
            updateSteeringUI();
            startCountdownSequence();
        }

        // Position Camera along a 3D spline with realistic coaster banking & subtle 2D bumper tilt
        function positionCameraOnCurve(curve, t, extraRoll = 0) {
            const clampedT = Math.max(0, Math.min(0.999, t));
            const pos = curve.getPointAt(clampedT);
            const tangent = curve.getTangentAt(clampedT).normalize();

            // Place camera slightly above the rails looking down the coaster track ahead
            const eyePos = pos.clone().add(new THREE.Vector3(0, 1.45, 0));
            camera.position.copy(eyePos);

            const lookTarget = eyePos.clone().add(tangent.clone().multiplyScalar(12)).add(new THREE.Vector3(0, -0.85, 0));
            camera.lookAt(lookTarget);

            // Apply tablet/steering lean roll to camera and subtle tilt to low-profile 2D bumper
            camera.rotateZ(-extraRoll * 0.22);
            if (coasterBumperEl) {
                coasterBumperEl.style.transform = `rotate(${-extraRoll * 3.5}deg) translateY(6px)`;
            }
        }

        let prevTime = performance.now();

        function animate(now) {
            requestAnimationFrame(animate);
            const dt = Math.min(0.05, (now - prevTime) / 1000);
            prevTime = now;

            // Rotate background Ferris Wheel & Carousel
            if (ferrisWheelRotor) {
                ferrisWheelRotor.rotation.z += 0.14 * dt;
            }
            if (carouselRotor) {
                carouselRotor.rotation.y += 0.45 * dt;
            }

            updateParticles(dt);

            if (gameState === 'COUNTDOWN') {
                // Slowly crawl up the initial lift hill during 4-3-2-1 countdown
                trackProgressT = Math.min(0.04, trackProgressT + 0.006 * dt);
                positionCameraOnCurve(mainCurve, trackProgressT, smoothSteerAngle);
                playChainClack();

                countdownTimer -= dt;
                const ceilInt = Math.ceil(countdownTimer);
                if (ceilInt !== lastCountdownInt && ceilInt >= 1) {
                    lastCountdownInt = ceilInt;
                    document.getElementById('countdown-digit').textContent = String(ceilInt);
                    playTone(440 + (4 - ceilInt) * 60, 'sine', 0.12, 0.18);
                }

                if (countdownTimer <= 0) {
                    playTone(880, 'triangle', 0.3, 0.25);
                    document.getElementById('countdown-overlay').classList.add('hidden');
                    gameState = 'RIDING';
                }
            } else if (gameState === 'RIDING') {
                // Determine speed based on slope
                const tangent = mainCurve.getTangentAt(Math.min(0.99, trackProgressT));
                const slopeFactor = 1.0 - tangent.y * 0.45;
                const currentSpeed = baseSpeedT * Math.max(0.65, slopeFactor);

                // Play lift hill clack when climbing
                if (tangent.y > 0.15) {
                    playChainClack();
                }

                trackProgressT += currentSpeed * dt;
                positionCameraOnCurve(mainCurve, trackProgressT, smoothSteerAngle);

                // Check current active gate
                const gate = gateCheckpoints[activeGateIndex];
                if (gate && !gate.resolved) {
                    if (!gate.promptShown && trackProgressT >= gate.promptStartT) {
                        showGatePrompt(gate);
                    }

                    if (gate.promptShown) {
                        // Update remaining distance timer bar
                        const totalWindow = gate.forkT - gate.promptStartT;
                        const remaining = Math.max(0, (gate.forkT - trackProgressT) / totalWindow);
                        document.getElementById('question-timer-bar').style.width = `${remaining * 100}%`;
                    }

                    // Reached the Y-junction fork!
                    if (trackProgressT >= gate.forkT) {
                        gate.resolved = true;
                        hideGatePrompt();

                        if (steeringChoice === gate.correctSide) {
                            // CORRECT ANSWER! Stay on main coaster track
                            score += 100;
                            document.getElementById('hud-score').textContent = String(score);
                            playCorrectChime();
                            spawnCelebrationSparks(camera.position);
                            activeGateIndex++;
                        } else {
                            // WRONG ANSWER (or failed to lean)! Switch onto broken rail branch!
                            gameState = 'WRONG_BRANCH';
                            wrongBranchCurve = gate.wrongCurve;
                            wrongBranchT = 0.0;
                            document.getElementById('vignette-overlay').classList.remove('opacity-0');
                            playTone(220, 'sawtooth', 0.35, 0.22, 130);
                        }
                    }
                }

                // Reached the end of the entire coaster course!
                if (trackProgressT >= 0.97) {
                    gameState = 'VICTORY';
                    playCorrectChime();
                    document.getElementById('victory-score').textContent = `${score} PTS`;
                    document.getElementById('victory-modal').classList.remove('hidden');
                    document.getElementById('victory-modal').classList.add('flex');
                }
            } else if (gameState === 'WRONG_BRANCH') {
                // Ride along the short broken spur track until it runs out of rails!
                wrongBranchT += 0.85 * dt;
                positionCameraOnCurve(wrongBranchCurve, Math.min(1, wrongBranchT), smoothSteerAngle);

                if (wrongBranchT >= 1.0) {
                    // Plunge off the broken track cliff!
                    gameState = 'FALLING';
                    fallTimer = 0;
                    const endPt = wrongBranchCurve.getPointAt(1).add(new THREE.Vector3(0, 1.35, 0));
                    const endTan = wrongBranchCurve.getTangentAt(1).normalize();
                    fallPosition.copy(endPt);
                    fallVelocity.copy(endTan).multiplyScalar(22);
                    fallRotation.copy(camera.rotation);
                    playFallScreamAndCrash();
                }
            } else if (gameState === 'FALLING') {
                fallTimer += dt;
                // Gravity accelerates the coaster car downward toward the park ground
                fallVelocity.y -= 34 * dt;
                fallPosition.addScaledVector(fallVelocity, dt);

                camera.position.copy(fallPosition);
                // Dramatic tumbling pitch & roll as the coaster falls
                camera.rotation.x -= 1.4 * dt;
                camera.rotation.z += (steeringChoice || 1) * 1.8 * dt;

                if (fallPosition.y <= 1.8 || fallTimer > 1.65) {
                    gameState = 'CRASHED';
                    const gate = gateCheckpoints[activeGateIndex];
                    const crashTitle = document.getElementById('crash-title');
                    const crashReason = document.getElementById('crash-reason');

                    if (steeringChoice === 0) {
                        crashTitle.textContent = "TOO SLOW! YOU FELL OFF!";
                        crashReason.textContent = "You didn't lean Left or Right before the track split!";
                    } else {
                        crashTitle.textContent = "WRONG TRACK! YOU FELL!";
                        crashReason.textContent = `You steered onto the broken rail for "${gate ? gate.question : ''}"`;
                    }
                    document.getElementById('crash-correct-answer').textContent = gate ? gate.correctAnswer : '';
                    document.getElementById('crash-modal').classList.remove('hidden');
                    document.getElementById('crash-modal').classList.add('flex');
                }
            }

            renderer.render(scene, camera);
        }

        /********************************************************************
         * 10. TEACHER / CUSTOM QUESTION EDITOR MODAL
         ********************************************************************/
        function openQuestionModal() {
            renderCustomQuestionsList();
            document.getElementById('question-modal').classList.remove('hidden');
            document.getElementById('question-modal').classList.add('flex');
        }

        function closeQuestionModal() {
            document.getElementById('question-modal').classList.add('hidden');
            document.getElementById('question-modal').classList.remove('flex');
        }

        function renderCustomQuestionsList() {
            const listEl = document.getElementById('custom-questions-list');
            listEl.innerHTML = '';
            QUESTION_BANK.custom.forEach((item, idx) => {
                const row = document.createElement('div');
                row.className = "bg-slate-800/80 border border-white/10 rounded-xl p-3 flex items-center justify-between gap-2";
                row.innerHTML = `
                    <div class="text-xs sm:text-sm text-white">
                        <div class="font-bold">${idx + 1}. ${item.q}</div>
                        <div class="text-xs mt-0.5">
                            <span class="text-emerald-400 font-semibold">✓ ${item.correct}</span>
                            <span class="text-slate-500 mx-1.5">|</span>
                            <span class="text-rose-400 font-semibold">✗ ${item.wrong}</span>
                        </div>
                    </div>
                    <button onclick="deleteCustomQuestion(${idx})" class="text-xs text-rose-400 hover:text-rose-300 font-bold px-2 py-1 rounded bg-rose-500/10">
                        Delete
                    </button>
                `;
                listEl.appendChild(row);
            });
        }

        function addCustomQuestion() {
            const qInput = document.getElementById('custom-q-text');
            const cInput = document.getElementById('custom-q-correct');
            const wInput = document.getElementById('custom-q-wrong');

            const q = qInput.value.trim();
            const correct = cInput.value.trim();
            const wrong = wInput.value.trim();
            if (!q || !correct || !wrong) return;

            QUESTION_BANK.custom.push({ q, correct, wrong });
            qInput.value = '';
            cInput.value = '';
            wInput.value = '';
            renderCustomQuestionsList();
        }

        function deleteCustomQuestion(idx) {
            if (QUESTION_BANK.custom.length <= 1) return;
            QUESTION_BANK.custom.splice(idx, 1);
            renderCustomQuestionsList();
        }

        function useCustomDeckNow() {
            document.getElementById('subject-select').value = 'custom';
            closeQuestionModal();
            restartFullRide();
        }

        // Responsive Window Resize Handler
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        // Start Game on Window Load
        window.onload = function () {
            restartFullRide();
            requestAnimationFrame(animate);
        };
    </script>
