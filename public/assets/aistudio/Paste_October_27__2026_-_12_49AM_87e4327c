<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Coaster Quiz 3D - Theme Park Challenge</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700;800&family=Inter:wght@500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
        }
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #0f172a;
            font-family: 'Inter', sans-serif;
        }
        .font-display {
            font-family: 'Fredoka', sans-serif;
        }
        #canvas-container {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }
        /* Cartoon 3D Text Stroke Effect matching the reference image */
        .title-stroke {
            color: #ffffff;
            text-shadow:
                0 4px 0 #1e293b,
                -2px -2px 0 #1e293b,
                2px -2px 0 #1e293b,
                -2px 2px 0 #1e293b,
                2px 2px 0 #1e293b,
                0 10px 25px rgba(0,0,0,0.65);
        }
        .countdown-number {
            color: #f59e0b;
            text-shadow:
                0 6px 0 #78350f,
                -3px -3px 0 #78350f,
                3px -3px 0 #78350f,
                -3px 3px 0 #78350f,
                3px 3px 0 #78350f,
                0 15px 35px rgba(0,0,0,0.75);
        }
        /* Dashed Touch/Tilt Control Circles from the reference image */
        .touch-wheel {
            border: 3.5px dashed rgba(255, 255, 255, 0.65);
            box-shadow: inset 0 0 30px rgba(255, 255, 255, 0.08), 0 0 20px rgba(0, 0, 0, 0.35);
            transition: all 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
            backdrop-filter: blur(2px);
        }
        .touch-wheel.active-left {
            border-color: #38bdf8;
            background: radial-gradient(circle, rgba(56, 189, 248, 0.32) 0%, rgba(56, 189, 248, 0.05) 70%);
            transform: scale(1.07);
            box-shadow: 0 0 35px rgba(56, 189, 248, 0.6), inset 0 0 25px rgba(56, 189, 248, 0.3);
        }
        .touch-wheel.active-right {
            border-color: #f43f5e;
            background: radial-gradient(circle, rgba(244, 63, 94, 0.32) 0%, rgba(244, 63, 94, 0.05) 70%);
            transform: scale(1.07);
            box-shadow: 0 0 35px rgba(244, 63, 94, 0.6), inset 0 0 25px rgba(244, 63, 94, 0.3);
        }
        /* Question Gate Cards */
        .answer-pill {
            transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .answer-pill.selected {
            transform: scale(1.08) translateY(-4px);
        }
        @keyframes pulseGlow {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }
        .animate-pulse-slow {
            animation: pulseGlow 1.6s infinite ease-in-out;
        }
    </style>
</head>
<body class="relative w-full h-full overflow-hidden select-none">

    <!-- 3D WebGL Viewport -->
    <div id="canvas-container"></div>

    <!-- Vignette & Speed Lines Overlay -->
    <div id="vignette-overlay" class="pointer-events-none fixed inset-0 z-10 transition-opacity duration-300 opacity-0"
         style="background: radial-gradient(circle, transparent 45%, rgba(220, 38, 38, 0.65) 100%);"></div>

    <!-- Top HUD Bar -->
    <header class="fixed top-0 left-0 right-0 z-20 flex items-center justify-between px-4 py-3 sm:px-6 pointer-events-none">
        <!-- Score & Question Progress -->
        <div class="flex items-center gap-2 sm:gap-3 pointer-events-auto">
            <div class="bg-slate-900/80 backdrop-blur-md border border-white/15 rounded-2xl px-3.5 py-2 flex items-center gap-3 shadow-xl">
                <div class="flex items-center gap-1.5">
                    <span class="text-amber-400 text-lg">★</span>
                    <span id="hud-score" class="font-display text-white text-lg sm:text-xl tracking-wide">0</span>
                </div>
                <div class="h-5 w-px bg-white/20"></div>
                <div class="text-xs sm:text-sm font-semibold text-slate-300">
                    Gate <span id="hud-progress" class="text-white font-bold">1/8</span>
                </div>
            </div>

            <!-- Subject Selector Pill -->
            <select id="subject-select" class="bg-slate-900/80 backdrop-blur-md border border-white/15 text-white text-xs sm:text-sm font-semibold rounded-2xl px-3 py-2.5 shadow-xl focus:outline-none focus:ring-2 focus:ring-amber-400 cursor-pointer">
                <option value="all">All Subjects</option>
                <option value="math">Math Mental</option>
                <option value="science">Science & Space</option>
                <option value="geography">World Geography</option>
                <option value="english">Vocabulary & Grammar</option>
                <option value="custom">Custom Teacher Set</option>
            </select>
        </div>

        <!-- Tablet Tilt Status & Action Buttons -->
        <div class="flex items-center gap-2 pointer-events-auto">
            <button id="btn-tilt-toggle" onclick="requestTiltPermission()"
                class="bg-indigo-600/90 hover:bg-indigo-500 active:scale-95 backdrop-blur-md border border-indigo-300/40 text-white text-xs sm:text-sm font-bold px-3.5 py-2 rounded-2xl shadow-lg flex items-center gap-1.5 transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                    <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                    <line x1="12" y1="18" x2="12.01" y2="18"></line>
                </svg>
                <span id="tilt-status-text">Enable Tablet Tilt</span>
            </button>

            <button onclick="openQuestionModal()"
                class="bg-slate-900/80 hover:bg-slate-800 active:scale-95 backdrop-blur-md border border-white/15 text-white text-xs sm:text-sm font-semibold px-3.5 py-2 rounded-2xl shadow-lg flex items-center gap-1.5 transition"
                title="Teacher Question Editor">
                <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
                <span class="hidden sm:inline">Questions</span>
            </button>
        </div>
    </header>

    <!-- Center Countdown Overlay ("GET READY" + 4, 3, 2, 1 matching reference image) -->
    <div id="countdown-overlay" class="fixed inset-0 z-20 flex flex-col items-center justify-center pointer-events-none pb-20">
        <h1 id="countdown-title" class="font-display text-5xl sm:text-7xl md:text-8xl tracking-wider uppercase title-stroke text-center px-4 select-none">
            GET READY
        </h1>
        <div id="countdown-digit" class="font-display text-7xl sm:text-9xl countdown-number mt-2 animate-pulse-slow select-none">
            4
        </div>
    </div>

    <!-- Active Question HUD Overlay (Compact at top so track split ahead is 100% visible) -->
    <div id="question-hud" class="fixed top-14 sm:top-16 left-1/2 -translate-x-1/2 z-20 w-[92%] max-w-xl pointer-events-none transition-all duration-300 opacity-0 scale-90">
        <!-- Timer Bar -->
        <div class="w-full bg-slate-950/85 h-2.5 rounded-t-2xl overflow-hidden border-x border-t border-white/20 p-0.5">
            <div id="question-timer-bar" class="h-full bg-gradient-to-r from-emerald-400 via-amber-400 to-rose-500 rounded-full transition-all duration-75" style="width: 100%;"></div>
        </div>

        <!-- Question Card -->
        <div class="bg-slate-900/80 backdrop-blur-md border-x border-b border-white/20 rounded-b-3xl px-4 py-2.5 sm:px-5 sm:py-3.5 shadow-2xl text-center">
            <div class="inline-flex items-center gap-1.5 text-[10px] sm:text-xs font-extrabold uppercase tracking-widest text-amber-400 bg-amber-500/15 border border-amber-400/30 px-2.5 py-0.5 rounded-full mb-1">
                <span>⚡ Track Split Ahead — Lean or Tap to Switch Rails!</span>
            </div>
            <h2 id="question-text" class="font-display text-lg sm:text-2xl md:text-3xl text-white tracking-wide drop-shadow-md">
                7 × 8 = ?
            </h2>

            <!-- Left & Right Answer Choice Gates -->
            <div class="grid grid-cols-2 gap-2.5 sm:gap-4 mt-2.5 pointer-events-auto">
                <!-- Left Choice -->
                <button id="choice-left-card" onclick="setSteeringChoice(-1)"
                    class="answer-pill group relative overflow-hidden rounded-2xl bg-gradient-to-br from-sky-500/90 to-blue-700/90 border-2 border-sky-300/70 p-2.5 sm:p-3 text-left shadow-xl flex items-center justify-between cursor-pointer">
                    <div class="flex items-center gap-2 sm:gap-2.5">
                        <span class="w-7 h-7 sm:w-9 sm:h-9 rounded-xl bg-slate-950/40 border border-white/25 flex items-center justify-center font-display text-white text-base sm:text-lg shrink-0">
                            ◀
                        </span>
                        <div>
                            <div class="text-[9px] sm:text-[11px] uppercase font-bold tracking-wider text-sky-100/85">Left Track</div>
                            <div id="choice-left-text" class="font-display text-base sm:text-xl text-white leading-tight">56</div>
                        </div>
                    </div>
                    <span id="left-lock-badge" class="hidden text-[9px] sm:text-[10px] font-extrabold uppercase bg-white text-blue-900 px-1.5 py-0.5 rounded-md shadow">LOCKED</span>
                </button>

                <!-- Right Choice -->
                <button id="choice-right-card" onclick="setSteeringChoice(1)"
                    class="answer-pill group relative overflow-hidden rounded-2xl bg-gradient-to-br from-rose-500/90 to-red-700/90 border-2 border-rose-300/70 p-2.5 sm:p-3 text-right shadow-xl flex items-center justify-between cursor-pointer">
                    <span id="right-lock-badge" class="hidden text-[9px] sm:text-[10px] font-extrabold uppercase bg-white text-rose-900 px-1.5 py-0.5 rounded-md shadow">LOCKED</span>
                    <div class="flex items-center gap-2 sm:gap-2.5 ml-auto">
                        <div>
                            <div class="text-[9px] sm:text-[11px] uppercase font-bold tracking-wider text-rose-100/85">Right Track</div>
                            <div id="choice-right-text" class="font-display text-base sm:text-xl text-white leading-tight">54</div>
                        </div>
                        <span class="w-7 h-7 sm:w-9 sm:h-9 rounded-xl bg-slate-950/40 border border-white/25 flex items-center justify-center font-display text-white text-base sm:text-lg shrink-0">
                            ▶
                        </span>
                    </div>
                </button>
            </div>
        </div>
    </div>

    <!-- Sleek Low-Profile 2D Coaster Front Bumper Bar at Very Bottom (~12% height max, never blocks view) -->
    <div id="coaster-bumper-bar" class="fixed bottom-0 left-0 right-0 h-20 sm:h-24 z-10 pointer-events-none transition-transform duration-100 overflow-hidden"
         style="background: linear-gradient(to bottom, rgba(24,24,27,0.88) 0%, rgba(9,9,11,0.98) 100%); border-top: 4px solid #dc2626; box-shadow: 0 -10px 30px rgba(0,0,0,0.65);">
        <!-- Subtle metallic sheen highlight -->
        <div class="w-full h-2 bg-gradient-to-r from-transparent via-white/25 to-transparent"></div>
        <!-- Center Coaster Lap Bar Graphic -->
        <div class="mx-auto mt-3 w-48 sm:w-64 h-3 rounded-full bg-zinc-800 border border-zinc-600/50 shadow-inner"></div>
    </div>

    <!-- Live Tilt / Steering Angle Meter (Positioned cleanly just above the low bumper) -->
    <div class="fixed bottom-24 sm:bottom-28 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center pointer-events-none">
        <div class="bg-slate-950/80 backdrop-blur-md border border-white/15 rounded-full px-4 py-1.5 flex items-center gap-3 shadow-xl">
            <span class="text-xs font-bold text-sky-400">◀ L</span>
            <div class="w-28 sm:w-36 h-2.5 bg-slate-800 rounded-full relative overflow-hidden border border-white/10">
                <!-- Center tick -->
                <div class="absolute left-1/2 top-0 bottom-0 w-0.5 bg-white/40 -translate-x-1/2 z-10"></div>
                <!-- Tilt bubble indicator -->
                <div id="tilt-indicator-dot" class="absolute top-0 bottom-0 w-5 bg-amber-400 rounded-full shadow transition-all duration-75" style="left: calc(50% - 10px);"></div>
            </div>
            <span class="text-xs font-bold text-rose-400">R ▶</span>
        </div>
        <span id="steer-direction-label" class="text-[11px] font-extrabold uppercase tracking-wider text-white/90 mt-1 drop-shadow">
            STEERING: CENTER
        </span>
    </div>

    <!-- Interactive Dashed Circular Touch Zones on Bottom Corners (Matching Reference Image) -->
    <div class="fixed bottom-4 sm:bottom-6 left-0 right-0 z-20 flex items-center justify-between px-6 sm:px-14 md:px-24 pointer-events-none">
        <!-- Left Dashed Steering Wheel Zone -->
        <button id="wheel-left"
            onpointerdown="setSteeringChoice(-1)"
            class="touch-wheel pointer-events-auto w-28 h-28 sm:w-40 sm:h-40 rounded-full flex flex-col items-center justify-center text-white/90 active:scale-95 cursor-pointer group">
            <svg class="w-8 h-8 sm:w-11 sm:h-11 text-white/85 group-hover:text-sky-300 transition" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
            <span class="font-display text-xs sm:text-sm tracking-wider uppercase mt-1 text-white/95">LEAN LEFT</span>
        </button>

        <!-- Right Dashed Steering Wheel Zone -->
        <button id="wheel-right"
            onpointerdown="setSteeringChoice(1)"
            class="touch-wheel pointer-events-auto w-28 h-28 sm:w-40 sm:h-40 rounded-full flex flex-col items-center justify-center text-white/90 active:scale-95 cursor-pointer group">
            <svg class="w-8 h-8 sm:w-11 sm:h-11 text-white/85 group-hover:text-rose-300 transition" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
            <span class="font-display text-xs sm:text-sm tracking-wider uppercase mt-1 text-white/95">LEAN RIGHT</span>
        </button>
    </div>

    <!-- Bottom Right Mute Button (Matching Reference Image) -->
    <button id="btn-mute" onclick="toggleAudioMute()"
        class="fixed bottom-4 right-5 z-30 w-11 h-11 rounded-full bg-slate-950/85 hover:bg-slate-900 border border-white/20 text-white flex items-center justify-center shadow-xl transition active:scale-90"
        title="Toggle Coaster Sound">
        <svg id="icon-sound-on" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5L6 9H2v6h4l5 4V5z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.54 8.46a5 5 0 010 7.07M19.07 4.93a10 10 0 010 14.14" />
        </svg>
        <svg id="icon-sound-off" class="w-5 h-5 hidden text-rose-400" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5L6 9H2v6h4l5 4V5z" />
            <line x1="23" y1="9" x2="17" y2="15" />
            <line x1="17" y1="9" x2="23" y2="15" />
        </svg>
    </button>

    <!-- Crash / Derailment Modal ("WRONG TRACK! YOU FELL OFF!") -->
    <div id="crash-modal" class="fixed inset-0 z-40 hidden items-center justify-center bg-slate-950/80 backdrop-blur-md p-4">
        <div class="bg-slate-900 border-2 border-rose-500/60 rounded-3xl max-w-md w-full p-6 sm:p-8 text-center shadow-2xl transform transition-all">
            <div class="w-20 h-20 rounded-full bg-rose-500/20 border-2 border-rose-500 flex items-center justify-center mx-auto mb-4 text-4xl">
                🎢💥
            </div>
            <h2 id="crash-title" class="font-display text-3xl sm:text-4xl text-white tracking-wide">
                DERAILED!
            </h2>
            <p id="crash-reason" class="text-slate-300 text-sm sm:text-base mt-2">
                You steered onto the broken track!
            </p>
            <div id="crash-correct-box" class="mt-4 bg-slate-800/90 border border-white/10 rounded-2xl p-3.5 text-sm text-emerald-300 font-semibold">
                Correct Answer: <span id="crash-correct-answer" class="text-white font-bold">56</span>
            </div>

            <div class="flex flex-col sm:flex-row gap-3 mt-6">
                <button onclick="retryFromCheckpoint()"
                    class="flex-1 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-display text-lg py-3 px-5 rounded-2xl shadow-lg transition active:scale-95 cursor-pointer">
                    Retry This Gate
                </button>
                <button onclick="restartFullRide()"
                    class="bg-slate-800 hover:bg-slate-700 text-white font-semibold text-sm py-3 px-5 rounded-2xl border border-white/15 transition active:scale-95 cursor-pointer">
                    New Ride
                </button>
            </div>
        </div>
    </div>

    <!-- Victory Modal (Completed All Coaster Gates) -->
    <div id="victory-modal" class="fixed inset-0 z-40 hidden items-center justify-center bg-slate-950/80 backdrop-blur-md p-4">
        <div class="bg-slate-900 border-2 border-amber-400/70 rounded-3xl max-w-md w-full p-6 sm:p-8 text-center shadow-2xl">
            <div class="w-20 h-20 rounded-full bg-amber-400/20 border-2 border-amber-400 flex items-center justify-center mx-auto mb-4 text-4xl">
                🏆🎡
            </div>
            <h2 class="font-display text-3xl sm:text-4xl text-white tracking-wide">
                RIDE CONQUERED!
            </h2>
            <p class="text-slate-300 text-sm sm:text-base mt-2">
                Amazing reflexes! You navigated every coaster junction without falling off!
            </p>
            <div class="mt-5 bg-slate-800/90 border border-amber-400/30 rounded-2xl p-4">
                <div class="text-xs uppercase font-bold tracking-widest text-amber-400">Final Score</div>
                <div id="victory-score" class="font-display text-4xl text-white mt-1">800 PTS</div>
            </div>
            <button onclick="restartFullRide()"
                class="w-full mt-6 bg-gradient-to-r from-emerald-400 to-teal-500 hover:from-emerald-300 hover:to-teal-400 text-slate-950 font-display text-xl py-3.5 px-6 rounded-2xl shadow-xl transition active:scale-95 cursor-pointer">
                Ride Again! 🎢
            </button>
        </div>
    </div>

    <!-- Teacher / Student Question Editor Modal -->
    <div id="question-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 backdrop-blur-md p-4">
        <div class="bg-slate-900 border border-white/20 rounded-3xl max-w-lg w-full p-5 sm:p-6 shadow-2xl max-h-[90vh] flex flex-col">
            <div class="flex items-center justify-between border-b border-white/10 pb-3">
                <div>
                    <h3 class="font-display text-xl sm:text-2xl text-white">Teacher Question Studio</h3>
                    <p class="text-xs text-slate-400">Add custom Left/Right questions for students on tablets</p>
                </div>
                <button onclick="closeQuestionModal()" class="text-slate-400 hover:text-white p-1.5 rounded-xl bg-slate-800">✕</button>
            </div>

            <!-- Add New Question Form -->
            <div class="mt-4 space-y-3">
                <div>
                    <label class="text-xs font-bold uppercase text-slate-300">Question Prompt</label>
                    <input id="custom-q-text" type="text" placeholder="e.g., What is 12 × 6 ?"
                        class="w-full mt-1 bg-slate-800 border border-white/15 rounded-xl px-3.5 py-2 text-white text-sm focus:outline-none focus:border-amber-400">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs font-bold uppercase text-emerald-400">Correct Answer</label>
                        <input id="custom-q-correct" type="text" placeholder="e.g., 72"
                            class="w-full mt-1 bg-slate-800 border border-emerald-500/40 rounded-xl px-3.5 py-2 text-white text-sm focus:outline-none focus:border-emerald-400">
                    </div>
                    <div>
                        <label class="text-xs font-bold uppercase text-rose-400">Wrong Answer (Falls Off)</label>
                        <input id="custom-q-wrong" type="text" placeholder="e.g., 68"
                            class="w-full mt-1 bg-slate-800 border border-rose-500/40 rounded-xl px-3.5 py-2 text-white text-sm focus:outline-none focus:border-rose-400">
                    </div>
                </div>
                <button onclick="addCustomQuestion()"
                    class="w-full bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm py-2.5 rounded-xl shadow transition cursor-pointer">
                    + Add Question to Custom Deck
                </button>
            </div>

            <!-- Existing Custom Questions List -->
            <div class="mt-4 flex-1 overflow-y-auto space-y-2 pr-1" id="custom-questions-list"></div>

            <div class="mt-4 pt-3 border-t border-white/10 flex justify-between items-center">
                <button onclick="useCustomDeckNow()" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs sm:text-sm px-4 py-2 rounded-xl cursor-pointer">
                    Play Custom Deck Now
                </button>
                <button onclick="closeQuestionModal()" class="text-slate-300 hover:text-white text-sm font-semibold px-4 py-2">
                    Close
                </button>
            </div>
        </div>
    </div>

    <script>
        /********************************************************************
         * 1. QUESTION BANK (Multi-Subject + Teacher Custom Deck)
         ********************************************************************/
        const QUESTION_BANK = {
            math: [
                { q: "7 × 8 = ?", correct: "56", wrong: "54" },
                { q: "144 ÷ 12 = ?", correct: "12", wrong: "14" },
                { q: "9 × 6 = ?", correct: "54", wrong: "52" },
                { q: "25 + 38 = ?", correct: "63", wrong: "53" },
                { q: "Square root of 81?", correct: "9", wrong: "8" },
                { q: "15 × 4 = ?", correct: "60", wrong: "45" },
                { q: "100 − 37 = ?", correct: "63", wrong: "73" },
                { q: "3³ (3 cubed) = ?", correct: "27", wrong: "9" }
            ],
            science: [
                { q: "Which planet is known as the Red Planet?", correct: "Mars", wrong: "Venus" },
                { q: "What gas do plants absorb for photosynthesis?", correct: "Carbon Dioxide", wrong: "Oxygen" },
                { q: "Boiling point of water at sea level?", correct: "100°C", wrong: "90°C" },
                { q: "Which force pulls the roller coaster down hills?", correct: "Gravity", wrong: "Magnetism" },
                { q: "Largest organ in the human body?", correct: "Skin", wrong: "Liver" },
                { q: "Chemical symbol for Gold?", correct: "Au", wrong: "Ag" },
                { q: "How many bones are in an adult human?", correct: "206", wrong: "186" },
                { q: "Center of an atom is called the...?", correct: "Nucleus", wrong: "Electron" }
            ],
            geography: [
                { q: "Largest ocean on Earth?", correct: "Pacific Ocean", wrong: "Atlantic Ocean" },
                { q: "Capital city of Japan?", correct: "Tokyo", wrong: "Kyoto" },
                { q: "Which continent is the Sahara Desert in?", correct: "Africa", wrong: "Asia" },
