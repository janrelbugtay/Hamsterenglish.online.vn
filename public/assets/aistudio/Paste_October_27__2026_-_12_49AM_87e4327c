        const RAIL_SPACING = 1.15;
        const railMaterial = new THREE.MeshStandardMaterial({ color: 0xef4444, roughness: 0.32, metalness: 0.35 });
        const spineMaterial = new THREE.MeshStandardMaterial({ color: 0xb91c1c, roughness: 0.45, metalness: 0.3 });
        const tieMaterial = new THREE.MeshStandardMaterial({ color: 0x451a03, roughness: 0.65 });

        function buildDetailedTrackSegment(curve, steps, includePillars = true, isBrokenBranch = false) {
            const segGroup = new THREE.Group();
            const leftRailPts = [];
            const rightRailPts = [];
            const spinePts = [];

            for (let i = 0; i <= steps; i++) {
                const t = i / steps;
                const pt = curve.getPointAt(t);
                const tan = curve.getTangentAt(t).normalize();
                const up = new THREE.Vector3(0, 1, 0);
                const side = new THREE.Vector3().crossVectors(tan, up).normalize();

                leftRailPts.push(pt.clone().addScaledVector(side, -RAIL_SPACING * 0.5));
                rightRailPts.push(pt.clone().addScaledVector(side, RAIL_SPACING * 0.5));
                spinePts.push(pt.clone().add(new THREE.Vector3(0, -0.24, 0)));

                // Crossties (sleepers) like the reference image
                if (i % 2 === 0) {
                    const tieGeo = new THREE.BoxGeometry(RAIL_SPACING + 0.25, 0.09, 0.24);
                    const tie = new THREE.Mesh(tieGeo, tieMaterial);
                    tie.position.copy(pt).add(new THREE.Vector3(0, -0.06, 0));
                    const lookTarget = pt.clone().add(tan);
                    tie.lookAt(lookTarget);
                    segGroup.add(tie);
                }

                // Vertical support pillars along intact track
                if (includePillars && i > 0 && i % 22 === 0 && pt.y > 2.5) {
                    const pillar = createTrussSupportPillar(pt.x, pt.y - 0.3, pt.z);
                    segGroup.add(pillar);
                }
            }

            const leftCurve = new THREE.CatmullRomCurve3(leftRailPts);
            const rightCurve = new THREE.CatmullRomCurve3(rightRailPts);
            const spineCurve = new THREE.CatmullRomCurve3(spinePts);

            const leftTube = new THREE.Mesh(new THREE.TubeGeometry(leftCurve, steps, 0.11, 8, false), railMaterial);
            const rightTube = new THREE.Mesh(new THREE.TubeGeometry(rightCurve, steps, 0.11, 8, false), railMaterial);
            const spineTube = new THREE.Mesh(new THREE.TubeGeometry(spineCurve, steps, 0.18, 8, false), spineMaterial);

            segGroup.add(leftTube, rightTube, spineTube);

            // If this is the wrong answer branch, add jagged hazard stripes at the broken cliff edge
            if (isBrokenBranch) {
                const endPt = curve.getPointAt(1);
                const warnGeo = new THREE.BoxGeometry(1.7, 0.35, 0.35);
                const warnMat = new THREE.MeshStandardMaterial({
                    color: 0xfacc15,
                    emissive: 0xdc2626,
                    emissiveIntensity: 0.5
                });
                const warnBar = new THREE.Mesh(warnGeo, warnMat);
                warnBar.position.copy(endPt);
                segGroup.add(warnBar);
            }

            return segGroup;
        }

