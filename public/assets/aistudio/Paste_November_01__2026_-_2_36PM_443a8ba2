        // Helper: Park Perimeter Fence & Safety Netting
        function createParkPerimeterFence(x1, z1, x2, z2, segments) {
            const postMat = new THREE.MeshStandardMaterial({ map: woodTexture, roughness: 0.8 });
            for (let i = 0; i <= segments; i++) {
                const t = i / segments;
                const x = x1 + (x2 - x1) * t;
                const z = z1 + (z2 - z1) * t;
                const post = new THREE.Mesh(new THREE.CylinderGeometry(0.28, 0.32, 3.2, 8), postMat);
                post.position.set(x, 1.6, z);
                post.castShadow = true;
                scene.add(post);
            }
            const dist = Math.hypot(x2 - x1, z2 - z1);
            const rail = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.12, dist, 8), postMat);
            rail.position.set((x1 + x2) / 2, 2.2, (z1 + z2) / 2);
            rail.rotation.z = Math.PI / 2;
            rail.rotation.y = -Math.atan2(z2 - z1, x2 - x1);
            scene.add(rail);
        }

