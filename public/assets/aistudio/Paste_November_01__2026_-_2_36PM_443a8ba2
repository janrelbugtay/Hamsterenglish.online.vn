<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Hamster Paintball - 3D Tactical Park Arena</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Fredoka, Rubik & Chakra Petch for Tactical Paintball HUD -->
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,600;0,700;1,700&family=Fredoka:wght@500;600;700&family=Rubik:ital,wght@0,500;0,700;0,800;0,900;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Three.js r128 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <style>
        :root {
            --glass-dark: rgba(15, 23, 42, 0.82);
            --glass-border: rgba(255, 255, 255, 0.16);
            --neon-lime: #a3e635;
            --neon-pink: #ff2a85;
            --neon-cyan: #22d3ee;
            --neon-amber: #fbbf24;
        }

        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: 'Rubik', sans-serif;
            background-color: #0f172a;
        }

        .font-tactical {
            font-family: 'Chakra Petch', sans-serif;
        }

        .font-gimkit-logo {
            font-family: 'Fredoka', sans-serif;
            letter-spacing: -0.02em;
        }

        /* Entry screen park tactical pattern */
        .doodle-bg {
            background-color: #1e293b;
            background-image: 
                radial-gradient(circle at 18% 22%, rgba(163, 230, 53, 0.18) 0%, transparent 28%),
                radial-gradient(circle at 82% 28%, rgba(255, 42, 133, 0.18) 0%, transparent 30%),
                radial-gradient(circle at 50% 80%, rgba(34, 211, 238, 0.16) 0%, transparent 35%),
                url("data:image/svg+xml,%3Csvg width='120' height='120' viewBox='0 0 120 120' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%23334155' stroke-width='2' stroke-linecap='round'%3E%3Ccircle cx='20' cy='20' r='5'/%3E%3Cpath d='M55 15 l10 6 l-6 10 z'/%3E%3Cpath d='M90 25 l8 -8 m-8 0 l8 8'/%3E%3Cpath d='M15 65 q5 -6 10 0 t10 0 t10 0'/%3E%3Crect x='65' y='55' width='10' height='10' transform='rotate(20 70 60)'/%3E%3Ccircle cx='105' cy='70' r='4'/%3E%3Cpath d='M25 100 l12 -5 l-4 12 z'/%3E%3C/g%3E%3C/svg%3E");
        }

        /* Outlined HUD text styles */
        .text-stroke-sm {
            text-shadow: 
                -1.5px -1.5px 0 #000,  
                 1.5px -1.5px 0 #000,
                -1.5px  1.5px 0 #000,
                 1.5px  1.5px 0 #000,
                 0px 2px 4px rgba(0,0,0,0.65);
        }

        .text-stroke-md {
            text-shadow: 
                -2px -2px 0 #000,  
                 2px -2px 0 #000,
                -2px  2px 0 #000,
                 2px  2px 0 #000,
                 0px 4px 8px rgba(0,0,0,0.75);
        }

        /* 3D Canvas Container */
        #canvas-container {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            cursor: none;
        }

        /* Sleek Tactical Glass Panel */
        .tactical-panel {
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.88) 0%, rgba(30, 41, 59, 0.78) 100%);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.16);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.12);
        }

        /* Glossy Liquid Paint Progress Bars */
        .paint-bar-gloss {
            position: relative;
            overflow: hidden;
        }
        .paint-bar-gloss::after {
            content: '';
            position: absolute;
            top: 1px;
            left: 2px;
            right: 2px;
            height: 42%;
            background: linear-gradient(180deg, rgba(255,255,255,0.55) 0%, rgba(255,255,255,0.05) 100%);
            border-radius: 999px;
            pointer-events: none;
        }

        /* Floating Damage Popups */
        @keyframes floatDamage {
            0% {
                opacity: 1;
                transform: translate(-50%, -50%) scale(0.55) rotate(-6deg);
            }
            22% {
                opacity: 1;
                transform: translate(-50%, -105%) scale(1.22) rotate(4deg);
            }
            100% {
                opacity: 0;
                transform: translate(-50%, -195%) scale(0.92) rotate(0deg);
            }
        }

        .damage-popup {
            position: absolute;
            pointer-events: none;
            font-family: 'Rubik', sans-serif;
            font-weight: 900;
            font-style: italic;
            font-size: 2rem;
            color: #ff922b;
            z-index: 30;
            animation: floatDamage 0.95s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            text-shadow:
                -2.5px -2.5px 0 #000,
                 2.5px -2.5px 0 #000,
                -2.5px  2.5px 0 #000,
                 2.5px  2.5px 0 #000,
                 0px 5px 10px rgba(0,0,0,0.65);
        }

        /* Visor Paint Splat Drip Effect when Local Player is Hit */
        @keyframes visorDrip {
            0% {
                opacity: 0.95;
                transform: scale(0.4) translateY(0);
            }
            12% {
                opacity: 0.92;
                transform: scale(1.05) translateY(4px);
            }
            65% {
                opacity: 0.75;
                transform: scale(1.0) translateY(28px);
            }
            100% {
                opacity: 0;
                transform: scale(0.96) translateY(65px);
            }
        }

        .visor-splat {
            position: absolute;
            pointer-events: none;
            animation: visorDrip 2.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
            filter: drop-shadow(0 6px 12px rgba(0,0,0,0.45));
        }

        /* Knockout Feed Alert Animation */
        @keyframes koPop {
            0% { transform: scale(0.45) translateY(24px); opacity: 0; }
            18% { transform: scale(1.08) translateY(0); opacity: 1; }
            82% { transform: scale(1) translateY(0); opacity: 1; }
            100% { transform: scale(0.92) translateY(-14px); opacity: 0; }
        }

        .ko-banner-anim {
            animation: koPop 2.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        /* Redesigned Tactical Loadout Slot */
        .loadout-slot {
            width: 74px;
            height: 64px;
            background: rgba(15, 23, 42, 0.78);
            border: 2px solid rgba(148, 163, 184, 0.32);
            border-radius: 14px;
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: all 0.16s cubic-bezier(0.16, 1, 0.3, 1);
            cursor: pointer;
            box-shadow: 0 8px 18px rgba(0, 0, 0, 0.35);
        }

        .loadout-slot:hover {
            transform: translateY(-4px);
            border-color: rgba(255, 255, 255, 0.6);
            background: rgba(30, 41, 59, 0.9);
        }

        .loadout-slot.active {
            background: linear-gradient(160deg, rgba(34, 211, 238, 0.32) 0%, rgba(59, 130, 246, 0.45) 100%);
            border: 2.5px solid #a3e635;
            transform: translateY(-7px) scale(1.05);
            box-shadow: 0 10px 24px rgba(163, 230, 53, 0.35), inset 0 0 12px rgba(163, 230, 53, 0.25);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: rgba(0,0,0,0.2); }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.3); border-radius: 4px; }
    </style>
</head>
<body class="relative select-none overflow-hidden">

    <!-- 3D THREE.JS GAME CANVAS -->
    <div id="canvas-container"></div>

    <!-- FIRST-PERSON GOGGLE VISOR PAINT SPLAT OVERLAY -->
    <div id="visor-splat-layer" class="fixed inset-0 pointer-events-none z-25 overflow-hidden"></div>

    <!-- CUSTOM TACTICAL PAINTBALL AIMING RETICLE -->
    <div id="aim-reticle" class="fixed pointer-events-none z-30 hidden" style="transform: translate(-50%, -50%);">
        <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Outer dynamic reticle ring -->
            <circle cx="32" cy="32" r="18" stroke="rgba(0,0,0,0.75)" stroke-width="4" stroke-dasharray="14 8"/>
            <circle id="reticle-color-ring" cx="32" cy="32" r="18" stroke="#a3e635" stroke-width="2.2" stroke-dasharray="14 8"/>
            <!-- Inner precision ring -->
            <circle cx="32" cy="32" r="7" stroke="#ffffff" stroke-width="1.8" fill="rgba(163,230,53,0.15)"/>
            <!-- Crosshair ticks -->
            <path d="M32 8 V15 M32 49 V56 M8 32 H15 M49 32 H56" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round"/>
            <!-- Center dot -->
            <circle cx="32" cy="32" r="2.5" fill="#ff2a85"/>
        </svg>
    </div>

    <!-- DYNAMIC WORLD LABELS & FLOATING DAMAGE OVERLAY -->
    <div id="world-labels-layer" class="fixed inset-0 pointer-events-none z-10 overflow-hidden"></div>
    <div id="damage-popups-layer" class="fixed inset-0 pointer-events-none z-30 overflow-hidden"></div>

    <!-- =====================================================================
         SCREEN 1: JOIN / ENTRY MODAL (Tactical Park Edition + Gimkit Flow)
         ===================================================================== -->
    <div id="join-screen" class="fixed inset-0 z-50 doodle-bg flex flex-col items-center justify-center p-4 transition-opacity duration-300">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-[460px] p-7 flex flex-col items-center border-2 border-slate-200 relative overflow-hidden">
            <!-- Top glossy paint accent bar -->
            <div class="absolute top-0 inset-x-0 h-2.5 bg-gradient-to-r from-lime-400 via-pink-500 to-cyan-400"></div>

            <!-- Floating Paint Splat Badge -->
            <div class="absolute top-4 right-4 w-11 h-11 rounded-xl bg-gradient-to-br from-pink-500 to-rose-600 shadow-lg flex items-center justify-center text-white transform rotate-6">
                <i class="fa-solid fa-crosshairs text-lg"></i>
            </div>

            <!-- Title Logo -->
            <div class="text-center mb-4 mt-1">
                <div class="inline-flex items-center gap-1.5 bg-lime-100 text-lime-800 font-black text-[11px] px-3 py-0.5 rounded-full mb-1 border border-lime-300">
                    <i class="fa-solid fa-tree text-emerald-600"></i> OUTDOOR SPEEDBALL & WOODSBALL PARK
                </div>
                <div class="font-gimkit-logo font-black text-4xl sm:text-5xl tracking-tight text-slate-900 leading-none">
                    HAMSTER PAINTBALL
                </div>
                <p class="text-xs font-bold text-slate-500 mt-1">
                    3D PBR Glossy Paintballs • Tactical Hamster Gear • Real-Time Park Arena
                </p>
            </div>

            <!-- 3D Hamster Character & Mask Selector -->
            <div class="w-full bg-slate-100 rounded-xl p-3.5 mb-4 border border-slate-200">
                <div class="flex items-center justify-between text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">
                    <span>Select Pro Hamster Rig</span>
                    <span id="selected-skin-name" class="text-indigo-900 font-extrabold">Choco Commando (Teacher Jan)</span>
                </div>
                <div class="grid grid-cols-5 gap-2" id="skin-selector-grid">
                    <!-- Populated via JS -->
                </div>
            </div>

            <!-- Your Name Input -->
            <div class="w-full mb-3">
                <label class="block text-[11px] font-extrabold uppercase text-slate-400 mb-1">Hamster Callsign</label>
                <input
                    id="player-name-input"
                    type="text"
                    maxlength="16"
                    placeholder="Your Name"
                    value="Teacher Jan"
                    class="w-full h-12 px-4 text-center text-lg font-extrabold text-slate-800 bg-white border-2 border-slate-800 rounded-xl focus:outline-none focus:ring-2 focus:ring-lime-500 transition"
                />
            </div>

            <!-- Room Code Input Row -->
            <div class="w-full mb-4 flex gap-2">
                <div class="relative flex-1">
                    <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[10px] font-black uppercase text-slate-400">PARK CODE</span>
                    <input
                        id="room-code-input"
                        type="text"
                        maxlength="6"
                        value="370741"
                        placeholder="370741"
                        class="w-full h-11 pl-20 pr-3 text-center font-black tracking-widest text-slate-800 bg-slate-50 border-2 border-slate-300 rounded-xl focus:outline-none focus:border-indigo-700"
                    />
                </div>
                <button
                    id="random-code-btn"
                    type="button"
                    title="Generate New 6-Digit Room Code"
                    class="px-3.5 h-11 bg-slate-200 hover:bg-slate-300 text-slate-800 font-extrabold text-xs rounded-xl transition flex items-center gap-1.5"
                >
                    <i class="fa-solid fa-dice"></i> New Code
                </button>
            </div>

            <!-- Enter Park Lobby Button -->
            <button
                id="join-game-btn"
                class="w-full h-13 py-3.5 bg-[#160269] hover:bg-[#220699] active:scale-[0.99] text-white font-black text-base rounded-xl shadow-lg transition flex items-center justify-center gap-2 border-b-4 border-[#0c013d]"
            >
                <i class="fa-solid fa-gun"></i>
                <span>Enter Paintball Park</span>
            </button>

            <div class="w-full mt-3 pt-2.5 border-t border-slate-200 flex items-center justify-between text-[11px] text-slate-500 font-semibold">
                <span><i class="fa-solid fa-check-circle text-emerald-500 mr-1"></i>Cloud + Multi-Tab Sync</span>
                <span><i class="fa-solid fa-robot text-indigo-500 mr-1"></i>Smart Speedball Bots</span>
            </div>
        </div>
    </div>

    <!-- =====================================================================
         SCREEN 2: PRE-GAME PARK LOBBY OVERLAY (Gimkit Host Banner + Park Preview)
         ===================================================================== -->
    <div id="lobby-overlay" class="fixed inset-0 z-30 pointer-events-none hidden flex-col justify-between">
        <!-- Top Translucent Banner -->
        <div class="w-full bg-[#2e1f4d]/90 backdrop-blur-md py-4 px-6 flex flex-col items-center justify-center pointer-events-auto shadow-2xl relative border-b border-white/15">
            <div class="text-white text-base sm:text-xl font-medium tracking-wide text-center flex items-center gap-2">
                <span class="px-2 py-0.5 rounded bg-lime-400 text-slate-950 font-black text-xs uppercase">LIVE PARK LOBBY</span>
                <span>Go to <strong class="underline decoration-pink-400">hamsterpaintball.io/join</strong> and enter code</span>
            </div>
            <div
                id="lobby-big-code"
                class="text-white font-black text-6xl sm:text-8xl tracking-tight leading-none mt-1 cursor-pointer hover:scale-105 transition transform select-all drop-shadow-md"
                title="Click to toggle QR Code & Copy Link"
            >
                370741
            </div>

            <!-- Top-right floating Lobby Icon Bar -->
            <div class="absolute right-5 -bottom-14 bg-[#2e1f4d] border-2 border-[#634d8f] rounded-xl p-1.5 flex items-center gap-1.5 shadow-xl">
                <button id="lobby-add-bot-icon" title="Add AI Speedball Hamster" class="w-9 h-9 rounded-lg bg-[#453073] hover:bg-[#5b4096] text-amber-400 flex items-center justify-center transition">
                    <i class="fa-solid fa-paw"></i>
                </button>
                <button id="lobby-qr-toggle-icon" title="Show/Hide Room QR Code" class="w-9 h-9 rounded-lg bg-[#453073] hover:bg-[#5b4096] text-pink-300 flex items-center justify-center transition">
                    <i class="fa-solid fa-qrcode"></i>
                </button>
                <button id="lobby-audio-toggle-icon" title="Toggle Sound Effects" class="w-9 h-9 rounded-lg bg-[#453073] hover:bg-[#5b4096] text-white flex items-center justify-center transition">
                    <i class="fa-solid fa-volume-high"></i>
                </button>
            </div>
        </div>

        <!-- Center QR Code & Copy Link Modal -->
        <div id="lobby-qr-modal" class="self-center my-auto pointer-events-auto hidden">
            <div class="bg-[#3b1578] p-4 rounded-2xl shadow-2xl border-2 border-indigo-400/40 flex flex-col items-center w-[280px] sm:w-[310px]">
                <div class="bg-white p-3 rounded-xl w-full aspect-square flex items-center justify-center shadow-inner" id="qr-svg-container"></div>
                <button
                    id="copy-join-link-btn"
                    class="w-full mt-3 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm rounded-xl shadow transition flex items-center justify-center gap-2"
                >
                    <i class="fa-solid fa-link"></i>
                    <span id="copy-link-text">Copy Join Link</span>
                </button>
            </div>
        </div>

        <!-- Bottom Translucent Lobby Control Bar -->
        <div class="w-full bg-[#2e1f4d]/90 backdrop-blur-md py-5 px-6 flex flex-col items-center justify-center gap-2.5 pointer-events-auto border-t border-white/15">
            <div class="flex flex-wrap items-center justify-center gap-3">
                <div class="bg-slate-800/90 border border-white/20 text-white font-bold text-sm px-5 py-2.5 rounded-xl shadow flex items-center gap-2.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-lime-400 animate-ping"></span>
                    <span id="lobby-status-text">Waiting for players... (5 Hamsters in Park)</span>
                </div>

                <button
                    id="start-match-btn"
                    class="bg-gradient-to-r from-lime-500 to-emerald-600 hover:from-lime-400 hover:to-emerald-500 active:scale-95 text-slate-950 font-black text-sm px-7 py-2.5 rounded-xl shadow-lg transition flex items-center gap-2 border-b-4 border-emerald-800"
                >
                    <i class="fa-solid fa-play"></i>
                    <span>START PARK PAINTBALL MATCH!</span>
                </button>

                <button
                    id="lobby-add-bot-btn"
                    class="bg-amber-400 hover:bg-amber-300 text-slate-950 font-extrabold text-xs px-4 py-2.5 rounded-xl shadow transition flex items-center gap-1.5"
                >
                    <i class="fa-solid fa-plus"></i> Add Pro Bot
                </button>
            </div>

            <div class="flex flex-wrap items-center justify-center gap-3">
                <button
                    id="spectator-toggle-btn"
                    class="bg-white/10 hover:bg-white/20 text-white/90 text-xs font-semibold px-4 py-1.5 rounded-lg transition"
                >
                    Mode: Active Player (Click to Spectate)
                </button>
                <span class="text-xs text-purple-200 hidden sm:inline">
                    Warmup Active: Move with <b>WASD</b>, switch camera with <b>V</b>, and test your Paintball Marker on the inflatable park bunkers!
                </span>
            </div>
        </div>
    </div>

    <!-- =====================================================================
         SCREEN 3: REDESIGNED TACTICAL IN-GAME HUD (Sleek Pro Paintball UI)
         ===================================================================== -->
    <div id="gameplay-hud" class="fixed inset-0 z-20 pointer-events-none hidden flex-col justify-between p-3 sm:p-4">
        
        <!-- TOP ROW: Left Vitals & HPA Air Tank | Center Match Clock & Park Event | Right Killfeed & Controls -->
        <div class="w-full flex items-start justify-between gap-3">

            <!-- TOP-LEFT: REDESIGNED HAMSTER VITALS, GOGGLE SHIELD & HPA AIR TANK CARD -->
            <div class="tactical-panel rounded-2xl p-3 w-68 sm:w-80 pointer-events-auto border-l-4 border-l-lime-400">
                <!-- Header: Hamster Avatar + Callsign + Kill Streak Badge -->
                <div class="flex items-center justify-between mb-2.5">
                    <div class="flex items-center gap-2.5">
                        <div id="hud-avatar-swatch" class="w-9 h-9 rounded-xl bg-amber-600 border-2 border-white/80 shadow flex items-center justify-center text-white relative">
                            <i class="fa-solid fa-glasses text-xs"></i>
                            <span class="absolute -bottom-1 -right-1 w-3.5 h-3.5 rounded-full bg-lime-400 border border-slate-900"></span>
                        </div>
                        <div>
                            <div id="hud-player-callsign" class="font-black text-white text-sm leading-tight tracking-wide">TEACHER JAN</div>
                            <div class="text-[10px] font-bold text-cyan-300 uppercase tracking-wider flex items-center gap-1">
                                <i class="fa-solid fa-Burst"></i> Pro Speedball Rig
                            </div>
                        </div>
                    </div>
                    <!-- Score & Seeds Mini Pill -->
                    <div class="flex items-center gap-2 bg-slate-950/70 px-2.5 py-1 rounded-xl border border-white/10">
                        <div class="text-center">
                            <div class="text-[9px] font-bold text-slate-400 uppercase">Splats</div>
                            <div id="hud-kos-count" class="font-tactical font-bold text-sm text-pink-400 leading-none">0</div>
                        </div>
                        <div class="w-px h-5 bg-white/15"></div>
                        <div class="text-center">
                            <div class="text-[9px] font-bold text-slate-400 uppercase">Seeds</div>
                            <div id="hud-seeds-count" class="font-tactical font-bold text-sm text-amber-300 leading-none">120</div>
                        </div>
                    </div>
                </div>

                <!-- Goggle Shield Bar (Cyan Gloss) -->
                <div class="mb-2">
                    <div class="flex items-center justify-between text-[11px] font-extrabold mb-0.5">
                        <span class="text-cyan-300 flex items-center gap-1"><i class="fa-solid fa-shield-halved"></i> GOGGLE SHIELD</span>
                        <span id="hud-shield-text" class="font-tactical text-white tabular-nums">100 / 100</span>
                    </div>
                    <div class="w-full h-3.5 bg-slate-950/90 rounded-full p-0.5 border border-cyan-500/30">
                        <div id="hud-shield-bar" class="h-full bg-gradient-to-r from-cyan-500 via-sky-400 to-cyan-300 rounded-full paint-bar-gloss transition-all duration-200" style="width: 100%;"></div>
                    </div>
                </div>

                <!-- Hamster Stamina / Health Bar (Neon Lime Gloss) -->
                <div class="mb-2">
                    <div class="flex items-center justify-between text-[11px] font-extrabold mb-0.5">
                        <span class="text-lime-300 flex items-center gap-1"><i class="fa-solid fa-heart-pulse"></i> HAMSTER HEALTH</span>
                        <span id="hud-hp-text" class="font-tactical text-white tabular-nums">100 / 100</span>
                    </div>
                    <div class="w-full h-3.5 bg-slate-950/90 rounded-full p-0.5 border border-lime-500/30">
                        <div id="hud-hp-bar" class="h-full bg-gradient-to-r from-emerald-500 via-lime-400 to-yellow-300 rounded-full paint-bar-gloss transition-all duration-200" style="width: 100%;"></div>
                    </div>
                </div>

                <!-- Bottom Micro Status: HPA Air Pressure & Pond Hydroplane Status -->
                <div class="flex items-center justify-between text-[10px] font-bold text-slate-300 pt-1 border-t border-white/10">
                    <span class="flex items-center gap-1">
                        <i class="fa-solid fa-gauge-high text-amber-400"></i> HPA Tank: <strong id="hud-air-psi" class="text-white">3000 PSI</strong>
                    </span>
                    <span id="pond-zone-badge" class="hidden text-cyan-300 font-black animate-pulse">
                        <i class="fa-solid fa-water"></i> POND HYDROPLANE SPEED!
                    </span>
