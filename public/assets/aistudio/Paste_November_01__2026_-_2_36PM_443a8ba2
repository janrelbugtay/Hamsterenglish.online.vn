        function renderRoomQRCode(codeStr) {
            const containerEl = document.getElementById('qr-svg-container');
            const size = 21;
            let seed = 0;
            for (let i = 0; i < codeStr.length; i++) seed = (seed * 31 + codeStr.charCodeAt(i)) % 100000;

            const isFinder = (r, c) =>
                (r < 7 && c < 7) || (r < 7 && c >= size - 7) || (r >= size - 7 && c < 7);

            let rects = '';
            for (let r = 0; r < size; r++) {
                for (let c = 0; c < size; c++) {
                    let filled = false;
                    if (isFinder(r, c)) {
                        const lr = r >= size - 7 ? r - (size - 7) : r;
                        const lc = c >= size - 7 ? c - (size - 7) : c;
                        if (lr === 0 || lr === 6 || lc === 0 || lc === 6 || (lr >= 2 && lr <= 4 && lc >= 2 && lc <= 4)) {
                            filled = true;
                        }
                    } else {
                        seed = (seed * 16807 + 11) % 2147483647;
                        filled = (seed % 10) < 5;
                    }
                    if (filled) {
                        rects += `<rect x="${c * 10}" y="${r * 10}" width="10" height="10" fill="#000"/>`;
                    }
                }
            }
            containerEl.innerHTML = `<svg viewBox="0 0 210 210" class="w-full h-full">${rects}</svg>`;
        }

