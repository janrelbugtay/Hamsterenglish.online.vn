                if (e.code === 'Digit1') selectLoadoutSlot(0);
                if (e.code === 'Digit2') selectLoadoutSlot(1);
                if (e.code === 'Digit3') selectLoadoutSlot(2);
                if (e.code === 'Digit4') selectLoadoutSlot(3);
                if (e.code === 'Digit5') selectLoadoutSlot(4);
                if (e.code === 'KeyV') toggleCameraPerspective();
                if (e.code === 'KeyQ') {
                    const isHidden = document.getElementById('question-modal').classList.contains('hidden');
                    if (isHidden) openQuestionModal();
                    else closeQuestionModal();
                }
                if (e.code === 'KeyR') refillWeaponMagazine();
                if (e.code === 'Space' && state.screen !== 'join') {
                    const angle = Math.atan2(state.aimWorldX - state.x, state.aimWorldZ - state.z);
                    state.vx += Math.sin(angle) * 15;
                    state.vz += Math.cos(angle) * 15;
                }
                if (e.code === 'Escape') {
                    closeQuestionModal();
                    document.getElementById('shop-modal').classList.add('hidden');
                    document.getElementById('leaderboard-modal').classList.add('hidden');
                }
            });

            window.addEventListener('keyup', (e) => {
                state.keys[e.code] = false;
            });

            const reticleEl = document.getElementById('aim-reticle');
            window.addEventListener('mousemove', (e) => {
                state.mouseScreenX = e.clientX;
                state.mouseScreenY = e.clientY;
                reticleEl.style.left = `${e.clientX}px`;
                reticleEl.style.top = `${e.clientY}px`;
            });

            container.addEventListener('mousedown', (e) => {
                if (e.button === 0) {
                    state.mouseDown = true;
                    tryLocalPlayerFire();
                }
            });
            window.addEventListener('mouseup', () => {
                state.mouseDown = false;
            });

            container.addEventListener('touchstart', (e) => {
                if (e.touches.length > 0) {
                    state.mouseScreenX = e.touches[0].clientX;
                    state.mouseScreenY = e.touches[0].clientY;
                    updateAimPointFromMouse();
                    tryLocalPlayerFire();
                }
            });

            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });

            setInterval(() => {
                if (state.screen === 'playing' && state.matchSecondsRemaining > 0) {
                    state.matchSecondsRemaining--;
                    const m = String(Math.floor(state.matchSecondsRemaining / 60)).padStart(2, '0');
                    const s = String(state.matchSecondsRemaining % 60).padStart(2, '0');
                    document.getElementById('match-timer').textContent = `${m}:${s}`;
                }
            }, 1000);
        }

        window.onload = function () {
            createOutdoorPaintballPark();
            spawnAIBot(0);
            spawnAIBot(1);
            spawnAIBot(2);
            spawnAIBot(3);
            setupEventListeners();
            initFirebaseMultiplayer();
            updateHUD();
            requestAnimationFrame(gameLoop);
        };
    </script>
</body>
</html>