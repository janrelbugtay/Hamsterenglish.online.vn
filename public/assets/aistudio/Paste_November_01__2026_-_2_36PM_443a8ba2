        function createWetPaintSplatTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 256;
            canvas.height = 256;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#ffffff';

            // Main organic center splat
            ctx.beginPath();
            const rays = 14;
            for (let i = 0; i <= rays * 2; i++) {
                const angle = (i / (rays * 2)) * Math.PI * 2;
                const r = i % 2 === 0 ? 52 + Math.random() * 28 : 30 + Math.random() * 14;
                const x = 128 + Math.cos(angle) * r;
                const y = 128 + Math.sin(angle) * r;
                if (i === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            ctx.closePath();
            ctx.fill();

            // Outer radial paint droplets
            for (let i = 0; i < 18; i++) {
                const a = Math.random() * Math.PI * 2;
                const dist = 56 + Math.random() * 52;
                const rad = 4 + Math.random() * 10;
                ctx.beginPath();
                ctx.arc(128 + Math.cos(a) * dist, 128 + Math.sin(a) * dist, rad, 0, Math.PI * 2);
                ctx.fill();
            }

            const tex = new THREE.CanvasTexture(canvas);
            return tex;
        }
