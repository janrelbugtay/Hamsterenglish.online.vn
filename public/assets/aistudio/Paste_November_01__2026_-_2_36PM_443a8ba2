                        state.seeds += bonusSeeds;
                        sfx.playCorrect();
                        banner.className = 'mt-4 p-3 rounded-xl font-black text-center text-white text-sm bg-emerald-600';
                        banner.textContent = `DIRECT HIT! +${bonusAmmo} Paintballs, +1 Paint Bomb & +${bonusSeeds} Seeds!`;
                        document.getElementById('q-streak-count').textContent = `${state.streak}x`;
