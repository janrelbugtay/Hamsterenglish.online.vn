        // Live Tactical Radar Minimap Renderer
        const radarCanvas = document.getElementById('radar-canvas');
        const rctx = radarCanvas ? radarCanvas.getContext('2d') : null;
        function renderParkRadar() {
            if (!rctx) return;
            const w = radarCanvas.width;
            const h = radarCanvas.height;
            rctx.clearRect(0, 0, w, h);

            // Park turf background
            rctx.fillStyle = '#0f291e';
            rctx.fillRect(0, 0, w, h);

            // Radar sweep rings
            rctx.strokeStyle = 'rgba(34, 211, 238, 0.18)';
            rctx.lineWidth = 1;
            [24, 46, 64].forEach((r) => {
                rctx.beginPath();
                rctx.arc(w / 2, h / 2, r, 0, Math.PI * 2);
                rctx.stroke();
            });

            const mapScaleX = w / 92;
            const mapScaleZ = h / 68;
            const toRX = (wx) => w / 2 + wx * mapScaleX;
            const toRZ = (wz) => h / 2 + wz * mapScaleZ;

            // Pond on east side
            rctx.fillStyle = 'rgba(6, 182, 212, 0.45)';
            rctx.beginPath();
            rctx.ellipse(toRX(26), toRZ(0), 11 * mapScaleX, 18 * mapScaleZ, 0, 0, Math.PI * 2);
            rctx.fill();

            // Central Gazebo
            rctx.strokeStyle = '#fbbf24';
            rctx.beginPath();
            rctx.arc(toRX(0), toRZ(0), 6 * mapScaleX, 0, Math.PI * 2);
            rctx.stroke();

            // Obstacles / Bunkers
            rctx.fillStyle = 'rgba(148, 163, 184, 0.55)';
            obstacles.forEach((obs) => {
                if (obs.type === 'tree') return;
                rctx.fillRect(toRX(obs.x) - 2, toRZ(obs.z) - 2, 4, 4);
            });

            // Loot Crates (Gold dots)
            rctx.fillStyle = '#fbbf24';
            powerupCrates.forEach((c) => {
                rctx.beginPath();
                rctx.arc(toRX(c.x), toRZ(c.z), 2.5, 0, Math.PI * 2);
                rctx.fill();
            });

            // AI Bots (Pink/Red dots)
            rctx.fillStyle = '#ff2a85';
            aiBots.forEach((b) => {
                rctx.beginPath();
                rctx.arc(toRX(b.x), toRZ(b.z), 3.5, 0, Math.PI * 2);
                rctx.fill();
            });

            // Remote Players (Cyan dots)
            rctx.fillStyle = '#22d3ee';
            remotePlayersData.forEach((r) => {
                rctx.beginPath();
                rctx.arc(toRX(r.x || 0), toRZ(r.z || 0), 3.5, 0, Math.PI * 2);
                rctx.fill();
            });

            // Local Player (Bright Lime Arrow/Dot)
            const px = toRX(state.x);
            const pz = toRZ(state.z);
            rctx.fillStyle = '#a3e635';
            rctx.beginPath();
            rctx.arc(px, pz, 4.5, 0, Math.PI * 2);
            rctx.fill();
            rctx.strokeStyle = '#ffffff';
            rctx.beginPath();
            rctx.moveTo(px, pz);
            rctx.lineTo(px + Math.sin(state.rotY) * 9, pz + Math.cos(state.rotY) * 9);
            rctx.stroke();
        }

        // =========================================================================
        // 10. COLLISION RESOLUTION, CAMERA PERSPECTIVES & AIMING
        // =========================================================================
        function resolveObstacleCollisions(entity) {
            entity.x = Math.max(-42, Math.min(42, entity.x));
            entity.z = Math.max(-29, Math.min(29, entity.z));

            for (const obs of obstacles) {
                const dx = entity.x - obs.x;
                const dz = entity.z - obs.z;
                const dist = Math.hypot(dx, dz);
                const minDist = obs.r + 1.05;
                if (dist < minDist && dist > 0.001) {
                    const push = minDist - dist;
                    entity.x += (dx / dist) * push;
                    entity.z += (dz / dist) * push;
                }
            }
        }

        function isInsidePondZone(x, z) {
            // Elliptical check around east duck pond (center 26, 0)
            const nx = (x - 26) / 11.4;
            const nz = z / 18.5;
            return (nx * nx + nz * nz) <= 1.0;
        }

        const raycaster = new THREE.Raycaster();
        const groundPlaneMath = new THREE.Plane(new THREE.Vector3(0, 1.2, 0), 0);
        const intersectPt = new THREE.Vector3();

        function updateAimPointFromMouse() {
            const ndcX = (state.mouseScreenX / window.innerWidth) * 2 - 1;
            const ndcY = -(state.mouseScreenY / window.innerHeight) * 2 + 1;
            raycaster.setFromCamera({ x: ndcX, y: ndcY }, camera);
            if (raycaster.ray.intersectPlane(groundPlaneMath, intersectPt)) {
                state.aimWorldX = intersectPt.x;
                state.aimWorldZ = intersectPt.z;
            }
        }

        function tryLocalPlayerFire() {
            if (state.isSpectator) return;
            const now = performance.now();
            if (now - state.lastShotTime < 210) return;

            if (state.activeSlot === 2) {
                // Slot 3: Paint Grenade Pod
                if (state.bombs <= 0) {
                    openQuestionModal();
                    return;
                }
                state.bombs--;
                state.lastShotTime = now + 240;
                firePaintball('local', state.playerName, state.x, state.z, state.aimWorldX, state.aimWorldZ, 2, state.damageMultiplier);
                updateHUD();
                return;
            }

            // Slot 0 (Speedball Marker) or Slot 1 (Triple-Burst)
            const cost = state.activeSlot === 1 ? 3 : 1;
            if (state.ammo < cost) {
                if (state.reserveAmmo > 0) refillWeaponMagazine();
                else openQuestionModal();
                return;
            }

            state.ammo -= cost;
            state.lastShotTime = now;
            const skinPaint = HAMSTER_SKINS[state.selectedSkinIdx].paintColor;
            firePaintball(
                'local',
                state.playerName,
                state.x,
                state.z,
                state.aimWorldX,
                state.aimWorldZ,
                state.activeSlot === 1 ? 1 : 0,
                state.damageMultiplier,
                skinPaint
            );
            updateHUD();
        }

        // =========================================================================
        // 11. MAIN 3D PARK GAME LOOP
        // =========================================================================
        let lastFrameTime = performance.now();

        function animateHamsterWalk(mesh, speed, dt, aimAngle) {
            const ud = mesh.userData;
            if (!ud) return;
            if (speed > 0.4) {
                ud.walkPhase += dt * 15;
                ud.leftFoot.position.z = Math.sin(ud.walkPhase) * 0.36;
                ud.rightFoot.position.z = -Math.sin(ud.walkPhase) * 0.36;
                ud.bodyGroup.position.y = Math.abs(Math.sin(ud.walkPhase)) * 0.14;
                // Jiggle paintballs inside translucent hopper!
                ud.hopperBallsGroup.rotation.z = Math.sin(ud.walkPhase * 1.5) * 0.25;
                ud.hopperBallsGroup.position.y = 0.52 + Math.abs(Math.cos(ud.walkPhase * 2)) * 0.05;
            } else {
                ud.leftFoot.position.z *= 0.85;
                ud.rightFoot.position.z *= 0.85;
                ud.bodyGroup.position.y *= 0.85;
            }

            // Smooth Marker Gun Recoil recovery
            if (ud.recoilOffset > 0.001) {
                ud.markerGroup.position.z = 0.35 - ud.recoilOffset;
                ud.recoilOffset *= Math.pow(0.08, dt);
            } else {
                ud.markerGroup.position.z = 0.35;
            }

            if (aimAngle !== undefined) {
                mesh.rotation.y = aimAngle;
            }
            if (ud.hamsterBallMesh.visible) {
                ud.hamsterBallMesh.rotation.x += speed * dt * 0.55;
                ud.hamsterBallMesh.rotation.z += speed * dt * 0.35;
            }
        }

        function projectLabelToScreen(labelEl, worldX, worldY, worldZ, hpPct = 100) {
            const vec = new THREE.Vector3(worldX, worldY, worldZ);
            vec.project(camera);
            if (vec.z > 1) {
                labelEl.style.display = 'none';
                return;
            }
            const sx = (vec.x * 0.5 + 0.5) * window.innerWidth;
            const sy = (-(vec.y * 0.5) + 0.5) * window.innerHeight;
            labelEl.style.display = 'flex';
            labelEl.style.left = `${sx}px`;
            labelEl.style.top = `${sy}px`;

            const miniBar = labelEl.querySelector('.hp-mini-bar');
            const fill = labelEl.querySelector('.hp-fill');
            if (miniBar && fill) {
                if (hpPct < 99) {
                    miniBar.classList.remove('hidden');
                    fill.style.width = `${Math.max(0, hpPct)}%`;
                } else {
                    miniBar.classList.add('hidden');
                }
            }
        }

        function gameLoop(now) {
            requestAnimationFrame(gameLoop);
            const dt = Math.min((now - lastFrameTime) / 1000, 0.05);
            lastFrameTime = now;

            // Animate Park Fountain Jet
            if (fountainWaterMesh) {
                fountainWaterMesh.scale.y = 0.9 + Math.sin(now * 0.008) * 0.15;
                fountainWaterMesh.rotation.y += dt * 3;
            }

            // Update Hamster Ball Shield Timer
            if (state.hamsterBallActive) {
                state.hamsterBallTimer -= dt;
                if (state.hamsterBallTimer <= 0) {
                    state.hamsterBallActive = false;
                    localHamsterMesh.userData.hamsterBallMesh.visible = false;
                    document.getElementById('slot-4-badge').textContent = 'RDY';
                    if (state.activeSlot === 4) state.activeSlot = 0;
                    updateHUD();
                }
            }

            // 1. LOCAL PLAYER MOVEMENT
            const questionModalOpen = !document.getElementById('question-modal').classList.contains('hidden');
            const shopModalOpen = !document.getElementById('shop-modal').classList.contains('hidden');

            let moveX = 0;
            let moveZ = 0;
            if (!questionModalOpen && !shopModalOpen && state.screen !== 'join') {
                if (state.keys['KeyW'] || state.keys['ArrowUp']) moveZ -= 1;
                if (state.keys['KeyS'] || state.keys['ArrowDown']) moveZ += 1;
                if (state.keys['KeyA'] || state.keys['ArrowLeft']) moveX -= 1;
                if (state.keys['KeyD'] || state.keys['ArrowRight']) moveX += 1;
            }

            const moveLen = Math.hypot(moveX, moveZ);
            if (moveLen > 0) {
                moveX /= moveLen;
                moveZ /= moveLen;
            }

            state.inPond = isInsidePondZone(state.x, state.z);
            document.getElementById('pond-zone-badge').classList.toggle('hidden', !state.inPond);

            const baseSpeed = 12.2 * state.speedMultiplier * (state.hamsterBallActive ? 1.32 : 1.0);
            if (state.inPond) {
                // Hydroplane slide across the shallow park duck pond!
                state.vx += moveX * baseSpeed * 4.5 * dt;
                state.vz += moveZ * baseSpeed * 4.5 * dt;
                state.vx *= Math.pow(0.96, dt * 60);
                state.vz *= Math.pow(0.96, dt * 60);
                if (Math.hypot(state.vx, state.vz) > 4 && Math.random() < 0.35) {
                    spawnSplatBurstParticles(state.x, 0.2, state.z, 0xa5f3fc, 2);
                }
            } else {
                state.vx = moveX * baseSpeed;
                state.vz = moveZ * baseSpeed;
            }

            state.x += state.vx * dt;
            state.z += state.vz * dt;
            resolveObstacleCollisions(state);

            updateAimPointFromMouse();
            state.rotY = Math.atan2(state.aimWorldX - state.x, state.aimWorldZ - state.z);

            localHamsterMesh.position.set(state.x, 0, state.z);
            animateHamsterWalk(localHamsterMesh, Math.hypot(state.vx, state.vz), dt, state.rotY);

            if (state.mouseDown && !questionModalOpen && !shopModalOpen && state.screen !== 'join') {
                tryLocalPlayerFire();
            }

            // Camera Tracking (Supports Tactical Overhead OR Action Over-The-Shoulder 3D View!)
            if (state.cameraMode === 'shoulder') {
                const camDist = 11.5;
                const targetCamX = state.x - Math.sin(state.rotY) * camDist;
                const targetCamZ = state.z - Math.cos(state.rotY) * camDist;
                camera.position.x += (targetCamX - camera.position.x) * 9 * dt;
                camera.position.y += (8.8 - camera.position.y) * 9 * dt;
                camera.position.z += (targetCamZ - camera.position.z) * 9 * dt;
                camera.lookAt(
                    state.x + Math.sin(state.rotY) * 8,
                    1.8,
                    state.z + Math.cos(state.rotY) * 8
                );
            } else {
                camera.position.x += (state.x - camera.position.x) * 8 * dt;
                camera.position.y += (30 - camera.position.y) * 8 * dt;
                camera.position.z += (state.z + 22 - camera.position.z) * 8 * dt;
                camera.lookAt(state.x, 0.9, state.z - 1.5);
            }

            projectLabelToScreen(localNameLabel, state.x, -0.35, state.z + 1.4, ((state.hp + state.shield) / (state.maxHp + state.maxShield)) * 100);

            // 2. UPDATE SPEEDBALL AI HAMSTER BOTS
            aiBots.forEach((bot) => {
                bot.retargetTimer -= dt;
                if (bot.retargetTimer <= 0) {
                    bot.retargetTimer = 1.4 + Math.random() * 1.8;
                    const angle = Math.random() * Math.PI * 2;
                    bot.targetX = state.x + Math.cos(angle) * (8 + Math.random() * 13);
                    bot.targetZ = state.z + Math.sin(angle) * (8 + Math.random() * 13);
                }

                const dx = bot.targetX - bot.x;
                const dz = bot.targetZ - bot.z;
                const dist = Math.hypot(dx, dz);
                const botSpeed = isInsidePondZone(bot.x, bot.z) ? 11.5 : 8.6;

                if (dist > 0.6) {
                    bot.vx = (dx / dist) * botSpeed;
                    bot.vz = (dz / dist) * botSpeed;
                    bot.x += bot.vx * dt;
                    bot.z += bot.vz * dt;
                    resolveObstacleCollisions(bot);
                } else {
                    bot.vx = 0;
                    bot.vz = 0;
                }

                bot.rotY = Math.atan2(state.x - bot.x, state.z - bot.z);
                bot.mesh.position.set(bot.x, 0, bot.z);
                animateHamsterWalk(bot.mesh, Math.hypot(bot.vx, bot.vz), dt, bot.rotY);

                projectLabelToScreen(bot.labelEl, bot.x, -0.35, bot.z + 1.4, ((bot.hp + bot.shield) / 200) * 100);

                if (state.screen === 'playing') {
                    bot.shootCooldown -= dt;
                    const distToPlayer = Math.hypot(state.x - bot.x, state.z - bot.z);
                    if (bot.shootCooldown <= 0 && distToPlayer < 27) {
                        bot.shootCooldown = 1.35 + Math.random() * 1.3;
                        const leadX = state.x + (Math.random() - 0.5) * 3.2;
                        const leadZ = state.z + (Math.random() - 0.5) * 3.2;
                        firePaintball(bot.id, bot.name, bot.x, bot.z, leadX, leadZ, 0, 0.32);
                    }
                }
            });

            // 3. UPDATE REMOTE MULTIPLAYER HAMSTERS
            remotePlayersData.forEach((rData, uid) => {
                let rObj = remoteMeshes.get(uid);
                if (!rObj) {
                    const mesh = build3DHamsterMesh(rData.skinIdx || 0);
                    scene.add(mesh);
                    const labelEl = createWorldNameLabel(rData.name || 'Hamster', false);
                    rObj = { mesh, labelEl };
                    remoteMeshes.set(uid, rObj);
                }
                rObj.mesh.position.x += ((rData.x || 0) - rObj.mesh.position.x) * 10 * dt;
                rObj.mesh.position.z += ((rData.z || 0) - rObj.mesh.position.z) * 10 * dt;
                rObj.mesh.userData.hamsterBallMesh.visible = !!rData.hamsterBall;
                animateHamsterWalk(rObj.mesh, 4.5, dt, rData.rotY || 0);
                projectLabelToScreen(rObj.labelEl, rObj.mesh.position.x, -0.35, rObj.mesh.position.z + 1.4, (((rData.hp || 100) + (rData.shield || 0)) / 200) * 100);
            });

            // 4. UPDATE PAINTBALL PROJECTILES & SURFACE-NORMAL SPLAT DECALS
            for (let i = projectiles.length - 1; i >= 0; i--) {
                const p = projectiles[i];
                const prevPos = p.mesh.position.clone();

                p.age += dt;
                p.vy -= p.gravity * dt;
                p.mesh.position.x += p.vx * dt;
                p.mesh.position.y += p.vy * dt;
                p.mesh.position.z += p.vz * dt;

                let hit = false;
                let impactPos = p.mesh.position.clone();
                let impactNormal = new THREE.Vector3(0, 1, 0);

                // Raycast between prevPos and current position against splatTargets (bunkers, spools, ground)
                const stepVec = p.mesh.position.clone().sub(prevPos);
                const stepDist = stepVec.length();
                if (stepDist > 0.001) {
                    splatRaycaster.set(prevPos, stepVec.normalize());
                    splatRaycaster.far = stepDist + p.radius;
                    const hits = splatRaycaster.intersectObjects(splatTargets, false);
                    if (hits.length > 0 && hits[0].face) {
                        hit = true;
                        impactPos.copy(hits[0].point);
                        impactNormal.copy(hits[0].face.normal).transformDirection(hits[0].object.matrixWorld);
                    }
                }

                // Fallback radial obstacle check
                if (!hit) {
                    for (const obs of obstacles) {
                        if (p.mesh.position.y < (obs.h || 3.2)) {
                            const dx = p.mesh.position.x - obs.x;
                            const dz = p.mesh.position.z - obs.z;
                            const d = Math.hypot(dx, dz);
                            if (d < obs.r + p.radius) {
                                hit = true;
                                impactNormal.set(dx / (d || 1), 0.15, dz / (d || 1)).normalize();
                                break;
                            }
                        }
                    }
                }

                // Check AI Bot hits
                if (!hit && p.ownerId === 'local') {
                    for (const bot of aiBots) {
                        const hitRadius = p.isBomb ? 3.5 : 1.38;
                        if (Math.hypot(p.mesh.position.x - bot.x, p.mesh.position.z - bot.z) < hitRadius) {
                            hit = true;
                            const dmg = p.damage + (Math.random() > 0.62 ? 75 : 0);
                            if (bot.shield > 0) {
                                const sDmg = Math.min(bot.shield, dmg);
                                bot.shield -= sDmg;
                                bot.hp -= (dmg - sDmg);
                            } else {
                                bot.hp -= dmg;
                            }

                            addPaintStainOnHamster(bot.mesh, p.color);
                            spawnFloatingDamageNumber(bot.x, 2.7, bot.z, dmg);
                            sfx.playSplat();

                            if (bot.hp <= 0) {
                                state.kos++;
                                state.seeds += 45;
                                triggerKnockoutAlert(bot.name);
                                pushKillfeedItem(state.playerName, bot.name, p.color);
                                updateHUD();
                                bot.hp = 100;
                                bot.shield = 100;
                                bot.mesh.userData.coatStainsGroup.clear();
                                const a = Math.random() * Math.PI * 2;
                                bot.x = Math.cos(a) * 26;
                                bot.z = Math.sin(a) * 18;
                            }
                            break;
                        }
                    }
                }

                // Check Local Player hit by opponent paintball
                if (!hit && p.ownerId !== 'local' && !state.isSpectator) {
                    if (Math.hypot(p.mesh.position.x - state.x, p.mesh.position.z - state.z) < 1.32) {
                        hit = true;
                        if (state.hamsterBallActive) {
                            spawnFloatingDamageNumber(state.x, 2.7, state.z, 0, 'DEFLECTED!');
                        } else {
                            const dmg = p.damage;
                            if (state.shield > 0) {
                                const sDmg = Math.min(state.shield, dmg);
                                state.shield -= sDmg;
                                state.hp -= (dmg - sDmg);
                            } else {
                                state.hp -= dmg;
                            }
                            addPaintStainOnHamster(localHamsterMesh, p.color);
                            triggerVisorGoggleSplat(p.color);
                            spawnFloatingDamageNumber(state.x, 2.7, state.z, dmg);
                            sfx.playSplat();

                            if (state.hp <= 0) {
                                pushKillfeedItem(p.ownerName || 'Bot', state.playerName, p.color);
                                state.hp = state.maxHp;
                                state.shield = state.maxShield;
                                localHamsterMesh.userData.coatStainsGroup.clear();
                                state.x = -9;
                                state.z = 5;
                                spawnFloatingDamageNumber(state.x, 2.8, state.z, 0, 'RE-ENTERED PARK!');
                            }
                            updateHUD();
                        }
                    }
                }

                if (!hit && (p.mesh.position.y <= 0.12 || p.age > 3.0)) {
                    hit = true;
                    impactPos.y = 0.03;
                    impactNormal.set(0, 1, 0);
                }

                if (hit) {
                    createSurfacePaintSplat(impactPos, impactNormal, p.color, p.isBomb ? 2.2 : 1.0);
                    spawnSplatBurstParticles(impactPos.x, Math.max(0.3, impactPos.y), impactPos.z, p.color, p.isBomb ? 24 : 12);
                    scene.remove(p.mesh);
                    projectiles.splice(i, 1);
                }
            }

            // 5. UPDATE FLYING PAINT DROPLETS
            for (let i = particles.length - 1; i >= 0; i--) {
                const pt = particles[i];
                pt.life -= dt;
                pt.vy -= 18 * dt;
                pt.mesh.position.x += pt.vx * dt;
                pt.mesh.position.y += pt.vy * dt;
                pt.mesh.position.z += pt.vz * dt;
                if (pt.life <= 0 || pt.mesh.position.y < 0) {
                    scene.remove(pt.mesh);
                    particles.splice(i, 1);
                }
            }

            // 6. UPDATE PARK POWER-UP CRATES
            for (let i = powerupCrates.length - 1; i >= 0; i--) {
                const crate = powerupCrates[i];
                crate.mesh.rotation.y += dt * 2.2;
                crate.mesh.position.y = 1.15 + Math.sin(now * 0.004 + i) * 0.25;

                if (Math.hypot(state.x - crate.x, state.z - crate.z) < 1.95) {
                    if (crate.type === 'seeds') state.seeds += 50;
                    if (crate.type === 'paint') {
                        state.ammo = state.maxAmmo;
                        state.reserveAmmo += 16;
                    }
                    if (crate.type === 'shield') {
                        state.shield = Math.min(state.maxShield, state.shield + 60);
                    }
                    sfx.playCorrect();
                    spawnFloatingDamageNumber(crate.x, 2.5, crate.z, 0, crate.label);
                    scene.remove(crate.mesh);
                    powerupCrates.splice(i, 1);
                    updateHUD();
                    setTimeout(spawnPowerupCrate, 6000);
                }
            }

            renderParkRadar();
            broadcastLocalPlayerState();
            renderer.render(scene, camera);
        }

