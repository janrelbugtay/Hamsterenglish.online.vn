        function firePaintball(ownerId, ownerName, startX, startZ, targetX, targetZ, weaponType = 0, dmgMult = 1.0, customColor = null, isRemote = false) {
            const dx = targetX - startX;
            const dz = targetZ - startZ;
            const baseAngle = Math.atan2(dx, dz);
            const dist = Math.min(Math.hypot(dx, dz), 30);

            let shots = [{ angleOffset: 0, speed: 32, radius: 0.32, baseDmg: 85, isBomb: false }];

            if (weaponType === 1) {
                // Triple-Burst Electro Marker
                shots = [
                    { angleOffset: -0.14, speed: 30, radius: 0.30, baseDmg: 65, isBomb: false },
                    { angleOffset: 0, speed: 32, radius: 0.32, baseDmg: 75, isBomb: false },
                    { angleOffset: 0.14, speed: 30, radius: 0.30, baseDmg: 65, isBomb: false }
                ];
            } else if (weaponType === 2) {
                // Lobbed Paint Grenade Pod
                shots = [
                    { angleOffset: 0, speed: Math.max(15, dist * 0.88), radius: 0.62, baseDmg: 160, isBomb: true }
                ];
            }

            const chosenColor = customColor || PAINT_PALETTE[Math.floor(Math.random() * PAINT_PALETTE.length)];

            shots.forEach((cfg) => {
                const angle = baseAngle + cfg.angleOffset;
                const group = new THREE.Group();

                // Glossy Gelatin Paintball Capsule with Specular Clearcoat
                const ballMesh = new THREE.Mesh(
                    new THREE.SphereGeometry(cfg.radius, 16, 14),
                    new THREE.MeshPhysicalMaterial({
                        color: chosenColor,
                        roughness: 0.04,
                        metalness: 0.05,
                        clearcoat: 1.0,
                        clearcoatRoughness: 0.02
                    })
                );
                ballMesh.castShadow = true;
                group.add(ballMesh);

                // Subtle trailing velocity streak
                const streak = new THREE.Mesh(
                    new THREE.ConeGeometry(cfg.radius * 0.7, cfg.radius * 3.8, 8),
                    new THREE.MeshBasicMaterial({ color: chosenColor, transparent: true, opacity: 0.45 })
                );
                streak.rotation.x = -Math.PI / 2;
                streak.position.z = -cfg.radius * 1.8;
                group.add(streak);

                group.position.set(startX + Math.sin(angle) * 1.25, 1.55, startZ + Math.cos(angle) * 1.25);
                group.rotation.y = angle;
                scene.add(group);

                projectiles.push({
                    ownerId,
                    ownerName,
                    mesh: group,
                    color: chosenColor,
                    vx: Math.sin(angle) * cfg.speed,
                    vy: cfg.isBomb ? 10.2 : 2.3,
                    vz: Math.cos(angle) * cfg.speed,
                    gravity: cfg.isBomb ? 22 : 9.8,
                    radius: cfg.radius,
                    damage: Math.round(cfg.baseDmg * dmgMult),
                    isBomb: cfg.isBomb,
                    age: 0
                });
            });

            if (ownerId === 'local') {
                sfx.playMarkerShot();
                localHamsterMesh.userData.recoilOffset = 0.32;
                if (parkChannel && !isRemote) {
                    parkChannel.postMessage({
                        type: 'paintballShot',
                        uid: localTabId,
                        roomCode: state.roomCode,
                        name: state.playerName,
                        sx: startX,
                        sz: startZ,
                        tx: targetX,
                        tz: targetZ,
                        weaponType,
                        color: chosenColor
                    });
                }
            }
        }

        // Surface-Adhering Wet Paint Splat Decal (Oriented along exact impact normal!)
        function createSurfacePaintSplat(impactPos, impactNormal, colorHex, scale = 1.0) {
            const splatMat = new THREE.MeshPhysicalMaterial({
                color: colorHex,
                alphaMap: sharedSplatAlphaTexture,
                transparent: true,
                opacity: 0.95,
                roughness: 0.06,
                metalness: 0.05,
                clearcoat: 1.0,
                clearcoatRoughness: 0.04,
                depthWrite: false,
                polygonOffset: true,
                polygonOffsetFactor: -2
            });

            const size = (2.1 + Math.random() * 0.7) * scale;
            const splatMesh = new THREE.Mesh(new THREE.PlaneGeometry(size, size), splatMat);

            const normal = impactNormal.clone().normalize();
            splatMesh.position.copy(impactPos).addScaledVector(normal, 0.03 + (splatDecals.length % 15) * 0.001);

            const targetQuat = new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, 0, 1), normal);
