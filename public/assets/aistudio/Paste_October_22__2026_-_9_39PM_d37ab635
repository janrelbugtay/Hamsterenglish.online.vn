      // -----------------------------------------------------------------------
      // 4. HIGH-DEFINITION CAMERA + 1-EURO VELOCITY-PREDICTED FACE & HAND TRACKER
      // -----------------------------------------------------------------------
      const webcamVideo = document.getElementById('webcamVideo');
      const motionCanvas = document.getElementById('motionCanvas');
      const motionCtx = motionCanvas.getContext('2d', { willReadFrequently: true });
      const gameCanvas = document.getElementById('gameCanvas');
      const ctx = gameCanvas.getContext('2d');

      function getCameraCoverTransform(cw, ch) {
        const vw = webcamVideo.videoWidth || 1280;
        const vh = webcamVideo.videoHeight || 720;
        const scale = Math.max(cw / vw, ch / vh);
        const drawW = vw * scale;
        const drawH = vh * scale;
        const offsetX = (cw - drawW) * 0.5;
        const offsetY = (ch - drawH) * 0.5;
        return { vw, vh, scale, drawW, drawH, offsetX, offsetY };
      }

      function mapCamToCanvasNorm(mirroredCamX, camY) {
        const cw = state.viewW || window.innerWidth;
        const ch = state.viewH || window.innerHeight;
        const tr = getCameraCoverTransform(cw, ch);
        const px = tr.offsetX + mirroredCamX * tr.drawW;
        const py = tr.offsetY + camY * tr.drawH;
        return {
          x: Math.max(0.02, Math.min(0.98, px / cw)),
          y: Math.max(0.04, Math.min(0.96, py / ch))
        };
      }

      // 1-Euro Adaptive Smoothing Helper: low jitter at rest, near-zero lag during fast movement
      function adaptiveSmooth(current, target, minAlpha, speedMultiplier) {
        const delta = Math.abs(target - current);
        const alpha = Math.min(0.94, Math.max(minAlpha, delta * speedMultiplier));
        return current + (target - current) * alpha;
      }

      function initMediaPipeFace() {
        if (state.mpFace || typeof window.FaceDetection === 'undefined') return;
        try {
          const faceDetection = new window.FaceDetection({
            locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/face_detection@0.4/${file}`
          });
          faceDetection.setOptions({
            model: 'short',
            minDetectionConfidence: 0.42
          });
          faceDetection.onResults((results) => {
            state.mpFaceReady = true;
            if (!results || !results.detections || results.detections.length === 0) return;

            const now = performance.now();
            const faces = results.detections.map((det) => {
              const bb = det.boundingBox;
              const mirroredX = 1.0 - bb.xCenter;
              const mapped = mapCamToCanvasNorm(mirroredX, bb.yCenter);

              let tilt = -0.03;
              if (det.landmarks && det.landmarks.length >= 2) {
                const eye0 = det.landmarks[0];
                const eye1 = det.landmarks[1];
                const ex0 = 1.0 - eye0.x;
                const ex1 = 1.0 - eye1.x;
                const leftEye = ex0 < ex1 ? { x: ex0, y: eye0.y } : { x: ex1, y: eye1.y };
                const rightEye = ex0 < ex1 ? { x: ex1, y: eye1.y } : { x: ex0, y: eye0.y };
                tilt = Math.atan2(rightEye.y - leftEye.y, rightEye.x - leftEye.x);
                tilt = Math.max(-0.45, Math.min(0.45, tilt));
              }

              const faceScale = Math.max(0.75, Math.min(1.55, (bb.width || 0.18) / 0.17));
              return { x: mapped.x, y: mapped.y, scale: faceScale, tilt: tilt };
            }).sort((a, b) => a.x - b.x);

            if (state.numPlayers === 1) {
              const f = faces[0];
              const p0 = state.players[0];
              p0.headVx = f.x - p0.headX;
              p0.headVy = f.y - p0.headY;
              p0.headX = adaptiveSmooth(p0.headX, f.x + p0.headVx * 0.25, 0.35, 9.0);
              p0.headY = adaptiveSmooth(p0.headY, f.y + p0.headVy * 0.25, 0.35, 9.0);
              p0.headScale = adaptiveSmooth(p0.headScale, f.scale, 0.30, 5.0);
              p0.headTilt = adaptiveSmooth(p0.headTilt, f.tilt, 0.35, 6.0);
              p0.lastFaceSeen = now;
            } else {
              faces.forEach((f) => {
                const pIdx = f.x < 0.5 ? 0 : 1;
                const p = state.players[pIdx];
                p.headVx = f.x - p.headX;
                p.headVy = f.y - p.headY;
                p.headX = adaptiveSmooth(p.headX, f.x + p.headVx * 0.25, 0.35, 9.0);
                p.headY = adaptiveSmooth(p.headY, f.y + p.headVy * 0.25, 0.35, 9.0);
                p.headScale = adaptiveSmooth(p.headScale, f.scale, 0.30, 5.0);
                p.headTilt = adaptiveSmooth(p.headTilt, f.tilt, 0.35, 6.0);
                p.lastFaceSeen = now;
              });
            }
          });
          state.mpFace = faceDetection;
        } catch (err) {
          state.mpFace = null;
        }
      }

      function initMediaPipeHands() {
        if (state.mpHands || typeof window.Hands === 'undefined') return;
        try {
          const hands = new window.Hands({
            locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands@0.4.1675469240/${file}`
          });
          hands.setOptions({
            maxNumHands: 4,
            modelComplexity: 1,
            minDetectionConfidence: 0.42,
            minTrackingConfidence: 0.42
          });
          hands.onResults((results) => {
            state.mpHandsReady = true;
            state.lastHandsTimestamp = performance.now();

            if (!results || !results.multiHandLandmarks || results.multiHandLandmarks.length === 0) {
              state.players.forEach(p => {
                p.leftHand.tracked = false;
                p.rightHand.tracked = false;
              });
              return;
            }

            const detectedHands = results.multiHandLandmarks.map((landmarks) => {
              const wrist = landmarks[0];
              const indexMcp = landmarks[5] || wrist;
              const midMcp = landmarks[9] || wrist;
              const indexTip = landmarks[8] || midMcp;
              const midTip = landmarks[12] || indexTip;

              const rawMirroredX = 1.0 - (wrist.x * 0.30 + midMcp.x * 0.45 + midTip.x * 0.25);
              const rawY = (wrist.y * 0.30 + midMcp.y * 0.45 + midTip.y * 0.25);
              const mapped = mapCamToCanvasNorm(rawMirroredX, rawY);

              // Exact wrist-to-finger direction vector in mirrored coordinates
              const dx = (1.0 - (midTip.x * 0.6 + indexTip.x * 0.4)) - (1.0 - wrist.x);
              const dy = (midTip.y * 0.6 + indexTip.y * 0.4) - wrist.y;
              const pointingAngle = Math.atan2(dy, dx);
              const gloveAngle = pointingAngle + Math.PI / 2;

              const handLen = Math.hypot(dx, dy);
              const handScale = Math.max(0.78, Math.min(1.5, handLen / 0.21));

              return {
                x: mapped.x,
                y: mapped.y,
                pointingAngle: pointingAngle,
                angle: gloveAngle,
                scale: handScale
              };
            }).sort((a, b) => a.x - b.x);

            if (state.numPlayers === 1) {
              applyDetectedHandsToPlayer(state.players[0], detectedHands);
            } else {
              const p1Hands = detectedHands.filter(h => h.x < 0.52);
              const p2Hands = detectedHands.filter(h => h.x >= 0.52);
              applyDetectedHandsToPlayer(state.players[0], p1Hands);
              applyDetectedHandsToPlayer(state.players[1], p2Hands);
            }
          });
          state.mpHands = hands;
        } catch (err) {
          state.mpHands = null;
        }
      }

      function applyDetectedHandsToPlayer(p, handsList) {
        if (!handsList || handsList.length === 0) {
          p.leftHand.tracked = false;
          p.rightHand.tracked = false;
          return;
        }

        if (handsList.length === 1) {
          const h = handsList[0];
          updatePlayerHandPosition(p.id, h.x, h.y, true, h.pointingAngle, h.scale);
          const distL = Math.hypot(h.x - p.leftHand.x, h.y - p.leftHand.y);
          const distR = Math.hypot(h.x - p.rightHand.x, h.y - p.rightHand.y);
          if (distL <= distR) {
            updateSingleGlove(p, p.leftHand, h.x, h.y, h.angle, h.scale);
            p.rightHand.tracked = false;
          } else {
            updateSingleGlove(p, p.rightHand, h.x, h.y, h.angle, h.scale);
            p.leftHand.tracked = false;
          }
        } else {
          const hLeft = handsList[0];
          const hRight = handsList[handsList.length - 1];
          updateSingleGlove(p, p.leftHand, hLeft.x, hLeft.y, hLeft.angle, hLeft.scale);
          updateSingleGlove(p, p.rightHand, hRight.x, hRight.y, hRight.angle, hRight.scale);

          const midX = (p.leftHand.x + p.rightHand.x) * 0.5;
          const midY = (p.leftHand.y + p.rightHand.y) * 0.5;
          // In Chop Chop mode, use the faster/dominant hand for the fencing sword
          const activeSwordHand = (p.rightHand.speed >= p.leftHand.speed * 0.8) ? hRight : hLeft;
          if (state.activeRoundMode === 'chop') {
            updatePlayerHandPosition(p.id, activeSwordHand.x, activeSwordHand.y, true, activeSwordHand.pointingAngle, activeSwordHand.scale);
          } else {
            updatePlayerHandPosition(p.id, midX, midY, true, hRight.pointingAngle, hRight.scale);
          }

          // Two-Hand Clap Slap Detection in Mosquito Slap Mode
          const handSeparation = Math.hypot(p.leftHand.x - p.rightHand.x, p.leftHand.y - p.rightHand.y);
          const closingSpeed = (p.leftHand.speed + p.rightHand.speed);
          if (state.inGame && !state.roundResolved && state.activeRoundMode === 'mosquito') {
            if (handSeparation < 0.17 && (closingSpeed > 0.010 || p.clapCooldown <= 0)) {
              p.slapAnim = 1.0;
              p.clapCooldown = 16;
              checkTargetInteractions(p.id, midX, midY, true);
            }
          }

          if (performance.now() - p.lastFaceSeen > 550) {
            const inferredHeadX = midX;
            const inferredHeadY = Math.max(0.20, midY - 0.19);
            p.headX = adaptiveSmooth(p.headX, inferredHeadX, 0.22, 6.0);
            p.headY = adaptiveSmooth(p.headY, inferredHeadY, 0.22, 6.0);
          }
        }
      }

      function updateSingleGlove(p, glove, targetX, targetY, targetAngle, targetScale) {
        glove.prevX = glove.x;
        glove.prevY = glove.y;
        // Velocity-predicted 1-Euro smoothing
        const vx = targetX - glove.x;
        const vy = targetY - glove.y;
        glove.x = adaptiveSmooth(glove.x, targetX + vx * 0.3, 0.45, 9.5);
        glove.y = adaptiveSmooth(glove.y, targetY + vy * 0.3, 0.45, 9.5);
        glove.speed = Math.hypot(glove.x - glove.prevX, glove.y - glove.prevY);
        glove.angle = adaptiveSmooth(glove.angle, targetAngle, 0.45, 6.0);
        glove.scale = adaptiveSmooth(glove.scale, targetScale, 0.35, 5.0);
        glove.tracked = true;

        if (state.inGame && !state.roundResolved) {
          if (state.activeRoundMode === 'mosquito' && glove.speed > 0.011) {
            p.slapAnim = 1.0;
            checkTargetInteractions(p.id, glove.x, glove.y, true);
          }
        }
      }

      async function startCamera(silent = false) {
        const btnCamInGame = document.getElementById('btnToggleCamInGame');

        if (state.cameraActive && state.cameraStream) {
          stopCamera();
          return;
        }

        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
          if (!silent) showToast('Camera unavailable; using 3D AR Simulation + Mouse/Touch!', '🕹️');
          updateCameraUI(false, '3D AR Simulation');
          return;
        }

        try {
          const stream = await navigator.mediaDevices.getUserMedia({
            video: {
              width: { ideal: 1280 },
              height: { ideal: 720 },
              frameRate: { ideal: 60 },
              facingMode: 'user'
            },
            audio: false
          });
          webcamVideo.srcObject = stream;
          await webcamVideo.play();
          state.cameraStream = stream;
          state.cameraActive = true;
          state.prevFrameData = null;
          initMediaPipeFace();
          initMediaPipeHands();
          updateCameraUI(true, 'HD Cam Live');
          if (!silent) showToast('HD Camera connected! 3D AR Tracking active!', '📷');
        } catch (err) {
          state.cameraActive = false;
          updateCameraUI(false, '3D Virtual AR');
          if (!silent) showToast('Using 3D Virtual AR + Mouse/Touch Controls!', '🤺');
        }

        if (btnCamInGame) {
          btnCamInGame.textContent = state.cameraActive ? '📷 Cam: HD ON' : '📷 Cam: Virtual 3D';
        }
      }

      function stopCamera() {
        if (state.cameraStream) {
          state.cameraStream.getTracks().forEach(t => t.stop());
          state.cameraStream = null;
        }
        state.cameraActive = false;
        state.prevFrameData = null;
        updateCameraUI(false, 'Cam Paused');
        const btnCamInGame = document.getElementById('btnToggleCamInGame');
        if (btnCamInGame) btnCamInGame.textContent = '📷 Cam: Virtual 3D';
      }

      function updateCameraUI(isLive, statusText) {
