      // -----------------------------------------------------------------------
      // 8. ULTRA-CRISP 3D RENDERING:
      //    - MOSQUITO SLAP: Purple Beekeeper Mosquito-Net Hat + 2 Purple Clapping Gloves
      //    - CHOP CHOP: 3D Metallic Steel-Mesh Fencing Mask + Long 3D Fencing Sword (`image_2333c3.png`)
      // -----------------------------------------------------------------------
      function drawBackgroundAndCamera(cw, ch, time) {
        if (state.cameraActive && webcamVideo.readyState >= 2) {
          const tr = getCameraCoverTransform(cw, ch);
          ctx.save();
          ctx.translate(cw, 0);
          ctx.scale(-1, 1);
          ctx.drawImage(webcamVideo, cw - tr.offsetX - tr.drawW, tr.offsetY, tr.drawW, tr.drawH);
          ctx.restore();

          // Subtle vibrant vignette around outer edges only (keeps face 100% bright & sharp!)
          const vig = ctx.createRadialGradient(cw * 0.5, ch * 0.5, cw * 0.3, cw * 0.5, ch * 0.5, cw * 0.78);
          vig.addColorStop(0, 'rgba(0,0,0,0)');
          vig.addColorStop(1, 'rgba(2, 6, 23, 0.38)');
          ctx.fillStyle = vig;
          ctx.fillRect(0, 0, cw, ch);
        } else {
          // Vibrant 3D Atmospheric Studio Arena when camera is off
          const grad = ctx.createRadialGradient(cw * 0.5, ch * 0.38, 40, cw * 0.5, ch * 0.5, Math.max(cw, ch) * 0.85);
          if (state.activeRoundMode === 'mosquito') {
            grad.addColorStop(0, '#2e1065');
            grad.addColorStop(0.55, '#1e1b4b');
            grad.addColorStop(1, '#090d16');
          } else {
            grad.addColorStop(0, '#1e293b');
            grad.addColorStop(0.55, '#0f172a');
            grad.addColorStop(1, '#020617');
          }
          ctx.fillStyle = grad;
          ctx.fillRect(0, 0, cw, ch);

          // 3D Perspective Floor Grid & Glowing Orbs
          ctx.save();
          ctx.strokeStyle = state.activeRoundMode === 'mosquito'
            ? 'rgba(168, 85, 247, 0.14)'
            : 'rgba(56, 189, 248, 0.14)';
          ctx.lineWidth = 1;
          for (let i = 0; i < 14; i++) {
            const bx = ((i * 197 + time * 0.025) % cw);
            const by = ((i * 131 + Math.sin(time * 0.0012 + i) * 40) % ch);
            ctx.fillStyle = state.activeRoundMode === 'mosquito'
              ? 'rgba(216, 180, 254, 0.22)'
              : 'rgba(125, 211, 252, 0.22)';
            ctx.beginPath();
            ctx.arc(bx, by, 3.5 + (i % 4), 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.restore();
        }

        if (state.numPlayers === 2) {
          ctx.save();
          ctx.strokeStyle = 'rgba(255, 255, 255, 0.28)';
          ctx.lineWidth = 2;
          ctx.setLineDash([10, 10]);
          ctx.beginPath();
          ctx.moveTo(cw / 2, 0);
          ctx.lineTo(cw / 2, ch);
          ctx.stroke();
          ctx.restore();
        }
      }

      // Dispatcher: Draws Purple Mosquito-Net Hat in Mosquito Slap mode,
