      // -----------------------------------------------------------------------
      // HEADGEAR A (MOSQUITO SLAP): Purple Beekeeper Mosquito-Net Hat (`image.png`)
      // -----------------------------------------------------------------------
      function drawPurpleMosquitoNetHat(p, cw, ch) {
        const hx = p.headX * cw;
        const hy = p.headY * ch;
        const baseScale = Math.max(0.75, Math.min(1.28, cw / 960)) * p.headScale;
        const th = p.theme;

        ctx.save();
        ctx.translate(hx, hy);
        ctx.rotate(p.headTilt);
        ctx.scale(baseScale, baseScale);

        if (!state.cameraActive) {
          ctx.fillStyle = '#ea580c';
          ctx.strokeStyle = '#1e1042';
          ctx.lineWidth = 4;
          ctx.beginPath();
          ctx.ellipse(0, 185, 130, 82, 0, Math.PI, 0, false);
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = '#1e1b2e';
          ctx.beginPath();
          ctx.ellipse(0, 30, 82, 95, 0, 0, Math.PI * 2);
          ctx.fill();

          ctx.fillStyle = '#fde0c4';
          ctx.beginPath();
          ctx.ellipse(0, 15, 62, 74, 0, 0, Math.PI * 2);
          ctx.fill();

          ctx.strokeStyle = '#64748b';
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.arc(-24, -4, 17, 0, Math.PI * 2);
          ctx.arc(24, -4, 17, 0, Math.PI * 2);
          ctx.moveTo(-7, -4);
          ctx.lineTo(7, -4);
          ctx.stroke();

          ctx.fillStyle = '#ffffff';
          ctx.strokeStyle = '#be123c';
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.arc(0, 32, 18, 0.1, Math.PI - 0.1, false);
          ctx.closePath();
          ctx.fill();
          ctx.stroke();
        }

        const veilTopY = -46;
        const veilBottomY = 96;
        const veilTopHalfW = 122;
        const veilBotHalfW = 114;

        // 3D Translucent White Cylindrical Mosquito Veil
        const veilGrad = ctx.createLinearGradient(-veilTopHalfW, 0, veilTopHalfW, 0);
        veilGrad.addColorStop(0, 'rgba(255, 255, 255, 0.55)');
        veilGrad.addColorStop(0.18, 'rgba(241, 245, 249, 0.28)');
        veilGrad.addColorStop(0.5, 'rgba(248, 250, 252, 0.20)');
        veilGrad.addColorStop(0.82, 'rgba(241, 245, 249, 0.30)');
        veilGrad.addColorStop(1, 'rgba(255, 255, 255, 0.56)');

        ctx.fillStyle = veilGrad;
        ctx.beginPath();
        ctx.moveTo(-veilTopHalfW, veilTopY);
        ctx.lineTo(-veilBotHalfW, veilBottomY);
        ctx.quadraticCurveTo(0, veilBottomY + 28, veilBotHalfW, veilBottomY);
        ctx.lineTo(veilTopHalfW, veilTopY);
        ctx.quadraticCurveTo(0, veilTopY - 18, -veilTopHalfW, veilTopY);
        ctx.closePath();
        ctx.fill();

        ctx.save();
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.24)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        for (let x = -104; x <= 104; x += 12) {
          ctx.moveTo(x, veilTopY);
          ctx.lineTo(x * 0.94, veilBottomY + 8);
        }
        for (let y = veilTopY + 12; y <= veilBottomY; y += 12) {
          ctx.moveTo(-114, y);
          ctx.lineTo(114, y + 4);
        }
        ctx.stroke();
        ctx.restore();

        ctx.strokeStyle = th.outline;
        ctx.lineWidth = 4.5;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(-veilTopHalfW, veilTopY + 4);
        ctx.lineTo(-veilBotHalfW, veilBottomY);
        ctx.moveTo(veilTopHalfW, veilTopY + 4);
        ctx.lineTo(veilBotHalfW, veilBottomY);
        ctx.stroke();

        // Rolled Purple Bottom Rim
        ctx.fillStyle = th.hatMain;
        ctx.strokeStyle = th.outline;
        ctx.lineWidth = 4.5;
        ctx.beginPath();
        ctx.moveTo(-veilBotHalfW - 6, veilBottomY - 4);
        ctx.quadraticCurveTo(0, veilBottomY + 26, veilBotHalfW + 6, veilBottomY - 4);
        ctx.quadraticCurveTo(veilBotHalfW + 10, veilBottomY + 10, veilBotHalfW - 2, veilBottomY + 14);
        ctx.quadraticCurveTo(0, veilBottomY + 42, -veilBotHalfW + 2, veilBottomY + 14);
        ctx.quadraticCurveTo(-veilBotHalfW - 10, veilBottomY + 10, -veilBotHalfW - 6, veilBottomY - 4);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        ctx.strokeStyle = th.hatLight;
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(-veilBotHalfW + 14, veilBottomY + 5);
        ctx.quadraticCurveTo(0, veilBottomY + 29, veilBotHalfW - 14, veilBottomY + 5);
        ctx.stroke();

        // Left Feather Plume
        ctx.fillStyle = th.plume;
        ctx.strokeStyle = th.outline;
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.moveTo(-58, -98);
        ctx.quadraticCurveTo(-115, -135, -162, -124);
        ctx.lineTo(-148, -110);
        ctx.lineTo(-175, -102);
        ctx.lineTo(-152, -88);
        ctx.lineTo(-168, -78);
        ctx.lineTo(-132, -72);
        ctx.lineTo(-142, -60);
        ctx.quadraticCurveTo(-96, -64, -55, -74);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        // 3D Shaded Purple Hat Dome
        const domeGrad = ctx.createRadialGradient(-22, -110, 10, 0, -90, 95);
        domeGrad.addColorStop(0, th.hatLight);
        domeGrad.addColorStop(0.55, th.hatMain);
        domeGrad.addColorStop(1, th.hatDark);
        ctx.fillStyle = domeGrad;
        ctx.strokeStyle = th.outline;
        ctx.lineWidth = 5;
        ctx.beginPath();
        ctx.moveTo(-78, -66);
        ctx.bezierCurveTo(-82, -138, 82, -138, 78, -66);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        // Brown Hatband + Gold Buckle
        ctx.fillStyle = th.band;
        ctx.strokeStyle = th.outline;
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.moveTo(-78, -82);
        ctx.quadraticCurveTo(0, -94, 78, -82);
        ctx.lineTo(81, -64);
        ctx.quadraticCurveTo(0, -76, -81, -64);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = th.buckle;
        ctx.beginPath();
        ctx.moveTo(28, -86);
