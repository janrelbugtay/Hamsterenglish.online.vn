      // -----------------------------------------------------------------------
      // 7. SLAP & FULL-LENGTH FENCING SWORD BLADE COLLISION LOGIC
      // -----------------------------------------------------------------------
      // Distance from point (px, py) to line segment (x1, y1)-(x2, y2)
      function distToSegment(px, py, x1, y1, x2, y2) {
        const l2 = (x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1);
        if (l2 === 0) return Math.hypot(px - x1, py - y1);
        let t = ((px - x1) * (x2 - x1) + (py - y1) * (y2 - y1)) / l2;
        t = Math.max(0, Math.min(1, t));
        return Math.hypot(px - (x1 + t * (x2 - x1)), py - (y1 + t * (y2 - y1)));
      }

      // Checks if ANY part of the long 3D Fencing Sword blade (from hilt to tip) sliced a fruit!
      function checkSwordBladeCollisions(playerIdx, hx, hy, tipX, tipY) {
        if (!state.inGame || state.roundResolved) return;
        for (let i = 0; i < state.targets.length; i++) {
          const t = state.targets[i];
          if (!t.alive || t.cooldown > 0) continue;

          const d = distToSegment(t.x, t.y, hx, hy, tipX, tipY);
          if (d <= t.radius + 22) {
            triggerTargetHit(playerIdx, t);
            break;
          }
        }
      }

      function checkTargetInteractions(playerIdx, normX, normY, isDirectClickOrSlap) {
        if (!state.inGame || state.roundResolved) return;

        const cw = state.viewW;
        const ch = state.viewH;
        const px = normX * cw;
        const py = normY * ch;
        const p = state.players[playerIdx];

        if (state.activeRoundMode === 'chop') {
          const bladeLen = getFencingSwordBladeLength(cw, p);
          const tipX = px + Math.cos(p.swordAngle) * bladeLen;
          const tipY = py + Math.sin(p.swordAngle) * bladeLen;
          checkSwordBladeCollisions(playerIdx, px, py, tipX, tipY);
          return;
        }

        for (let i = 0; i < state.targets.length; i++) {
          const t = state.targets[i];
          if (!t.alive || t.cooldown > 0) continue;

          const dist = Math.hypot(px - t.x, py - t.y);
          const hitRadius = t.radius + (isDirectClickOrSlap ? 44 : 32);

          if (dist <= hitRadius) {
            triggerTargetHit(playerIdx, t);
            break;
          }
        }
      }

      function triggerTargetHit(playerIdx, target) {
        if (state.roundResolved) return;
        const p = state.players[playerIdx];
        p.slapAnim = 1.0;
        p.swordLunge = 1.0;

        if (target.isCorrect) {
          target.alive = false;
          state.roundResolved = true;
          const pts = 100 * p.streak + Math.round(state.questionTimer * 5);
          p.score += pts;
          p.hits += 1;
          p.streak = Math.min(5, p.streak + 1);

          if (state.activeRoundMode === 'mosquito') {
            playSlapSound(true);
            state.splats.push({
              x: target.x,
              y: target.y,
              color: '#a855f7',
              alpha: 1.0
            });
            spawnBurstParticles(target.x, target.y, '#c084fc', 32);
            spawnFloatingText(
              target.x,
              target.y - 24,
              `👏 CLAP SLAP! ${target.letter} +${pts}`,
              '#4ade80'
            );
          } else {
            playSwordSlashSound(true);
            spawnSlicedFruitHalves(target);
            spawnBurstParticles(target.x, target.y, target.color.main, 42);
            spawnFloatingText(
              target.x,
              target.y - 24,
              `🤺 EN GARDE SLICE! ${target.letter} +${pts}`,
              '#38bdf8'
            );
          }

          updateScoreCardsHUD();
          setTimeout(() => {
            if (!state.inGame) return;
            state.currentQIndex++;
            loadCurrentQuestion();
          }, 1200);
        } else {
          target.cooldown = 32;
          p.streak = 1;
          p.score = Math.max(0, p.score - 25);

          if (state.activeRoundMode === 'mosquito') {
            playSlapSound(false);
            target.vx = -target.vx * 1.3;
            target.vy = -target.vy * 1.3;
            spawnBurstParticles(target.x, target.y, '#f43f5e', 14);
            spawnFloatingText(target.x, target.y - 15, `❌ OUCH! Not ${target.letter} (-25)`, '#fb7185');
          } else {
            playSwordSlashSound(false);
            target.alive = false;
            spawnSlicedFruitHalves(target);
            spawnBurstParticles(target.x, target.y, '#f43f5e', 20);
            spawnFloatingText(target.x, target.y - 15, `❌ WRONG (${target.letter})! -25`, '#fb7185');
          }
          updateScoreCardsHUD();
        }
      }

      function spawnSlicedFruitHalves(target) {
        for (let side = -1; side <= 1; side += 2) {
          state.slicedHalves.push({
            x: target.x + side * 14,
            y: target.y,
            vx: target.vx + side * (3.6 + Math.random() * 1.6),
            vy: -4.0 - Math.random() * 2,
            rotation: target.rotation,
            rotSpeed: side * 0.14,
            radius: target.radius,
            side: side,
            color: target.color,
            alpha: 1.0
          });
        }
      }

      function spawnBurstParticles(x, y, color, count) {
        for (let i = 0; i < count; i++) {
          const angle = Math.random() * Math.PI * 2;
          const spd = 2.5 + Math.random() * 8.5;
          state.particles.push({
            x: x,
            y: y,
            vx: Math.cos(angle) * spd,
            vy: Math.sin(angle) * spd - 1.8,
            size: 4 + Math.random() * 7,
            color: color,
            life: 1.0
          });
        }
      }

      function spawnFloatingText(x, y, text, color) {
        state.floatingTexts.push({
          x: x,
          y: y,
          text: text,
          color: color,
          life: 1.0
        });
      }

