      // -----------------------------------------------------------------------
      // HEADGEAR B (CHOP CHOP MODE): 3D Metallic Fencing Mask (`image_2333c3.png`)
      // -----------------------------------------------------------------------
      function draw3DFencingMask(p, cw, ch) {
        const hx = p.headX * cw;
        const hy = p.headY * ch;
        const baseScale = Math.max(0.76, Math.min(1.30, cw / 950)) * p.headScale;

        ctx.save();
        ctx.translate(hx, hy);
        ctx.rotate(p.headTilt);
        ctx.scale(baseScale, baseScale);

        // Drop shadow for 3D depth
        ctx.save();
        ctx.shadowColor = 'rgba(0, 0, 0, 0.55)';
        ctx.shadowBlur = 24;
        ctx.shadowOffsetY = 12;

        // 1. BROAD 3D PADDED SILVER/WHITE FENCING BIB (GORGET / THROAT PROTECTOR)
        // Faithfully sculpted after the wide curved lower bib in `image_2333c3.png`
        const bibGrad = ctx.createRadialGradient(0, 88, 12, 0, 95, 130);
        bibGrad.addColorStop(0, '#f8fafc');
        bibGrad.addColorStop(0.45, '#e2e8f0');
        bibGrad.addColorStop(0.78, '#94a3b8');
        bibGrad.addColorStop(1, '#64748b');

        ctx.fillStyle = bibGrad;
        ctx.strokeStyle = '#475569';
        ctx.lineWidth = 3;
        ctx.beginPath();
        // Neck/cheek sides sweeping down into the wide rounded fencing bib
        ctx.moveTo(-74, -6);
        ctx.bezierCurveTo(-76, 35, -108, 52, -106, 92);
        ctx.bezierCurveTo(-104, 146, 104, 146, 106, 92);
        ctx.bezierCurveTo(108, 52, 76, 35, 74, -6);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
        ctx.restore();

        // 3D Contour shading folds on the fencing bib
        ctx.strokeStyle = 'rgba(71, 85, 105, 0.35)';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.moveTo(-78, 86);
        ctx.quadraticCurveTo(0, 124, 78, 86);
        ctx.stroke();

        // 2. 3D METALLIC OUTER BEZEL / CHIN GUARD FRAME AROUND THE MESH VISOR
        const bezelGrad = ctx.createLinearGradient(-85, -110, 85, 85);
        bezelGrad.addColorStop(0, '#f1f5f9');
        bezelGrad.addColorStop(0.35, '#94a3b8');
        bezelGrad.addColorStop(0.7, '#475569');
        bezelGrad.addColorStop(1, '#cbd5e1');

        ctx.fillStyle = bezelGrad;
        ctx.strokeStyle = '#1e293b';
        ctx.lineWidth = 3.5;
        ctx.beginPath();
        ctx.moveTo(0, -122);
        ctx.bezierCurveTo(92, -122, 92, 12, 0, 82);
        ctx.bezierCurveTo(-92, 12, -92, -122, 0, -122);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        // 3. OVAL DARK STEEL WIRE-MESH VISOR DOME (`image_2333c3.png`)
        ctx.save();
        ctx.beginPath();
        ctx.moveTo(0, -114);
        ctx.bezierCurveTo(82, -114, 82, 4, 0, 68);
        ctx.bezierCurveTo(-82, 4, -82, -114, 0, -114);
        ctx.closePath();

        // Semi-translucent dark steel interior so the mask looks 3D & solid while subtly framing the player
        const meshBg = ctx.createRadialGradient(-18, -52, 10, 0, -25, 105);
        meshBg.addColorStop(0, 'rgba(30, 41, 59, 0.82)');
        meshBg.addColorStop(0.6, 'rgba(15, 23, 42, 0.88)');
        meshBg.addColorStop(1, 'rgba(2, 6, 23, 0.94)');
        ctx.fillStyle = meshBg;
        ctx.fill();

        // Clip the 3D curved steel wire-mesh grid inside the oval visor!
        ctx.clip();

        // Vertical curved 3D steel wires
        ctx.lineWidth = 1.15;
        for (let i = -12; i <= 12; i++) {
          const xTop = i * 6.8;
          const xMid = i * 8.2;
          const xBot = i * 6.2;
          const distFromCenter = Math.abs(i) / 12;
          const alpha = 0.72 - distFromCenter * 0.38;
          ctx.strokeStyle = `rgba(226, 232, 240, ${alpha})`;
          ctx.beginPath();
          ctx.moveTo(xTop, -118);
          ctx.quadraticCurveTo(xMid, -22, xBot, 72);
          ctx.stroke();
        }

        // Horizontal curved 3D steel wires
        for (let j = -14; j <= 10; j++) {
          const yCenter = j * 7.6;
          const curve = j * 1.4;
          const distFromCenter = Math.abs(j + 2) / 14;
          const alpha = 0.72 - distFromCenter * 0.35;
          ctx.strokeStyle = `rgba(226, 232, 240, ${alpha})`;
          ctx.beginPath();
          ctx.moveTo(-88, yCenter - curve);
          ctx.quadraticCurveTo(0, yCenter + curve, 88, yCenter - curve);
          ctx.stroke();
        }

        // 3D Specular sheen on top-left of the steel mesh dome
        const sheen = ctx.createRadialGradient(-26, -64, 4, -20, -55, 58);
        sheen.addColorStop(0, 'rgba(255, 255, 255, 0.28)');
        sheen.addColorStop(1, 'rgba(255, 255, 255, 0)');
        ctx.fillStyle = sheen;
        ctx.fillRect(-90, -120, 180, 195);
        ctx.restore();

        // Inner metallic rim highlight around the mesh visor
        ctx.strokeStyle = p.id === 0 ? '#e2e8f0' : '#fca5a5';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.moveTo(0, -114);
        ctx.bezierCurveTo(82, -114, 82, 4, 0, 68);
        ctx.bezierCurveTo(-82, 4, -82, -114, 0, -114);
        ctx.closePath();
        ctx.stroke();

        ctx.restore();
      }

      // -----------------------------------------------------------------------
      // WEAPON A (MOSQUITO SLAP): Cartoon Long-Cuff Purple Clapping Gloves (`image.png`)
      // -----------------------------------------------------------------------
      function drawSingleCartoonGlove(gx, gy, angle, scale, isRightHand, th, slapBoost) {
        ctx.save();
        ctx.translate(gx, gy);
        ctx.rotate(angle);
        const s = scale * (1 + slapBoost * 0.20);
        ctx.scale(isRightHand ? s : -s, s);

        if (slapBoost > 0.08) {
          ctx.save();
          ctx.strokeStyle = '#e879f9';
          ctx.lineWidth = 4;
          ctx.globalAlpha = slapBoost;
          ctx.beginPath();
          ctx.arc(0, -25, 45 + (1 - slapBoost) * 38, 0, Math.PI * 2);
          ctx.stroke();
          ctx.restore();
        }

        // 3D shaded purple glove gradient
        const gloveGrad = ctx.createLinearGradient(-26, -60, 26, 65);
        gloveGrad.addColorStop(0, th.gloveLight);
        gloveGrad.addColorStop(0.5, th.gloveMain);
        gloveGrad.addColorStop(1, th.gloveDark);

        ctx.fillStyle = gloveGrad;
        ctx.strokeStyle = th.outline;
        ctx.lineWidth = 4.5;
        ctx.lineJoin = 'round';
        ctx.lineCap = 'round';

        ctx.beginPath();
        ctx.moveTo(-24, 68);
        ctx.quadraticCurveTo(-30, 62, -23, 54);
        ctx.quadraticCurveTo(-24, 15, -24, -44);
        ctx.bezierCurveTo(-24, -64, -10, -66, -9, -48);
        ctx.bezierCurveTo(-9, -68, 6, -68, 6, -46);
        ctx.bezierCurveTo(6, -62, 19, -58, 19, -38);
        ctx.quadraticCurveTo(22, -8, 25, 18);
        ctx.quadraticCurveTo(24, 42, 23, 54);
        ctx.quadraticCurveTo(30, 62, 24, 68);
        ctx.quadraticCurveTo(0, 74, -24, 68);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        // Highlight on fingers
        ctx.fillStyle = th.gloveLight;
        ctx.beginPath();
        ctx.ellipse(-6, -10, 9, 26, -0.05, 0, Math.PI * 2);
        ctx.fill();

        // Finger divider seams
        ctx.strokeStyle = th.outline;
        ctx.lineWidth = 3.5;
        ctx.beginPath();
        ctx.moveTo(-9, -48);
        ctx.lineTo(-7, -6);
        ctx.moveTo(6, -46);
        ctx.lineTo(7, -4);
        ctx.moveTo(11, -14);
        ctx.quadraticCurveTo(2, 8, 14, 26);
        ctx.moveTo(-21, 55);
        ctx.quadraticCurveTo(0, 60, 21, 55);
        ctx.stroke();

        ctx.restore();
      }

      // -----------------------------------------------------------------------
      // WEAPON B (CHOP CHOP): Extra-Long 3D Metallic Fencing Sword (`image_2333c3.png`)
      //   + Volumetric Multi-Layer Slash Ribbon & Dynamic Lunge Animation
      // -----------------------------------------------------------------------
      function draw3DFencingSwordAndTrail(p, cw, ch, now) {
        const hx = p.handX * cw;
        const hy = p.handY * ch;
        const bladeLen = getFencingSwordBladeLength(cw, p);

        // 1. VOLUMETRIC 3D SWORD SLASH RIBBON TRAIL
        if (p.trail.length > 2) {
          ctx.save();
          for (let i = 1; i < p.trail.length; i++) {
            const pt0 = p.trail[i - 1];
            const pt1 = p.trail[i];
            const x0 = (pt0.tipX !== undefined ? pt0.tipX : pt0.x) * cw;
            const y0 = (pt0.tipY !== undefined ? pt0.tipY : pt0.y) * ch;
            const x1 = (pt1.tipX !== undefined ? pt1.tipX : pt1.x) * cw;
            const y1 = (pt1.tipY !== undefined ? pt1.tipY : pt1.y) * ch;

            // Outer glowing energy wake
            ctx.strokeStyle = p.theme.swordColor;
            ctx.globalAlpha = pt1.life * 0.45;
            ctx.lineWidth = pt1.life * 26;
            ctx.lineCap = 'round';
            ctx.beginPath();
            ctx.moveTo(x0, y0);
            ctx.lineTo(x1, y1);
            ctx.stroke();

            // Inner razor-sharp white steel core
            ctx.strokeStyle = '#ffffff';
            ctx.globalAlpha = pt1.life * 0.92;
            ctx.lineWidth = pt1.life * 7;
            ctx.beginPath();
            ctx.moveTo(x0, y0);
            ctx.lineTo(x1, y1);
            ctx.stroke();
          }
          ctx.restore();
        }

        // 2. 3D METALLIC FENCING SWORD (SABRE / EPEE FROM `image_2333c3.png`)
        ctx.save();
        ctx.translate(hx, hy);
        ctx.rotate(p.swordAngle);

        // Subtle 3D drop shadow under the sword
        ctx.shadowColor = 'rgba(0, 0, 0, 0.45)';
        ctx.shadowBlur = 12;
        ctx.shadowOffsetY = 6;

        // A. Curved Metallic Knuckle-Bow Guard Loop (connecting Bell Guard to Pommel, exact match to `image_2333c3.png`)
        ctx.strokeStyle = '#cbd5e1';
        ctx.lineWidth = 4.5;
        ctx.beginPath();
        ctx.moveTo(6, 28);
        ctx.bezierCurveTo(-18, 48, -68, 36, -78, 6);
        ctx.stroke();

        ctx.strokeStyle = '#64748b';
        ctx.lineWidth = 1.5;
        ctx.stroke();

        // B. Ergonomic Ribbed Black Handle Grip (`#111827` -> `#374151`)
        const gripGrad = ctx.createLinearGradient(-74, -8, -74, 8);
        gripGrad.addColorStop(0, '#4b5563');
        gripGrad.addColorStop(0.5, '#1f2937');
        gripGrad.addColorStop(1, '#090d16');
        ctx.fillStyle = gripGrad;
        ctx.strokeStyle = '#0f172a';
        ctx.lineWidth = 2;
        roundRect(ctx, -74, -7.5, 62, 15, 5);
        ctx.fill();
        ctx.stroke();

        // Metallic ferrule collar near bell guard
        ctx.fillStyle = '#94a3b8';
        ctx.fillRect(-18, -8.5, 10, 17);

        // C. Spherical 3D Metallic Pommel at back of handle (`image_2333c3.png`)
        const pommelGrad = ctx.createRadialGradient(-82, -3, 1, -80, 0, 11);
        pommelGrad.addColorStop(0, '#ffffff');
        pommelGrad.addColorStop(0.5, '#94a3b8');
        pommelGrad.addColorStop(1, '#334155');
        ctx.fillStyle = pommelGrad;
        ctx.beginPath();
        ctx.arc(-80, 0, 9.5, 0, Math.PI * 2);
        ctx.fill();

        // D. LONG GLEAMING 3D TAPERED STEEL BLADE (Extending `bladeLen` pixels!)
        // Upper sunlit bevel (bright white/silver)
        const upperBladeGrad = ctx.createLinearGradient(12, 0, bladeLen, 0);
        upperBladeGrad.addColorStop(0, '#e2e8f0');
        upperBladeGrad.addColorStop(0.5, '#ffffff');
        upperBladeGrad.addColorStop(0.85, '#bae6fd');
        upperBladeGrad.addColorStop(1, '#ffffff');

        ctx.fillStyle = upperBladeGrad;
        ctx.beginPath();
        ctx.moveTo(12, -6.5);
        ctx.lineTo(bladeLen - 16, -2.2);
        ctx.lineTo(bladeLen, 0);
        ctx.lineTo(12, 0);
        ctx.closePath();
        ctx.fill();

        // Lower shaded steel bevel
        const lowerBladeGrad = ctx.createLinearGradient(12, 0, bladeLen, 0);
        lowerBladeGrad.addColorStop(0, '#475569');
        lowerBladeGrad.addColorStop(0.6, '#94a3b8');
        lowerBladeGrad.addColorStop(1, '#e2e8f0');

        ctx.fillStyle = lowerBladeGrad;
        ctx.beginPath();
        ctx.moveTo(12, 0);
        ctx.lineTo(bladeLen, 0);
        ctx.lineTo(bladeLen - 16, 2.2);
        ctx.lineTo(12, 6.5);
        ctx.closePath();
        ctx.fill();

        // Central fuller ridge highlight along the blade
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 1.6;
        ctx.beginPath();
        ctx.moveTo(16, 0);
        ctx.lineTo(bladeLen - 4, 0);
        ctx.stroke();

        // E. 3D Sculpted Hemispherical Metallic Bell Guard (Cup Hilt from `image_2333c3.png`)
        const bellGrad = ctx.createRadialGradient(4, -10, 3, 2, 0, 34);
        bellGrad.addColorStop(0, '#ffffff');
        bellGrad.addColorStop(0.35, '#e2e8f0');
        bellGrad.addColorStop(0.72, '#64748b');
        bellGrad.addColorStop(1, '#1e293b');

        ctx.fillStyle = bellGrad;
        ctx.strokeStyle = '#334155';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        // Cup curve facing forward toward the blade
        ctx.moveTo(14, -30);
        ctx.bezierCurveTo(-18, -28, -18, 28, 14, 30);
        ctx.quadraticCurveTo(20, 0, 14, -30);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        // Rolled front lip of the Bell Guard
        ctx.fillStyle = '#cbd5e1';
        ctx.beginPath();
        ctx.ellipse(14, 0, 4.5, 31, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        // F. Animated Star-Glint at the Tip of the Long Fencing Sword!
        const glintPulse = 0.75 + Math.sin(now * 0.015) * 0.25 + p.swordLunge * 0.5;
        ctx.save();
        ctx.translate(bladeLen, 0);
        ctx.scale(glintPulse, glintPulse);
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        for (let k = 0; k < 4; k++) {
          ctx.rotate(Math.PI / 2);
          ctx.moveTo(0, 0);
          ctx.quadraticCurveTo(2, -3, 14, 0);
          ctx.quadraticCurveTo(2, 3, 0, 0);
        }
        ctx.fill();
        ctx.restore();

        ctx.restore();
      }

      function drawPlayerHandWeapon(p, cw, ch, now) {
        if (!state.showHandGear) return;

        if (state.activeRoundMode === 'mosquito') {
          const baseScale = Math.max(0.78, Math.min(1.18, cw / 980));
          drawSingleCartoonGlove(
            p.leftHand.x * cw,
            p.leftHand.y * ch,
            p.leftHand.angle,
            baseScale * p.leftHand.scale,
            false,
            p.theme,
            p.slapAnim
          );
          drawSingleCartoonGlove(
            p.rightHand.x * cw,
            p.rightHand.y * ch,
            p.rightHand.angle,
            baseScale * p.rightHand.scale,
            true,
            p.theme,
            p.slapAnim
          );
        } else {
          draw3DFencingSwordAndTrail(p, cw, ch, now);
        }
      }

      // -----------------------------------------------------------------------
      // 3D VOLUMETRIC MOSQUITO & 3D JUICY FRUIT TARGETS
      // -----------------------------------------------------------------------
      function drawMosquitoTarget(t, time) {
        ctx.save();
        ctx.translate(t.x, t.y);

        const facingLeft = t.vx < 0;
        const bobY = Math.sin(time * 0.012 + t.wobblePhase) * 5;
        ctx.translate(0, bobY);

        // Minimalist 3D Glassmorphic Option Pill below Mosquito
        const cardW = Math.max(145, Math.min(210, t.text.length * 8.0 + 52));
        const cardH = 40;
        const cardY = 24;

        ctx.strokeStyle = 'rgba(255,255,255,0.55)';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(-12, 8);
        ctx.lineTo(-cardW * 0.28, cardY);
        ctx.moveTo(12, 8);
        ctx.lineTo(cardW * 0.28, cardY);
        ctx.stroke();

        ctx.save();
        ctx.shadowColor = 'rgba(0, 0, 0, 0.45)';
        ctx.shadowBlur = 14;
        ctx.shadowOffsetY = 5;
        ctx.fillStyle = 'rgba(15, 23, 42, 0.88)';
        ctx.strokeStyle = t.color.main;
        ctx.lineWidth = 2.5;
        roundRect(ctx, -cardW / 2, cardY, cardW, cardH, 13);
        ctx.fill();
        ctx.stroke();
        ctx.restore();

        ctx.fillStyle = t.color.main;
        roundRect(ctx, -cardW / 2 + 5, cardY + 5, 30, 30, 8);
        ctx.fill();

        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 16px Fredoka, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(t.letter, -cardW / 2 + 20, cardY + 20);

        ctx.fillStyle = '#f8fafc';
        ctx.font = '600 13px Inter, sans-serif';
        ctx.textAlign = 'left';
        const displayStr = t.text.length > 22 ? t.text.slice(0, 20) + '…' : t.text;
        ctx.fillText(displayStr, -cardW / 2 + 42, cardY + 20);

        // 3D Shaded Mosquito Body & Iridescent Flapping Wings
        ctx.save();
        if (!facingLeft) ctx.scale(-1, 1);

        const wingFlap = Math.sin(time * 0.095 + t.wingPhase) * 0.58;
        const wingGrad = ctx.createLinearGradient(0, -28, 20, 0);
        wingGrad.addColorStop(0, 'rgba(255, 255, 255, 0.90)');
        wingGrad.addColorStop(0.6, 'rgba(186, 230, 253, 0.72)');
        wingGrad.addColorStop(1, 'rgba(56, 189, 248, 0.35)');
        ctx.fillStyle = wingGrad;
        ctx.strokeStyle = '#7dd3fc';
        ctx.lineWidth = 1.2;

        ctx.save();
        ctx.translate(4, -12);
        ctx.rotate(wingFlap - 0.3);
        ctx.beginPath();
        ctx.ellipse(10, -14, 23, 9.5, 0.4, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.restore();

        ctx.save();
        ctx.translate(-4, -10);
        ctx.rotate(-wingFlap + 0.2);
        ctx.beginPath();
        ctx.ellipse(6, -12, 19, 7.5, 0.2, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.restore();

        // Legs
        ctx.strokeStyle = '#0f172a';
        ctx.lineWidth = 2.2;
        for (let l = -1; l <= 1; l++) {
          ctx.beginPath();
          ctx.moveTo(l * 8, 4);
          ctx.lineTo(l * 14, 15);
          ctx.lineTo(l * 18, 22);
          ctx.stroke();
        }

        // 3D Striped Abdomen
        const abdGrad = ctx.createRadialGradient(14, -2, 2, 18, 2, 20);
        abdGrad.addColorStop(0, '#64748b');
        abdGrad.addColorStop(1, '#0f172a');
        ctx.fillStyle = abdGrad;
        ctx.beginPath();
        ctx.ellipse(18, 2, 19, 10.5, 0.2, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = t.color.main;
        for (let s = 8; s <= 26; s += 7) {
          ctx.fillRect(s, -5, 3.5, 14);
        }

        // 3D Thorax & Head
        const thxGrad = ctx.createRadialGradient(-4, -6, 2, 0, -2, 14);
        thxGrad.addColorStop(0, '#475569');
        thxGrad.addColorStop(1, '#0f172a');
        ctx.fillStyle = thxGrad;
        ctx.beginPath();
        ctx.arc(0, -2, 11.5, 0, Math.PI * 2);
        ctx.arc(-14, -4, 9.5, 0, Math.PI * 2);
        ctx.fill();

        // Proboscis
        ctx.strokeStyle = '#f8fafc';
        ctx.lineWidth = 2.4;
        ctx.beginPath();
        ctx.moveTo(-22, -4);
        ctx.lineTo(-44, -1);
        ctx.stroke();

        // 3D Glossy Eyes
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(-17, -7, 5.8, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#ef4444';
        ctx.beginPath();
        ctx.arc(-18.5, -7, 3.0, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(-19.5, -8.2, 1.2, 0, Math.PI * 2);
        ctx.fill();

        ctx.restore();
        ctx.restore();
      }

      function drawFruitTarget(t) {
        ctx.save();
        ctx.translate(t.x, t.y);

        // 3D Spherical Fruit with Specular Highlight & Rim Lighting
        ctx.save();
        ctx.rotate(t.rotation);
        const r = t.radius * 0.80;

        ctx.shadowColor = 'rgba(0, 0, 0, 0.5)';
        ctx.shadowBlur = 18;
        ctx.shadowOffsetY = 8;

        // Outer 3D Rind
        ctx.fillStyle = t.color.dark;
        ctx.strokeStyle = t.color.rim;
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.arc(0, 0, r, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        // 3D Radial Flesh Gradient
        const fleshGrad = ctx.createRadialGradient(-r * 0.32, -r * 0.32, r * 0.08, 0, 0, r * 0.88);
        fleshGrad.addColorStop(0, t.color.light);
        fleshGrad.addColorStop(0.45, t.color.main);
        fleshGrad.addColorStop(1, t.color.dark);
        ctx.fillStyle = fleshGrad;
        ctx.beginPath();
        ctx.arc(0, 0, r * 0.86, 0, Math.PI * 2);
        ctx.fill();

        // Glossy 3D Specular Shine
        ctx.fillStyle = 'rgba(255, 255, 255, 0.55)';
        ctx.beginPath();
        ctx.ellipse(-r * 0.32, -r * 0.32, r * 0.26, r * 0.14, -0.6, 0, Math.PI * 2);
        ctx.fill();

        // Seeds
        ctx.fillStyle = '#0f172a';
        for (let a = 0; a < 6; a++) {
          const ang = (a / 6) * Math.PI * 2;
          ctx.beginPath();
          ctx.arc(Math.cos(ang) * (r * 0.45), Math.sin(ang) * (r * 0.45), 2.6, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();

        // Floating Minimalist Option Pill
        const cardW = Math.max(145, Math.min(215, t.text.length * 8.2 + 52));
        const cardH = 40;

        ctx.fillStyle = 'rgba(15, 23, 42, 0.90)';
        ctx.strokeStyle = t.color.light;
        ctx.lineWidth = 2.5;
        roundRect(ctx, -cardW / 2, -cardH / 2, cardW, cardH, 12);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = t.color.main;
        roundRect(ctx, -cardW / 2 + 5, -cardH / 2 + 5, 30, 30, 8);
        ctx.fill();

        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 16px Fredoka, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(t.letter, -cardW / 2 + 20, 0);

        ctx.fillStyle = '#ffffff';
        ctx.font = '600 13px Inter, sans-serif';
        ctx.textAlign = 'left';
        const displayStr = t.text.length > 22 ? t.text.slice(0, 20) + '…' : t.text;
        ctx.fillText(displayStr, -cardW / 2 + 42, 0);

        ctx.restore();
      }

      function drawSlicedHalf(h) {
        ctx.save();
        ctx.globalAlpha = Math.max(0, h.alpha);
        ctx.translate(h.x, h.y);
        ctx.rotate(h.rotation);

        ctx.fillStyle = h.color.dark;
        ctx.strokeStyle = h.color.rim || '#ffffff';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.arc(0, 0, h.radius * 0.78, 0, Math.PI, h.side > 0);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = h.color.main;
        ctx.beginPath();
        ctx.arc(0, 0, h.radius * 0.66, 0, Math.PI, h.side > 0);
        ctx.closePath();
        ctx.fill();

        ctx.restore();
      }

      function roundRect(context, x, y, w, h, r) {
        context.beginPath();
        context.moveTo(x + r, y);
        context.arcTo(x + w, y, x + w, y + h, r);
        context.arcTo(x + w, y + h, x, y + h, r);
        context.arcTo(x, y + h, x, y, r);
        context.arcTo(x, y, x + w, y, r);
        context.closePath();
      }

      // -----------------------------------------------------------------------
      // 9. MAIN ANIMATION & PHYSICS LOOP (60FPS HiDPI)
      // -----------------------------------------------------------------------
      let lastTime = performance.now();

      function gameLoop(now) {
        const dt = Math.min(0.05, (now - lastTime) / 1000);
        lastTime = now;

        processWebcamMotion();

        const cw = state.viewW;
        const ch = state.viewH;
        const setupOpen = !document.getElementById('setupScreen').classList.contains('hidden');

        if (state.inGame && !setupOpen) {
          if (!state.roundResolved) {
            state.questionTimer = Math.max(0, state.questionTimer - dt);
            const pct = (state.questionTimer / state.questionMaxTime) * 100;
            const timerBar = document.getElementById('hudTimerBar');
            if (timerBar) timerBar.style.width = `${pct}%`;

            if (state.questionTimer <= 0) {
              state.roundResolved = true;
              const qObj = state.questions[state.currentQIndex];
              const rightLet = qObj ? OPTION_LETTERS[qObj.correct] : '';
              spawnFloatingText(cw / 2, ch / 2, `⏰ TIME UP! Correct was ${rightLet}`, '#fbbf24');
              setTimeout(() => {
                if (!state.inGame) return;
                state.currentQIndex++;
                loadCurrentQuestion();
              }, 1250);
            }
          }
        }

        // 1. Draw High-Res Mirrored Camera or 3D Arena Backdrop
        drawBackgroundAndCamera(cw, ch, now);

        // 2. Draw Mode-Specific 3D Headgear:
        //    - Mosquito Slap: Purple Beekeeper Mosquito-Net Hat
        //    - Chop Chop: 3D Metallic Fencing Mask (`image_2333c3.png`)
        drawARHeadgearForPlayer(state.players[0], cw, ch);
        if (state.numPlayers === 2) {
          drawARHeadgearForPlayer(state.players[1], cw, ch);
        }

        // 3. Draw Splat Marks
        for (let i = state.splats.length - 1; i >= 0; i--) {
          const s = state.splats[i];
          s.alpha -= dt * 0.45;
          if (s.alpha <= 0) {
            state.splats.splice(i, 1);
            continue;
          }
          ctx.save();
          ctx.globalAlpha = s.alpha;
          ctx.fillStyle = s.color;
          ctx.beginPath();
          ctx.arc(s.x, s.y, 34, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        }

        // 4. Draw Player's Gloves (Mosquito Slap) OR Long 3D Fencing Sword (Chop Chop)
        state.players.forEach((p, idx) => {
          if (idx === 1 && state.numPlayers === 1) return;
          p.slapAnim = Math.max(0, p.slapAnim - dt * 3.8);
          p.swordLunge = Math.max(0, p.swordLunge - dt * 3.2);
          if (p.clapCooldown > 0) p.clapCooldown--;
          for (let t = p.trail.length - 1; t >= 0; t--) {
            p.trail[t].life -= dt * 3.8;
            if (p.trail[t].life <= 0) p.trail.splice(t, 1);
          }
          drawPlayerHandWeapon(p, cw, ch, now);
        });

        // 5. Update & Draw Targets (3D Mosquitoes OR 3D Flying Fruits)
        let activeFruitCount = 0;
        for (let i = 0; i < state.targets.length; i++) {
          const t = state.targets[i];
          if (t.cooldown > 0) t.cooldown--;
          if (!t.alive) continue;

          if (state.activeRoundMode === 'mosquito') {
            t.x += t.vx + Math.sin(now * 0.006 + t.wobblePhase) * 1.1;
            t.y += t.vy + Math.cos(now * 0.007 + t.wobblePhase) * 1.1;

            const padX = 95;
            const padTop = 55;
            const padBottom = 85;
            if (t.x < padX) { t.x = padX; t.vx = Math.abs(t.vx); }
            if (t.x > cw - padX) { t.x = cw - padX; t.vx = -Math.abs(t.vx); }
            if (t.y < padTop) { t.y = padTop; t.vy = Math.abs(t.vy); }
            if (t.y > ch - padBottom) { t.y = ch - padBottom; t.vy = -Math.abs(t.vy); }

            drawMosquitoTarget(t, now);
          } else {
            t.x += t.vx;
            t.y += t.vy;
            t.vy += t.gravity;
            t.rotation += t.rotSpeed;

            if (t.x < 85) { t.x = 85; t.vx = Math.abs(t.vx); }
            if (t.x > cw - 85) { t.x = cw - 85; t.vx = -Math.abs(t.vx); }

            if (t.y < ch + 110) {
              activeFruitCount++;
            }
            drawFruitTarget(t);
          }
        }

        if (state.activeRoundMode === 'chop' && !state.roundResolved && activeFruitCount === 0) {
          launchFruitWave();
        }

        // 6. Sliced Halves, Juice Droplets & Sword Sparks
        for (let i = state.slicedHalves.length - 1; i >= 0; i--) {
          const h = state.slicedHalves[i];
          h.x += h.vx;
          h.y += h.vy;
          h.vy += 0.28;
          h.rotation += h.rotSpeed;
          h.alpha -= dt * 0.7;
          if (h.alpha <= 0 || h.y > ch + 100) {
            state.slicedHalves.splice(i, 1);
            continue;
          }
          drawSlicedHalf(h);
        }

        for (let i = state.particles.length - 1; i >= 0; i--) {
          const pt = state.particles[i];
          pt.x += pt.vx;
          pt.y += pt.vy;
          pt.vy += 0.20;
          pt.life -= dt * 1.4;
          if (pt.life <= 0) {
            state.particles.splice(i, 1);
            continue;
          }
          ctx.save();
          ctx.globalAlpha = pt.life;
          ctx.fillStyle = pt.color;
          ctx.beginPath();
          ctx.arc(pt.x, pt.y, pt.size, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        }

        for (let i = state.swordSparks.length - 1; i >= 0; i--) {
          const sp = state.swordSparks[i];
          sp.x += sp.vx;
          sp.y += sp.vy;
          sp.life -= dt * 2.6;
          if (sp.life <= 0) {
            state.swordSparks.splice(i, 1);
            continue;
          }
          ctx.save();
          ctx.globalAlpha = sp.life;
          ctx.fillStyle = sp.color;
          ctx.beginPath();
          ctx.arc(sp.x, sp.y, sp.size, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        }

        // 7. Floating Score / Feedback Texts
        for (let i = state.floatingTexts.length - 1; i >= 0; i--) {
          const ft = state.floatingTexts[i];
          ft.y -= 1.5;
          ft.life -= dt * 0.95;
          if (ft.life <= 0) {
            state.floatingTexts.splice(i, 1);
            continue;
          }
          ctx.save();
          ctx.globalAlpha = ft.life;
          ctx.font = 'bold 23px Fredoka, sans-serif';
          ctx.textAlign = 'center';
          ctx.strokeStyle = '#0f172a';
          ctx.lineWidth = 5;
          ctx.strokeText(ft.text, ft.x, ft.y);
          ctx.fillStyle = ft.color;
          ctx.fillText(ft.text, ft.x, ft.y);
          ctx.restore();
        }

        requestAnimationFrame(gameLoop);
      }

      // -----------------------------------------------------------------------
      // 10. EVENT LISTENERS (POP-UP SETUP, BULK PASTE, POINTER & HOTKEYS)
      // -----------------------------------------------------------------------
      function initEvents() {
        document.getElementById('btnSelect1P').addEventListener('click', () => setPlayersCount(1));
        document.getElementById('btnSelect2P').addEventListener('click', () => setPlayersCount(2));

        document.getElementById('btnModeMosquito').addEventListener('click', () => setGameMode('mosquito'));
        document.getElementById('btnModeChop').addEventListener('click', () => setGameMode('chop'));
        document.getElementById('btnModeCombo').addEventListener('click', () => setGameMode('combo'));

        document.getElementById('btnTestCameraSetup').addEventListener('click', () => startCamera(false));

        // Cancel button on Setup Modal -> closes modal and plays immediately
        document.getElementById('btnCancelSetupModal').addEventListener('click', startGameSession);

        // Folder / Preset Pack selector
        document.getElementById('selectPresetPack').addEventListener('change', (e) => {
          const val = e.target.value;
          if (val && PRESET_DECKS[val]) {
            state.questions = JSON.parse(JSON.stringify(PRESET_DECKS[val]));
            state.setupActiveIdx = 0;
            saveQuestionsToStorage();
            renderQuestionList();
            showToast(`Loaded "${e.target.options[e.target.selectedIndex].text}"!`, '📚');
          }
        });

        // Question Pager bar inside the blue banner (switches question without scrolling!)
        document.getElementById('questionPagerBar').addEventListener('click', (e) => {
          const btn = e.target.closest('button[data-page-idx]');
          if (!btn) return;
          syncCurrentCardToState();
          state.setupActiveIdx = parseInt(btn.getAttribute('data-page-idx'), 10) || 0;
          renderQuestionList();
        });

        // Live sync when editing inputs in the Setup Card
        ['inputQuestionText', 'inputOpt0', 'inputOpt1', 'inputOpt2', 'inputOpt3'].forEach(id => {
          const el = document.getElementById(id);
          if (el) el.addEventListener('input', syncCurrentCardToState);
        });
        document.querySelectorAll('input[name="correctOption"]').forEach(r => {
          r.addEventListener('change', syncCurrentCardToState);
        });

        // + Option / - Option buttons (matching `image_232f61.png`)
        document.getElementById('btnAddOptionField').addEventListener('click', () => {
          const opt2 = document.getElementById('optBox2');
          const opt3 = document.getElementById('optBox3');
          if (opt2.classList.contains('hidden')) {
            opt2.classList.remove('hidden');
            showToast('Added Option 3', '➕');
          } else if (opt3.classList.contains('hidden')) {
            opt3.classList.remove('hidden');
            showToast('Added Option 4', '➕');
          } else {
            showToast('Maximum 4 options active!', '✨');
          }
        });

        document.getElementById('btnRemoveOptionField').addEventListener('click', () => {
          const opt3 = document.getElementById('optBox3');
          if (!opt3.classList.contains('hidden')) {
            opt3.classList.add('hidden');
            document.getElementById('inputOpt3').value = 'None';
            showToast('Hid Option 4', '➖');
          } else {
            showToast('Minimum 3 options kept active', 'ℹ️');
          }
        });

        // Delete current question
        document.getElementById('btnDeleteCurrentQuestion').addEventListener('click', () => {
          if (state.questions.length <= 1) {
            showToast('At least 1 question is required!', '⚠️');
            return;
          }
          state.questions.splice(state.setupActiveIdx, 1);
          if (state.setupActiveIdx >= state.questions.length) {
            state.setupActiveIdx = state.questions.length - 1;
          }
          saveQuestionsToStorage();
          renderQuestionList();
          showToast('Question deleted', '🗑️');
        });

        // Clear all questions
        document.getElementById('btnClearQuestions').addEventListener('click', () => {
          state.questions = [
            {
              id: 'q_' + Date.now(),
              q: '',
              options: ['', '', '', ''],
              correct: 0
            }
          ];
          state.setupActiveIdx = 0;
          saveQuestionsToStorage();
          renderQuestionList();
          document.getElementById('inputQuestionText').focus();
          showToast('Reset deck to Question #1!', '🗑️');
        });

        // "+ Add Another Question" dashed button & "+ Add Question to Game" submit button
        function addNewBlankOrSaveQuestion() {
          syncCurrentCardToState();
          const cur = state.questions[state.setupActiveIdx];
          if (cur && !cur.q.trim()) {
            document.getElementById('inputQuestionText').focus();
            showToast('Type your current question first!', '✏️');
            return;
          }
          state.questions.push({
            id: 'q_' + Date.now() + '_' + Math.floor(Math.random() * 1000),
            q: '',
            options: ['', '', '', ''],
            correct: 0
          });
          state.setupActiveIdx = state.questions.length - 1;
          saveQuestionsToStorage();
          renderQuestionList();
          document.getElementById('inputQuestionText').focus();
          showToast(`Added Question #${state.setupActiveIdx + 1}!`, '➕');
        }

        document.getElementById('btnAddAnotherQuestionCard').addEventListener('click', addNewBlankOrSaveQuestion);

        const form = document.getElementById('questionForm');
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          addNewBlankOrSaveQuestion();
        });

        // Bulk Paste Modal handlers
        const bulkModal = document.getElementById('bulkPasteModal');
        document.getElementById('btnOpenBulkPaste').addEventListener('click', () => {
          document.getElementById('bulkModalTitle').textContent = '📋 Bulk Paste Questions';
          bulkModal.classList.remove('hidden');
        });
        document.getElementById('btnHowToBulkPaste').addEventListener('click', () => {
          document.getElementById('bulkModalTitle').textContent = '▶️ How to Bulk Paste (1 Line = 1 Question)';
          document.getElementById('textareaBulkPaste').value =
            'What is 8 × 7? | 54 | 56 | 64 | 48 | 2\n' +
            'Which insect buzzes and bites? | Mosquito | Butterfly | Ladybug | Ant | 1\n' +
            'What protective mask do fencers wear? | Wire-Mesh Fencing Mask | Sun Visor | Beret | Crown | 1';
          bulkModal.classList.remove('hidden');
        });
        document.getElementById('btnCloseBulkModal').addEventListener('click', () => {
          bulkModal.classList.add('hidden');
        });
        document.getElementById('btnFillBulkExample').addEventListener('click', () => {
          document.getElementById('textareaBulkPaste').value =
            'What is 12 × 12? | 124 | 144 | 164 | 112 | 2\n' +
            'Largest planet in our Solar System? | Earth | Mars | Jupiter | Venus | 3\n' +
            'Capital city of Japan? | Seoul | Tokyo | Bangkok | Hanoi | 2';
        });
        document.getElementById('btnImportBulkQuestions').addEventListener('click', () => {
          const raw = document.getElementById('textareaBulkPaste').value.trim();
          if (!raw) {
            showToast('Paste at least one line first!', '⚠️');
            return;
          }
          const lines = raw.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
          let added = 0;
          lines.forEach(line => {
            const parts = line.split('|').map(s => s.trim());
            if (parts.length >= 5) {
              const qStr = parts[0];
              const opts = [parts[1], parts[2], parts[3], parts[4] || 'Option 4'];
              const corrNum = parseInt(parts[5], 10);
              const corrIdx = (!isNaN(corrNum) && corrNum >= 1 && corrNum <= 4) ? (corrNum - 1) : 0;
              state.questions.push({
                id: 'qb_' + Date.now() + '_' + Math.random(),
                q: qStr,
                options: opts,
                correct: corrIdx
              });
              added++;
            }
          });
          if (added > 0) {
            // Remove any empty placeholder question
            state.questions = state.questions.filter(q => q.q && q.q.trim().length > 0);
            state.setupActiveIdx = state.questions.length - 1;
            saveQuestionsToStorage();
            renderQuestionList();
            bulkModal.classList.add('hidden');
            showToast(`Imported ${added} question(s)!`, '✅');
          } else {
            showToast('Use format: Question | Opt1 | Opt2 | Opt3 | Opt4 | Correct(1-4)', '⚠️');
          }
        });

        // Save Quiz / Launch Arena Buttons
        document.getElementById('btnSaveQuizModal').addEventListener('click', () => {
          syncCurrentCardToState();
          state.questions = state.questions.filter(q => q.q && q.q.trim().length > 0);
          startGameSession();
          showToast('Quiz Saved! Game Arena Launched!', '💾');
        });
        document.getElementById('btnStartGameTop').addEventListener('click', () => {
          // Filter out empty trailing questions before starting
          syncCurrentCardToState();
          state.questions = state.questions.filter(q => q.q && q.q.trim().length > 0);
          startGameSession();
          showToast('Quiz Saved! Game Arena Launched!', '🚀');
        });
        document.getElementById('btnStartGameBottom').addEventListener('click', () => {
          syncCurrentCardToState();
          state.questions = state.questions.filter(q => q.q && q.q.trim().length > 0);
          startGameSession();
        });

        // In-Game HUD Controls
        document.getElementById('btnToggleModeInGame').addEventListener('click', () => {
          state.activeRoundMode = state.activeRoundMode === 'mosquito' ? 'chop' : 'mosquito';
          updateInGameHUD();
          spawnTargetsForCurrentQuestion();
          showToast(
            state.activeRoundMode === 'mosquito'
              ? 'Mosquito Slap Mode (Purple Net Hat + 2 Gloves)!'
              : 'Chop Chop Mode (3D Fencing Mask + Long Fencing Sword)!',
            state.activeRoundMode === 'mosquito' ? '🦟' : '🤺'
          );
        });

        document.getElementById('btnToggleCamInGame').addEventListener('click', () => {
          startCamera(false);
        });

        document.getElementById('btnToggleNetInGame').addEventListener('click', () => {
          state.showHeadgear = !state.showHeadgear;
          updateInGameHUD();
        });

        document.getElementById('btnPauseOrSetup').addEventListener('click', () => {
          renderQuestionList();
          document.getElementById('setupScreen').classList.remove('hidden');
        });

        document.getElementById('hudOptionsBar').addEventListener('click', (e) => {
          const btn = e.target.closest('button[data-option-idx]');
          if (!btn || !state.inGame || state.roundResolved) return;
          const optIdx = parseInt(btn.getAttribute('data-option-idx'), 10);
          const target = state.targets.find(t => t.optionIndex === optIdx && t.alive);
          if (target) {
            const cw = state.viewW || 1;
            const ch = state.viewH || 1;
            updatePlayerHandPosition(0, target.x / cw, target.y / ch, false);
            triggerTargetHit(0, target);
          }
        });

        document.getElementById('btnPlayAgain').addEventListener('click', startGameSession);
        document.getElementById('btnBackToSetup').addEventListener('click', () => {
          document.getElementById('gameOverModal').classList.add('hidden');
          renderQuestionList();
          document.getElementById('setupScreen').classList.remove('hidden');
        });

        let isPointerDown = false;

        function handleCanvasPointer(clientX, clientY, isClickTap) {
          const rect = gameCanvas.getBoundingClientRect();
          const normX = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
          const normY = Math.max(0, Math.min(1, (clientY - rect.top) / rect.height));

          const playerIdx = (state.numPlayers === 2 && normX >= 0.5) ? 1 : 0;
          const p = state.players[playerIdx];
          if (isClickTap) {
            p.slapAnim = 1.0;
            p.swordLunge = 1.0;
          }
          updatePlayerHandPosition(playerIdx, normX, normY, false);

          if (isClickTap || state.activeRoundMode === 'chop') {
            checkTargetInteractions(playerIdx, normX, normY, isClickTap);
          }
        }

        gameCanvas.addEventListener('pointerdown', (e) => {
          isPointerDown = true;
          ensureAudio();
          handleCanvasPointer(e.clientX, e.clientY, true);
        });

        gameCanvas.addEventListener('pointermove', (e) => {
          const rect = gameCanvas.getBoundingClientRect();
          const normX = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
          const normY = Math.max(0, Math.min(1, (e.clientY - rect.top) / rect.height));
          const playerIdx = (state.numPlayers === 2 && normX >= 0.5) ? 1 : 0;
          updatePlayerHandPosition(playerIdx, normX, normY, false);

          if (state.activeRoundMode === 'chop' || isPointerDown) {
            checkTargetInteractions(playerIdx, normX, normY, false);
          }
        });

        window.addEventListener('pointerup', () => {
          isPointerDown = false;
        });

        window.addEventListener('keydown', (e) => {
          if (state.roundResolved) return;
          if (!document.getElementById('setupScreen').classList.contains('hidden')) return;
          if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;

          const key = e.key.toUpperCase();
          const p1Map = { 'A': 0, 'B': 1, 'C': 2, 'D': 3, '1': 0, '2': 1, '3': 2, '4': 3 };
          const p2Map = { 'J': 0, 'K': 1, 'L': 2, ';': 3, '7': 0, '8': 1, '9': 2, '0': 3 };

          if (key in p1Map) {
            const idx = p1Map[key];
            const t = state.targets.find(item => item.optionIndex === idx && item.alive);
            if (t) {
              state.players[0].slapAnim = 1.0;
              updatePlayerHandPosition(0, t.x / state.viewW, t.y / state.viewH, false);
              triggerTargetHit(0, t);
            }
          } else if (state.numPlayers === 2 && key in p2Map) {
            const idx = p2Map[key];
            const t = state.targets.find(item => item.optionIndex === idx && item.alive);
            if (t) {
              state.players[1].slapAnim = 1.0;
              updatePlayerHandPosition(1, t.x / state.viewW, t.y / state.viewH, false);
              triggerTargetHit(1, t);
            }
          }
        });

        window.addEventListener('resize', resizeGameCanvas);
      }

      window.addEventListener('load', () => {
        resizeGameCanvas();
        initAmbientNetBugs();
        renderQuestionList();
        loadCurrentQuestion();
        initEvents();
        requestAnimationFrame(gameLoop);
      });
    })();
  </script>
