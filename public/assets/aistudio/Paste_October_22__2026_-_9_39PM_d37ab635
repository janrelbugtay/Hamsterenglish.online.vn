<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Mosquito Slap &amp; Chop Chop — 3D AR Motion Quiz Game</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands@0.4.1675469240/hands.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/face_detection@0.4/face_detection.js" crossorigin="anonymous"></script>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&amp;family=Inter:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet" />
  <style>
    :root {
      --font-display: 'Fredoka', sans-serif;
      --font-sans: 'Inter', sans-serif;
    }
    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
    }
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: var(--font-sans);
      background: #060913;
      color: #f8fafc;
    }
    .font-display {
      font-family: var(--font-display);
    }
    .glass-hud {
      background: rgba(15, 23, 42, 0.72);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.16);
    }
    .setup-popup-shadow {
      box-shadow: 0 28px 80px -12px rgba(2, 6, 23, 0.78), 0 0 0 1px rgba(148, 163, 184, 0.18);
    }
    .mode-card-active {
      border-color: #2563eb !important;
      background: #eff6ff !important;
      color: #1d4ed8 !important;
    }
    .mode-card-chop-active {
      border-color: #ea580c !important;
      background: #fff7ed !important;
      color: #c2410c !important;
    }
    .mode-card-combo-active {
      border-color: #7c3aed !important;
      background: #f5f3ff !important;
      color: #6d28d9 !important;
    }
    .player-card-active {
      border-color: #2563eb !important;
      background: #eff6ff !important;
      color: #1d4ed8 !important;
    }
    #gameCanvas {
      touch-action: none;
      cursor: none;
    }
  </style>
</head>
<body class="relative w-screen h-screen overflow-hidden bg-slate-950 select-none">

  <!-- Hidden high-res webcam video & offscreen optical tracking canvas -->
  <video id="webcamVideo" autoplay playsinline muted class="hidden"></video>
  <canvas id="motionCanvas" width="160" height="120" class="hidden"></canvas>

  <!-- Toast Notification -->
  <div id="toastBanner" class="fixed bottom-5 right-5 z-50 hidden transform transition-all duration-300 translate-y-2 opacity-0 pointer-events-none">
    <div class="glass-hud px-4 py-2.5 rounded-2xl shadow-2xl flex items-center gap-2.5 border border-sky-400/40">
      <span id="toastIcon" class="text-lg">✨</span>
      <span id="toastText" class="text-xs sm:text-sm font-semibold text-white">Saved!</span>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- FULL-SCREEN 3D HIGH-RESOLUTION ARENA (Always rendered in background)      -->
  <!-- ========================================================================= -->
  <div id="gameScreen" class="fixed inset-0 z-10 flex flex-col select-none overflow-hidden">
    
    <!-- MINIMALIST FLOATING TOP HUD -->
    <div class="relative z-20 w-full px-3 sm:px-5 pt-2.5 pb-1 pointer-events-auto">
      <div class="max-w-6xl mx-auto flex flex-col gap-2">
        
        <!-- Row 1: Minimalist Player Score Pills & Quick Controls -->
        <div class="flex items-center justify-between gap-2">
          
          <!-- Player 1 Minimalist Pill -->
          <div class="glass-hud flex items-center gap-2.5 px-3.5 py-1.5 rounded-full shadow-lg">
            <span class="text-lg" id="hudP1Icon">🧤</span>
            <span id="hudP1Name" class="text-xs font-bold uppercase tracking-wider text-sky-300">Player 1</span>
            <span id="hudP1Score" class="font-display text-base sm:text-lg font-bold text-white">0 pts</span>
            <span id="hudP1Streak" class="text-[10px] px-2 py-0.5 rounded-full bg-amber-500/25 text-amber-300 font-bold">🔥 x1</span>
          </div>

          <!-- Minimalist Center Control Bar -->
          <div class="flex items-center gap-1.5 flex-wrap justify-center">
            <span id="hudQuestionCounter" class="glass-hud px-3 py-1 rounded-full text-xs font-bold text-sky-300">
              Q 1 / 8
            </span>

            <button id="btnToggleModeInGame" type="button" title="Switch between Mosquito Slap and Chop Chop Fencing!" class="glass-hud px-3.5 py-1 rounded-full font-display font-bold text-xs sm:text-sm transition flex items-center gap-1.5 text-white hover:border-sky-400">
              <span id="hudModeEmoji">🦟</span>
              <span id="hudModeText">MOSQUITO SLAP</span>
            </button>

            <button id="btnToggleCamInGame" type="button" class="glass-hud px-3 py-1 rounded-full hover:bg-slate-800/80 text-xs font-semibold text-sky-300 transition">
              📷 Cam: Auto
            </button>

            <button id="btnToggleNetInGame" type="button" class="glass-hud px-3 py-1 rounded-full hover:bg-slate-800/80 text-xs font-semibold text-purple-200 transition">
              🪖 Net Hat: ON
            </button>

            <button id="btnPauseOrSetup" type="button" class="glass-hud px-3.5 py-1 rounded-full bg-blue-600/80 hover:bg-blue-500 text-xs font-bold text-white border border-blue-400/40 transition shadow">
              ⚙️ Setup / Questions
            </button>
          </div>

          <!-- Player 2 Minimalist Pill -->
          <div id="hudP2Card" class="glass-hud flex items-center gap-2.5 px-3.5 py-1.5 rounded-full shadow-lg">
            <span id="hudP2Streak" class="text-[10px] px-2 py-0.5 rounded-full bg-amber-500/25 text-amber-300 font-bold">🔥 x1</span>
            <span id="hudP2Name" class="text-xs font-bold uppercase tracking-wider text-rose-300">Player 2</span>
            <span id="hudP2Score" class="font-display text-base sm:text-lg font-bold text-white">0 pts</span>
            <span class="text-lg" id="hudP2Icon">🧤</span>
          </div>
        </div>

        <!-- Row 2: Minimalist High-Contrast Floating Question Pill on Top -->
        <div class="glass-hud relative overflow-hidden rounded-2xl px-4 py-2 text-center shadow-2xl border border-white/20 max-w-4xl mx-auto w-full">
          <div class="absolute bottom-0 left-0 right-0 h-1 bg-slate-800/80">
            <div id="hudTimerBar" class="h-full bg-gradient-to-r from-sky-400 via-emerald-400 to-rose-500 transition-all duration-100" style="width: 100%;"></div>
          </div>

          <p id="hudQuestionPrompt" class="font-display text-base sm:text-xl md:text-2xl font-bold text-white tracking-wide drop-shadow">
            Loading question...
          </p>

          <!-- Minimalist Option Pills -->
          <div id="hudOptionsBar" class="mt-1.5 grid grid-cols-2 sm:grid-cols-4 gap-1.5 text-left">
            <!-- Populated dynamically -->
          </div>
        </div>

      </div>
    </div>

    <!-- HIGH-RESOLUTION 3D GAME CANVAS -->
    <div class="relative flex-1 w-full h-full overflow-hidden">
      <canvas id="gameCanvas" class="w-full h-full block"></canvas>

      <!-- Minimalist Bottom Hint Pill -->
      <div class="pointer-events-none absolute bottom-3 left-1/2 -translate-x-1/2 z-20 px-4 py-1 rounded-full glass-hud text-[11px] sm:text-xs text-slate-200 whitespace-nowrap shadow-lg">
        <span id="hudBottomHint">🦟 Clap your Purple Gloves on camera (or click/tap) to SLAP the mosquito with the right answer!</span>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- MINIMALIST POP-UP MODAL: GAME SETUP (Matches `image_232f61.png`, No Scroll) -->
  <!-- ========================================================================= -->
  <div id="setupScreen" class="fixed inset-0 z-40 bg-slate-950/70 backdrop-blur-md flex items-center justify-center p-3 sm:p-5 overflow-hidden">
    
    <!-- White Minimalist Modal Card (Fits viewport cleanly without scrolling) -->
    <div class="bg-white text-slate-800 w-full max-w-4xl rounded-[26px] setup-popup-shadow flex flex-col justify-between p-5 sm:p-7 overflow-hidden max-h-[95vh]">
      
      <!-- 1. TOP HEADER ROW: "GAME SETUP" + Players/Mode Quick Bar + Cancel & Save Quiz -->
      <div class="flex flex-wrap items-center justify-between gap-3 pb-3">
        <div class="flex items-center gap-3">
          <h1 class="text-xl sm:text-2xl font-black tracking-tight text-slate-900 uppercase">
            GAME SETUP
          </h1>
          <!-- Compact Camera Connect Badge -->
          <div class="flex items-center gap-1.5 bg-slate-100 px-2.5 py-1 rounded-full border border-slate-200 text-[11px] font-semibold text-slate-600">
            <span id="camStatusDot" class="w-2 h-2 rounded-full bg-amber-400"></span>
            <span id="camStatusLabel" class="hidden sm:inline">HD Cam Ready</span>
            <button id="btnTestCameraSetup" type="button" class="text-blue-600 hover:underline font-bold ml-1">
              Enable Cam
            </button>
          </div>
        </div>

        <!-- Right Actions: Cancel & Save Quiz (Exact match to `image_232f61.png`) -->
        <div class="flex items-center gap-3">
          <button id="btnCancelSetupModal" type="button" class="px-3 py-2 text-sm font-bold text-slate-600 hover:text-slate-900 transition">
            Cancel
          </button>
          <button id="btnSaveQuizModal" type="button" class="px-4 py-2.5 rounded-xl bg-[#1d7dfa] hover:bg-blue-600 text-white font-bold text-sm shadow-md shadow-blue-500/25 flex items-center gap-1.5 transition">
            <span>💾 Save Quiz</span>
          </button>
          <button id="btnStartGameTop" type="button" class="px-4 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-xs sm:text-sm shadow-md shadow-emerald-500/25 flex items-center gap-1.5 transition">
            <span>🎮 START GAME NOW</span>
            <span id="startBtnCountBadge" class="text-[11px] px-2 py-0.5 rounded-full bg-emerald-800/60 text-emerald-100">8 Qs</span>
          </button>
        </div>
      </div>

      <!-- 2. TOPIC / CLASS LEVEL / FOLDER + PLAYERS & MODE ROW (Matches `image_232f61.png`) -->
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 pb-3.5 border-b border-blue-100">
        <div class="sm:col-span-3">
          <label for="inputQuizTopic" class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">TOPIC</label>
          <input id="inputQuizTopic" type="text" value="Science &amp; Nature" placeholder="e.g. Present Simple" class="w-full px-3 py-2 rounded-xl bg-[#f8fafc] border border-slate-200 text-xs sm:text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-blue-500 focus:bg-white transition" />
        </div>

        <div class="sm:col-span-3">
          <label for="inputClassLevel" class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">CLASS LEVEL</label>
          <input id="inputClassLevel" type="text" value="All Levels" placeholder="e.g. KET, Starters" class="w-full px-3 py-2 rounded-xl bg-[#f8fafc] border border-slate-200 text-xs sm:text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-blue-500 focus:bg-white transition" />
        </div>

        <div class="sm:col-span-3">
          <label for="selectPresetPack" class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">FOLDER</label>
          <select id="selectPresetPack" aria-label="Load Preset Question Pack" class="w-full px-3 py-2 rounded-xl bg-[#f8fafc] border border-slate-200 text-xs sm:text-sm font-medium text-slate-700 focus:outline-none focus:border-blue-500 focus:bg-white transition">
            <option value="">No Folder (Root)</option>
            <option value="default">🌿 Starter Mix (Science &amp; Fun)</option>
            <option value="math">🧮 Quick Math &amp; Logic</option>
            <option value="world">🌍 World Geography</option>
          </select>
        </div>

        <!-- Players (1P/2P) & Mode Selector Compact Pills -->
        <div class="sm:col-span-3 flex flex-col justify-end gap-1.5">
          <div class="grid grid-cols-2 gap-1.5">
            <button id="btnSelect1P" type="button" class="player-card-active py-1.5 px-2 rounded-lg border border-slate-200 bg-slate-50 text-xs font-bold text-slate-700 transition flex items-center justify-center gap-1">
              <span>👤 1P</span>
              <span id="badge1P" class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
            </button>
            <button id="btnSelect2P" type="button" class="py-1.5 px-2 rounded-lg border border-slate-200 bg-slate-50 text-xs font-bold text-slate-700 transition flex items-center justify-center gap-1">
              <span>👥 2P</span>
              <span id="badge2P" class="hidden w-1.5 h-1.5 rounded-full bg-blue-600"></span>
            </button>
          </div>
          <div class="grid grid-cols-3 gap-1">
            <button id="btnModeMosquito" type="button" class="mode-card-active py-1 px-1.5 rounded-lg border border-slate-200 bg-slate-50 text-[11px] font-bold text-slate-700 transition truncate" title="Mosquito Slap Mode (Purple Net Hat + 2 Gloves)">
              🦟 Slap
            </button>
            <button id="btnModeChop" type="button" class="py-1 px-1.5 rounded-lg border border-slate-200 bg-slate-50 text-[11px] font-bold text-slate-700 transition truncate" title="Chop Chop Mode (3D Fencing Mask + Long Sword)">
              🤺 Chop
            </button>
            <button id="btnModeCombo" type="button" class="py-1 px-1.5 rounded-lg border border-slate-200 bg-slate-50 text-[11px] font-bold text-slate-700 transition truncate" title="Mix Both Modes">
              🔥 Mix
            </button>
          </div>
        </div>
      </div>

      <!-- 3. BLUE QUESTIONS BANNER BAR (Matches `image_232f61.png`) -->
      <div class="my-3 bg-[#eef4ff] border border-blue-100 rounded-2xl px-4 py-2.5 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-3 flex-wrap">
          <span id="questionListHeading" class="text-xs font-extrabold uppercase tracking-wider text-slate-700">
            QUESTIONS (1 / 8)
          </span>
          <!-- Non-scrolling Question Number Pager Pills -->
          <div id="questionPagerBar" class="flex items-center gap-1 flex-wrap">
            <!-- Populated dynamically by JS -->
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button id="btnOpenBulkPaste" type="button" class="px-3.5 py-1.5 rounded-xl bg-[#1d7dfa] hover:bg-blue-600 text-white text-xs font-bold shadow-sm flex items-center gap-1.5 transition">
            <span>📋</span>
            <span>Bulk Paste</span>
          </button>
          <button id="btnHowToBulkPaste" type="button" class="px-3.5 py-1.5 rounded-xl bg-[#6d28d9] hover:bg-purple-700 text-white text-xs font-bold shadow-sm flex items-center gap-1.5 transition">
            <span>▶️</span>
            <span>How to Bulk Paste</span>
          </button>
          <button id="btnClearQuestions" type="button" title="Delete Current / Clear" class="px-2.5 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 text-xs font-bold transition">
            Clear All
          </button>
        </div>
      </div>

      <!-- 4. SINGLE QUESTION EDITOR CARD (Matches `image_232f61.png` — Zero Scrolling!) -->
      <form id="questionForm" class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-sm space-y-4">
        <div class="flex items-start gap-3">
          <!-- Blue Question Number Circle -->
          <div id="activeQuestionNumCircle" class="w-8 h-8 rounded-full bg-blue-100 border border-blue-200 text-blue-600 font-bold text-sm flex items-center justify-center shrink-0 mt-1">
            1
          </div>
          <div class="flex-1">
            <input id="inputQuestionText" type="text" required placeholder="Type your question here..." class="w-full px-4 py-2.5 rounded-xl bg-white border border-slate-200 text-sm sm:text-base text-slate-800 placeholder-slate-400 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/15 transition" />
          </div>
        </div>

        <!-- Options Grid (3 on Row 1, 1 on Row 2 — Exact layout from `image_232f61.png`) -->
        <div class="pl-0 sm:pl-11 space-y-3">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <!-- Option 1 -->
            <div class="flex items-center gap-2">
              <input type="radio" name="correctOption" id="radioCorrect0" value="0" checked class="w-4 h-4 accent-blue-600 cursor-pointer shrink-0" title="Mark Option 1 as Correct" />
              <input id="inputOpt0" type="text" required placeholder="Option 1" class="w-full px-3.5 py-2 rounded-xl bg-white border border-blue-300 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-blue-600 transition" />
              <span class="w-7 h-7 rounded-lg bg-purple-100 text-purple-500 flex items-center justify-center text-xs shrink-0" title="Option A">🖼️</span>
            </div>

            <!-- Option 2 -->
            <div class="flex items-center gap-2">
              <input type="radio" name="correctOption" id="radioCorrect1" value="1" class="w-4 h-4 accent-blue-600 cursor-pointer shrink-0" title="Mark Option 2 as Correct" />
              <input id="inputOpt1" type="text" required placeholder="Option 2" class="w-full px-3.5 py-2 rounded-xl bg-white border border-slate-200 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-blue-600 transition" />
              <span class="w-7 h-7 rounded-lg bg-purple-100 text-purple-500 flex items-center justify-center text-xs shrink-0" title="Option B">🖼️</span>
            </div>

            <!-- Option 3 -->
            <div id="optBox2" class="flex items-center gap-2">
              <input type="radio" name="correctOption" id="radioCorrect2" value="2" class="w-4 h-4 accent-blue-600 cursor-pointer shrink-0" title="Mark Option 3 as Correct" />
              <input id="inputOpt2" type="text" required placeholder="Option 3" class="w-full px-3.5 py-2 rounded-xl bg-white border border-slate-200 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-blue-600 transition" />
              <span class="w-7 h-7 rounded-lg bg-purple-100 text-purple-500 flex items-center justify-center text-xs shrink-0" title="Option C">🖼️</span>
            </div>
          </div>

          <!-- Row 2: Option 4 -->
          <div id="optBox3" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="flex items-center gap-2">
              <input type="radio" name="correctOption" id="radioCorrect3" value="3" class="w-4 h-4 accent-blue-600 cursor-pointer shrink-0" title="Mark Option 4 as Correct" />
              <input id="inputOpt3" type="text" required placeholder="Option 4" class="w-full px-3.5 py-2 rounded-xl bg-white border border-slate-200 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-blue-600 transition" />
              <span class="w-7 h-7 rounded-lg bg-purple-100 text-purple-500 flex items-center justify-center text-xs shrink-0" title="Option D">🖼️</span>
            </div>
          </div>

          <!-- + Option / - Option & Quick Save Row (Matches `image_232f61.png`) -->
          <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
            <div class="flex items-center gap-2">
              <button id="btnAddOptionField" type="button" class="px-3 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition">
                + Option
              </button>
              <button id="btnRemoveOptionField" type="button" class="px-3 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition">
                - Option
              </button>
              <span id="formTitleLabel" class="text-[11px] text-slate-400 ml-2">Select the radio circle for the correct answer</span>
              <button id="btnCancelEdit" type="button" class="hidden text-xs text-slate-400 underline">Cancel Edit</button>
            </div>

            <div class="flex items-center gap-2">
              <button id="btnDeleteCurrentQuestion" type="button" class="px-3 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-600 text-xs font-bold transition">
                🗑️ Delete Q
              </button>
              <button id="btnSubmitQuestion" type="submit" class="px-4 py-1.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-bold shadow-sm transition">
                + Add Question to Game
              </button>
            </div>
          </div>
        </div>
      </form>

      <!-- 5. DASHED "+ Add Another Question" BUTTON + PLAY FOOTER (Matches `image_232f61.png`) -->
      <div class="mt-3 flex flex-col sm:flex-row items-center gap-3">
        <button id="btnAddAnotherQuestionCard" type="button" class="w-full sm:flex-1 py-2.5 px-4 rounded-2xl border-2 border-dashed border-slate-300 hover:border-blue-500 hover:bg-blue-50/40 text-slate-600 hover:text-blue-600 font-bold text-xs sm:text-sm transition flex items-center justify-center gap-2">
          <span class="text-base leading-none">＋</span>
          <span>Add Another Question</span>
        </button>

        <button id="btnStartGameBottom" type="button" class="w-full sm:w-auto px-7 py-2.5 rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-display font-bold text-sm sm:text-base shadow-lg shadow-blue-600/25 transition">
          🚀 LAUNCH ARENA
        </button>
      </div>

      <!-- Hidden compatibility elements for state sync -->
      <div class="hidden">
        <input id="inputP1Name" type="text" value="Player 1" />
        <div id="p2NameContainer"><input id="inputP2Name" type="text" value="Player 2" /></div>
        <input id="chkShowHeadgear" type="checkbox" checked />
        <input id="chkShowHandGear" type="checkbox" checked />
        <input id="chkSoundFx" type="checkbox" checked />
        <select id="selectSpeed"><option value="1" selected>Normal</option></select>
        <div id="questionListContainer"></div>
      </div>

    </div>

    <!-- ===================================================================== -->
    <!-- BULK PASTE POP-UP OVERLAY (Inside Setup Modal)                        -->
    <!-- ===================================================================== -->
    <div id="bulkPasteModal" class="hidden fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-4">
      <div class="bg-white text-slate-800 max-w-lg w-full rounded-3xl p-6 shadow-2xl space-y-4 border border-slate-200">
        <div class="flex items-center justify-between">
          <h3 id="bulkModalTitle" class="text-lg font-extrabold text-slate-900">📋 Bulk Paste Questions</h3>
          <button id="btnCloseBulkModal" type="button" class="text-slate-400 hover:text-slate-700 font-bold text-sm">✕ Close</button>
        </div>
        <p id="bulkModalHelp" class="text-xs text-slate-500 leading-relaxed">
          Paste one question per line in the format: <code class="bg-slate-100 px-1.5 py-0.5 rounded text-blue-700">Question | Option 1 | Option 2 | Option 3 | Option 4 | CorrectNumber(1-4)</code>
        </p>
        <textarea id="textareaBulkPaste" rows="5" placeholder="What is 9 x 6? | 48 | 54 | 56 | 63 | 2&#10;Which insect buzzes? | Mosquito | Turtle | Snail | Crab | 1" class="w-full p-3 rounded-xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-800 focus:outline-none focus:border-blue-500"></textarea>
        <div class="flex items-center justify-end gap-2">
