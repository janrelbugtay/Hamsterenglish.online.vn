      function processWebcamMotion() {
        if (!state.cameraActive || webcamVideo.readyState < 2) return;

        if (state.mpHands && !state.mpHandsBusy) {
          state.mpHandsBusy = true;
          state.mpHands.send({ image: webcamVideo }).then(() => {
            state.mpHandsBusy = false;
          }).catch(() => {
            state.mpHandsBusy = false;
          });
        }

        if (state.mpFace && !state.mpFaceBusy) {
          state.mpFaceBusy = true;
          state.mpFace.send({ image: webcamVideo }).then(() => {
            state.mpFaceBusy = false;
          }).catch(() => {
            state.mpFaceBusy = false;
          });
        }

        const mw = motionCanvas.width;
        const mh = motionCanvas.height;

        motionCtx.save();
        motionCtx.scale(-1, 1);
        motionCtx.drawImage(webcamVideo, -mw, 0, mw, mh);
        motionCtx.restore();

        let frame;
        try {
          frame = motionCtx.getImageData(0, 0, mw, mh);
        } catch (e) {
          return;
        }
        const data = frame.data;

        if (!state.prevFrameData) {
          state.prevFrameData = new Uint8ClampedArray(data);
          return;
        }

        const prev = state.prevFrameData;
        const threshold = 30;
        const now = performance.now();
        const mpHandsRecent = state.mpHandsReady && (now - state.lastHandsTimestamp < 320);

        let skinX = 0, skinY = 0, skinCount = 0;
        let leftMotionX = 0, leftMotionY = 0, leftMotionCount = 0;
        let rightMotionX = 0, rightMotionY = 0, rightMotionCount = 0;

        for (let y = 6; y < mh - 6; y += 2) {
          for (let x = 6; x < mw - 6; x += 2) {
            const i = (y * mw + x) * 4;
            const r = data[i], g = data[i + 1], b = data[i + 2];

            if (y < mh * 0.65 && r > 95 && g > 40 && b > 20 && (r - g) > 15 && r > b) {
              skinX += x;
              skinY += y;
              skinCount++;
            }

            const diff = Math.abs(r - prev[i]) + Math.abs(g - prev[i + 1]) + Math.abs(b - prev[i + 2]);
            if (diff > threshold * 3) {
              if (x < mw * 0.5) {
                leftMotionX += x;
                leftMotionY += y;
                leftMotionCount++;
              } else {
                rightMotionX += x;
                rightMotionY += y;
                rightMotionCount++;
              }
            }
          }
        }

        if (skinCount > 45 && (now - state.players[0].lastFaceSeen > 550)) {
          const mappedFace = mapCamToCanvasNorm((skinX / skinCount) / mw, (skinY / skinCount) / mh);
          const p0 = state.players[0];
          p0.headX = adaptiveSmooth(p0.headX, mappedFace.x, 0.25, 6.0);
          p0.headY = adaptiveSmooth(p0.headY, Math.max(0.20, Math.min(0.55, mappedFace.y)), 0.25, 6.0);
        }

        if (!mpHandsRecent) {
          if (state.numPlayers === 1) {
            const p0 = state.players[0];
            if (leftMotionCount > 9) {
              const mL = mapCamToCanvasNorm((leftMotionX / leftMotionCount) / mw, (leftMotionY / leftMotionCount) / mh);
              updateSingleGlove(p0, p0.leftHand, mL.x, mL.y, -0.18, 1.0);
              updatePlayerHandPosition(0, mL.x, mL.y, true);
            }
            if (rightMotionCount > 9) {
              const mR = mapCamToCanvasNorm((rightMotionX / rightMotionCount) / mw, (rightMotionY / rightMotionCount) / mh);
              updateSingleGlove(p0, p0.rightHand, mR.x, mR.y, -0.32, 1.0);
              updatePlayerHandPosition(0, mR.x, mR.y, true);
            }
          } else {
            if (leftMotionCount > 9) {
              const m1 = mapCamToCanvasNorm((leftMotionX / leftMotionCount) / mw, (leftMotionY / leftMotionCount) / mh);
              updatePlayerHandPosition(0, m1.x, m1.y, true);
            }
            if (rightMotionCount > 9) {
              const m2 = mapCamToCanvasNorm((rightMotionX / rightMotionCount) / mw, (rightMotionY / rightMotionCount) / mh);
              updatePlayerHandPosition(1, m2.x, m2.y, true);
            }
          }
        }

        state.prevFrameData.set(data);
      }

      // Computes the exact blade length of the long 3D Fencing Sword in pixels
      function getFencingSwordBladeLength(cw, p) {
        const baseLen = Math.max(255, Math.min(350, cw * 0.29));
        return baseLen * (1 + p.swordLunge * 0.22);
      }

      function updatePlayerHandPosition(playerIdx, normX, normY, isFromCamera, pointingAngle, customScale) {
        const p = state.players[playerIdx];
        if (!p) return;

        p.prevHandX = p.handX;
        p.prevHandY = p.handY;

        const rawVx = normX - p.handX;
        const rawVy = normY - p.handY;
        p.handX = adaptiveSmooth(p.handX, normX + (isFromCamera ? rawVx * 0.32 : 0), isFromCamera ? 0.48 : 0.82, 10.0);
        p.handY = adaptiveSmooth(p.handY, normY + (isFromCamera ? rawVy * 0.32 : 0), isFromCamera ? 0.48 : 0.82, 10.0);

        p.vx = p.handX - p.prevHandX;
        p.vy = p.handY - p.prevHandY;
        p.speed = Math.hypot(p.vx, p.vy);

        // Dynamic Fencing Sword rotation & lunge physics
        let targetSwordAngle = p.swordAngle;
        if (p.speed > 0.0035) {
          // Blend hand velocity direction with natural upward-forward fencing poise
          const velAngle = Math.atan2(p.vy, p.vx);
          targetSwordAngle = typeof pointingAngle === 'number'
            ? pointingAngle * 0.55 + velAngle * 0.45
            : velAngle;
          p.swordLunge = Math.min(1.0, p.swordLunge + p.speed * 11);
        } else if (typeof pointingAngle === 'number') {
          targetSwordAngle = pointingAngle;
        }

        // Smooth shortest-arc angle interpolation
        let angleDiff = targetSwordAngle - p.swordAngle;
        while (angleDiff > Math.PI) angleDiff -= Math.PI * 2;
        while (angleDiff < -Math.PI) angleDiff += Math.PI * 2;
        p.swordAngVel = angleDiff * 0.42;
        p.swordAngle += p.swordAngVel;

        const cw = state.viewW || 960;
        const ch = state.viewH || 540;
        const bladeLen = getFencingSwordBladeLength(cw, p);
        const hx = p.handX * cw;
        const hy = p.handY * ch;
        const tipX = hx + Math.cos(p.swordAngle) * bladeLen;
        const tipY = hy + Math.sin(p.swordAngle) * bladeLen;

        p.trail.push({
          x: p.handX,
          y: p.handY,
          tipX: tipX / cw,
          tipY: tipY / ch,
          life: 1.0
        });
        if (p.trail.length > 22) {
          p.trail.shift();
        }

        // Emit gleaming metallic sword sparks when slashing fast in Chop Chop mode
        if (state.activeRoundMode === 'chop' && (p.speed > 0.008 || Math.abs(p.swordAngVel) > 0.08)) {
          for (let s = 0; s < 2; s++) {
            const frac = 0.35 + Math.random() * 0.65;
            state.swordSparks.push({
              x: hx + Math.cos(p.swordAngle) * (bladeLen * frac),
              y: hy + Math.sin(p.swordAngle) * (bladeLen * frac),
              vx: (Math.random() - 0.5) * 4.5,
              vy: (Math.random() - 0.5) * 4.5 - 1.0,
              size: 2 + Math.random() * 3.5,
              color: Math.random() < 0.5 ? '#ffffff' : p.theme.swordColor,
              life: 1.0
            });
          }
        }

        if (!isFromCamera || (!p.leftHand.tracked && !p.rightHand.tracked)) {
          const clapPinch = p.slapAnim * 0.048;
          const spreadX = Math.max(0.018, 0.065 - clapPinch);
          p.leftHand.x += ((p.handX - spreadX) - p.leftHand.x) * 0.68;
          p.leftHand.y += ((p.handY + 0.04) - p.leftHand.y) * 0.68;
          p.leftHand.angle = -0.15 + p.slapAnim * 0.22;

          p.rightHand.x += ((p.handX + spreadX * 0.75) - p.rightHand.x) * 0.68;
          p.rightHand.y += ((p.handY - 0.02) - p.rightHand.y) * 0.68;
          p.rightHand.angle = -0.35 - p.slapAnim * 0.22;
        }

        if (!state.cameraActive) {
          const baseHeadX = state.numPlayers === 1 ? 0.5 : (playerIdx === 0 ? 0.27 : 0.73);
          p.headX = baseHeadX + (p.handX - baseHeadX) * 0.22;
          p.headTilt = -0.04 + (p.handX - baseHeadX) * 0.16;
        }

        if (state.inGame && !state.roundResolved) {
          if (state.activeRoundMode === 'chop' && (p.speed > 0.004 || Math.abs(p.swordAngVel) > 0.04)) {
            checkSwordBladeCollisions(playerIdx, hx, hy, tipX, tipY);
          } else if (state.activeRoundMode === 'mosquito' && isFromCamera && p.speed > 0.012) {
            p.slapAnim = 1.0;
            checkTargetInteractions(playerIdx, p.handX, p.handY, true);
          }
        }
      }

      // -----------------------------------------------------------------------
      // 5. MINIMALIST POP-UP SETUP UI & NON-SCROLLING QUESTION PAGER
      // -----------------------------------------------------------------------
      function renderQuestionList() {
        const heading = document.getElementById('questionListHeading');
        const badge = document.getElementById('startBtnCountBadge');
        const pager = document.getElementById('questionPagerBar');
        const circle = document.getElementById('activeQuestionNumCircle');
        const container = document.getElementById('questionListContainer');

        const total = state.questions.length;
        if (state.setupActiveIdx >= total) {
          state.setupActiveIdx = Math.max(0, total - 1);
        }

        if (heading) {
          heading.textContent = `QUESTIONS (${total > 0 ? state.setupActiveIdx + 1 : 0} / ${Math.max(30, total)})`;
        }
        if (badge) {
          badge.textContent = `${total} Qs`;
        }
        if (circle) {
          circle.textContent = String(state.setupActiveIdx + 1);
        }

        // Render compact non-scrolling question number pills inside the blue bar
        if (pager) {
          pager.innerHTML = state.questions.map((item, idx) => {
            const active = idx === state.setupActiveIdx;
            const cls = active
              ? 'bg-[#1d7dfa] text-white border-[#1d7dfa] shadow-sm'
              : 'bg-white text-slate-600 border-blue-200 hover:border-blue-400';
            return `<button type="button" data-page-idx="${idx}" class="w-6 h-6 rounded-full border text-[11px] font-bold transition flex items-center justify-center ${cls}">${idx + 1}</button>`;
          }).join('');
        }

        // Populate the active question into the clean card inputs
        const activeQ = state.questions[state.setupActiveIdx];
        const qInput = document.getElementById('inputQuestionText');
        if (activeQ && qInput) {
          state.editingQuestionId = activeQ.id;
          qInput.value = activeQ.q;
          for (let i = 0; i < 4; i++) {
            const optEl = document.getElementById('inputOpt' + i);
            if (optEl) optEl.value = activeQ.options[i] || '';
          }
          const radio = document.getElementById('radioCorrect' + activeQ.correct);
          if (radio) radio.checked = true;
        } else if (qInput) {
          state.editingQuestionId = null;
          qInput.value = '';
          for (let i = 0; i < 4; i++) {
            const optEl = document.getElementById('inputOpt' + i);
            if (optEl) optEl.value = '';
          }
          const radio0 = document.getElementById('radioCorrect0');
          if (radio0) radio0.checked = true;
        }

        // Also keep hidden compatibility container updated
        if (container) {
          container.innerHTML = state.questions.map((item, idx) =>
            `<div data-id="${item.id}">#${idx + 1} ${escapeHtml(item.q)}</div>`
          ).join('');
        }
      }

      function syncCurrentCardToState() {
        const activeQ = state.questions[state.setupActiveIdx];
        if (!activeQ) return;
        const qText = document.getElementById('inputQuestionText').value.trim();
        const opts = [
          document.getElementById('inputOpt0').value.trim() || 'Option 1',
          document.getElementById('inputOpt1').value.trim() || 'Option 2',
          document.getElementById('inputOpt2').value.trim() || 'Option 3',
          document.getElementById('inputOpt3').value.trim() || 'Option 4'
        ];
        const checkedRadio = document.querySelector('input[name="correctOption"]:checked');
        const correctIdx = checkedRadio ? parseInt(checkedRadio.value, 10) : 0;

        if (qText) {
          activeQ.q = qText;
          activeQ.options = opts;
          activeQ.correct = correctIdx;
          saveQuestionsToStorage();
        }
      }

      function escapeHtml(str) {
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function setPlayersCount(count) {
        state.numPlayers = count;
        const btn1P = document.getElementById('btnSelect1P');
        const btn2P = document.getElementById('btnSelect2P');
        const badge1P = document.getElementById('badge1P');
        const badge2P = document.getElementById('badge2P');

        if (count === 1) {
          btn1P.classList.add('player-card-active');
          btn2P.classList.remove('player-card-active');
          badge1P.classList.remove('hidden');
          badge2P.classList.add('hidden');
        } else {
          btn2P.classList.add('player-card-active');
          btn1P.classList.remove('player-card-active');
          badge2P.classList.remove('hidden');
          badge1P.classList.add('hidden');
        }
      }

      function setGameMode(mode) {
        state.selectedMode = mode;
        const btnMosq = document.getElementById('btnModeMosquito');
        const btnChop = document.getElementById('btnModeChop');
        const btnCombo = document.getElementById('btnModeCombo');

        btnMosq.classList.remove('mode-card-active');
        btnChop.classList.remove('mode-card-chop-active');
        btnCombo.classList.remove('mode-card-combo-active');

        if (mode === 'mosquito') btnMosq.classList.add('mode-card-active');
        else if (mode === 'chop') btnChop.classList.add('mode-card-chop-active');
        else btnCombo.classList.add('mode-card-combo-active');
      }

      // -----------------------------------------------------------------------
      // 6. HIGH-RESOLUTION HiDPI CANVAS & GAMEPLAY SPAWNING
      // -----------------------------------------------------------------------
      function resizeGameCanvas() {
        const rect = gameCanvas.parentElement.getBoundingClientRect();
        const cssW = Math.max(320, rect.width || window.innerWidth);
        const cssH = Math.max(280, rect.height || window.innerHeight);
        const dpr = Math.min(2.5, window.devicePixelRatio || 1);

        state.viewW = cssW;
        state.viewH = cssH;
        state.dpr = dpr;

        gameCanvas.width = Math.round(cssW * dpr);
        gameCanvas.height = Math.round(cssH * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = 'high';
      }

      function initAmbientNetBugs() {
        state.ambientBugs = [];
        for (let i = 0; i < 5; i++) {
          state.ambientBugs.push({
            angle: Math.random() * Math.PI * 2,
            dist: 42 + Math.random() * 28,
            speed: (Math.random() * 0.035 + 0.02) * (Math.random() < 0.5 ? 1 : -1),
            phase: Math.random() * 10
          });
        }
      }

      function startGameSession() {
        syncCurrentCardToState();

        if (state.questions.length === 0) {
          state.questions = JSON.parse(JSON.stringify(PRESET_DECKS.default));
          state.setupActiveIdx = 0;
          renderQuestionList();
        }

        ensureAudio();

        const p1Input = document.getElementById('inputP1Name');
        const p2Input = document.getElementById('inputP2Name');
        const p1Name = (p1Input && p1Input.value.trim()) ? p1Input.value.trim() : 'Player 1';
        const p2Name = (p2Input && p2Input.value.trim()) ? p2Input.value.trim() : 'Player 2';

        state.players[0] = createPlayerState(0, p1Name, false);
        state.players[1] = createPlayerState(1, p2Name, true);
        if (state.numPlayers === 2) {
          state.players[0].headX = 0.27;
          state.players[0].handX = 0.27;
          state.players[0].leftHand.x = 0.20;
          state.players[0].rightHand.x = 0.33;
        }

        state.currentQIndex = 0;
        state.inGame = true;
        state.splats = [];
        state.slicedHalves = [];
        state.particles = [];
        state.swordSparks = [];
        state.floatingTexts = [];
        initAmbientNetBugs();

        // Hide the Game Setup Pop-Up Modal so the full-screen 3D arena is front and center
        document.getElementById('setupScreen').classList.add('hidden');
        document.getElementById('gameOverModal').classList.add('hidden');

        resizeGameCanvas();

        if (!state.cameraActive) {
          startCamera(true);
        }

        loadCurrentQuestion();
      }

      function determineRoundMode() {
        if (state.selectedMode === 'mosquito') return 'mosquito';
        if (state.selectedMode === 'chop') return 'chop';
        return (state.currentQIndex % 2 === 0) ? 'mosquito' : 'chop';
      }

      function loadCurrentQuestion() {
        if (state.currentQIndex >= state.questions.length) {
          finishGameSession();
          return;
        }

        state.activeRoundMode = determineRoundMode();
        state.roundResolved = false;
        state.questionMaxTime = 18;
        state.questionTimer = state.questionMaxTime;
        state.targets = [];
        state.slicedHalves = [];

        updateInGameHUD();
        spawnTargetsForCurrentQuestion();
      }

      function spawnTargetsForCurrentQuestion() {
        const qObj = state.questions[state.currentQIndex];
        if (!qObj) return;

        const cw = state.viewW || 960;
        const ch = state.viewH || 540;
        const spd = state.speedMultiplier;

        state.targets = [];

        if (state.activeRoundMode === 'mosquito') {
          for (let i = 0; i < 4; i++) {
            const colX = (i % 2 === 0) ? cw * (0.18 + Math.random() * 0.20) : cw * (0.62 + Math.random() * 0.20);
            const rowY = (i < 2) ? ch * (0.24 + Math.random() * 0.16) : ch * (0.56 + Math.random() * 0.18);
            const angle = Math.random() * Math.PI * 2;
            const baseSpeed = (2.1 + Math.random() * 1.1) * spd;

            state.targets.push({
              optionIndex: i,
              letter: OPTION_LETTERS[i],
              text: qObj.options[i] || `Option ${i + 1}`,
              isCorrect: i === qObj.correct,
              x: colX,
              y: rowY,
              vx: Math.cos(angle) * baseSpeed,
              vy: Math.sin(angle) * baseSpeed,
              radius: Math.max(48, Math.min(64, cw * 0.056)),
              wingPhase: Math.random() * Math.PI * 2,
              wobblePhase: Math.random() * Math.PI * 2,
              alive: true,
              cooldown: 0,
              color: OPTION_COLORS[i]
            });
          }
        } else {
          launchFruitWave();
        }
      }

      function launchFruitWave() {
        const qObj = state.questions[state.currentQIndex];
        if (!qObj) return;

        const cw = state.viewW || 960;
        const ch = state.viewH || 540;
        const spd = state.speedMultiplier;

        state.targets = [];
        for (let i = 0; i < 4; i++) {
          const laneX = cw * (0.16 + i * 0.22) + (Math.random() - 0.5) * 40;
          const targetPeakY = ch * (0.18 + Math.random() * 0.18);
          const gravity = 0.20 * spd;
          const travelH = Math.max(180, (ch + 40) - targetPeakY);
          const vy = -Math.sqrt(2 * gravity * travelH);
          const centerPull = ((cw * 0.5) - laneX) * 0.0055 * spd;

          state.targets.push({
            optionIndex: i,
            letter: OPTION_LETTERS[i],
            text: qObj.options[i] || `Option ${i + 1}`,
            isCorrect: i === qObj.correct,
            x: laneX,
            y: ch + 45 + (i % 2) * 28,
            vx: centerPull + (Math.random() - 0.5) * 1.4,
            vy: vy,
            gravity: gravity,
            rotation: Math.random() * Math.PI * 2,
            rotSpeed: (Math.random() - 0.5) * 0.065,
            radius: Math.max(50, Math.min(66, cw * 0.058)),
            alive: true,
            cooldown: 0,
            color: OPTION_COLORS[i]
          });
        }
      }

