<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mystery Box Game</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
      @keyframes floatUp {
        0% {
          transform: translateY(0) scale(0.5) rotate(0deg);
          opacity: 1;
        }
        100% {
          transform: translateY(-120vh) scale(1.5) rotate(360deg);
          opacity: 0;
        }
      }
      @keyframes dropDown {
        0% {
          transform: translateY(0) scale(1) rotate(0deg);
          opacity: 1;
        }
        100% {
          transform: translateY(120vh) scale(0.5) rotate(-90deg);
          opacity: 0;
        }
      }
      @keyframes shake {
        0%,
        100% {
          transform: translateX(0);
        }
        20%,
        60% {
          transform: translateX(-10px);
        }
        40%,
        80% {
          transform: translateX(10px);
        }
      }
      @keyframes confettiFall {
        0% {
          transform: translateY(-20vh) rotate(0deg);
          opacity: 1;
        }
        100% {
          transform: translateY(120vh) rotate(720deg);
          opacity: 0;
        }
      }

      .animate-float-up {
        animation: floatUp 2.5s ease-out forwards;
      }
      .animate-drop-down {
        animation: dropDown 2.5s ease-in forwards;
      }
      .animate-shake {
        animation: shake 0.5s ease-in-out;
      }
      .animate-confetti {
        animation: confettiFall linear infinite;
      }

      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: transparent;
      }
      ::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
      }

      .animate-in {
        animation: fadeIn 0.3s ease-out;
      }
      .zoom-in-95 {
        animation: zoomIn 0.3s ease-out;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      @keyframes zoomIn {
        from {
          transform: scale(0.95);
          opacity: 0;
        }
        to {
          transform: scale(1);
          opacity: 1;
        }
      }
    </style>
  </head>
  <body class="text-slate-800 font-sans">
    <div id="app-root"></div>

    <script>
      // --- SOUND SYNTHESIZER ---
      const playSound = (type, isMuted) => {
        if (isMuted) return;
        try {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (!AudioContext) return;
          const ctx = new AudioContext();
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();

          osc.connect(gain);
          gain.connect(ctx.destination);

          if (type === "click") {
            osc.type = "sine";
            osc.frequency.setValueAtTime(600, ctx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(
              300,
              ctx.currentTime + 0.1,
            );
            gain.gain.setValueAtTime(0.1, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(
              0.001,
              ctx.currentTime + 0.1,
            );
            osc.start();
            osc.stop(ctx.currentTime + 0.1);
          } else if (type === "correct") {
            osc.type = "sine";
            osc.frequency.setValueAtTime(523.25, ctx.currentTime);
            osc.frequency.setValueAtTime(659.25, ctx.currentTime + 0.1);
            osc.frequency.setValueAtTime(783.99, ctx.currentTime + 0.2);
            gain.gain.setValueAtTime(0.1, ctx.currentTime);
            gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 0.4);
            osc.start();
            osc.stop(ctx.currentTime + 0.4);
          } else if (type === "incorrect") {
            osc.type = "sawtooth";
            osc.frequency.setValueAtTime(150, ctx.currentTime);
            osc.frequency.linearRampToValueAtTime(100, ctx.currentTime + 0.3);
            gain.gain.setValueAtTime(0.1, ctx.currentTime);
            gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 0.3);
            osc.start();
            osc.stop(ctx.currentTime + 0.3);
          } else if (type === "reveal") {
            osc.type = "square";
            osc.frequency.setValueAtTime(440, ctx.currentTime);
            osc.frequency.setValueAtTime(554.37, ctx.currentTime + 0.1);
            osc.frequency.setValueAtTime(659.25, ctx.currentTime + 0.2);
            osc.frequency.setValueAtTime(880, ctx.currentTime + 0.3);
            gain.gain.setValueAtTime(0.05, ctx.currentTime);
            gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 0.6);
            osc.start();
            osc.stop(ctx.currentTime + 0.6);
          } else if (type === "win") {
            osc.type = "square";
            osc.frequency.setValueAtTime(440, ctx.currentTime);
            osc.frequency.setValueAtTime(554.37, ctx.currentTime + 0.15);
            osc.frequency.setValueAtTime(659.25, ctx.currentTime + 0.3);
            osc.frequency.setValueAtTime(880, ctx.currentTime + 0.45);
            osc.frequency.setValueAtTime(1108.73, ctx.currentTime + 0.6);
            gain.gain.setValueAtTime(0.1, ctx.currentTime);
            gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 1.0);
            osc.start();
            osc.stop(ctx.currentTime + 1.0);
          } else if (type === "lose") {
            osc.type = "sawtooth";
            osc.frequency.setValueAtTime(300, ctx.currentTime);
            osc.frequency.linearRampToValueAtTime(200, ctx.currentTime + 0.4);
            osc.frequency.setValueAtTime(200, ctx.currentTime + 0.4);
            osc.frequency.linearRampToValueAtTime(100, ctx.currentTime + 0.9);
            gain.gain.setValueAtTime(0.15, ctx.currentTime);
            gain.gain.linearRampToValueAtTime(0.1, ctx.currentTime + 0.4);
            gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 0.9);
            osc.start();
            osc.stop(ctx.currentTime + 0.9);
          } else if (type === "grand_win") {
            osc.type = "square";
            osc.frequency.setValueAtTime(523.25, ctx.currentTime);
            osc.frequency.setValueAtTime(659.25, ctx.currentTime + 0.2);
            osc.frequency.setValueAtTime(783.99, ctx.currentTime + 0.4);
            osc.frequency.setValueAtTime(1046.5, ctx.currentTime + 0.6);
            gain.gain.setValueAtTime(0.15, ctx.currentTime);
            gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 2.0);
            osc.start();
            osc.stop(ctx.currentTime + 2.0);
          }
        } catch (e) {
          console.error("Audio playback failed:", e);
        }
      };

      // --- GLOBAL DATA & CONSTANTS ---
      const OUTCOMES = [
        {
          id: "add500",
          text: "+500 points",
          icon: `<i data-lucide="star" class="w-10 h-10 text-yellow-100"></i>`,
          color: "bg-green-600 shadow-green-600/40",
          action: (teams, tIdx) => {
            teams[tIdx].score += 500;
            return teams;
          },
        },
        {
          id: "add300",
          text: "+300 points",
          icon: `<i data-lucide="star" class="w-10 h-10 text-yellow-100"></i>`,
          color: "bg-emerald-500 shadow-emerald-500/40",
          action: (teams, tIdx) => {
            teams[tIdx].score += 300;
            return teams;
          },
        },
        {
          id: "add200_1",
          text: "+200 points",
          icon: `<i data-lucide="star" class="w-10 h-10 text-yellow-100"></i>`,
          color: "bg-green-500 shadow-green-500/40",
          action: (teams, tIdx) => {
            teams[tIdx].score += 200;
            return teams;
          },
        },
        {
          id: "add200_2",
          text: "+200 points",
          icon: `<i data-lucide="star" class="w-10 h-10 text-yellow-100"></i>`,
          color: "bg-green-500 shadow-green-500/40",
          action: (teams, tIdx) => {
            teams[tIdx].score += 200;
            return teams;
          },
        },
        {
          id: "add100_1",
          text: "+100 points",
          icon: `<i data-lucide="star" class="w-10 h-10 text-yellow-100"></i>`,
          color: "bg-teal-500 shadow-teal-500/40",
          action: (teams, tIdx) => {
            teams[tIdx].score += 100;
            return teams;
          },
        },
        {
          id: "add100_2",
          text: "+100 points",
          icon: `<i data-lucide="star" class="w-10 h-10 text-yellow-100"></i>`,
          color: "bg-teal-500 shadow-teal-500/40",
          action: (teams, tIdx) => {
            teams[tIdx].score += 100;
            return teams;
          },
        },
        {
          id: "add50_1",
          text: "+50 points",
          icon: `<i data-lucide="star" class="w-10 h-10 text-yellow-100"></i>`,
          color: "bg-cyan-500 shadow-cyan-500/40",
          action: (teams, tIdx) => {
            teams[tIdx].score += 50;
            return teams;
          },
        },
        {
          id: "add50_2",
          text: "+50 points",
          icon: `<i data-lucide="star" class="w-10 h-10 text-yellow-100"></i>`,
          color: "bg-cyan-500 shadow-cyan-500/40",
          action: (teams, tIdx) => {
            teams[tIdx].score += 50;
            return teams;
          },
        },

        {
          id: "sub50_1",
          text: "-50 points",
          icon: `<i data-lucide="cloud-rain" class="w-10 h-10 text-white"></i>`,
          color: "bg-red-400 shadow-red-400/40",
          action: (teams, tIdx) => {
            teams[tIdx].score -= 50;
            return teams;
          },
        },
        {
          id: "sub50_2",
          text: "-50 points",
          icon: `<i data-lucide="cloud-rain" class="w-10 h-10 text-white"></i>`,
          color: "bg-red-400 shadow-red-400/40",
          action: (teams, tIdx) => {
            teams[tIdx].score -= 50;
            return teams;
          },
        },
        {
          id: "sub100_1",
          text: "-100 points",
          icon: `<i data-lucide="cloud-rain" class="w-10 h-10 text-white"></i>`,
          color: "bg-red-500 shadow-red-500/40",
          action: (teams, tIdx) => {
            teams[tIdx].score -= 100;
            return teams;
          },
        },
        {
          id: "sub100_2",
          text: "-100 points",
          icon: `<i data-lucide="cloud-rain" class="w-10 h-10 text-white"></i>`,
          color: "bg-red-500 shadow-red-500/40",
          action: (teams, tIdx) => {
            teams[tIdx].score -= 100;
            return teams;
          },
        },
        {
          id: "sub200_1",
          text: "-200 points",
          icon: `<i data-lucide="alert-triangle" class="w-10 h-10 text-white"></i>`,
          color: "bg-rose-600 shadow-rose-600/40",
          action: (teams, tIdx) => {
            teams[tIdx].score -= 200;
            return teams;
          },
        },
        {
          id: "sub200_2",
          text: "-200 points",
          icon: `<i data-lucide="alert-triangle" class="w-10 h-10 text-white"></i>`,
          color: "bg-rose-600 shadow-rose-600/40",
          action: (teams, tIdx) => {
            teams[tIdx].score -= 200;
            return teams;
          },
        },
        {
          id: "sub300",
          text: "-300 points",
          icon: `<i data-lucide="alert-triangle" class="w-10 h-10 text-white"></i>`,
          color: "bg-red-600 shadow-red-600/40",
          action: (teams, tIdx) => {
            teams[tIdx].score -= 300;
            return teams;
          },
        },
        {
          id: "sub500",
          text: "-500 points",
          icon: `<i data-lucide="alert-triangle" class="w-10 h-10 text-white"></i>`,
          color: "bg-red-700 shadow-red-700/40",
          action: (teams, tIdx) => {
            teams[tIdx].score -= 500;
            return teams;
          },
        },
      ];

      const getTeamStyle = (index) => {
        const styles = [
          {
            text: "text-orange-600",
            bg: "bg-orange-100",
            border: "border-orange-400",
            shadow: "shadow-[0_0_30px_rgba(251,146,60,0.5)]",
            badge: "bg-orange-500",
          },
          {
            text: "text-blue-600",
            bg: "bg-blue-100",
            border: "border-blue-400",
            shadow: "shadow-[0_0_30px_rgba(96,165,250,0.5)]",
            badge: "bg-blue-500",
          },
          {
            text: "text-emerald-600",
            bg: "bg-emerald-100",
            border: "border-emerald-400",
            shadow: "shadow-[0_0_30px_rgba(52,211,153,0.5)]",
            badge: "bg-emerald-500",
          },
          {
            text: "text-fuchsia-600",
            bg: "bg-fuchsia-100",
            border: "border-fuchsia-400",
            shadow: "shadow-[0_0_30px_rgba(232,121,249,0.5)]",
            badge: "bg-fuchsia-500",
          },
        ];
        return styles[index % styles.length];
      };

      // --- GLOBAL STATE ---
      let gameState = "setup"; // 'setup' or 'playing'
      let isMuted = false;

      let setupTeamCount = 2;
      let customQuestions = Array.from({ length: 26 }, (_, i) => ({
        letter: String.fromCharCode(65 + i),
        type: "mcq",
        question: `Sample Question ${String.fromCharCode(65 + i)}`,
        options: ["Option A", "Option B", "Option C", "Option D"],
        correctOptionIndex: 0,
        answer: `Sample Answer ${String.fromCharCode(65 + i)}`,
      }));

      let teams = [];
      let currentTeamIdx = 0;
      let openedBoxes = [];

      let activeBox = null;
      let isAnswerRevealed = false;
      let selectedOptionIndex = null;
      let currentOutcome = null;
      let modalStep = "question"; // 'question', 'decision', 'reveal'
      let targetTeamIdx = null;
      let celebration = null;

      // --- ACTIONS ---

      const updateQuestionType = (idx, type) => {
        customQuestions[idx].type = type;
        renderApp();
      };

      const updateCorrectOption = (qIdx, optIdx) => {
        customQuestions[qIdx].correctOptionIndex = optIdx;
        // No re-render needed, native HTML radio handles it visually
      };

      const startGame = () => {
        playSound("click", isMuted);
        const gameData = {
          setupTeamCount,
          customQuestions,
        };
        window.parent.postMessage(
          { type: "SAVE_MYSTERY_BOX", data: gameData },
          "*",
        );
      };

      const returnToSetup = () => {
        gameState = "setup";
        activeBox = null;
        renderApp();
      };

      const toggleTeam = () => {
        currentTeamIdx = (currentTeamIdx + 1) % teams.length;
      };

      const handleBoxClick = (letter) => {
        if (openedBoxes.includes(letter)) return;
        playSound("click", isMuted);
        activeBox = customQuestions.find((q) => q.letter === letter);
        isAnswerRevealed = false;
        selectedOptionIndex = null;
        currentOutcome = null;
        modalStep = "question";
        targetTeamIdx = null;
        renderApp();
      };

      const handleOptionSelect = (index) => {
        if (!isAnswerRevealed) {
          playSound("click", isMuted);
          selectedOptionIndex = index;
          renderApp();
        }
      };

      const handleReveal = () => {
        playSound("reveal", isMuted);
        isAnswerRevealed = true;
        renderApp();
      };

      const handleIncorrect = () => {
        playSound("incorrect", isMuted);
        openedBoxes.push(activeBox.letter);
        activeBox = null;
        toggleTeam();
        renderApp();
        checkGameOver();
      };

      const handleCorrect = () => {
        playSound("click", isMuted);
        modalStep = "decision";
        renderApp();
      };

      const handleDecision = (choiceTargetIdx) => {
        targetTeamIdx = choiceTargetIdx;

        const randomOutcome =
          OUTCOMES[Math.floor(Math.random() * OUTCOMES.length)];
        currentOutcome = randomOutcome;

        const isPositive = !["sub", "lose"].some((prefix) =>
          randomOutcome.id.startsWith(prefix),
        );
        playSound(isPositive ? "win" : "lose", isMuted);

        celebration = isPositive ? "win" : "lose";
        setTimeout(() => {
          celebration = null;
          renderApp();
        }, 3000);

        teams = randomOutcome.action(teams, choiceTargetIdx);
        openedBoxes.push(activeBox.letter);
        modalStep = "reveal";
        renderApp();
      };

      const closeReveal = () => {
        activeBox = null;
        toggleTeam();
        renderApp();
        checkGameOver();
      };

      const resetGame = () => {
        teams.forEach((t) => (t.score = 0));
        openedBoxes = [];
        currentTeamIdx = 0;
        activeBox = null;
        celebration = null;
        renderApp();
      };

      const toggleMute = () => {
        isMuted = !isMuted;
        renderApp();
      };

      const getWinners = () => {
        if (teams.length === 0) return [];
        const maxScore = Math.max(...teams.map((t) => t.score));
        return teams.filter((t) => t.score === maxScore);
      };

      const checkGameOver = () => {
        const isGameOver =
          gameState === "playing" &&
          openedBoxes.length === customQuestions.length &&
          activeBox === null;
        if (isGameOver && openedBoxes.length > 0) {
          playSound("grand_win", isMuted);
          renderApp();
        }
      };

      // --- RENDER FUNCTIONS ---

      const renderSetupScreen = () => {
        let teamButtons = [2, 3, 4]
          .map(
            (num) => `
        <button 
          onclick="playSound('click', isMuted); setupTeamCount = ${num}; renderApp();"
          class="w-32 py-4 rounded-xl font-bold text-xl transition-all duration-300 ${
            setupTeamCount === num
              ? "bg-blue-500 text-white shadow-md border-2 border-blue-600"
              : "bg-slate-100 text-slate-500 border-2 border-slate-200 hover:bg-slate-200"
          }"
        >
          ${num} Teams
        </button>
      `,
          )
          .join("");

        let questionsHtml = customQuestions
          .map(
            (q, idx) => `
        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4 gap-4">
            <div class="flex items-center gap-3">
              <div class="bg-blue-500 text-white w-10 h-10 flex items-center justify-center rounded-full font-black text-xl">
                ${q.letter}
              </div>
              <h3 class="text-lg font-bold text-slate-700">Question Setup</h3>
            </div>
            
            <div class="flex bg-slate-200 rounded-lg p-1">
              <button
                onclick="updateQuestionType(${idx}, 'mcq')"
                class="px-4 py-2 rounded-md text-sm font-bold transition-colors ${q.type === "mcq" ? "bg-white shadow-sm text-slate-800" : "text-slate-500 hover:text-slate-700"}"
              >
                Multiple Choice
              </button>
              <button
                onclick="updateQuestionType(${idx}, 'fib')"
                class="px-4 py-2 rounded-md text-sm font-bold transition-colors ${q.type === "fib" ? "bg-white shadow-sm text-slate-800" : "text-slate-500 hover:text-slate-700"}"
              >
                Fill in Blanks
              </button>
            </div>
          </div>

          <div class="mb-4">
            <label class="block text-sm font-bold text-slate-500 mb-2">Question</label>
            <textarea 
              oninput="customQuestions[${idx}].question = this.value"
              class="w-full bg-white border border-slate-300 rounded-xl p-3 resize-none h-20 focus:ring-2 focus:ring-blue-400 outline-none font-medium text-slate-700"
            >${q.question}</textarea>
          </div>

          ${
            q.type === "mcq"
              ? `
            <div>
              <label class="block text-sm font-bold text-slate-500 mb-2">Answers (Select the correct option)</label>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                ${q.options
                  .map(
                    (opt, oIdx) => `
                  <div class="flex items-center gap-3 bg-white border border-slate-200 p-3 rounded-xl focus-within:border-blue-400">
                    <label class="flex items-center gap-3 cursor-pointer select-none">
                      <input 
                        type="radio" 
                        name="q-${q.letter}-correct"
                        ${q.correctOptionIndex === oIdx ? "checked" : ""} 
                        onchange="updateCorrectOption(${idx}, ${oIdx})" 
                        class="w-5 h-5 accent-blue-500 cursor-pointer" 
                      />
                      <span class="font-bold text-slate-400 w-4">${String.fromCharCode(65 + oIdx)}</span>
                    </label>
                    <input 
                      type="text" 
                      value="${opt.replace(/"/g, "&quot;")}" 
                      oninput="customQuestions[${idx}].options[${oIdx}] = this.value" 
                      class="flex-1 bg-transparent outline-none font-medium text-slate-700" 
                      placeholder="Option ${String.fromCharCode(65 + oIdx)}"
                    />
                  </div>
                `,
                  )
                  .join("")}
              </div>
            </div>
          `
              : ""
          }

          ${
            q.type === "fib"
              ? `
            <div>
              <label class="block text-sm font-bold text-slate-500 mb-2">Answer</label>
              <textarea 
                oninput="customQuestions[${idx}].answer = this.value"
                class="w-full bg-white border border-slate-300 rounded-xl p-3 resize-none h-20 focus:ring-2 focus:ring-blue-400 outline-none font-medium text-slate-700"
              >${q.answer}</textarea>
            </div>
          `
              : ""
          }
        </div>
      `,
          )
          .join("");

        return `
        <div class="min-h-screen bg-slate-50 p-6 md:p-10 font-sans">
          <div class="max-w-6xl mx-auto">
            <div class="flex flex-col items-center mb-10">
              <h1 class="text-4xl font-black text-slate-800 drop-shadow-sm">Game Setup</h1>
              <p class="text-slate-500 font-bold mt-2">Configure teams and questions</p>
            </div>

            <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-200 mb-8">
              <h2 class="text-2xl font-bold mb-6 text-slate-700">1. Number of Teams</h2>
              <div class="flex gap-4">${teamButtons}</div>
            </div>

            <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-200 mb-8">
              <h2 class="text-2xl font-bold mb-6 text-slate-700">2. Questions List (A-Z)</h2>
              <div class="space-y-6">${questionsHtml}</div>
            </div>

            <div class="sticky bottom-6 mt-8">
              <button onclick="startGame()" class="w-full py-6 bg-green-600 text-white rounded-2xl font-black text-2xl hover:bg-green-700 hover:shadow-xl hover:shadow-green-600/30 transition-all flex items-center justify-center gap-3">
                <i data-lucide="save" class="w-8 h-8"></i> SAVE GAME
              </button>
            </div>
          </div>
          <div class="fixed bottom-4 right-6 text-slate-400/80 font-black text-sm pointer-events-none z-50 select-none drop-shadow-sm uppercase tracking-wider">
            Created by: Teacher Jan
          </div>
        </div>
      `;
      };

      const renderGameScreen = () => {
        const isGameOver =
          openedBoxes.length === customQuestions.length && activeBox === null;
        let shakeClass = celebration === "lose" ? "animate-shake" : "";

        let teamsHeaderHtml = teams
          .map((team, idx) => {
            const isCurrent = currentTeamIdx === idx;
            const style = getTeamStyle(idx);
            return `
          <div class="px-4 md:px-8 py-3 md:py-4 rounded-xl border-4 transition-all duration-300 min-w-[120px] md:min-w-[180px] text-center ${
            isCurrent
              ? `${style.border} ${style.bg} scale-110 ${style.shadow} z-10`
              : "border-transparent bg-white/60"
          }">
            <p class="text-sm md:text-xl font-black uppercase tracking-wider mb-1 ${isCurrent ? style.text : "text-slate-400"}">${team.name}</p>
            <p class="text-4xl md:text-6xl font-black drop-shadow-sm transition-all ${isCurrent ? style.text : "text-slate-600"}">
              ${team.score > 0 ? "+" : ""}${team.score}
            </p>
          </div>
          ${idx < teams.length - 1 ? `<div class="text-sky-300 font-black text-xl md:text-3xl opacity-50">VS</div>` : ""}
        `;
          })
          .join("");

        let gridHtml = customQuestions
          .map((box) => {
            const isOpened = openedBoxes.includes(box.letter);
            return `
          <button
            onclick="handleBoxClick('${box.letter}')"
            ${isOpened ? "disabled" : ""}
            class="relative group aspect-square rounded-[2rem] flex flex-col items-center justify-center text-2xl sm:text-3xl md:text-4xl font-black shadow-xl transition-all duration-300
              ${
                isOpened
                  ? "bg-white/40 text-slate-400/50 cursor-not-allowed border-2 border-white/50 shadow-inner scale-95"
                  : "bg-gradient-to-br from-yellow-300 to-orange-400 text-white hover:-translate-y-2 hover:shadow-2xl hover:shadow-orange-400/50 border-4 border-white active:scale-95"
              }
            "
          >
            ${!isOpened ? `<div class="absolute inset-0 bg-white/0 group-hover:bg-white/20 transition-colors rounded-[2rem]"></div>` : ""}
            ${box.letter}
            ${!isOpened ? `<i data-lucide="gift" class="w-6 h-6 sm:w-8 sm:h-8 mt-1 sm:mt-2 text-white/80 group-hover:text-white transition-colors drop-shadow-md"></i>` : ""}
          </button>
        `;
          })
          .join("");

        // Modal HTML
        let modalHtml = "";
        if (activeBox) {
          let modalInner = "";
          if (modalStep === "question") {
            let mcqOptionsHtml = "";
            if (activeBox.type === "mcq") {
              mcqOptionsHtml = `
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mt-12 max-w-6xl mx-auto">
                ${activeBox.options
                  .map((opt, i) => {
                    let optionStyle =
                      "bg-white border-slate-200 text-slate-600";
                    if (!isAnswerRevealed) {
                      if (selectedOptionIndex === i) {
                        optionStyle =
                          "bg-blue-100 border-blue-500 text-blue-800 shadow-lg scale-[1.02]";
                      } else {
                        optionStyle +=
                          " hover:border-blue-300 hover:bg-blue-50 cursor-pointer";
                      }
                    } else {
                      if (activeBox.correctOptionIndex === i) {
                        optionStyle =
                          "bg-green-100 border-green-500 text-green-700 scale-[1.03] shadow-2xl z-10";
                      } else if (selectedOptionIndex === i) {
                        optionStyle =
                          "bg-red-100 border-red-500 text-red-700 opacity-90";
                      } else {
                        optionStyle =
                          "bg-white border-slate-200 text-slate-500 opacity-40";
                      }
                    }
                    return `
                    <button 
                      onclick="handleOptionSelect(${i})"
                      ${isAnswerRevealed ? "disabled" : ""}
                      class="p-6 md:p-8 rounded-3xl text-3xl md:text-5xl lg:text-6xl font-bold border-[4px] transition-all flex items-center text-left w-full ${optionStyle}"
                    >
                      <span class="mr-4 md:mr-6 opacity-50">${String.fromCharCode(65 + i)}.</span> 
                      ${opt}
                    </button>
                  `;
                  })
                  .join("")}
              </div>
            `;
            }

            let fibHtml = "";
            if (activeBox.type === "fib" && isAnswerRevealed) {
              fibHtml = `
              <div class="mt-12 p-8 md:p-10 bg-green-50 border-[4px] border-green-400 rounded-[2rem] animate-in fade-in duration-300">
                <span class="text-green-700 font-black text-4xl md:text-6xl lg:text-7xl">Answer: ${activeBox.answer}</span>
              </div>
            `;
            }

            let controlsHtml = !isAnswerRevealed
              ? `
            <button onclick="handleReveal()" class="mx-auto flex items-center gap-4 px-12 py-6 bg-blue-500 hover:bg-blue-600 text-white rounded-3xl font-black text-3xl shadow-xl hover:shadow-blue-500/40 transition-all hover:-translate-y-1">
              <i data-lucide="eye" class="w-8 h-8"></i> Reveal Answer
            </button>
          `
              : `
            <div class="flex flex-col sm:flex-row justify-center gap-6 animate-in fade-in zoom-in duration-300">
              <button onclick="handleIncorrect()" class="flex-1 max-w-[350px] mx-auto sm:mx-0 flex items-center justify-center gap-3 px-8 py-6 bg-white hover:bg-red-50 text-slate-600 hover:text-red-600 border-[4px] border-slate-200 hover:border-red-300 rounded-3xl font-black text-3xl transition-all">
                <i data-lucide="x" class="w-10 h-10"></i> INCORRECT
              </button>
              <button onclick="handleCorrect()" class="flex-1 max-w-[350px] mx-auto sm:mx-0 flex items-center justify-center gap-3 px-8 py-6 bg-green-500 hover:bg-green-600 text-white rounded-3xl font-black text-3xl shadow-xl hover:shadow-green-500/40 transition-all hover:-translate-y-1">
                <i data-lucide="check" class="w-10 h-10"></i> CORRECT
              </button>
            </div>
          `;

            modalInner = `
            <p class="text-2xl font-black text-blue-500 uppercase tracking-widest mb-6">QUESTION</p>
            <div class="bg-slate-50 rounded-[3rem] p-10 md:p-14 mb-8 shadow-inner border border-slate-100">
              <h3 class="text-5xl md:text-7xl lg:text-8xl font-extrabold text-slate-800 leading-tight whitespace-pre-wrap">${activeBox.question}</h3>
              ${mcqOptionsHtml}
              ${fibHtml}
            </div>
            ${controlsHtml}
          `;
          } else if (modalStep === "decision") {
            let giveButtonsHtml = "";
            if (teams.length === 2) {
              giveButtonsHtml = `
              <button onclick="handleDecision(${(currentTeamIdx + 1) % 2})" class="flex-1 flex flex-col items-center justify-center gap-3 px-6 py-8 bg-[#faf5ff] hover:bg-[#f3e8ff] text-[#a855f7] border-[3px] border-[#c084fc] rounded-[1.5rem] transition-all hover:-translate-y-1 shadow-sm">
                <div class="flex items-center gap-3 font-black text-3xl">
                  <i data-lucide="arrow-right-left" class="w-8 h-8" stroke-width="2.5"></i> GIVE IT AWAY
                </div>
                <span class="text-sm font-bold opacity-80">(Applies to ${teams[(currentTeamIdx + 1) % 2].name})</span>
              </button>
            `;
            } else {
              giveButtonsHtml = `
              <div class="flex-1 flex flex-col bg-[#faf5ff] border-[3px] border-[#c084fc] rounded-[1.5rem] p-4">
                <div class="flex items-center justify-center gap-2 font-black text-xl text-[#a855f7] mb-3">
                  <i data-lucide="arrow-right-left" class="w-6 h-6"></i> GIVE TO:
                </div>
                <div class="flex flex-wrap justify-center gap-3">
                  ${teams
                    .map((t, i) => {
                      if (i === currentTeamIdx) return "";
                      return `<button onclick="handleDecision(${i})" class="flex-1 min-w-[100px] flex items-center justify-center py-3 bg-white hover:bg-purple-100 text-[#a855f7] rounded-xl font-bold text-lg transition-all shadow-sm border border-purple-200">${t.name}</button>`;
                    })
                    .join("")}
                </div>
              </div>
            `;
            }

            modalInner = `
            <div class="animate-in zoom-in-95 duration-500 bg-white rounded-[2rem] px-4 py-6 md:p-8">
              <p class="text-xl md:text-2xl font-black text-[#3b82f6] uppercase tracking-widest mb-8">Decision Time!</p>
              <div class="mb-10 p-6 md:p-8 bg-white border shadow-[0_0_15px_rgba(0,0,0,0.05)] rounded-3xl">
                <h3 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4">You answered correctly! 🎉</h3>
                <p class="text-xl md:text-2xl font-medium text-slate-600">
                  Do you want to <span class="font-black text-[#f97316]">KEEP</span> the mystery box, or <span class="font-black text-[#a855f7]">GIVE</span> it away?
                </p>
              </div>
              <div class="flex flex-col md:flex-row justify-center gap-6">
                <button onclick="handleDecision(${currentTeamIdx})" class="flex-1 flex flex-col items-center justify-center gap-3 px-6 py-8 bg-[#fff8f1] hover:bg-[#ffedd5] text-[#f97316] border-[3px] border-[#fb923c] rounded-[1.5rem] transition-all hover:-translate-y-1 shadow-sm">
                  <div class="flex items-center gap-3 font-black text-3xl">
                    <i data-lucide="gift" class="w-8 h-8" stroke-width="2.5"></i> KEEP IT
                  </div>
                  <span class="text-sm font-bold opacity-80">(Applies to ${teams[currentTeamIdx].name})</span>
                </button>
                ${giveButtonsHtml}
              </div>
            </div>
          `;
          } else if (modalStep === "reveal") {
            modalInner = `
            <div class="animate-in zoom-in-90 duration-500">
              <p class="text-xl font-black text-slate-400 uppercase tracking-widest mb-4">Mystery Box Revealed</p>
              <div class="mt-6 mb-8 mx-auto w-full max-w-lg ${currentOutcome.color} rounded-[2rem] p-12 shadow-xl flex flex-col items-center gap-6 transform transition-all hover:scale-105 border-[6px] border-white">
                <div class="bg-white/20 p-6 rounded-full shadow-inner backdrop-blur-sm">
                  ${currentOutcome.icon}
                </div>
                <h3 class="text-5xl md:text-6xl font-black text-white text-center drop-shadow-md leading-tight">
                  ${currentOutcome.text}
                </h3>
              </div>
              <p class="text-2xl font-bold text-slate-600 mb-8">
                Applied to: <span class="px-4 py-1 rounded-xl text-white ${getTeamStyle(targetTeamIdx).badge}">${teams[targetTeamIdx].name}</span>
              </p>
              <button onclick="closeReveal()" class="w-full sm:w-auto px-16 py-5 bg-slate-800 text-white hover:bg-slate-700 rounded-2xl font-black text-2xl shadow-xl transition-all hover:-translate-y-1">
                Continue
              </button>
            </div>
          `;
          }

          modalHtml = `
          <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-md overflow-y-auto">
            <div class="bg-white border-[6px] border-yellow-300 rounded-[3rem] p-8 md:p-12 max-w-[90vw] xl:max-w-7xl w-full shadow-2xl relative animate-in zoom-in-95 duration-300 my-auto">
              <div class="absolute -top-12 left-1/2 -translate-x-1/2">
                <div class="bg-gradient-to-br from-yellow-400 to-orange-500 text-white w-24 h-24 rounded-full flex items-center justify-center text-5xl font-black shadow-lg border-[6px] border-white">
                  ${activeBox.letter}
                </div>
              </div>
              <div class="mt-8 text-center">${modalInner}</div>
              <button onclick="activeBox=null; renderApp();" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 transition-colors bg-slate-100 hover:bg-slate-200 rounded-full p-2">
                <i data-lucide="x" class="w-6 h-6"></i>
              </button>
            </div>
          </div>
        `;
        }

        // Visual Effects Html
        let visualEffectsHtml = "";
        if (celebration === "win") {
          let confettis = Array.from({ length: 40 })
            .map(
              () => `
          <div class="absolute text-5xl md:text-6xl animate-float-up" style="left: ${Math.random() * 100}%; bottom: -10%; animation-delay: ${Math.random() * 0.5}s; animation-duration: ${1.5 + Math.random()}s">
            ${["🎉", "✨", "🥳", "🌟", "💸", "🏆"][Math.floor(Math.random() * 6)]}
          </div>
        `,
            )
            .join("");
          visualEffectsHtml = `<div class="fixed inset-0 pointer-events-none z-[100] flex items-center justify-center overflow-hidden">${confettis}</div>`;
        } else if (celebration === "lose") {
          let drops = Array.from({ length: 30 })
            .map(
              () => `
          <div class="absolute text-5xl md:text-6xl animate-drop-down" style="left: ${Math.random() * 100}%; top: -10%; animation-delay: ${Math.random() * 0.3}s; animation-duration: ${1 + Math.random()}s">
            ${["🌧️", "💀", "📉", "💔", "⚡", "💣"][Math.floor(Math.random() * 6)]}
          </div>
        `,
            )
            .join("");
          visualEffectsHtml = `<div class="fixed inset-0 pointer-events-none z-[100] bg-red-900/20 flex items-center justify-center overflow-hidden transition-colors duration-500">${drops}</div>`;
        }

        // Game Over Html
        let gameOverHtml = "";
        if (isGameOver) {
          let confettis = Array.from({ length: 80 })
            .map(
              () => `
          <div class="absolute text-4xl md:text-5xl animate-confetti" style="left: ${Math.random() * 100}%; top: -20%; animation-delay: ${Math.random() * 5}s; animation-duration: ${2 + Math.random() * 3}s">
            ${["🎉", "✨", "🥳", "🌟", "🏆", "🎊"][Math.floor(Math.random() * 6)]}
          </div>
        `,
            )
            .join("");

          const winners = getWinners();
          let winnerInner = "";
          if (winners.length > 1) {
            winnerInner = `
            <div class="text-8xl mb-6">🤝</div>
            <h3 class="text-5xl md:text-6xl font-black text-slate-800">It's a TIE!</h3>
            <p class="text-2xl text-slate-500 font-bold mt-4">${winners.map((w) => w.name).join(" & ")} scored ${winners[0].score} points!</p>
          `;
          } else if (winners.length === 1) {
            const winner = winners[0];
            winnerInner = `
            <div class="text-8xl mb-6 animate-bounce">🏆</div>
            <h3 class="text-5xl md:text-7xl font-black mb-4 uppercase"><span class="${getTeamStyle(winner.id).text}">${winner.name}</span> WINS!</h3>
            <p class="text-3xl text-slate-600 font-bold">Final Score: <span class="text-slate-800 font-black">${winner.score}</span></p>
          `;
          }

          gameOverHtml = `
          <div class="fixed inset-0 z-[120] flex items-center justify-center p-4 bg-slate-900/80 backdrop-blur-sm">
            <div class="absolute inset-0 pointer-events-none overflow-hidden">${confettis}</div>
            <div class="bg-white rounded-[3rem] p-12 max-w-3xl w-full shadow-[0_0_100px_rgba(251,191,36,0.6)] relative flex flex-col items-center animate-in zoom-in duration-700 text-center border-[6px] border-yellow-400">
              <h2 class="text-4xl font-black text-slate-400 uppercase tracking-widest mb-6">Game Over</h2>
              <div class="mb-10 w-full">${winnerInner}</div>
              <div class="flex gap-4 w-full">
                <button onclick="returnToSetup()" class="flex-1 px-8 py-5 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-2xl font-black text-xl transition-all">Setup Options</button>
                <button onclick="resetGame()" class="flex-[2] px-12 py-5 bg-gradient-to-r from-orange-400 to-yellow-500 hover:from-orange-500 hover:to-yellow-600 text-white rounded-2xl font-black text-2xl shadow-xl transition-all hover:scale-105">Play Again</button>
              </div>
            </div>
          </div>
        `;
        }

        return `
        <div class="min-h-screen bg-gradient-to-br from-cyan-200 via-sky-100 to-yellow-100 pb-10 ${shakeClass}">
          
          <header class="p-4 md:p-6 bg-white/80 backdrop-blur-md shadow-lg shadow-sky-200/50 mb-8 border-b border-white flex flex-col xl:flex-row justify-between items-center gap-6 z-10 relative">
            <div class="flex items-center gap-3">
              <div class="bg-yellow-400 p-2 rounded-full shadow-lg shadow-yellow-400/40">
                <i data-lucide="sun" class="w-8 h-8 text-white"></i>
              </div>
              <h1 class="text-3xl md:text-4xl font-black bg-gradient-to-r from-orange-500 to-yellow-500 bg-clip-text text-transparent drop-shadow-sm hidden md:block">
                Mystery Box
              </h1>
            </div>

            <div class="flex items-center justify-center gap-2 md:gap-4 bg-white/60 p-2 md:p-3 rounded-2xl shadow-inner border border-white flex-wrap">
              ${teamsHeaderHtml}
            </div>

            <div class="flex items-center gap-3">
              <button onclick="toggleMute()" class="p-3 bg-white text-slate-500 hover:text-sky-500 rounded-xl shadow-md transition-colors" title="${isMuted ? "Unmute sounds" : "Mute sounds"}">
                ${isMuted ? `<i data-lucide="volume-x" class="w-6 h-6"></i>` : `<i data-lucide="volume-2" class="w-6 h-6"></i>`}
              </button>
              <button onclick="resetGame()" class="p-3 bg-white text-slate-500 hover:text-red-500 rounded-xl shadow-md transition-colors" title="Reset Scores">
                <i data-lucide="refresh-cw" class="w-6 h-6"></i>
              </button>
              <button onclick="returnToSetup()" class="flex items-center gap-2 px-5 py-3 bg-slate-800 text-white hover:bg-slate-700 rounded-xl shadow-md transition-colors font-bold">
                <i data-lucide="settings" class="w-5 h-5"></i> Setup
              </button>
            </div>
          </header>

          <main class="max-w-7xl mx-auto px-4">
            <div class="text-center mb-10">
              <div class="inline-block bg-white border-2 border-white rounded-full p-2 pr-6 shadow-xl shadow-sky-200/50 transform transition-all hover:scale-105">
                <h2 class="text-xl md:text-2xl font-bold text-slate-600 flex items-center gap-4">
                  <span class="px-6 py-2 rounded-full text-white font-black shadow-md ${getTeamStyle(currentTeamIdx).badge}">
                    ${teams[currentTeamIdx]?.name.toUpperCase()} TURN
                  </span>
                  Pick a Mystery Box!
                </h2>
              </div>
            </div>

            <div class="grid grid-cols-4 sm:grid-cols-5 md:grid-cols-6 lg:grid-cols-7 gap-3 md:gap-4 justify-center max-w-6xl mx-auto">
              ${gridHtml}
            </div>
          </main>

          ${modalHtml}
          ${visualEffectsHtml}
          ${gameOverHtml}

          <div class="fixed bottom-4 right-6 text-slate-500/80 font-black text-sm pointer-events-none z-50 select-none drop-shadow-sm uppercase tracking-wider">
            Created by: Teacher Jan
          </div>
        </div>
      `;
      };

      const renderApp = () => {
        const root = document.getElementById("app-root");
        if (gameState === "setup") {
          root.innerHTML = renderSetupScreen();
        } else {
          root.innerHTML = renderGameScreen();
        }
        lucide.createIcons(); // Initialize all Lucide icons after rendering
      };

      // Initialize App
      renderApp();

      window.addEventListener("message", (event) => {
        if (event.data?.type === "LOAD_MYSTERY_BOX") {
          const gameData = event.data.data;
          setupTeamCount = gameData.setupTeamCount || 2;
          customQuestions = gameData.customQuestions || customQuestions;
          teams = Array.from({ length: setupTeamCount }, (_, i) => ({
            id: i,
            name: `Team ${i + 1}`,
            score: 0,
          }));
          currentTeamIdx = 0;
          openedBoxes = [];
          gameState = "playing";
          renderApp();
        }
      });
    </script>
  </body>
</html>
